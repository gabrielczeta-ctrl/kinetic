                else if (side == 1 && mHscActive && hscStriker().mFist && mHscWorldRotation)
                {
                    hand = mHscGrip;
                    handRotation = *mHscWorldRotation;
                }
                else if (!(mManualMotorPoseApplied && mManualMotorPoseTick == mCurrentContactPhysicsStep))
                    continue;
