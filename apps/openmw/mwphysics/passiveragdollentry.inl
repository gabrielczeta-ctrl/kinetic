                        Log(Debug::Info) << "ARM_COMMAND_LIMIT step=" << mCurrentContactPhysicsStep
                            << " phase=" << static_cast<int>(mAnimationAttack.mPhase)
                            << " held=" << mSwingInput.mHeld << " weight=" << input.mWeight
                            << " shoulder_error=" << shoulderError << " wrist_error=" << wristError;
                    }
                }
                if (RagdollCore::tuningText("OPENMW_RAGDOLL_ARM_TOOL_CAPTURE") && &arm == &mRightArm
                    && getPtr() == MWMechanics::getPlayer() && input.mHandRotation && result->mApplied)
                {
                    static std::optional<JPH::Quat> previousWanted, previousSolved;
                    static std::optional<JPH::Quat> previousFull;
                    static float previousBlendDot = 1.0f;
                    static std::uint64_t previousIdentity = 0, previousStep = 0;
                    static unsigned jumpRows = 0;
                    const auto solved = pose.mBodyTransforms[arm->mHand].mRotation;
                    const auto angle = [](JPH::QuatArg first, JPH::QuatArg second) {
                        return 2.0f * std::acos(std::clamp(std::abs(first.Dot(second)), 0.0f, 1.0f));
                    };
                    const float wantedAngle = previousWanted ? angle(*previousWanted, *input.mHandRotation) : 0;
                    const float solvedAngle = previousSolved ? angle(*previousSolved, solved) : 0;
                    auto fullPose = *toolIncoming;
                    auto fullInput = input;
                    fullInput.mWeight = 1.0f;
                    const auto full = RagdollCore::applyArmTargetPose(fullPose.mBodyTransforms,
                        base.mBodyTransforms, mCurrentPhysicsPose.mBodyTransforms, arm->mFrame, fullInput);
                    const auto wantedFull = fullPose.mBodyTransforms[arm->mHand].mRotation;
                    const auto incoming = toolIncoming->mBodyTransforms[arm->mHand].mRotation;
                    if (jumpRows < 64 && (wantedAngle > osg::PI_2 || solvedAngle > osg::PI_2
                            || previousIdentity != mSwingIdentity))
                    {
                        ++jumpRows;
                        const auto quaternion = [](JPH::QuatArg q) {
                            std::ostringstream text;
                            text << std::setprecision(9) << q.GetX() << ',' << q.GetY() << ',' << q.GetZ() << ',' << q.GetW();
                            return text.str();
                        };
                        Log(Debug::Info) << "ARM_TOOL_JUMP step=" << mCurrentContactPhysicsStep
                            << " previous_step=" << previousStep << " identity=" << mSwingIdentity
                            << " previous_identity=" << previousIdentity
                            << " phase=" << static_cast<unsigned>(mAnimationAttack.mPhase)
                            << " held=" << mSwingInput.mHeld << " swinging=" << mSwing.mSwinging
                            << " wanted_angle=" << wantedAngle << " solved_angle=" << solvedAngle
                            << " weight=" << input.mWeight << " reach=" << result->mReachError
                            << " wanted=" << quaternion(*input.mHandRotation)
                            << " solved=" << quaternion(solved);
                        if (toolIncoming)
                        {
                            if (full && full->mApplied)
                            {
                                Log(Debug::Info) << "ARM_TOOL_BLEND step=" << mCurrentContactPhysicsStep
                                    << " weight=" << input.mWeight << " incoming=" << quaternion(incoming)
                                    << " full=" << quaternion(wantedFull) << " dot=" << incoming.Dot(wantedFull)
                                    << " previous_dot=" << previousBlendDot
                                    << " full_angle=" << (previousFull ? angle(*previousFull, wantedFull) : 0.0f)
                                    << " full_reach=" << full->mReachError;
                            }
                        }
                    }
                    previousWanted = *input.mHandRotation;
                    previousSolved = solved;
                    previousFull = wantedFull;
                    previousBlendDot = incoming.Dot(wantedFull);
                    previousIdentity = mSwingIdentity;
                    previousStep = mCurrentContactPhysicsStep;
                }
                static bool capturedToolFixture = false;
                const bool traceTool = !capturedToolFixture && RagdollCore::tuningText("OPENMW_RAGDOLL_ARM_TOOL_CAPTURE")
                    && input.mHandRotation && input.mHandGeometry && !input.mHandAimOffset.IsNearZero()
                    && result->mReachError > 8.0f;
                if (traceTool)
                {
                    auto probe = base;
                    auto probeInput = input;
                    probeInput.mHandAimOffset = JPH::Vec3::sZero();
                    const auto positionOnly = RagdollCore::applyArmTargetPose(probe.mBodyTransforms,
                        base.mBodyTransforms, mCurrentPhysicsPose.mBodyTransforms, arm->mFrame, probeInput);
                    Log(Debug::Info) << "ARM_TOOL_REACH oriented=" << result->mReachError
                        << " positionOnly=" << (positionOnly ? positionOnly->mReachError : -1.0f);
                }
                if (input.mPreservedPositionAxis && result->mApplied && result->mReachError > 0.1f && !request->mBrace
                    && mSwing.mSwinging && mSwingInput.mHeld && mSwingRestOffset)
                {
                    const auto frameDelta = (mCurrentPhysicsPose.mBodyTransforms[arm->mFrame].mRotation
                        * base.mBodyTransforms[arm->mFrame].mRotation.Conjugated()).Normalized();
                    const auto solvedOffset = mRagdoll->getWorldVector(frameDelta
                        * (result->mHandPosition - base.mBodyTransforms[arm->mShoulder].mTranslation));
                    if (solvedOffset)
                        RagdollCore::constrainWeaponSwingToReach(mSwing,
                            JPH::Vec3(solvedOffset->Dot(mSwingBasisRight), solvedOffset->Dot(mSwingBasisForward),
                                solvedOffset->Dot(mSwingBasisUp)) - *mSwingRestOffset);
                }
                if (tracePose && fullShoulder)
                {
                    const auto quaternion = [](JPH::QuatArg q) {
                        std::ostringstream out;
                        out << std::setprecision(9) << q.GetX() << ',' << q.GetY() << ',' << q.GetZ() << ',' << q.GetW();
                        return out.str();
                    };
                    const auto written = (pose.mBodyTransforms[arm->mFrame].mRotation.Conjugated()
                        * pose.mBodyTransforms[arm->mShoulder].mRotation).Normalized();
                    Log(Debug::Info) << "ARM_POSE sample=" << poseTraceSamples++ << " weight=" << input.mWeight
                        << " incoming=" << quaternion(incomingShoulder) << " full=" << quaternion(*fullShoulder)
                        << " written=" << quaternion(written) << " error=" << result->mReachError;
                }
                // One reproducible native solve per process, opt-in and bounded.
                // Capture reference, measurement and actual live joint limits
                // for an isolated arm solve initialized from that reference.
                static bool capturedArmFixture = false;
                if ((traceTool || traceSequence || (!capturedArmFixture && RagdollCore::tuningText("OPENMW_RAGDOLL_ARM_TRACE")
                         && result->mReachError > 8.0f)) && input.mHingeGeometry && input.mShoulderGeometry)
                {
                    capturedArmFixture = true;
                    capturedToolFixture = capturedToolFixture || traceTool;
                    const auto vector = [](auto value) {
                        std::ostringstream out;
                        out << std::setprecision(9) << value.GetX() << ',' << value.GetY() << ',' << value.GetZ();
                        return out.str();
                    };
                    const auto quaternion = [&](JPH::Quat value) {
                        std::ostringstream out;
                        out << vector(value) << ',' << std::setprecision(9) << value.GetW();
                        return out.str();
                    };
                    if (traceSequence)
                        Log(Debug::Info) << "ARM_FIXTURE sequence " << sequenceSamples++ << ' ' << input.mWeight;
                    for (const auto body : { arm->mFrame, arm->mShoulder, arm->mElbow, arm->mHand })
                    {
                        const auto emit = [&](const char* name, const RagdollCore::Transform& transform) {
                            Log(Debug::Info) << "ARM_FIXTURE " << name << ' ' << body << ' '
                                << vector(transform.mTranslation) << ' ' << quaternion(transform.mRotation);
                        };
                        emit("base", base.mBodyTransforms[body]);
                        emit("measured", mCurrentPhysicsPose.mBodyTransforms[body]);
                        if (incomingPose)
                            emit("incoming", incomingPose->mBodyTransforms[body]);
                    }
                    const auto& hinge = *input.mHingeGeometry;
                    const auto& joint = *input.mShoulderGeometry;
                    Log(Debug::Info) << "ARM_FIXTURE input " << vector(input.mTargetHandPosition) << ' '
                        << vector(input.mPreferredBendDirection);
                    Log(Debug::Info) << "ARM_FIXTURE hinge " << vector(hinge.mUpperOffset) << ' '
                        << vector(hinge.mLowerOffset) << ' ' << quaternion(hinge.mLowerRotation) << ' '
                        << vector(hinge.mHingeAxis) << ' ' << hinge.mMinimumAngle << ' ' << hinge.mMaximumAngle;
                    Log(Debug::Info) << "ARM_FIXTURE shoulder " << quaternion(joint.mParentFrame) << ' '
                        << quaternion(joint.mChildFrame) << ' ' << joint.mNormalHalfConeAngle << ' '
                        << joint.mPlaneHalfConeAngle << ' ' << joint.mTwistMinimum << ' '
                        << joint.mTwistMaximum << ' ' << joint.mPyramid;
                    if (traceTool)
                    {
                        const auto& wrist = *input.mHandGeometry;
                        Log(Debug::Info) << "ARM_FIXTURE wrist " << quaternion(wrist.mParentFrame) << ' '
                            << quaternion(wrist.mChildFrame) << ' ' << wrist.mNormalHalfConeAngle << ' '
                            << wrist.mPlaneHalfConeAngle << ' ' << wrist.mTwistMinimum << ' '
                            << wrist.mTwistMaximum << ' ' << wrist.mPyramid;
                        Log(Debug::Info) << "ARM_FIXTURE tool " << quaternion(*input.mHandRotation) << ' '
                            << vector(input.mHandAimOffset);
                    }
                }
            };
            // The weapon arm first: a support hand is aimed at the pose the
            // weapon hand was just given.
            place(mRightArmTarget, mRightArm);
            place(mLeftArmTarget, mLeftArm);
            traceWristLimits(pose);
        }

        // How far a wrist sits outside its own joint limits, degrees (-1 =
        // unknown): in the measured pose, or in the commanded one.
        float wristOutsideDegrees(const std::optional<RagdollArmChain>& arm, const RagdollCore::RagdollPose* command) const
        {
            if (!arm || !mRagdoll)
                return -1.0f;
            const auto geometry = mRagdoll->getSwingTwistJointGeometry(arm->mHand);
            const auto& measured = command ? command->mBodyTransforms : mCurrentPhysicsPose.mBodyTransforms;
            if (!geometry || arm->mHand >= measured.size() || arm->mElbow >= measured.size())
                return -1.0f;
            const auto legal = RagdollCore::clampSwingTwistJointOrientation(
                *geometry, measured[arm->mElbow].mRotation, measured[arm->mHand].mRotation);
            if (!legal)
                return -1.0f;
            return 2.0f * std::acos(std::clamp(std::abs(legal->Dot(measured[arm->mHand].mRotation)), 0.0f, 1.0f))
                * 180.0f / osg::PIf;
        }
        // Dev diagnostic (OPENMW_RAGDOLL_WRIST_LIMIT_TRACE): how far each
        // measured wrist sits outside its own joint limits, in degrees.
        void traceWristLimits(const RagdollCore::RagdollPose& pose) const
        {
            static const auto enabled_tuned = RagdollCore::tuned<bool>([] { return RagdollCore::tuningText("OPENMW_RAGDOLL_WRIST_LIMIT_TRACE") != nullptr; });
            static const auto& enabled = enabled_tuned.get();
            if (!enabled || getPtr() != MWMechanics::getPlayer())
                return;
            const auto outside = [&](const std::optional<RagdollArmChain>& arm, bool command) {
                return wristOutsideDegrees(arm, command ? &pose : nullptr);
            };
            Log(Debug::Info) << "WRIST_LIMIT step=" << mCurrentContactPhysicsStep << " right=" << outside(mRightArm, false)
                             << " left=" << outside(mLeftArm, false) << " command_right=" << outside(mRightArm, true)
                             << " command_left=" << outside(mLeftArm, true);
        }

        void applyWeaponFixtureYaw(RagdollCore::RagdollPose& pose) const
        {
            if (!mWeaponFixtureYaw || !mWeapon || !mRightArm || pose.mBodyTransforms.size() != mRagdoll->getBodyCount())
                return;
            const auto& arm = *mRightArm;
            if (arm.mShoulder >= pose.mBodyTransforms.size() || arm.mElbow >= pose.mBodyTransforms.size()
                || arm.mHand >= pose.mBodyTransforms.size() || mWeapon->mWeaponBody >= pose.mBodyTransforms.size())
                return;
            const JPH::Quat rotation = JPH::Quat::sRotation(JPH::Vec3::sAxisZ(), *mWeaponFixtureYaw);
            const JPH::Vec3 pivot = pose.mBodyTransforms[arm.mShoulder].mTranslation;
            for (const std::size_t body : { arm.mShoulder, arm.mElbow, arm.mHand, mWeapon->mWeaponBody })
            {
                auto& target = pose.mBodyTransforms[body];
                target.mTranslation = pivot + rotation * (target.mTranslation - pivot);
                target.mRotation = (rotation * target.mRotation).Normalized();
            }
        }
