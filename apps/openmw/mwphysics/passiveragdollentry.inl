        void beginScopedRecovery(float impulse)
        {
            if (!scopedRecovery() || !mRagdoll || !std::isfinite(impulse)
                || (mControllerOutput && mControllerOutput->mMode == RagdollCore::ActiveControllerMode::Fallen)
                || getPtr().getClass().getCreatureStats(getPtr()).isDead())
                return;
            float mass = 0.0f;
            for (const float m : mRagdoll->getBodyMasses())
                mass += m;
            const float deltaV = mass > 0.0f ? impulse / mass : 0.0f;
            if (deltaV < 25.0f)
                return;
            if (!mScopedEpisode)
                Log(Debug::Info) << "RAGDOLL_SCOPED_RECOVERY begin actor=" << getPtr().getCellRef().getRefId()
                                 << " dv=" << deltaV;
            mScopedEpisode = true;
            mScopedTime = mScopedBalanced = 0.0f;
            mScopedCatchSeen = false;
            mScopedStep.reset();
        }
        // Once per physics step, from the Footfall input: whether the episode
        // still runs.
        bool updateScopedRecovery(float dt)
        {
            if (!mScopedEpisode)
                return false;
            if (mScopedStep && *mScopedStep == mFixedSteps)
                return true;
            // Footfall did not run last step (a fall, a get-up): the episode
            // is over, not paused.
            const bool interrupted = mScopedStep && mFixedSteps > *mScopedStep + 1;
            mScopedStep = mFixedSteps;
            mScopedDt = dt;
            mScopedTime += dt;
            mScopedCatchSeen = mScopedCatchSeen || mCatchRecovering;
            using Mode = RagdollCore::ActiveControllerMode;
            const char* end = nullptr;
            if (!mControllerOutput
                || !(mControllerOutput->mMode == Mode::Standing || mControllerOutput->mMode == Mode::Bracing
                    || mControllerOutput->mMode == Mode::Stumbling))
                end = "fallen";
            else if (interrupted)
                end = "interrupted";
            else if (mScopedCatchSeen && !mCatchRecovering)
                end = "caught";
            else if (mScopedTime > 3.0f)
                end = "timeout";
            else if (mControllerInput)
            {
                const JPH::Vec3 wanted = gaitCommandVelocity();
                JPH::Vec3 error = mControllerInput->mCenterOfMassVelocity - wanted;
                error.SetZ(0.0f);
                const JPH::Vec3 flat(wanted.GetX(), wanted.GetY(), 0.0f);
                bool balanced = footfallPinnedAt(0) && footfallPinnedAt(1) && mSupportEstimate
                    && mSupportEstimate->mLeftFootSupported && mSupportEstimate->mRightFootSupported
                    && mControllerInput->mTorsoUpDot > 0.9f && error.Length() < std::max(20.0f, 0.2f * flat.Length());
                RagdollCore::RagdollTelemetry telemetry;
                if (balanced && mPelvisBodyIndex && mRagdoll->captureTelemetry(telemetry)
                    && *mPelvisBodyIndex < telemetry.mBodies.size())
                    balanced = telemetry.mBodies[*mPelvisBodyIndex].mMotion.mAngularVelocity.Length() < 1.5f;
                mScopedBalanced = balanced ? mScopedBalanced + dt : 0.0f;
                if (mScopedBalanced >= 0.3f)
                    end = "balanced";
            }
            if (!end)
                return true;
            Log(Debug::Info) << "RAGDOLL_SCOPED_RECOVERY end actor=" << getPtr().getCellRef().getRefId()
                             << " reason=" << end << " t=" << mScopedTime;
            mScopedEpisode = false;
            return false;
        }
        // Planted, supported ankles twice as stiff during the episode.
        void applyScopedAnkles()
        {
            if (!scopedRecovery() || !mRagdoll || !mRuntimeProfile)
                return;
            for (std::size_t side = 0; side < 2; ++side)
            {
                const auto& leg = side == 0 ? mLeftLeg : mRightLeg;
                if (!leg || leg->mFoot >= mRuntimeProfile->mBodies.size()
                    || !mRuntimeProfile->mBodies[leg->mFoot].mConstraint)
                    continue;
                const bool supported = mSupportEstimate
                    && (side == 0 ? mSupportEstimate->mLeftFootSupported : mSupportEstimate->mRightFootSupported);
                const bool stiff = mScopedEpisode && scopedPiece('a') && footfallPinnedAt(side) && supported;
                if (stiff == mScopedAnkle[side])
                    continue;
                mScopedAnkle[side] = stiff;
                const auto& motor = mRuntimeProfile->mBodies[leg->mFoot].mConstraint->mMotor;
                mRagdoll->setMotorSpring(leg->mFoot, motor.mFrequency * (stiff ? 2.0f : 1.0f), motor.mDamping);
            }
        }
