            {
                const auto& arm = side == 0 ? mLeftArm : mRightArm;
                if (!arm || arm->mHand >= telemetry.mBodies.size()
                    || std::find(mManualDisabledMotors.begin(), mManualDisabledMotors.end(), arm->mHand)
                        != mManualDisabledMotors.end())
                    continue;
