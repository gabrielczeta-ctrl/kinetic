                [] { return weaponDriveSetting("OPENMW_RAGDOLL_CREATURE_BIPEDS", 1.0f) > 0.0f; });
            return bipeds_tuned.get() && ptr.getType() == ESM::REC_CREA && ptr.getClass().isBipedal(ptr)
                && ptr.getClass().hasInventoryStore(ptr);
        }
