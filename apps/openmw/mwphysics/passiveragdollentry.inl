                    mSoftRootToppledStandTime = 0.0f;
                    mSoftRootReholdElapsed = 0.0f;
                    mSoftRootReheld = true;
                    Log(Debug::Info) << "RAGDOLL_TOPPLE_REHOLD actor=" << getPtr().getCellRef().getRefId()
                                     << " up=" << mControllerInput->mTorsoUpDot;
                }
            }
            const bool owns = routeMatches && mPowered && !interrupted && drivenMode && !mSoftRootToppled
                && (recoveryOwns
                    || (!mKinematicRootLandingReleased
                        && (!mKinematicRootPhysicsOwned || reacquired)));
            if (!owns)
            {
                if (mRagdoll && mRagdoll->isRootKinematic())
                {
                    JPH::Vec3 releaseVelocity = mRawTargetHorizontalVelocity;
                    releaseVelocity.SetZ(mKinematicRootActualVerticalVelocity);
                    mRagdoll->releaseRootKinematic(releaseVelocity);
                }
                // Physics owns the body now: hand the vanilla animation speed
                // back and restart the stride adaptation on the next takeover.
                if (auto* animation = MWBase::Environment::get().getWorld()->getAnimation(getPtr()))
                    animation->setLocomotionSpeedScale(1.0f);
                mKinematicRootStrideFactor = 1.0f;
                mKinematicRootStrideApplied = 1.0f;
                mKinematicRootPhysicsOwned = true;
                mKinematicRootLocalOffset.reset();
                mKinematicRootLocalRotation.reset();
                mKinematicRootAcquireOffset.reset();
                mKinematicRootAcquireRotation.reset();
                mKinematicRootAcquireBlend = 1.0f;
                mKinematicRootFollowedRotation.reset();
                mKinematicRootSupportDrop = 0.0f;
                mKinematicRootLocalRise.reset();
                mKinematicRootSoleCorrectionSeeded = false;
                mKinematicRootReactionOffset = JPH::Vec3::sZero();
                mKinematicRootReactionVelocity = JPH::Vec3::sZero();
                mSoftRootFollower.reset();
                mSoftRootCapsulePrevious.reset();
                // A body that physics owns stands, stumbles and gets up on
                // its feet: give both back their authored grip.
                if (mKinematicSwingFrictionApplied && mRagdoll && mLeftFootBodyIndex && mRightFootBodyIndex)
                {
                    mRagdoll->setBodyFrictionScale(*mLeftFootBodyIndex, 1.0f);
                    mRagdoll->setBodyFrictionScale(*mRightFootBodyIndex, 1.0f);
                    mKinematicSwingFrictionApplied = false;
                }
                mKinematicTargetLeftSample = TargetFootSample{};
                mKinematicTargetRightSample = TargetFootSample{};
                mStrideStanceFloor = {};
                mClipFootFloor.reset();
                mClipFootLowest.reset();
                mLiftUnrouteNoneTimer = 0.0f;
                return;
            }
            mKinematicRootPhysicsOwned = false;
            mKinematicRootReacquireTimer = 0.0f;
            if (!mRagdoll || mRagdoll->getBodyCount() == 0
                || mCurrentPhysicsPose.mBodyTransforms.empty())
                return;
            // The root mirrors the live animation pelvis every tick. Using the
            // creation pose instead left the motors pulling the legs toward an
            // animation whose feet sat lower than the physical ones could
            // reach, so the feet floated and never loaded.
            const bool acquiringRoot = !mRagdoll->isRootKinematic();
            if (acquiringRoot && mPelvisBodyIndex && mMotorTargetCaptured
                && mCurrentPhysicsPose.mBodyTransforms.size() > *mPelvisBodyIndex)
            {
                const auto physicalPosition
                    = mRagdoll->getWorldBodyPosition(mCurrentPhysicsPose, *mPelvisBodyIndex);
                const auto physicalRotation
                    = mRagdoll->getWorldBodyRotation(mCurrentPhysicsPose, *mPelvisBodyIndex);
                if (physicalPosition && physicalRotation)
                {
                    mKinematicRootAcquireOffset = actorRotation.Conjugated()
                        * JPH::Vec3(*physicalPosition - actorPosition);
                    mKinematicRootAcquireRotation
                        = (actorRotation.Conjugated() * *physicalRotation).Normalized();
                    mKinematicRootAcquireBlend = 0.0f;
                }
            }
            if (!mMotorTargetPose.mBodyTransforms.empty()
                && mMotorTargetPose.mBodyTransforms[0].mRotation.IsNormalized())
            {
                const JPH::Vec3& animationOffset = mMotorTargetPose.mBodyTransforms[0].mTranslation;
                const JPH::Quat& animationRotation = mMotorTargetPose.mBodyTransforms[0].mRotation;
                if (mKinematicRootAcquireOffset && mKinematicRootAcquireRotation
                    && mKinematicRootAcquireBlend < 1.0f)
                {
                    mKinematicRootAcquireBlend
                        = std::min(1.0f, mKinematicRootAcquireBlend + duration / 0.75f);
                    // Start and finish the lift at zero blend velocity. A
                    // quarter-second linear lift jerked the loaded chain away
                    // from its contacts even with extra position iterations.
                    const float t = mKinematicRootAcquireBlend;
                    const float blend = t * t * (3.0f - 2.0f * t);
                    mKinematicRootLocalOffset = *mKinematicRootAcquireOffset * (1.0f - blend)
                        + animationOffset * blend;
                    mKinematicRootLocalRotation
                        = mKinematicRootAcquireRotation->SLERP(animationRotation, blend).Normalized();
                    if (blend >= 1.0f)
                    {
                        mKinematicRootAcquireOffset.reset();
                        mKinematicRootAcquireRotation.reset();
                    }
                }
                else
                {
                    mKinematicRootLocalOffset = animationOffset;
                    mKinematicRootLocalRotation = animationRotation;
                }
            }
            else if (!mKinematicRootLocalOffset || !mKinematicRootLocalRotation)
            {
                if (mCurrentPhysicsPose.mBodyTransforms.empty())
                    return;
                mKinematicRootLocalOffset
                    = mCurrentPhysicsPose.mBodyTransforms[0].mTranslation;
                mKinematicRootLocalRotation
                    = mCurrentPhysicsPose.mBodyTransforms[0].mRotation;
            }
            if (!mRagdoll->isRootKinematic() && !mRagdoll->setRootKinematic(true))
                return;
            if (mLeftFootBodyIndex && mRightFootBodyIndex && duration > 0.0f)
            {
                const auto targetLeft = mRagdoll->getWorldBodyPosition(mMotorTargetPose, *mLeftFootBodyIndex);
                const auto targetRight = mRagdoll->getWorldBodyPosition(mMotorTargetPose, *mRightFootBodyIndex);
                if (targetLeft && targetRight)
                {
                    if (mKinematicTargetFeetSeeded)
                    {
                        // The animation capture can jump a frame's worth of
                        // travel back and forth on consecutive drive steps, so
                        // blend the per-step delta; the loop below steers on
                        // the trend, not the sampling noise.
                        JPH::Vec3 leftDelta(*targetLeft - mKinematicTargetLeftFoot);
                        JPH::Vec3 rightDelta(*targetRight - mKinematicTargetRightFoot);
                        leftDelta.SetZ(0.0f);
                        rightDelta.SetZ(0.0f);
                        mKinematicTargetLeftVel = 0.5f * mKinematicTargetLeftVel + 0.5f * leftDelta / duration;
                        mKinematicTargetRightVel = 0.5f * mKinematicTargetRightVel + 0.5f * rightDelta / duration;
                    }
                    mKinematicTargetLeftFoot = *targetLeft;
                    mKinematicTargetRightFoot = *targetRight;
                    mKinematicTargetFeetSeeded = true;
                }
                // Swing-foot scuff. The motors trail a swinging target, so
                // the physical foot can reach the floor while the clip still
                // carries it forward; with full friction the saturated hip and
                // knee then press it down and it stops dead under the body
                // until the target has run a whole step ahead (the right foot
                // stalled about 12 ticks at the origin, 2026-09-18). The held
                // root does not push off its feet, so a foot whose target is
                // travelling over the ground gives up its grip and slides on;
                // a foot whose target is planted keeps the authored friction.
                //
                // The ground speed of a target foot is the actor's velocity
                // plus the foot's velocity inside the clip. The clip pose only
                // changes when a render frame advances, so its share is
                // sampled and held; differencing world positions every fixed
                // step instead reads a planted foot as alternately racing
                // forward and snapping back.
                const auto swingFriction = [&](TargetFootSample& sample, std::size_t foot) {
                    constexpr float plantedSpeed = 60.0f;
                    constexpr float swingingSpeed = 140.0f;
                    constexpr float swingingScale = 0.05f;
                    if (foot >= mMotorTargetPose.mBodyTransforms.size())
                        return 1.0f;
                    const JPH::Vec3 position = mMotorTargetPose.mBodyTransforms[foot].mTranslation;
                    if (!sample.mSeeded)
                    {
                        sample = TargetFootSample{ position, JPH::Vec3::sZero(), 0.0f, true };
                        return 1.0f;
                    }
                    sample.mAge += duration;
                    if ((position - sample.mPosition).LengthSq() > 1e-8f)
                    {
                        sample.mVelocity = (position - sample.mPosition) / sample.mAge;
                        sample.mPosition = position;
                        sample.mAge = 0.0f;
                    }
                    else if (sample.mAge > 0.1f)
                        sample.mVelocity = JPH::Vec3::sZero();
                    JPH::Vec3 ground = mKinematicRootActualVelocity + actorRotation * sample.mVelocity;
                    ground.SetZ(0.0f);
                    sample.mGroundSpeed = ground.Length();
                    const float swing = std::clamp(
                        (sample.mGroundSpeed - plantedSpeed) / (swingingSpeed - plantedSpeed), 0.0f, 1.0f);
                    return 1.0f + (swingingScale - 1.0f) * swing;
                };
                static const auto swingFrictionEnabled_tuned = RagdollCore::tuned<bool>([] {
                    const char* text = RagdollCore::tuningText("OPENMW_RAGDOLL_SWING_FOOT_FRICTION");
                    return !(text && std::atoi(text) == 0);
                });
                static const auto& swingFrictionEnabled = swingFrictionEnabled_tuned.get();
                if (swingFrictionEnabled)
                {
                    // A foot Footfall has pinned keeps its full grip: the clip's
                    // own stance foot skates and read as a swinging foot.
                    const float leftFriction = swingFriction(mKinematicTargetLeftSample, *mLeftFootBodyIndex);
                    const float rightFriction = swingFriction(mKinematicTargetRightSample, *mRightFootBodyIndex);
                    // Pinned grip (experiment): the planted foot meets the world
                    // at 0.40 combined (Jolt's static 0.2 x the foot's 0.8,
                    // geometric mean); the offline balance sim needed ~0.57 to
                    // keep stance feet from slipping in catch steps (PGC,
                    // 2026-09-29). OPENMW_RAGDOLL_PINNED_FOOT_FRICTION = scale
                    // on a pinned foot's friction (default 1; 2 gives 0.57).
                    // 2 by default since alpha 0.4 item 10 (skating feet): push
                    // table (2 runs x 12 per row) standing 2000-4000 slide 89-96
                    // -> 80-86 units, walking 268-294 -> 240-257, falls, drift and
                    // recovery unchanged.
                    static const auto pinnedGrip_tuned = RagdollCore::tuned<float>([] { return weaponDriveSetting("OPENMW_RAGDOLL_PINNED_FOOT_FRICTION", 2.0f); });
                    static const auto& pinnedGrip = pinnedGrip_tuned.get();
                    // Stagger grip (10-05): after a hit, a swinging foot already
                    // on the ground grips like a planted one. At 0.05 it glided
                    // (0.09 combined) when a staggering body put it down before
                    // Footfall counted the landing. OPENMW_RAGDOLL_STAGGER_GRIP=1.
                    static const auto staggerGrip_tuned = RagdollCore::tuned<bool>([] { return weaponDriveSetting("OPENMW_RAGDOLL_STAGGER_GRIP", 0.0f) > 0.0f; });
                    static const auto& staggerGrip = staggerGrip_tuned.get();
                    const bool staggering = staggerGrip
                        && (mScopedEpisode || mHitStun.active() || mSoftRootStrength < 0.98f);
                    const auto swingGrip = [&](std::size_t side) {
                        const bool down = mSupportEstimate
                            && (side == 0 ? mSupportEstimate->mLeftFootSupported : mSupportEstimate->mRightFootSupported);
                        return staggering && down ? pinnedGrip : 0.05f;
                    };
                    // The slope stance grips harder (planted feet).
                    const float slopeGrip = std::min(4.0f,
                        pinnedGrip * (1.0f + (slopeStanceSettings().mGrip - 1.0f) * mSlopeStance));
                    // STEP-01 S2: a foot down while staggering grips fully even
                    // when the clip's foot travels (the stumble walk read it as
                    // swinging and gave it 0.05).
                    const bool stepHold = step01Settings().mFeetHold && mSupportEstimate && step01Staggering();
                    const auto clipGrip = [&](std::size_t side, float friction) {
                        const bool down = side == 0 ? mSupportEstimate->mLeftFootSupported : mSupportEstimate->mRightFootSupported;
                        return stepHold && down ? std::max(friction, pinnedGrip) : friction;
                    };
                    mRagdoll->setBodyFrictionScale(*mLeftFootBodyIndex,
                        footfallPinnedAt(0) ? slopeGrip : footfallSwingingAt(0) ? swingGrip(0) : clipGrip(0, leftFriction));
                    mRagdoll->setBodyFrictionScale(*mRightFootBodyIndex,
                        footfallPinnedAt(1) ? slopeGrip : footfallSwingingAt(1) ? swingGrip(1) : clipGrip(1, rightFriction));
                    mKinematicSwingFrictionApplied = true;
                    updateStepHold();
                }
            }
            // Stride matching: Morrowind's walk clip is authored for strides
            // far shorter than the actor's movement speed, so left at the
            // game's own scaling the animation's planted foot itself skates
            // forward. The played speed must remove that slide: measure the
            // animation stance foot's world velocity (the foot the animation
            // keeps planted) and steer the playback factor until it is still.
            // Physical contacts are deliberately not the sensor here - a
            // swing foot that scuffs reads the same contact as a planted one.
            const float travelSpeed = mKinematicRootActualVelocity.Length();
            // Running is matched too: measured 2026-09-24, at 231 u/s the run
            // clip's stance foot moved back at only 171 u/s relative to the
            // pelvis, so the clip itself skated 60-76 u/s and the physical
            // planted foot slid at ~185 u/s ("floaty especially when running").
            // OPENMW_RAGDOLL_RUN_STRIDE_MATCH=0 restores retiring it.
            static const auto runStrideMatch_tuned = RagdollCore::tuned<bool>([] {
                const char* text = RagdollCore::tuningText("OPENMW_RAGDOLL_RUN_STRIDE_MATCH");
                return !(text && std::atoi(text) == 0);
            });
            static const auto& runStrideMatch = runStrideMatch_tuned.get();
            // A planted clip foot is slow relative to travel; the fixed 80 u/s
            // test sat right at a running stance foot's speed.
            const float plantedSpeed = std::max(80.0f, 0.6f * travelSpeed);
            if (!runStrideMatch && travelSpeed > 180.0f)
            {
                // Running: the game's own run scaling already matches its
                // clip, so retire the walk correction instead of hunting on
                // the run's short, fast stance phases.
                mKinematicRootStrideFactor += (1.0f - mKinematicRootStrideFactor)
                    * std::min(1.0f, 6.0f * duration);
            }
            else if (mSupportEstimate
                && (mSupportEstimate->mLeftFootSupported || mSupportEstimate->mRightFootSupported)
                && mKinematicRootActualVelocity.LengthSq() > 1.0f)
            {
                // Slide is the planted target foot's velocity along the
                // direction of travel, whatever world heading that is; the
                // earlier world-Y projection measured nothing on an east-west
                // walk and half on a diagonal.
                const JPH::Vec3 travel = mKinematicRootActualVelocity.Normalized();
                // A sample is a foot the clip itself has on the floor. Gating
                // on the physical contact let weighted feet, which stay down
                // after the clip has lifted them, feed the lift-off roll into
                // the sensor: running, 100% of clip feet 8-10 units up still
                // touched (weightless armed legs 23%) and read +85 u/s, so the
                // factor overshot to 1.45 (3.0-3.2 steps/s, vanilla 2.1-2.2)
                // and the clip's stance foot then ran backward 38-54 u/s.
                // Referenced to the lowest 20% of each foot's clip lift, the
                // stance foot read -39..-54 u/s at 1.45 (r2) and +12..+24 at
                // the weightless factor 1.07 (wb warhammer): the match is
                // expected near 1.2-1.3 (2.7-2.9 steps/s unarmed), 2026-09-25
                // run straight/turn. A fixed height above the actor is not
                // used: at 7/8/9 units it read -37/-25/-9 u/s, and race height
                // moves the stance level by ~0.6 units. So each foot is
                // measured against its own running minimum clip lift, which
                // follows the foot down at once and up with the time constant
                // below (about one run cycle).
                // OPENMW_RAGDOLL_STRIDE_STANCE_LIFT="units,seconds" (default
                // 2,0.7; units 0 = the physical contact gate).
                static const auto stanceLift_tuned = RagdollCore::tuned<std::pair<float, float>>([] {
                    std::pair<float, float> value(2.0f, 0.7f);
                    if (const char* text = RagdollCore::tuningText("OPENMW_RAGDOLL_STRIDE_STANCE_LIFT"))
                        std::sscanf(text, "%f,%f", &value.first, &value.second);
                    return value;
                });
                static const auto& stanceLift = stanceLift_tuned.get();
                const float actorZ = static_cast<float>(actorPosition.GetZ());
                const auto clipStance = [&](bool supported, const JPH::RVec3& target, std::optional<float>& floor) {
                    if (!(stanceLift.first > 0.0f))
                        return supported;
                    if (!mKinematicTargetFeetSeeded)
                    {
                        floor.reset();
                        return false;
                    }
                    const float lift = static_cast<float>(target.GetZ()) - actorZ;
                    const float rise = stanceLift.second > 0.0f ? std::min(1.0f, duration / stanceLift.second) : 1.0f;
                    floor = floor ? std::min(lift, *floor + (lift - *floor) * rise) : lift;
                    return lift - *floor < stanceLift.first;
                };
                // Both feet are measured every step, so neither floor goes stale.
                const bool leftStance
                    = clipStance(mSupportEstimate->mLeftFootSupported, mKinematicTargetLeftFoot, mStrideStanceFloor[0]);
                const bool rightStance
                    = clipStance(mSupportEstimate->mRightFootSupported, mKinematicTargetRightFoot, mStrideStanceFloor[1]);
                float slide = 0.0f;
                unsigned samples = 0;
                if (leftStance && mKinematicTargetLeftVel.Length() < plantedSpeed)
                {
                    slide += mKinematicTargetLeftVel.Dot(travel);
                    ++samples;
                }
                if (rightStance && mKinematicTargetRightVel.Length() < plantedSpeed)
                {
                    slide += mKinematicTargetRightVel.Dot(travel);
                    ++samples;
                }
                if (samples > 0)
                {
                    slide /= static_cast<float>(samples);
                    constexpr float strideGain = 0.02f;
                    mKinematicRootStrideFactor = std::clamp(
                        mKinematicRootStrideFactor + strideGain * slide * duration, 0.6f, 2.0f);
                }
                // A soft cap while running, against the next sensor bias: the
                // contact-gated sensor ran the factor to 1.45 where the clip's
                // stance foot is still near 1.2-1.3.
                // OPENMW_RAGDOLL_RUN_STRIDE_CAP (default 1.35; 9 = off).
                static const auto runStrideCap_tuned = RagdollCore::tuned<float>([] { return weaponDriveSetting("OPENMW_RAGDOLL_RUN_STRIDE_CAP", 1.35f); });
                static const auto& runStrideCap = runStrideCap_tuned.get();
                if (travelSpeed > 180.0f && mKinematicRootStrideFactor > runStrideCap)
                    mKinematicRootStrideFactor = std::max(runStrideCap, 0.6f);
            }
            // Publish the factor to gameplay's own animation speed scaling.
            // adjustSpeedMult would be overwritten by the character
            // controller every frame, so the scale lives on the Animation.
            if (auto* animation = MWBase::Environment::get().getWorld()->getAnimation(getPtr()))
            {
                const float applied = std::clamp(mKinematicRootStrideFactor, 0.3f, 3.0f);
                animation->setLocomotionSpeedScale(applied);
                mKinematicRootStrideApplied = applied;
            }
            const bool supported = mSupportEstimate
                && (mSupportEstimate->mLeftFootSupported || mSupportEstimate->mRightFootSupported);
            // Only a small settle nudge while stationary. Dropping while
            // walking sinks the whole gait under the floor and the controller
            // reads the descent as a fall.
            constexpr float supportDropRate = 40.0f;
            constexpr float supportDropMaximum = 10.0f;
            // On the ground only: in the air nothing supports the feet either,
            // and a standing jump left the body 10 units low for good
            // (2026-09-24, jump in place).
            if (!supported && mRawTargetHorizontalVelocity.Length() < 1.0f
                && mKinematicRootSupportDrop < supportDropMaximum
                && MWBase::Environment::get().getWorld()->isOnGround(getPtr()))
                mKinematicRootSupportDrop
                    = std::min(supportDropMaximum, mKinematicRootSupportDrop + supportDropRate * duration);
            // ...and it comes back once a foot is down. It never did: every
            // stationary moment without foot contact (a stop, a blow) lowered
            // the root for good, until a fall reset it, and a long session
            // walked and ran up to 10 units under the animation (user play
            // test 2026-09-27: the chest 6-12 units low, still low standing).
            // OPENMW_RAGDOLL_SUPPORT_DROP_RECOVER = units/s (0 = never).
            static const auto supportDropRecover_tuned = RagdollCore::tuned<float>([] { return weaponDriveSetting("OPENMW_RAGDOLL_SUPPORT_DROP_RECOVER", 20.0f); });
            static const auto& supportDropRecover = supportDropRecover_tuned.get();
            if (supported && supportDropRecover > 0.0f && mKinematicRootSupportDrop > 0.0f)
                mKinematicRootSupportDrop = std::max(0.0f, mKinematicRootSupportDrop - supportDropRecover * duration);
            // Reaction recoil: a landed blow pushes the root a bounded few
            // units off the clip, then a spring-damper snaps it back. This is
            // the visible flinch behind a stagger that never leaves the feet.
            {
                mKinematicRootReactionVelocity
                    -= (mKinematicRootReactionOffset * sKinematicRootReactionStiffness
                           + mKinematicRootReactionVelocity * sKinematicRootReactionDamping)
                    * duration;
                mKinematicRootReactionOffset += mKinematicRootReactionVelocity * duration;
                const float reactionLength = mKinematicRootReactionOffset.Length();
                if (reactionLength > 12.0f)
                    mKinematicRootReactionOffset *= 12.0f / reactionLength;
            }
            mKinematicRootFollowedRotation = actorRotation;
            // The landing clip drops the pelvis ~30 units and snaps it back up
            // within 0.15 s; the soft body followed the snap and was thrown
            // 24 units above standing height ("after landing the jump the
            // character does a small hop", 2026-09-24 R2). The clip pelvis may
            // rise at most this fast (walking bob is well under it).
            // OPENMW_RAGDOLL_ROOT_RISE_RATE units/s (0 = off).
            static const auto riseRate_tuned = RagdollCore::tuned<float>([] {
                const char* text = RagdollCore::tuningText("OPENMW_RAGDOLL_ROOT_RISE_RATE");
                return text ? static_cast<float>(std::atof(text)) : 90.0f;
            });
            static const auto& riseRate = riseRate_tuned.get();
            JPH::Vec3 localOffset = actorRotation * *mKinematicRootLocalOffset;
            if (riseRate > 0.0f && duration > 0.0f)
            {
                if (mKinematicRootLocalRise && localOffset.GetZ() > *mKinematicRootLocalRise + riseRate * duration)
                    localOffset.SetZ(*mKinematicRootLocalRise + riseRate * duration);
                mKinematicRootLocalRise = localOffset.GetZ();
            }
            // The run's bob (user 10-30 play: "when running sometimes the two
            // feet are suspended and the character slides", "about 50% more
            // grounded"; no foot pinned 33% of running, 29% on the run course):
            // the root target rode the run clip's pelvis bob, and the soft
            // root's spring threw the body up on every rise. While running the
            // bob keeps `keep` of its swing about its own mean and the pelvis
            // sits `sink` units lower, faded in from 60% to 100% of `speed`.
            // OPENMW_RAGDOLL_RUN_BOB = "keep, sink, speed u/s" (1,0 = off).
            {
                const auto& bob = runBobSettings();
                const float z = localOffset.GetZ();
                if (!mRunBobMean)
                    mRunBobMean = z;
                *mRunBobMean += (z - *mRunBobMean) * std::min(1.0f, duration / 0.35f);
                const JPH::Vec3 request(mRawTargetHorizontalVelocity.GetX(), mRawTargetHorizontalVelocity.GetY(), 0.0f);
                const float run = bob[2] > 0.0f && footfallEnabled()
                    ? std::clamp((request.Length() - 0.6f * bob[2]) / (0.4f * bob[2]), 0.0f, 1.0f)
                    : 0.0f;
                mRunBobShare += (run - mRunBobShare) * std::min(1.0f, duration * 6.0f);
                // The sink fades out while the run turns (10-30 release check:
                // with the pelvis 5 units down a warhammer's fast-turn run ended
                // leaning 15-23 deg, 2-4 without the sink): full on a straight
                // run, gone at 1.5 rad/s of the request's heading.
                if (request.Length() > 1.0f && duration > 0.0f)
                {
                    const float heading = std::atan2(request.GetX(), request.GetY());
                    if (mRunBobHeading)
                    {
                        float turn = heading - *mRunBobHeading;
                        turn = std::atan2(std::sin(turn), std::cos(turn));
                        const float rate = std::abs(turn) / duration;
                        if (std::isfinite(rate))
                            mRunBobTurnRate += (rate - mRunBobTurnRate) * std::min(1.0f, duration * 4.0f);
                    }
                    mRunBobHeading = heading;
                }
                const float straight = std::clamp(1.0f - mRunBobTurnRate / 1.5f, 0.0f, 1.0f);
                if (mRunBobShare > 1e-3f && std::isfinite(*mRunBobMean))
                    localOffset.SetZ(*mRunBobMean + (z - *mRunBobMean) * (1.0f - (1.0f - bob[0]) * mRunBobShare)
                        - bob[1] * mRunBobShare * straight);
            }
            // The landing and slope crouch reach the root once: through the
            // Footfall library's pelvis drop when it drives (mExtraCrouch),
            // else here (both, before: twice the crouch).
            const float ownCrouch = footfallLibraryDrives()
                ? 0.0f : mLandingCrouch + mSlopeStance * slopeStanceSettings().mCrouch;
            const JPH::RVec3 targetPosition = actorPosition
                + JPH::RVec3(localOffset)
                - JPH::RVec3(0.0f, 0.0f, mKinematicRootSupportDrop + footfallRootDrop() + mDazeDrop + ownCrouch)
                - JPH::RVec3(mTeeterToward * (mTeeter * edgeTeeterSettings().mHips))
                - JPH::RVec3(0.0f, 0.0f, std::max(0.0f, mTeeter - 0.4f) * 20.0f)
                + JPH::RVec3(mKinematicRootReactionOffset);
            // Root height: the live animation pelvis can leave the physical
            // feet floating, and correcting per tick pins whichever sole is
            // lowest, which stops that foot from ever lifting. Instead the
            // root drops to support once while the body is stationary and the
            // calibrated height is kept through the gait, so the legs follow
            // the animation's own foot lift.
            // Jump anticipation: crouch into the buffered jump, then rise.
            if (mJumpAnticipation > 0.0f)
            {
                mJumpAnticipation -= duration;
                mJumpCrouch = std::min(mJumpCrouch + 90.0f * duration, 14.0f);
                if (mJumpAnticipation <= 0.0f)
                    mJumpReleasePending = true;
            }
            else if (!mJumpReleasePending && mJumpCrouch > 0.0f)
                mJumpCrouch = std::max(0.0f, mJumpCrouch - 70.0f * duration);
            JPH::RVec3 groundedTarget = targetPosition;
            groundedTarget.SetZ(groundedTarget.GetZ() - mJumpCrouch);
#ifdef OPENMW_RAGDOLL_DEV_API
            {
                static const auto traceRoot_tuned = RagdollCore::tuned<bool>([] { return RagdollCore::tuningText("OPENMW_RAGDOLL_ROOT_TRACE") != nullptr; });
                static const auto& traceRoot = traceRoot_tuned.get();
                static unsigned rootRows = 0;
                if (traceRoot && getPtr() == MWMechanics::getPlayer() && rootRows < 4000)
                {
                    ++rootRows;
                    Log(Debug::Info) << std::fixed << std::setprecision(1) << "RAGDOLL_ROOT actor_z=" << actorPosition.GetZ()
                                     << " local_z=" << localOffset.GetZ()
                                     << " drop=" << mKinematicRootSupportDrop << " crouch=" << mJumpCrouch
                                     << " reaction_z=" << mKinematicRootReactionOffset.GetZ()
                                     << " target_z=" << groundedTarget.GetZ()
                                     << " ground=" << MWBase::Environment::get().getWorld()->isOnGround(getPtr());
