            }
            static const auto staggerSettleFor_tuned = RagdollCore::tuned<float>([] { return weaponDriveSetting("OPENMW_RAGDOLL_STAGGER_SETTLE", 0.0f); });
            static const auto& staggerSettleFor = staggerSettleFor_tuned.get();
            if (staggerSettleFor > 0.0f && bodyDv >= 25.0f)
            {
                mStaggerSettle = staggerSettleFor;
                mStaggerSettleTime = mStaggerSettling = 0.0f;
            }
            beginStumble(bodyDv);
            mHitStun.begin(impulseMagnitude / std::max(0.1f, hitToughness()), mExperimentalReferenceProfile);
        }
        // Old name kept for the clash branch's callers (dead under GUARD_BLOWS;
        // the clash redesign routes them): a blow like any other.
        void registerHitReaction(float impulseMagnitude, bool regionCanKnockDown)
        {
            registerBlowV2(impulseMagnitude, regionCanKnockDown);
        }

        // Head blows daze (user bookmark 11, 2026-10-02: "head hits should ...
        // cause more stagger/stun, maybe even lower the softroot anchor"): the
        // knees give (the root target sinks), balance stays weak and the feet
        // slow while it lasts; a harder blow dazes longer.
        // OPENMW_RAGDOLL_HEAD_DAZE = "seconds per 2500 impulse, max seconds,
        // sink units, balance cap" (first 0 = off).
        struct DazeSettings
        {
            float mPerImpulse = 1.2f, mMaximum = 1.8f, mSink = 12.0f, mBalance = 1.0f;
        };
        static const DazeSettings& dazeSettings()
        {
            static const auto value_tuned = RagdollCore::tuned<DazeSettings>([] {
                DazeSettings result;
                if (const char* text = RagdollCore::tuningText("OPENMW_RAGDOLL_HEAD_DAZE"))
                    std::sscanf(text, "%f,%f,%f,%f", &result.mPerImpulse, &result.mMaximum, &result.mSink,
                        &result.mBalance);
                return result;
            });
            static const auto& value = value_tuned.get();
            return value;
        }
        float mDazeTime = 0.0f;
        float mDazeDrop = 0.0f;
        std::uint64_t mDazeCount = 0;
        void beginDaze(RagdollCore::AnatomicalRegion region, float reactionImpulse)
        {
            if (region != RagdollCore::AnatomicalRegion::Head && region != RagdollCore::AnatomicalRegion::Neck)
                return;
            const auto& daze = dazeSettings();
            if (daze.mPerImpulse <= 0.0f || !std::isfinite(reactionImpulse) || reactionImpulse <= 0.0f)
                return;
            const float seconds = std::min(daze.mMaximum,
                daze.mPerImpulse * reactionImpulse / (2500.0f * std::max(0.1f, hitToughness())));
            if (seconds < 0.25f)
                return;
            mDazeTime = std::max(mDazeTime, seconds);
            ++mDazeCount;
            static const auto trace_tuned = RagdollCore::tuned<bool>([] { return RagdollCore::tuningText("OPENMW_RAGDOLL_DAMAGE_TRACE") != nullptr; });
            static const auto& trace = trace_tuned.get();
            if (trace)
                Log(Debug::Info) << "RAGDOLL_DAZE actor=" << getPtr().getCellRef().getRefId()
                                 << " impulse=" << reactionImpulse << " seconds=" << seconds;
        }
        void stepDaze(float duration)
        {
            const auto& daze = dazeSettings();
            if (mDazeTime > 0.0f)
            {
                mDazeTime = std::max(0.0f, mDazeTime - duration);
                mSoftRootStrength = std::min(mSoftRootStrength, daze.mBalance);
            }
            // Sink in fast, rise back over the last 0.4 s.
            const float wanted = daze.mSink * std::clamp(mDazeTime / 0.4f, 0.0f, 1.0f);
            mDazeDrop += (wanted - mDazeDrop) * std::clamp(duration * 10.0f, 0.0f, 1.0f);
        }

        void decayHitReaction(float duration)
        {
            for (auto& reaction : mWoundReactions)
                reaction.step(duration);
            mImpactCounterbalanceStrength = std::max(0.0f,
                mImpactCounterbalanceStrength * std::max(0.0f, 1.0f - 2.0f * duration));
        }

        // Development aid for localized limb damage. There is no injury
        // model yet (DMG-02 onward), so this is only a ledger of the damage
        // each anatomical region has taken on this body, drawn as a red tint
        // on the matching body parts: a hit shows at once and the part
        // saturates at sRegionDamageFullTint points. It resets with the
        // ragdoll and through the development interface.
        static constexpr std::size_t sRegionCount
            = static_cast<std::size_t>(RagdollCore::AnatomicalRegion::RightFoot) + 1;
        static constexpr float sRegionDamageFullTint = 40.0f;
        std::array<float, sRegionCount> mRegionDamage{};
        struct PendingWound
        {
            RagdollCore::WeaponContactEvent mContact;
            bool mClaimed = false;
            // The blow's local reaction impulse (0 until the strike is paid).
            float mLocalReaction = 0.0f;
        };
        std::map<std::uint64_t, PendingWound> mPendingWounds;
        std::array<RagdollCore::LocalWoundReaction, sRegionCount> mWoundReactions;
        std::array<JPH::Vec3, sRegionCount> mWoundAxes;
        std::array<std::size_t, sRegionCount> mWoundBodies{};
        std::uint64_t mWoundReceiptCount = 0;
        std::uint64_t mWoundMarkCount = 0;
        std::string mLastWoundKind = "none";
        std::string mLastWoundRegion = "unknown";
        float mLastWoundHealth = 0;
        float mLastWoundFatigue = 0;
        float mLocalReactionAngle = 0;

        struct ReactionMotorLimit
        {
            std::size_t mBody;
            JPH::Vec3 mMinimum, mMaximum;
        };
        std::vector<ReactionMotorLimit> mReactionMotorLimits;

        // Hit give (alpha 0.8, user: "hits landed should push the enemy
        // ragdoll in that spot more"): the struck part and the two joints
        // above it go soft for a moment so the blow's push shows (a standing
        // dummy's chest moved 1-4 units per landed blow, even a warhammer's),
        // then their strength comes back. Legs and pelvis stay strong (no
        // falls from it). OPENMW_RAGDOLL_HIT_GIVE = "softening,seconds"
        // at full force (0 = off).
        struct HitGive
        {
            std::size_t mBody;
            float mRemaining, mTotal, mSoft;
        };
        std::vector<HitGive> mHitGives;
        // Hit reactions (stage 7, video "still too spongy"; user 10-06: "the
        // main focus ... reacting to a hit"). [0] head snap (rad/s of spin at a
        // full push), [1] the push's lever cap on the chest and shoulders
        // (units; 10 before, so an off-centre blow barely turned the trunk),
        // [2] the interrupt: a blow of this many u/s of the body's mass
        // breaks its own wind-up or cut, [3] poise: seconds after an
        // interrupt in which no other blow interrupts (no stun-lock), [4] an
        // NPC hit in the head this hard (u/s) covers up - its guard up for
        // 0.6 s - if it is not attacking.
        // OPENMW_RAGDOLL_HIT_REACT = "head snap, lever, interrupt, poise,
        // cover" (0 = off for each).
        static const std::array<float, 5>& hitReactSettings()
        {
            static const auto value_tuned = RagdollCore::tuned<std::array<float, 5>>([] {
                std::array<float, 5> v{ 0.0f, 10.0f, 0.0f, 1.2f, 0.0f };
                if (const char* text = RagdollCore::tuningText("OPENMW_RAGDOLL_HIT_REACT"))
                    std::sscanf(text, "%f,%f,%f,%f,%f", &v[0], &v[1], &v[2], &v[3], &v[4]);
                return v;
            });
            static const auto& value = value_tuned.get();
            return value;
        }
        float mSinceInterrupt = 1e9f; // seconds since a blow broke this body's attack (poise)
        std::uint64_t mInterruptCount = 0; // diagnostics
        float mCoverTime = 0.0f; // an NPC covering up after a head blow (seconds left)
        static const std::array<float, 2>& hitGiveSetting()
        {
            static const auto value_tuned = RagdollCore::tuned<std::array<float, 2>>([] {
                std::array<float, 2> v{ 0.85f, 0.3f };
                if (const char* text = RagdollCore::tuningText("OPENMW_RAGDOLL_HIT_GIVE"))
                    std::sscanf(text, "%f,%f", &v[0], &v[1]);
                return v;
            });
            static const auto& value = value_tuned.get();
            return value;
        }
        void beginHitGive(std::size_t struck, float force)
        {
            const auto& setting = hitGiveSetting();
            if (!(setting[0] > 0.0f) || !(setting[1] > 0.0f) || !(force > 0.0f) || !mPowered || !mRagdoll)
                return;
            force = std::min(force, 1.0f);
            std::size_t body = struck;
            for (int level = 0; level < 3 && body < mBodyRegions.size(); ++level)
            {
                if (body == 0 || RagdollCore::regionCanKnockDown(mBodyRegions[body]))
                    break;
                const float seconds = setting[1] * (0.5f + 0.5f * force);
                const float soft = setting[0] * force * (level == 0 ? 1.0f : level == 1 ? 0.7f : 0.4f);
                auto found = std::find_if(mHitGives.begin(), mHitGives.end(),
                    [&](const HitGive& g) { return g.mBody == body; });
                if (found == mHitGives.end())
                    mHitGives.push_back({ body, seconds, seconds, soft });
                else if (soft > found->mSoft * found->mRemaining / found->mTotal)
                    *found = { body, seconds, seconds, soft };
                const int parent = body < mReplayCreationSkeleton.mBones.size()
                    ? mReplayCreationSkeleton.mBones[body].mParent : -1;
                if (parent < 0)
                    break;
                body = static_cast<std::size_t>(parent);
            }
        }
        void stepHitGives(float duration)
        {
            for (auto it = mHitGives.begin(); it != mHitGives.end();)
            {
                it->mRemaining -= duration;
                if (it->mRemaining <= 0.0f || !mPowered)
                {
                    it = mHitGives.erase(it);
                    continue;
                }
                // Soft at once, strength back over the give.
                const float scale = 1.0f - it->mSoft * (it->mRemaining / it->mTotal);
                RagdollCore::MotorTargetTelemetry motor;
                mRagdoll->captureMotorTargetTelemetry(it->mBody, motor);
                if (motor.mDrive && mRagdoll->setMotorTorqueLimits(it->mBody,
                        motor.mDrive->mMinimumTorque * scale, motor.mDrive->mMaximumTorque * scale))
                    mReactionMotorLimits.push_back({ it->mBody, motor.mDrive->mMinimumTorque, motor.mDrive->mMaximumTorque });
                ++it;
            }
        }

        void limitReactionMotors()
        {
            // (RXN-01's stabilization scale also lived here; removed 10-07,
            // user build 60 bookmark 14: "lets remove RXN".)
            if (mPowered && mRagdoll)
                stepHitGives(1.0f / 60.0f);
        }

        void restoreReactionMotors()
        {
            // Newest first: a body softened twice gets its original back.
            for (auto it = mReactionMotorLimits.rbegin(); it != mReactionMotorLimits.rend(); ++it)
                mRagdoll->setMotorTorqueLimits(it->mBody, it->mMinimum, it->mMaximum);
            mReactionMotorLimits.clear();
        }


        void addRegionDamage(RagdollCore::AnatomicalRegion region, float damage)
        {
#ifdef OPENMW_RAGDOLL_DEV_API
            static const auto enabled_tuned = RagdollCore::tuned<bool>([] {
                const char* text = RagdollCore::tuningText("OPENMW_RAGDOLL_LIMB_DAMAGE_TINT");
                return !(text && std::atoi(text) == 0);
            });
            static const auto& enabled = enabled_tuned.get();
            const std::size_t index = static_cast<std::size_t>(region);
            if (region == RagdollCore::AnatomicalRegion::Unknown || index >= mRegionDamage.size()
                || !std::isfinite(damage) || damage <= 0.0f)
                return;
            mRegionDamage[index] += damage;
            if (!enabled)
                return; // hiding the debug tint must not disable the damage ledger
            const float tint = 0.3f + 0.7f * std::min(1.0f, mRegionDamage[index] / sRegionDamageFullTint);
            if (auto* animation = MWBase::Environment::get().getWorld()->getAnimation(getPtr()))
                animation->setAnatomicalDamageTint(RagdollCore::regionName(region), tint);
#else
            (void)region;
            (void)damage;
#endif
        }

        void clearRegionDamage()
        {
            mRegionDamage.fill(0.0f);
            // The marks and tints are scene graph: cleared on the main thread at
            // the next update (applyPendingTintClear). Called from a Lua script
            // (ragdoll.clearLimbDamage, the duel hub's reset), this ran on the
            // Lua thread while the main thread culled the scene, and removing
            // the wound marks crashed the renderer (10-06: RigGeometry::cull /
            // osg Group traversal at the hub's unarmed -> longsword reset, about
            // 3 runs in 4; build 57 too).
            mTintClearPending = true;
        }
        bool mTintClearPending = false;
        void applyPendingTintClear()
        {
            if (!mTintClearPending)
                return;
            mTintClearPending = false;
            if (auto* animation = MWBase::Environment::get().getWorld()->getAnimation(getPtr()))
                animation->clearAnatomicalDamageTints();
        }

        // Bounded visible recoil: a hit shoves the kinematic root off its
        // animation path so it reads as a flinch or stumble instead of a
        // fall, and a spring-damper returns it to the clip. The hit sets a
        // velocity, never a position: a position step moved the infinite-mass
        // root several units in one tick (about 540 units/s), which yanked
        // every joint attached to it and read to the controller as a fall.
        JPH::Vec3 mKinematicRootReactionOffset = JPH::Vec3::sZero();
        JPH::Vec3 mKinematicRootReactionVelocity = JPH::Vec3::sZero();
        static constexpr float sKinematicRootReactionStiffness = 90.0f;
        static constexpr float sKinematicRootReactionDamping = 11.0f;
        JPH::Vec3 mImpactCounterbalanceDirection = JPH::Vec3::sZero();
        float mImpactCounterbalanceStrength = 0.0f;

        // STEP-01 (docs/ragdoll/designs/STEP-01-step-not-slide.md, 2026-10-27):
        // hits step instead of slide. OPENMW_RAGDOLL_STEP01 = "one shove, feet
        // hold, push scale, grip, chain, lift u, recover share, reach u,
        // budget" (unset = all off). One shove (S1): a blow
        // moves the body only by the physical push on the struck part (x push
        // scale); the whole-body shove and the capsule kick below are off.
        // Feet hold (S2): while staggering, a foot on the ground that Footfall
        // does not swing grips fully and is held where it landed by static
        // friction from the floor (up to grip x its share of the body weight)
        // until it lifts. Chain (S3): the stagger plan steps toward the
        // capture point after every landing until it is back between the
        // feet or the budget is spent (StaggerSettings::mChain), and its
        // swings lift the foot at least `lift` units. Give up (S4), three more
        // fields "give up, abort ratio, margin u": the budget becomes 2 +
        // Agility / 25 (at most `budget`, fewer when tired or hurt) and a plan
        // that runs out of steps with the capture point still `margin` outside
        // the feet, or leans past `abort ratio` x its height, decides a fall.
        // Slump (S5), field 13: leg and trunk torque share for the 1.5 s after
        // a give-up (1 = off); the feet hold lets go meanwhile.
        struct Step01
        {
            bool mOneShove = false, mFeetHold = false, mChain = false;
            float mPushScale = 1.0f, mGrip = 0.9f;
            float mLift = 12.0f, mRecover = 0.9f, mReach = 55.0f;
            int mBudget = 6;
            bool mGiveUp = false;
            float mAbort = 0.6f, mGiveUpMargin = 15.0f;
            float mSlump = 1.0f;
        };
        static const Step01& step01Settings()
        {
            static const auto value_tuned = RagdollCore::tuned<Step01>([] {
                Step01 value;
                if (const char* text = RagdollCore::tuningText("OPENMW_RAGDOLL_STEP01"))
                {
                    float shove = 0.0f, hold = 0.0f, chain = 0.0f, budget = 6.0f, giveUp = 0.0f;
                    std::sscanf(text, "%f,%f,%f,%f,%f,%f,%f,%f,%f,%f,%f,%f,%f", &shove, &hold, &value.mPushScale,
                        &value.mGrip, &chain, &value.mLift, &value.mRecover, &value.mReach, &budget, &giveUp,
                        &value.mAbort, &value.mGiveUpMargin, &value.mSlump);
                    value.mGiveUp = giveUp > 0.0f;
                    value.mOneShove = shove > 0.0f;
                    value.mFeetHold = hold > 0.0f;
                    value.mChain = chain > 0.0f;
                    value.mBudget = std::clamp(static_cast<int>(budget), 1, 12);
                }
                return value;
            });
            return value_tuned.get();
        }
        std::array<std::optional<JPH::RVec3>, 2> mStepHoldPlant;
        unsigned mStepHoldReplants = 0;
        bool step01Staggering()
        {
            if (staggerGaveUp())
                return false;
            return mScopedEpisode || mHitStun.active() || mSoftRootStrength < 0.98f || mStaggerPlan.active()
                || bearingsStumble() > 0.0f;
        }
        // S2: the floor's static friction on a planted foot while staggering.
        void updateStepHold()
        {
            const Step01& step = step01Settings();
            const bool on = step.mFeetHold && mRagdoll && mLeftLeg && mRightLeg && mSupportEstimate && step01Staggering();
            RagdollCore::RagdollTelemetry now;
            if (!on || !mRagdoll->captureTelemetry(now))
            {
                mStepHoldPlant = {};
                return;
            }
            float mass = 0.0f;
            for (const auto& body : now.mBodies)
                mass += body.mMass;
            for (std::size_t side = 0; side < 2; ++side)
            {
                const std::size_t foot = side == 0 ? mLeftLeg->mFoot : mRightLeg->mFoot;
                const bool down = side == 0 ? mSupportEstimate->mLeftFootSupported : mSupportEstimate->mRightFootSupported;
                static const auto holdTrace_tuned = RagdollCore::tuned<bool>([] { return RagdollCore::tuningText("OPENMW_RAGDOLL_STEP01_TRACE") != nullptr; });
                const bool holdTrace = holdTrace_tuned.get();
                if (foot >= now.mBodies.size() || !down || footfallSwingingAt(side))
                {
                    if (holdTrace && mStepHoldPlant[side])
                        Log(Debug::Info) << "RAGDOLL_STEP_HOLD end side=" << side << " down=" << down
                                         << " swinging=" << (foot < now.mBodies.size() && footfallSwingingAt(side));
                    mStepHoldPlant[side].reset();
                    continue;
                }
                const JPH::RVec3 at = now.mBodies[foot].mCenterOfMass;
                if (!mStepHoldPlant[side])
                {
                    mStepHoldPlant[side] = at;
                    if (holdTrace)
                        Log(Debug::Info) << "RAGDOLL_STEP_HOLD begin side=" << side << " pinned=" << footfallPinnedAt(side);
                }
                JPH::Vec3 error(*mStepHoldPlant[side] - at);
                error.SetZ(0.0f);
                // Past 8 u the grip was lost (it slid): it holds again from here.
                if (error.Length() > 8.0f)
                {
                    mStepHoldPlant[side] = at;
                    error = JPH::Vec3::sZero();
                    ++mStepHoldReplants;
                    if (holdTrace)
                        Log(Debug::Info) << "RAGDOLL_STEP_HOLD slipped side=" << side;
                }
                JPH::Vec3 velocity = now.mBodies[foot].mMotion.mLinearVelocity;
                velocity.SetZ(0.0f);
                // A 12 Hz critically damped hold, at most grip x half the weight.
                constexpr float omega = 2.0f * 3.14159265f * 12.0f;
                JPH::Vec3 force = (error * (omega * omega) - velocity * (2.0f * omega)) * now.mBodies[foot].mMass;
                const float cap = step.mGrip * 0.5f * mass * 627.2f;
                if (force.Length() > cap)
                    force *= cap / force.Length();
                mRagdoll->applyExternalBodyWrench(foot, force, JPH::Vec3::sZero());
            }
        }

        void addKinematicRootReactionKick(const JPH::Vec3& direction, float impulseMagnitude)
        {
            JPH::Vec3 flat(direction.GetX(), direction.GetY(), 0.0f);
            if (flat.LengthSq() < 1e-6f || !(impulseMagnitude > 0.0f))
                return;
            flat = flat.Normalized();
            if (step01Settings().mOneShove)
            {
                // S1: no whole-body shove and no capsule kick; the counterlean
                // and the stepping walk still play.
                const auto& hit = softRootHitSettings();
                const float band = std::clamp((impulseMagnitude - 300.0f) / (1750.0f - 300.0f), 0.0f, 1.3f);
                const float stumble = std::max(0.0f, band - hit.mStumbleThreshold) * hit.mStumbleSeconds;
                if (stumble > mSoftRootStumbleTime)
                {
                    mSoftRootStumbleTime = stumble;
                    mSoftRootStumbleDirection = flat;
                }
                mImpactCounterbalanceDirection = flat;
                mImpactCounterbalanceStrength = std::clamp(impulseMagnitude / 2500.0f, 0.0f, 1.0f);
                return;
            }
            if (mRagdoll && mRagdoll->getSoftRoot().mEnabled && mRagdoll->isRootKinematic())
            {
                // Soft root: a registered hit shoves the whole body. The shove
                // grows from the stun band to the fall band; balance strength
                // drops at the same time (registerHitReaction), so the body
                // lurches or stumbles and the yielding anchor follows it.
                const auto& hit = softRootHitSettings();
                const float band = std::clamp((impulseMagnitude - 300.0f) / (1750.0f - 300.0f), 0.0f, 1.3f);
                // OPENMW_RAGDOLL_SHOVE_LEGS = s: calves and feet take s of
                // the upper body's shove, thighs halfway, same momentum (1 =
                // off). At 1 a chest push slid planted feet 50 units with the
                // body and no step (push stand front/back 2000-3000,
                // 2026-09-29).
                // Standing (under 15 u/s asked) the default is 0 since 2026-09-30:
                // the shove on planted feet was a real part of the standing
                // skate (push stand 2000-4000, 2 runs: double-support slide
                // 58-85 -> 33-56, total -30%, no falls); walking it was slightly
                // worse (double 164-202 -> 177-211), so moving keeps 1.
                // OPENMW_RAGDOLL_SHOVE_LEGS="standing,moving".
                static const auto shoveLegsSetting_tuned = RagdollCore::tuned<std::array<float, 2>>([] {
                    std::array<float, 2> value{ 0.0f, 1.0f };
                    if (const char* text = RagdollCore::tuningText("OPENMW_RAGDOLL_SHOVE_LEGS"))
                    {
                        const int read = std::sscanf(text, "%f,%f", &value[0], &value[1]);
                        if (read == 1)
                            value[1] = value[0];
                    }
                    return std::array<float, 2>{ std::clamp(value[0], 0.0f, 1.0f), std::clamp(value[1], 0.0f, 1.0f) };
                });
                static const auto& shoveLegsSetting = shoveLegsSetting_tuned.get();
                const bool standingStill
                    = std::hypot(mTargetHorizontalVelocity.GetX(), mTargetHorizontalVelocity.GetY()) < 15.0f;
                const float shoveLegs = standingStill ? shoveLegsSetting[0] : shoveLegsSetting[1];
                if (shoveLegs < 1.0f && mLeftLeg && mRightLeg)
                {
                    std::vector<float> share(mRagdoll->getBodyCount(), 1.0f);
                    for (const auto* leg : { &*mLeftLeg, &*mRightLeg })
                    {
                        if (leg->mHip < share.size())
                            share[leg->mHip] = 0.5f * (1.0f + shoveLegs);
                        for (const std::size_t body : { leg->mKnee, leg->mFoot })
                            if (body < share.size())
                                share[body] = shoveLegs;
                    }
                    mRagdoll->addLinearVelocity(flat * (band * hit.mShoveSpeed), share);
                }
                else
                    mRagdoll->addLinearVelocity(flat * (band * hit.mShoveSpeed));
                // Legs step instead of sliding: the ordinary walk/strafe clip
                // runs in the shove direction for a moment.
                const float stumble = std::max(0.0f, band - hit.mStumbleThreshold) * hit.mStumbleSeconds;
                if (stumble > mSoftRootStumbleTime)
                {
                    mSoftRootStumbleTime = stumble;
                    mSoftRootStumbleDirection = flat;
                }
            }
            mImpactCounterbalanceDirection = flat;
            mImpactCounterbalanceStrength = std::clamp(impulseMagnitude / 2500.0f, 0.0f, 1.0f);
            // Peak excursion the blow should reach, then the launch speed that
            // produces it on the underdamped return spring:
            // x_peak = v0 / w * exp(-z * atan2(sqrt(1 - z^2), z) / sqrt(1 - z^2)).
            const float excursion = std::clamp(impulseMagnitude / 220.0f, 0.0f, 9.0f);
            const float frequency = std::sqrt(sKinematicRootReactionStiffness);
            const float ratio = std::clamp(sKinematicRootReactionDamping / (2.0f * frequency), 0.0f, 0.99f);
            const float damped = std::sqrt(1.0f - ratio * ratio);
            const float speed = excursion * frequency * std::exp(ratio * std::atan2(damped, ratio) / damped);
            // A second blow while the first still plays out adds to the motion
            // but stays inside what one full-strength blow can do.
            JPH::Vec3 velocity = mKinematicRootReactionVelocity + flat * speed;
            const float limit = 9.0f * frequency * std::exp(ratio * std::atan2(damped, ratio) / damped);
            if (velocity.Length() > limit)
                velocity *= limit / velocity.Length();
            mKinematicRootReactionVelocity = velocity;
        }

        void applyImpactCounterbalance(RagdollCore::RagdollPose& pose)
        {
            if (!mTorsoBodyIndex || mImpactCounterbalanceStrength <= 0.0f
                || mImpactCounterbalanceDirection.IsNearZero()
                || *mTorsoBodyIndex >= pose.mBodyTransforms.size())
                return;
            const auto axis = JPH::Vec3::sAxisZ().Cross(mImpactCounterbalanceDirection)
                .NormalizedOr(JPH::Vec3::sAxisX());
            const float angle = -0.22f * std::clamp(mImpactCounterbalanceStrength, 0.0f, 1.0f);
            pose.mBodyTransforms[*mTorsoBodyIndex].mRotation
                = (JPH::Quat::sRotation(axis, angle) * pose.mBodyTransforms[*mTorsoBodyIndex].mRotation).Normalized();
        }

