                    mRagdoll->setSoftRootGrounded(*mLeftFootBodyIndex, leftGrounded);
                if (mRightFootBodyIndex)
                    mRagdoll->setSoftRootGrounded(*mRightFootBodyIndex, rightGrounded);
                // The anchor gives way: when the pelvis has been pushed more
                // than a few units off its target, the actor capsule is
                // carried toward it, so a shove displaces the fighter instead
                // of springing back to the same spot.
                const auto& yield = softRootYieldSettings();
                JPH::RVec3 pelvis;
                JPH::Quat pelvisRotation;
                physics.GetBodyInterface().GetPositionAndRotation(mRagdoll->getBodyId(0), pelvis, pelvisRotation);
                JPH::Vec3 offset(pelvis - groundedTarget);
                offset.SetZ(0.0f);
                const float excess = offset.Length() - yield.mDeadZone;
                mSoftRootKnockback = excess > 0.0f
                    ? offset.Normalized() * std::min(excess * yield.mGain, yield.mMaximumSpeed)
                    : JPH::Vec3::sZero();
