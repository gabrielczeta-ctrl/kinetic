                    // 260 u crawl down peaked at ~570 u/s and was released
                    // as a hard landing).
                    if (mKinematicRootSmoothedFallSpeed > hardLandingSpeed && !mantling())
                    {
                        mKinematicRootFalling = true;
                        mKinematicRootPeakFallSpeed = std::max(
                            mKinematicRootPeakFallSpeed, mKinematicRootSmoothedFallSpeed);
                    }
                    else if (mKinematicRootFalling
                        && mKinematicRootSmoothedFallSpeed < hardLandingSpeed * 0.4f)
                    {
                        const float releaseSpeed = smartLanding().mOn ? smartLanding().mRelease : hardLandingSpeed;
                        if (mKinematicRootPeakFallSpeed >= releaseSpeed && mRagdoll
                            && mRagdoll->isRootKinematic() && !mRollOwnsLanding)
                        {
                            JPH::Vec3 releaseVelocity = mRawTargetHorizontalVelocity;
                            releaseVelocity.SetZ(-mKinematicRootPeakFallSpeed * 0.5f);
                            mRagdoll->releaseRootKinematic(releaseVelocity);
                            mKinematicRootLandingReleased = true;
                            mKinematicRootReleaseCooldown = 0.0f;
                        }
                        mKinematicRootFalling = false;
                        mKinematicRootPeakFallSpeed = 0.0f;
                        mKinematicRootSmoothedFallSpeed = 0.0f;
                        if (!rollOwnsBody())
                            mRollOwnsLanding = false;
                    }
                }
                else
                {
                    mKinematicRootReleaseCooldown += duration;
                    const bool standing = mControllerOutput
                        && mControllerOutput->mMode == RagdollCore::ActiveControllerMode::Standing;
                    const float comSpeed = mControllerInput
                        ? mControllerInput->mCenterOfMassVelocity.Length() : 0.0f;
                    if (standing && comSpeed < 30.0f && mKinematicRootReleaseCooldown > 0.75f)
                        mKinematicRootLandingReleased = false;
                }
            }
            else
            {
                mKinematicRootFalling = false;
                mKinematicRootPeakFallSpeed = 0.0f;
                mKinematicRootHasLastZ = false;
                mKinematicRootSmoothedFallSpeed = 0.0f;
            }
            // The root is kinematic while the physical controller is in a
            // driven mode. Getting-up and blend-back are included: their
            // authored clips carry the whole pelvis path, and with a released
            // root nothing raises the body - the get-up ends lying on the
            // ground, the settle topples, and walking never resumes (measured
            // in the duel opponent, 2026-09-17). Falling and fallen stay
            // released so a real fall is physical. Re-taking the root after
            // physics owned the body also needs a short settled-standing
