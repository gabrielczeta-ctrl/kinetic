                bool leftGrounded = mSupportEstimate && mSupportEstimate->mLeftFootSupported;
                bool rightGrounded = mSupportEstimate && mSupportEstimate->mRightFootSupported;
                // Ground routing pushes the routed weight down through every
                // foot in contact, shared equally. A foot the clip has already
                // lifted but whose toe still touches got half of it (0.26 of
                // body weight, more than the whole leg's 0.17) and could not
                // leave the floor: unarmed forward walking lifted that foot
                // 5-8 units under the clip's 13, dragged it, then whipped it
                // through under the pelvis 23 units ahead of the clip and
                // across the midline. Steps with 4-11 such frames crossed 78%
                // (n 62, inward 12.6), steps with none 6% (n 47, inward 6.7);
                // the sheathed rig crossed only once its legs were loaded (rig
                // masks: pinned right foot 0% -> 56%, 2026-09-24). While the other
                // foot is also down, the clip's swing foot (lifted by the
                // swing clearance threshold) takes no routed weight; the clip's
                // stance foot carries all of it.
                // OPENMW_RAGDOLL_SOFT_ROOT_SWING_UNROUTE = lift in units (0 = off).
                static const auto swingUnrouteLift_tuned = RagdollCore::tuned<float>([] {
                    const char* text = RagdollCore::tuningText("OPENMW_RAGDOLL_SOFT_ROOT_SWING_UNROUTE");
                    return text ? static_cast<float>(std::atof(text)) : 0.0f;
                });
                static const auto& swingUnrouteLift = swingUnrouteLift_tuned.get();
                if (swingUnrouteLift > 0.0f && leftGrounded && rightGrounded && mKinematicTargetFeetSeeded)
                {
                    const float lift
                        = static_cast<float>(mKinematicTargetLeftFoot.GetZ() - mKinematicTargetRightFoot.GetZ());
                    if (lift >= swingUnrouteLift)
                        leftGrounded = false;
                    else if (-lift >= swingUnrouteLift)
                        rightGrounded = false;
                }
                // The same for Footfall's own swings (the clip rule above sees
                // the clip, not the steps Footfall places): a commanded swing
                // stayed pressed at rest height for the whole 0.3 s and slid
                // ~5 units (offline sim, hybrid/pgc-footfall 2026-09-29).
                // On by default since 2026-09-30 (push stand 2000-4000, 2 runs:
                // double-support slide 40-49 -> 33-44, a few more steps; walking
                // 173-239 -> 135-215; sentinel pass).
                // OPENMW_RAGDOLL_SOFT_ROOT_FOOTFALL_UNROUTE=0 = off.
                static const auto footfallUnroute_tuned = RagdollCore::tuned<bool>([] {
                    const char* text = RagdollCore::tuningText("OPENMW_RAGDOLL_SOFT_ROOT_FOOTFALL_UNROUTE");
                    return !(text != nullptr && std::atoi(text) == 0);
                });
                static const auto& footfallUnroute = footfallUnroute_tuned.get();
                // Standing only: walking with it the course's step timing
                // spread rose past its bar (walk stepT 30-32 against 28).
                if (footfallUnroute && pgcRequestSpeed() < 15.0f && leftGrounded && rightGrounded
                    && footfallLibraryDrives())
                {
                    if (footfallSwingingAt(0) && !footfallSwingingAt(1))
                        leftGrounded = false;
                    else if (footfallSwingingAt(1) && !footfallSwingingAt(0))
                        rightGrounded = false;
                }
