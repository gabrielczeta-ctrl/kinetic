                && mControllerInput->mTorsoUpDot > 0.85f && mControllerInput->mCenterOfMassVelocity.Length() < 60.0f;
            mKinematicRootBracedTime = bracedUpright ? mKinematicRootBracedTime + duration : 0.0f;
