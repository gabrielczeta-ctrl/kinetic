            std::string_view wanted = "chop";
            if (speed > 10.0f && std::abs(along) > std::abs(across) + 0.2f * speed)
                wanted = "thrust";
            else if (speed > 10.0f && std::abs(across) > std::abs(along) + 0.2f * speed)
                wanted = "slash";
            const auto can = [&](std::string_view type) {
                return type == "thrust" ? allowed.mThrust : type == "slash" ? allowed.mSlash : allowed.mChop;
            };
            if (can(wanted))
                return wanted;
            for (const std::string_view fallback : { "thrust", "slash", "chop" })
                if (can(fallback))
                    return fallback;
            return wanted;
        }

        // The native attack's animation hand biased toward an aim point,
        // clamped to the arm's reach. Shared by the AI strike and the player's
        // own quick or charged attack so the blow lands where the attack is
        // pointed, not where the clip happens to swing.
        std::optional<JPH::RVec3> strikeAssistTarget(JPH::RVec3Arg aimPoint) const
        {
            if (!mRightArm || !mCurrentPhysicsPoseCaptured)
                return std::nullopt;
            const auto shoulder = mRagdoll->getWorldBodyPosition(mCurrentPhysicsPose, mRightArm->mShoulder);
            const auto animHand = mRagdoll->getWorldBodyPosition(mMotorTargetPose, mRightArm->mHand);
            if (!shoulder || !animHand)
                return std::nullopt;
            const auto geometry
                = mRagdoll->getHingeLegGeometry(mRightArm->mShoulder, mRightArm->mElbow, mRightArm->mHand);
            const auto reach = geometry ? RagdollCore::hingeChainReachRange(*geometry) : std::nullopt;
            const auto worldUnit = mRagdoll->getWorldVector(JPH::Vec3::sAxisX());
            if (!reach || !worldUnit || !(reach->second > 0.0f))
                return std::nullopt;
            const float reachWorld = reach->second * worldUnit->Length();
            const float distance = static_cast<float>((aimPoint - *shoulder).Length());
            if (distance <= 1e-3f)
                return std::nullopt;
            JPH::RVec3 assist = aimPoint;
            // An armed strike places the hand so the outer blade or head meets
            // the aim; punching the grip into the body is what made the butt
            // land the blows.
            if (mWeapon && mWeapon->mAttached && mWeapon->mWeaponBody < mRagdoll->getBodyCount())
            {
                if (getPtr() == MWMechanics::getPlayer())
                {
                    // The player's wrist target points the long axis toward
                    // the aim. Derive its hand target from that same desired
                    // axis, not from the lagging blade: the measured-axis
                    // threshold switched between grip-at-aim and tip-at-aim
                    // while the arm was still travelling toward the target.
                    const JPH::Vec3 toAim = JPH::Vec3(aimPoint - *shoulder).Normalized();
                    const float handDistance = std::clamp(distance - mWeapon->tipDistanceFromHand(),
                        reach->first * worldUnit->Length(), 0.95f * reachWorld);
                    assist = *shoulder + JPH::RVec3(toAim * handDistance);
                }
                else if (const auto rotation
                    = mRagdoll->getWorldBodyRotation(mCurrentPhysicsPose, mWeapon->mWeaponBody))
                {
                    const JPH::Vec3 bladeDirection = *rotation * mWeapon->mBladeAxis;
                    const JPH::Vec3 toAim = JPH::Vec3(aimPoint - *shoulder).Normalized();
                    if (bladeDirection.Dot(toAim) > 0.3f)
                        assist = aimPoint - JPH::RVec3(bladeDirection * mWeapon->tipDistanceFromHand());
                }
            }
            JPH::RVec3 toAssist = assist - *shoulder;
            const float assistDistance = static_cast<float>(toAssist.Length());
            const float clamped = 0.95f * reachWorld;
            if (assistDistance > clamped)
                toAssist *= clamped / assistDistance;
            assist = *shoulder + toAssist;
            const float reachError = static_cast<float>((assist - *animHand).Length());
            const float weight = std::clamp(reachError / (0.5f * reachWorld), 0.25f, 1.0f);
            JPH::RVec3 target = *animHand + (assist - *animHand) * weight;
            if (getPtr() == MWMechanics::getPlayer() && mWeapon && mWeapon->mAttached)
            {
                // The blend must obey the same anatomical reach as its aimed
                // endpoint. A close blade contact uses a nearer part of the
                // physical blade; it cannot fold the elbow through its limit
                // or move the grip behind the shoulder to put the far tip there.
                const JPH::Vec3 forward = JPH::Vec3(aimPoint - *shoulder).Normalized();
                JPH::Vec3 offset(target - *shoulder);
                offset -= forward * std::min(0.0f, offset.Dot(forward));
                const float length = offset.Length();
                const float bounded = std::clamp(length, reach->first * worldUnit->Length(), clamped);
                target = *shoulder + JPH::RVec3(offset.NormalizedOr(forward) * bounded);
            }
            return target;
        }

        struct TipControlFrame
        {
            JPH::RVec3 mPivot;
            float mScale = 1.0f;
            float mMinimumGrip = 0.0f;
        };

        // Which drags steer the weapon's tip rather than its grip:
        // OPENMW_RAGDOLL_TIP_CONTROL=0 off, 1 (default) two-handed grips,
        // 2 also one-handed long blades.
        static int tipControlMode()
        {
            static const auto mode_tuned = RagdollCore::tuned<int>([] {
                const char* text = RagdollCore::tuningText("OPENMW_RAGDOLL_TIP_CONTROL");
                return text ? std::clamp(std::atoi(text), 0, 2) : 1;
            });
            static const auto& mode = mode_tuned.get();
            return mode;
        }

        // For a long weapon the mouse should steer where the blade or head
        // is, not where the hand is: a grip that moves a little near the body
        // swings the tip through a large arc. The pivot is between the
        // shoulders for two hands (the weapon shoulder for one); the tip
        // sphere is the hand gesture sphere scaled by (reach + length) / reach.
        // The weapon's pivot sits this far under the shoulders (units): the
        // grip lies on the pivot-to-tip line, so a shoulder-high pivot put a
        // raised blade's hands at the shoulders or above - a guard with the
        // warhammer over the head, the "wrong and unnatural" arm positions
        // (2026-09-26). The Mixamo great sword guard holds the hands at the
        // waist, 0.75 arm lengths under the shoulders, the blade up from
        // there. OPENMW_RAGDOLL_TIP_PIVOT_DROP.
        static float tipPivotDrop()
        {
            static const auto drop_tuned = RagdollCore::tuned<float>([] { return weaponDriveSetting("OPENMW_RAGDOLL_TIP_PIVOT_DROP", 0.0f); });
            static const auto& drop = drop_tuned.get();
            return drop;
        }
        std::optional<TipControlFrame> tipControlFrame(JPH::RVec3Arg weaponShoulder) const
        {
            const int mode = tipControlMode();
            if (!mode || !mWeapon || !mWeapon->mAttached || !mRightArm || !mLeftArm || !mCurrentPhysicsPoseCaptured
                || getPtr() != MWMechanics::getPlayer() || !(mSwingInput.mMaximumHandDistance > 0.0f)
                || mAiStrikeActive || mAnimationAttack.mPhase != MWMechanics::RagdollAttackPhase::Idle)
                return std::nullopt;
            const bool twoHanded = mWeapon->mTwoHanded && mSupportGripEnabled && !mWeapon->mWideSpearGrip;
            const bool longBlade = mode >= 2 && mWeapon->mUsesBladeSurface && mWeapon->tipDistanceFromHand() > 40.0f;
            if (!twoHanded && !longBlade)
                return std::nullopt;
            const auto leftShoulder = mRagdoll->getWorldBodyPosition(mCurrentPhysicsPose, mLeftArm->mShoulder);
            if (!leftShoulder)
                return std::nullopt;
            TipControlFrame frame;
            frame.mPivot = (twoHanded ? weaponShoulder + (*leftShoulder - weaponShoulder) * 0.5 : weaponShoulder)
                - JPH::RVec3(0.0f, 0.0f, tipPivotDrop());
            const float length = std::max(mWeapon->tipDistanceFromHand(), 0.0f);
            frame.mScale = (mSwingInput.mMaximumHandDistance + length) / mSwingInput.mMaximumHandDistance;
            frame.mMinimumGrip = 0.3f * mSwingInput.mMaximumHandDistance;
            return frame;
        }

        // Two-handed drag workspace. A sphere around the weapon shoulder put
        // the support grip at 121-134% of the other arm's reach, and a fixed
        // shrink (TWO_HAND_REACH=0.62) fixed the grip but left about 18 units
        // of side travel. Centre the workspace between the shoulders so the
        // hands cross the body both ways, then pull the target back only by
        // what keeps the support grip inside the other arm's reach, using the
        // measured hand-to-hand offset for where that grip will be.
        void fitTwoHandedWorkspace(JPH::RVec3& target, JPH::RVec3Arg weaponShoulder, bool recentre = true,
            std::optional<JPH::Vec3> predictedGripOffset = std::nullopt)
        {
            if (!mCurrentPhysicsPoseCaptured || !mRightArm || !mLeftArm)
                return;
            const auto leftShoulder = mRagdoll->getWorldBodyPosition(mCurrentPhysicsPose, mLeftArm->mShoulder);
            const auto rightHand = mRagdoll->getWorldBodyPosition(mCurrentPhysicsPose, mRightArm->mHand);
            const auto leftHand = mRagdoll->getWorldBodyPosition(mCurrentPhysicsPose, mLeftArm->mHand);
            const auto geometry = mRagdoll->getHingeLegGeometry(mLeftArm->mShoulder, mLeftArm->mElbow, mLeftArm->mHand);
            const auto reach = geometry ? RagdollCore::hingeChainReachRange(*geometry) : std::nullopt;
            const auto worldUnit = mRagdoll->getWorldVector(JPH::Vec3::sAxisX());
            if (!leftShoulder || !rightHand || !leftHand || !reach || !worldUnit)
                return;
            static const auto centre_tuned = RagdollCore::tuned<float>([] {
                const char* text = RagdollCore::tuningText("OPENMW_RAGDOLL_TWO_HAND_CENTER");
                const float value = text ? static_cast<float>(std::atof(text)) : 0.5f;
                return std::isfinite(value) ? std::clamp(value, 0.0f, 1.0f) : 0.5f;
            });
            static const auto& centre = centre_tuned.get();
            static const auto margin_tuned = RagdollCore::tuned<float>([] {
                const char* text = RagdollCore::tuningText("OPENMW_RAGDOLL_TWO_HAND_MARGIN");
                const float value = text ? static_cast<float>(std::atof(text)) : 0.95f;
                return std::isfinite(value) ? std::clamp(value, 0.5f, 1.0f) : 0.95f;
            });
            static const auto& margin = margin_tuned.get();
            if (recentre)
                target += JPH::RVec3(JPH::Vec3(*leftShoulder - weaponShoulder) * centre);
            const JPH::Vec3 gripOffset = predictedGripOffset ? *predictedGripOffset : JPH::Vec3(*leftHand - *rightHand);
            const JPH::Vec3 support(target + JPH::RVec3(gripOffset) - *leftShoulder);
            const float limit = margin * reach->second * worldUnit->Length();
            const float distance = support.Length();
            if (distance > limit && distance > 1e-3f)
                target -= JPH::RVec3(support * ((distance - limit) / distance));
        }

        // PLAY-04 spec v0.2 tip controller (docs/ragdoll/specs/player-weapon-
        // control.md). One command for the player's drawn weapon: the tip's
        // direction from the chest in the body's yaw frame (azimuth,
        // elevation) and its distance. Guard, drag, release and the quick
        // attack all move that command; it accelerates and brakes with the
        // weapon's weight; the grip sits on the chest-to-tip line one tip
        // distance back and the wrist points the blade along it (3.3); arm IK,
        // the arm motors and the weapon drive make the physical weapon follow.
        // It replaces, for the player's drawn weapon, the hand-offset drag
        // (a small sphere around the shoulder with its own return), the
        // first-person rest and the animation-clip arm of a quick attack: the
        // gate suite measured a drag range of 58 degrees on the warhammer, a
        // guard 20-85 units off one second after a release, and quick attacks
        // passing the crosshair 20-55 units away. The clip still plays for the
        // body; the arm follows the strike below. OPENMW_RAGDOLL_TIP_CONTROLLER=0
        // restores the old paths.
        struct TipController
        {
            enum class Mode
            {
                Guard,
                Drag,
                WindUp,
                Strike,
            };
            bool mActive = false;
            Mode mMode = Mode::Guard;
            float mAz = 0.0f, mEl = 0.0f, mRadius = 0.0f;
            float mAzRate = 0.0f, mElRate = 0.0f;
            float mGoalAz = 0.0f, mGoalEl = 0.0f, mGoalRadius = 0.0f;
            float mStrikeAz = 0.0f, mStrikeEl = 0.0f, mStrikeRadius = 0.0f;
            float mTimer = 0.0f;
            float mHoldTime = 0.0f;
            bool mReleasedDrag = false; // back to the guard from a released drag
            float mSwingLean = 0.0f; // radians, the hard-swing forward lean
            int mStance = 0; // 0 middle, 1 high, 2 low guard (TIP_STANCES)
            // Direction of the current drag stroke (unit, az/el rates).
            float mStrokeAz = 0.0f, mStrokeEl = 0.0f;
            // Where the current drag started: a release near it is a click.
            float mDragStartAz = 0.0f, mDragStartEl = 0.0f, mDragStartRadius = 0.0f;
            // 1 at a press, down to 0 as the drag moves (see the Drag case).
            float mDragSettle = 0.0f;
            // The aim wander (DMG-04) as it stood at the last press, taken
            // off the controller's target so a press starts on the blade.
            float mWanderBaseAz = 0.0f, mWanderBaseEl = 0.0f;
            // Committed swing (2b): a fast drag stroke commits a full-power
            // swing that carries through along its direction. mStrokeRate is
            // the smoothed speed of the mouse-driven goal (rad/s); the commit
            // lasts mCommitTimer seconds past the last fast input.
            float mStrokeRate = 0.0f, mCommitTimer = 0.0f;
            float mCommitAz = 0.0f, mCommitEl = 0.0f;
            bool mSlipArmed = false;
            float mSlipGoalAz = 0.0f, mSlipGoalEl = 0.0f, mSlipAz = 0.0f, mSlipEl = 0.0f;
            float mSlipTime = 0.0f, mSlipRecovery = 0.0f;
            // Parry knock: an offset on the drive goal in every mode (beginParryKnock).
            float mKnockGoalAz = 0.0f, mKnockGoalEl = 0.0f, mKnockAz = 0.0f, mKnockEl = 0.0f;
            float mKnockTime = 0.0f, mKnockRecovery = 0.0f;
            // Roll of the blade about its long axis away from the handshake
            // grip (radians), turned so an edge leads the stroke.
            float mRoll = 0.0f;
            // The current quick attack is a thrust: out along the aim line.
            bool mThrust = false;
            // An aimed click strike (see solveAim): the target in the world,
            // the shoulder the lever was solved from (right, forward, up of
            // the tip frame, taken at the click), the solved aim, and where
            // the strike's line started.
            bool mGuided = false;
            JPH::RVec3 mAimWorld = JPH::RVec3::sZero();
            JPH::Vec3 mShoulderLocal = JPH::Vec3::sZero();
            float mAimAz = 0.0f, mAimEl = 0.0f, mAimRadius = 0.0f;
            float mLineAz = 0.0f, mLineEl = 0.0f;
            // The chest's turn and lean toward the weapon (radians, body yaw
            // frame: twist positive to the right, lean positive backwards).
            float mBodyTwist = 0.0f, mBodyLean = 0.0f;
            // 0 = the guard rest, 1 = the walking carry (see playerWalkCarry).
            float mRestBlend = 0.0f;
            float mRestGrip = 0.0f; // 0 = grip on the shoulder-to-tip line, 1 = the low rest grip
            float mPivotHeight = 0.0f;
            bool mHeld = false;
            bool mAttackIdle = true;
            std::string mAttackType;
        };
        TipController mTip;
        // Impact feel (user 2026-09-29: "impacts more beefy... if the opponent
        // is armored, the weapon bounces back"). A clean blow holds this body's
        // weapon still for a moment (hit-stop, the weapon and hand only), then
        // the stored bounce throws it back; on the tip controller the command
        // swings back with it (recoil) instead of pulling the blade on through.
        float mImpactFreeze = 0.0f;
        JPH::Vec3 mImpactBounce = JPH::Vec3::sZero();
        float mImpactHardness = 0.0f;
        float mImpactRecoil = 0.0f;
        float mImpactRateAz = 0.0f, mImpactRateEl = 0.0f;
        // The weapon and hand's motion when the hit-stop began: a blow with
        // nothing to bounce off (flesh, cloth) carries on through with part
        // of it afterwards instead of stopping dead.
        bool mImpactHeld = false;
        std::array<JPH::Vec3, 4> mImpactMotion{};
        std::uint64_t mImpactCount = 0;
        // DUEL-AI-01 stage 1: what an opponent can see of this body's weapon -
        // how fast its tip (or the striking hand) moves, since when it has
        // been slow, and since its last bounce or clash.
        float mDuelTipSpeed = 0.0f;
        JPH::Vec3 mDuelBladeVelocity = JPH::Vec3::sZero(); // the weapon body's (or hand's), u/s
        float mDuelSinceFast = 1.0e9f;
        float mDuelSinceImpact = 1.0e9f;
        float mAiSinceParryWon = 1.0e9f; // AI-02 item 5: since this body's last parry won (knockaway)
        bool mRiposteAttack = false; // ... and the attack now running answers it
        // The weapon's tip (hand + blade axis x reach) and its velocity,
        // differenced per frame (u/s): the timed parry reads the arrival from
        // it - the weapon body's linear velocity misses the swing's rotation.
        std::optional<JPH::RVec3> mDuelTipPoint;
        JPH::Vec3 mDuelTipVelocity = JPH::Vec3::sZero();
        float mRiposteGranted = 0.0f; // the AI decided a riposte (requestRagdollAiRiposte), s left
        void trackDuelMotion(float duration, JPH::BodyInterface& bodies)
        {
            mAiSinceParryWon += duration;
            mDuelSinceFast += duration;
            {
                std::optional<JPH::RVec3> tip;
                if (mCurrentPhysicsPoseCaptured && mWeapon && mWeapon->mAttached && mWeapon->mHandBody < mRagdoll->getBodyCount())
                {
                    const auto hand = mRagdoll->getWorldBodyPosition(mCurrentPhysicsPose, mWeapon->mHandBody);
                    const auto turn = mRagdoll->getWorldBodyRotation(mCurrentPhysicsPose, mWeapon->mHandBody);
                    if (hand && turn)
                        tip = *hand
                            + JPH::RVec3(*turn * mWeapon->mBladeAxis * std::max(mWeapon->tipDistanceFromHand(), 0.0f));
                }
                if (tip && mDuelTipPoint && duration > 0.0f)
                {
                    const JPH::Vec3 velocity(JPH::Vec3(*tip - *mDuelTipPoint) / duration);
                    if (velocity.Length() < 3000.0f)
                        mDuelTipVelocity = velocity;
                }
                else
                    mDuelTipVelocity = JPH::Vec3::sZero();
                mDuelTipPoint = tip;
            }
            mDuelSinceImpact += duration;
            std::optional<std::size_t> body;
            float length = 0.0f;
            if (mWeapon && mWeapon->mAttached && mWeapon->mWeaponBody < mRagdoll->getBodyCount())
            {
                body = mWeapon->mWeaponBody;
                length = mWeapon->mLength;
            }
            else if (mRightArm)
                body = mRightArm->mHand;
            if (!body || *body >= mRagdoll->getBodyCount())
            {
                mDuelTipSpeed = 0.0f;
                return;
            }
            const JPH::BodyID id = mRagdoll->getBodyId(*body);
            mDuelBladeVelocity = bodies.GetLinearVelocity(id);
            mDuelTipSpeed = mDuelBladeVelocity.Length() + bodies.GetAngularVelocity(id).Length() * 0.5f * length;
            if (mDuelTipSpeed > 300.0f)
                mDuelSinceFast = 0.0f;
        }
        // Pose map drags (alpha 0.9, user 2026-10-02: drags "don't feel like a
        // smooth combat experience. I shouldn't have to worry about my
        // character's elbow or wrist positions"; "the wind up makes the sword
        // go around the back"). Per weapon class, a grid of upper-body poses
        // by the commanded tip's azimuth and elevation (degrees, actor frame):
        // the guard cells captured from the game where the old solve settles
        // cleanly (POSEMAP-01, tools/body/posemap.py), and authored wind-up
        // cells past the top and the sides (blade back over the head or
        // behind a shoulder, elbows up, chest turned away). A drag blends the
        // grip, blade direction, elbow pole and chest twist of the four
        // nearest cells, so the arms never search for a joint solution and
        // the blade can go round the back. Files: posemap-twohanded.cfg and
        // posemap-onehanded.cfg next to ragdoll.cfg.
        // OPENMW_RAGDOLL_POSE_MAP: on by default (0 = the old tip solve).
        struct PoseMapCell
        {
            float mAz = 0.0f, mEl = 0.0f;
            JPH::Vec3 mGrip = JPH::Vec3::sZero(), mBlade = JPH::Vec3::sAxisZ(), mPole = -JPH::Vec3::sAxisZ();
            float mTwist = 0.0f;
        };
        struct PoseMap
        {
            std::vector<float> mAz, mEl; // sorted grid lines
            std::vector<PoseMapCell> mCells; // mEl.size() x mAz.size(), row-major by elevation
            const PoseMapCell* cellAt(std::size_t a, std::size_t e) const { return &mCells[e * mAz.size() + a]; }
            // Bilinear over the grid (clamped at its edges); directions are
            // blended and renormalised.
            PoseMapCell sample(float az, float el) const
            {
                const auto bracket = [](const std::vector<float>& lines, float value, std::size_t& i, float& t) {
                    value = std::clamp(value, lines.front(), lines.back());
                    i = 0;
                    while (i + 2 < lines.size() && value > lines[i + 1])
                        ++i;
                    const float span = lines.size() > 1 ? lines[i + 1] - lines[i] : 1.0f;
                    t = lines.size() > 1 ? std::clamp((value - lines[i]) / span, 0.0f, 1.0f) : 0.0f;
                };
                std::size_t ai = 0, ei = 0;
                float ta = 0.0f, te = 0.0f;
                bracket(mAz, az, ai, ta);
                bracket(mEl, el, ei, te);
                const std::size_t a1 = std::min(ai + 1, mAz.size() - 1), e1 = std::min(ei + 1, mEl.size() - 1);
                const std::array<std::pair<const PoseMapCell*, float>, 4> corners{ {
                    { cellAt(ai, ei), (1.0f - ta) * (1.0f - te) }, { cellAt(a1, ei), ta * (1.0f - te) },
                    { cellAt(ai, e1), (1.0f - ta) * te }, { cellAt(a1, e1), ta * te } } };
                PoseMapCell result;
                result.mAz = az;
                result.mEl = el;
                result.mBlade = result.mPole = JPH::Vec3::sZero();
                for (const auto& [cell, weight] : corners)
                {
                    result.mGrip += cell->mGrip * weight;
                    result.mBlade += cell->mBlade * weight;
                    result.mPole += cell->mPole * weight;
                    result.mTwist += cell->mTwist * weight;
                }
                result.mBlade = result.mBlade.NormalizedOr(JPH::Vec3::sAxisZ());
                result.mPole = result.mPole.NormalizedOr(-JPH::Vec3::sAxisZ());
                return result;
            }
        };
        static std::optional<PoseMap> loadPoseMap(const std::string& name)
        {
            const char* settings = RagdollCore::tuningText("OPENMW_RAGDOLL_SETTINGS");
            if (!settings)
                return std::nullopt;
            const std::filesystem::path path = std::filesystem::path(settings).parent_path() / ("posemap-" + name + ".cfg");
            std::ifstream file(path);
            if (!file)
                return std::nullopt;
            std::vector<PoseMapCell> cells;
            std::string line;
            while (std::getline(file, line))
            {
                PoseMapCell cell;
                float g[3], b[3], q[3];
                if (std::sscanf(line.c_str(), "cell %f %f grip=%f,%f,%f blade=%f,%f,%f pole=%f,%f,%f twist=%f", &cell.mAz,
                        &cell.mEl, &g[0], &g[1], &g[2], &b[0], &b[1], &b[2], &q[0], &q[1], &q[2], &cell.mTwist)
                    != 12)
                    continue;
                cell.mGrip = JPH::Vec3(g[0], g[1], g[2]);
                cell.mBlade = JPH::Vec3(b[0], b[1], b[2]).NormalizedOr(JPH::Vec3::sAxisZ());
                cell.mPole = JPH::Vec3(q[0], q[1], q[2]).NormalizedOr(-JPH::Vec3::sAxisZ());
                cells.push_back(cell);
            }
            PoseMap map;
            for (const auto& cell : cells)
            {
                if (std::find(map.mAz.begin(), map.mAz.end(), cell.mAz) == map.mAz.end())
                    map.mAz.push_back(cell.mAz);
                if (std::find(map.mEl.begin(), map.mEl.end(), cell.mEl) == map.mEl.end())
                    map.mEl.push_back(cell.mEl);
            }
            std::sort(map.mAz.begin(), map.mAz.end());
            std::sort(map.mEl.begin(), map.mEl.end());
            if (map.mAz.size() < 2 || map.mEl.size() < 2)
                return std::nullopt;
            map.mCells.assign(map.mAz.size() * map.mEl.size(), PoseMapCell{});
            std::vector<bool> filled(map.mCells.size(), false);
            for (const auto& cell : cells)
            {
                const std::size_t a = std::find(map.mAz.begin(), map.mAz.end(), cell.mAz) - map.mAz.begin();
                const std::size_t e = std::find(map.mEl.begin(), map.mEl.end(), cell.mEl) - map.mEl.begin();
                map.mCells[e * map.mAz.size() + a] = cell;
                filled[e * map.mAz.size() + a] = true;
            }
            if (std::find(filled.begin(), filled.end(), false) != filled.end())
            {
                Log(Debug::Warning) << "Pose map " << path << " has holes in its grid; not used";
                return std::nullopt;
            }
            Log(Debug::Info) << "Pose map " << name << ": " << map.mAz.size() << " x " << map.mEl.size() << " cells";
            return map;
        }
        static bool poseMapEnabled()
        {
            static const auto value_tuned = RagdollCore::tuned<bool>([] {
                const char* text = RagdollCore::tuningText("OPENMW_RAGDOLL_POSE_MAP");
                return !(text && std::atoi(text) == 0);
            });
            static const auto& value = value_tuned.get();
            return value;
        }
        // The map for the weapon in hand, or none (bare hands, daggers,
        // spears and staves keep the old solve for now).
        const PoseMap* activePoseMap(bool bare) const
        {
            if (!poseMapEnabled() || bare || !mWeapon || !mWeapon->mAttached || mWeapon->mWideSpearGrip)
                return nullptr;
            static const std::optional<PoseMap> twoHanded = loadPoseMap("twohanded");
            static const std::optional<PoseMap> oneHanded = loadPoseMap("onehanded");
            const auto& map = mWeapon->mTwoHanded ? twoHanded : oneHanded;
            return map ? &*map : nullptr;
        }
        float mPoseMapBlend = 0.0f; // 0 old solve .. 1 the map (eases over 0.15 s)
        // Hilt control (OPENMW_RAGDOLL_HILT, see stepPlayerTipControl): the
        // drag steers the hands' direction from the shoulders with a trackball.
        bool mHiltActive = false;
        float mHiltBlend = 0.0f;
        float mHiltWeight = 0.0f; // the hilt's share of the drive this step
        JPH::Quat mHiltRotation = JPH::Quat::sIdentity(); // body frame: x right, y forward, z up
        JPH::Vec3 mHiltPrevious = JPH::Vec3::sAxisY();
        float mHiltRate = 0.0f; // rad/s of the hands' direction, filtered
        float mHiltReach = 0.0f; // the hands' distance from the pivot, eased
        JPH::Vec3 mHiltStartBlade = JPH::Vec3::sAxisZ(); // body frame, at the drag's start
        float mHiltTravel = 0.0f; // radians the hands turned since the drag began
        JPH::Vec3 mHiltVelocity = JPH::Vec3::sZero(); // of the direction, body frame, filtered

        // Parry knock (user bookmark 20, 2026-10-02: "hitting a weapon should
        // push the character's hand in the attack direction"). The parrying
        // blade's goal is thrown along the attacking blade's travel by
        // `units` and comes back over a recovery that grows as skill falls;
        // the tip controller used to pull the parry straight back to the
        // guard (kicks of 0.3 x the bounce).
        // OPENMW_RAGDOLL_PARRY_KNOCK = "units at the reference kick, recovery s
        // at no skill, reference kick" (0 = off; PARRY-01 kicks run 30-330).
        static const std::array<float, 3>& parryKnockSettings()
        {
            static const auto value_tuned = RagdollCore::tuned<std::array<float, 3>>([] {
                std::array<float, 3> v{ 35.0f, 0.7f, 300.0f };
                if (const char* text = RagdollCore::tuningText("OPENMW_RAGDOLL_PARRY_KNOCK"))
                    std::sscanf(text, "%f,%f,%f", &v[0], &v[1], &v[2]);
                return v;
            });
            static const auto& value = value_tuned.get();
            return value;
        }
        JPH::RVec3 mKnockHandStart = JPH::RVec3::sZero();
        JPH::Vec3 mKnockDirection = JPH::Vec3::sZero();
        float mKnockPeak = 0.0f;
        std::uint64_t mKnockCount = 0;
        void beginParryKnock(JPH::Vec3Arg attackDirection, float units)
        {
            if (!mTip.mActive || !mWeapon || !mWeapon->mAttached || !mRagdoll || attackDirection.IsNearZero())
                return;
            const JPH::Vec3 push = attackDirection.Normalized() * units;
            const TipFrame frame = tipFrame();
            const float radius = std::max(20.0f, mTip.mRadius);
            const JPH::Vec3 tip = frame.direction(mTip.mAz, mTip.mEl) * radius;
            const auto [az, el] = frame.angles(tip + push);
            constexpr float pi = 3.14159265f;
            float dAz = az - mTip.mAz;
            while (dAz > pi)
                dAz -= 2.0f * pi;
            while (dAz < -pi)
                dAz += 2.0f * pi;
            mTip.mKnockGoalAz = dAz;
            mTip.mKnockGoalEl = el - mTip.mEl;
            const float skillLoss = std::clamp((1.0f - mWeaponControl) / 0.8f, 0.0f, 1.0f);
            mTip.mKnockRecovery = parryKnockSettings()[1] * (0.35f + 0.65f * skillLoss);
            mTip.mKnockTime = 0.0f;
            if (mWeapon->mHandBody < mRagdoll->getBodyCount() && mCurrentPhysicsPoseCaptured)
                if (const auto hand = mRagdoll->getWorldBodyPosition(mCurrentPhysicsPose, mWeapon->mHandBody))
                    mKnockHandStart = *hand;
            mKnockDirection = attackDirection.Normalized();
            mKnockPeak = 0.0f;
            ++mKnockCount;
        }
        // Once per step before the tip drive: out in 0.06 s, back over the recovery.
        void stepParryKnock(float duration)
        {
            if (mTip.mKnockRecovery <= 0.0f)
                return;
            mTip.mKnockTime += duration;
            const float out = std::min(1.0f, mTip.mKnockTime / 0.06f);
            const float back = std::exp(-std::max(0.0f, mTip.mKnockTime - 0.06f) / mTip.mKnockRecovery);
            mTip.mKnockAz = mTip.mKnockGoalAz * out * back;
            mTip.mKnockEl = mTip.mKnockGoalEl * out * back;
            if (mWeapon && mWeapon->mAttached && mRagdoll && mCurrentPhysicsPoseCaptured
                && mWeapon->mHandBody < mRagdoll->getBodyCount())
                if (const auto hand = mRagdoll->getWorldBodyPosition(mCurrentPhysicsPose, mWeapon->mHandBody))
                    mKnockPeak = std::max(mKnockPeak, JPH::Vec3(*hand - mKnockHandStart).Dot(mKnockDirection));
            if (mTip.mKnockTime > 0.06f + 4.0f * mTip.mKnockRecovery)
            {
                Log(Debug::Info) << "RAGDOLL_PARRY_KNOCK_END actor=" << getPtr().getCellRef().getRefId()
                                 << " hand_moved=" << mKnockPeak << " recovery=" << mTip.mKnockRecovery;
                mTip.mKnockRecovery = mTip.mKnockAz = mTip.mKnockEl = 0.0f;
            }
        }

        void beginWeaponImpact(float freeze, JPH::Vec3Arg bounce, float hardness,
            std::optional<JPH::RVec3> point = std::nullopt)
        {
            mDuelSinceImpact = 0.0f;
            if (!mWeapon || !mWeapon->mAttached)
                return;
            if (bounce.LengthSq() > mImpactBounce.LengthSq())
            {
                mImpactBounce = bounce;
                mImpactPoint = point;
            }
            // Torque from where the blade is struck (C2, build 59 bookmark
            // 12: "hitting the tip of the spear should really cause heavy
            // torque"): the bounce goes in at the contact point, and the
            // weapon drive gives way for a moment by the lever - the contact's
            // distance from the hand over the weapon's reach - so the twist
            // shows. OPENMW_RAGDOLL_WEAPON_TORQUE = "drive given at the tip,
            // seconds" (0 = the bounce at the centre of mass, no give).
            if (point && weaponTorqueSettings()[0] > 0.0f && mWeapon->mHandBody < mRagdoll->getBodyCount())
                if (const auto hand = mRagdoll->getWorldBodyPosition(mCurrentPhysicsPose, mWeapon->mHandBody))
                {
                    const float reach = std::max(10.0f, mWeapon->tipDistanceFromHand());
                    const float lever = std::clamp(static_cast<float>((*point - *hand).Length()) / reach, 0.0f, 1.0f);
                    const float strength = std::clamp(bounce.Length() / 400.0f, 0.0f, 1.0f);
                    mImpactTwistYield = std::min(mImpactTwistYield, 1.0f - weaponTorqueSettings()[0] * lever * strength);
                }
            mImpactHardness = std::max(mImpactHardness, hardness);
            if (mImpactFreeze <= 0.0f && mImpactRecoil <= 0.0f)
            {
                mImpactRateAz = mTip.mAzRate;
                mImpactRateEl = mTip.mElRate;
            }
            mImpactFreeze = std::max(mImpactFreeze, freeze);
            ++mImpactCount;
            if (getPtr() == MWMechanics::getPlayer())
                mCameraKick = std::max(mCameraKick, std::clamp(hardness, 0.3f, 1.0f));
        }
        // Once per fixed step, before the drives: hold the weapon and hand
        // still while frozen, then release the bounce and start the recoil.
        static const std::array<float, 2>& weaponTorqueSettings()
        {
            static const auto value_tuned = RagdollCore::tuned<std::array<float, 2>>([] {
                std::array<float, 2> v{ 0.0f, 0.25f };
                if (const char* text = RagdollCore::tuningText("OPENMW_RAGDOLL_WEAPON_TORQUE"))
                    std::sscanf(text, "%f,%f", &v[0], &v[1]);
                v[0] = std::clamp(v[0], 0.0f, 0.95f);
                v[1] = std::max(0.02f, v[1]);
                return v;
            });
            static const auto& value = value_tuned.get();
            return value;
        }
        std::optional<JPH::RVec3> mImpactPoint;
        float mImpactTwistYield = 1.0f; // the weapon drive's share after a struck lever (C2)
        void stepWeaponImpact(float duration, JPH::BodyInterface& bodies)
        {
            mImpactRecoil = std::max(0.0f, mImpactRecoil - duration);
            mImpactTwistYield = std::min(1.0f, mImpactTwistYield + duration / weaponTorqueSettings()[1]);
            if (!mWeapon || !mWeapon->mAttached || !mRagdoll || mWeapon->mWeaponBody >= mRagdoll->getBodyCount())
            {
                mImpactFreeze = 0.0f;
                mImpactBounce = JPH::Vec3::sZero();
                return;
            }
            const JPH::BodyID weapon = mRagdoll->getBodyId(mWeapon->mWeaponBody);
            const std::optional<JPH::BodyID> hand = mWeapon->mHandBody < mRagdoll->getBodyCount()
                ? std::optional(mRagdoll->getBodyId(mWeapon->mHandBody))
                : std::nullopt;
            if (mImpactFreeze > 0.0f)
            {
                if (!mImpactHeld)
                {
                    mImpactHeld = true;
                    mImpactMotion = { bodies.GetLinearVelocity(weapon), bodies.GetAngularVelocity(weapon),
                        hand ? bodies.GetLinearVelocity(*hand) : JPH::Vec3::sZero(),
                        hand ? bodies.GetAngularVelocity(*hand) : JPH::Vec3::sZero() };
                }
                mImpactFreeze -= duration;
                for (const auto& id : { std::optional(weapon), hand })
                    if (id)
                    {
                        bodies.SetLinearVelocity(*id, JPH::Vec3::sZero());
                        bodies.SetAngularVelocity(*id, JPH::Vec3::sZero());
                    }
                if (mImpactFreeze > 0.0f)
                    return;
                mImpactFreeze = 0.0f;
            }
            const bool wasHeld = mImpactHeld;
            mImpactHeld = false;
            if (mImpactBounce.IsNearZero())
            {
                // Through flesh: the blow goes on at 70% of its speed.
                if (wasHeld)
                {
                    constexpr float carry = 0.7f;
                    bodies.SetLinearVelocity(weapon, mImpactMotion[0] * carry);
                    bodies.SetAngularVelocity(weapon, mImpactMotion[1] * carry);
                    if (hand)
                    {
                        bodies.SetLinearVelocity(*hand, mImpactMotion[2] * carry);
                        bodies.SetAngularVelocity(*hand, mImpactMotion[3] * carry);
                    }
                    if (mTip.mActive)
                    {
                        mTip.mAzRate = mImpactRateAz * carry;
                        mTip.mElRate = mImpactRateEl * carry;
                    }
                }
                mImpactHardness = 0.0f;
                return;
            }
            if (mImpactPoint && weaponTorqueSettings()[0] > 0.0f)
                bodies.AddImpulse(weapon, mImpactBounce, *mImpactPoint);
            else
                bodies.AddImpulse(weapon, mImpactBounce);
            mImpactPoint.reset();
            if (hand)
                bodies.AddImpulse(*hand, mImpactBounce * 0.3f);
            // The command swings back along the way it came, at a share of
            // its incoming rate by the surface's hardness, and eases out.
            static const auto recoil_tuned = RagdollCore::tuned<std::array<float, 2>>([] {
                std::array<float, 2> value{ 0.25f, 0.8f };
                if (const char* text = RagdollCore::tuningText("OPENMW_RAGDOLL_IMPACT_RECOIL"))
                    std::sscanf(text, "%f,%f", &value[0], &value[1]);
                return value;
            });
            static const auto& recoil = recoil_tuned.get();
            if (mTip.mActive && recoil[0] > 0.0f)
            {
                mTip.mAzRate = -mImpactRateAz * recoil[1] * mImpactHardness;
                mTip.mElRate = -mImpactRateEl * recoil[1] * mImpactHardness;
                mImpactRecoil = recoil[0] * mImpactHardness;
                mTip.mCommitTimer = 0.0f;
                // A bounce ends the stroke: no slip on through the armour.
                mTip.mSlipArmed = false;
                mTip.mSlipRecovery = mTip.mSlipAz = mTip.mSlipEl = 0.0f;
                if (mTip.mMode == TipController::Mode::Strike)
                    mTip.mMode = TipController::Mode::Guard;
            }
            mImpactBounce = JPH::Vec3::sZero();
            mImpactHardness = 0.0f;
        }
        // What the tip controller wants this step (world): the weapon drive's
        // target and the recorder's commanded tip.
        JPH::RVec3 mTipDesiredGrip = JPH::RVec3::sZero();
        JPH::RVec3 mTipDesiredTip = JPH::RVec3::sZero();
        std::optional<JPH::Quat> mTipDesiredRotation;
        bool mTipOrients = true;
        static bool tipControllerEnabled()
        {
            static const auto enabled_tuned = RagdollCore::tuned<bool>([] { return weaponDriveSetting("OPENMW_RAGDOLL_TIP_CONTROLLER", 1.0f) > 0.0f; });
            static const auto& enabled = enabled_tuned.get();
            return enabled;
        }
        struct TipFrame
        {
            JPH::RVec3 mPivot;
            JPH::Vec3 mRight, mForward, mUp;
            JPH::Vec3 direction(float az, float el) const
            {
                return mRight * (std::sin(az) * std::cos(el)) + mForward * (std::cos(az) * std::cos(el))
                    + mUp * std::sin(el);
            }
            std::pair<float, float> angles(JPH::Vec3Arg d) const
            {
                const JPH::Vec3 n = d.NormalizedOr(mForward);
                return { std::atan2(n.Dot(mRight), n.Dot(mForward)),
                    std::asin(std::clamp(n.Dot(mUp), -1.0f, 1.0f)) };
            }
        };
        // Two-handed and spear grips: both hands on the haft.
        bool narrowGrip() const { return mWeapon && mWeapon->mAttached && (mWeapon->mTwoHanded || mWeapon->mWideSpearGrip); }
        TipFrame tipFrame() const
        {
            TipFrame frame;
            const float yaw = getPtr().getRefData().getPosition().rot[2];
            frame.mForward = JPH::Vec3(std::sin(yaw), std::cos(yaw), 0.0f);
            // The body's turn is rate limited (max_yaw_rate); the actor's
            // facing follows the mouse at once. Aiming in the actor's frame
            // swung the goal with every mouse flick while the body lagged,
            // and a claymore whipped round a full turn (user bookmarks
            // 2026-10-01, facing 560 deg/s against the body's 240).
            // OPENMW_RAGDOLL_TIP_BODY_FRAME=0 = the actor's facing.
            static const auto bodyFrame_tuned = RagdollCore::tuned<bool>([] { return weaponDriveSetting("OPENMW_RAGDOLL_TIP_BODY_FRAME", 1.0f) > 0.0f; });
            static const auto& bodyFrame = bodyFrame_tuned.get();
            if (bodyFrame && mKinematicRootFollowedRotation)
            {
                JPH::Vec3 forward = *mKinematicRootFollowedRotation * JPH::Vec3::sAxisY();
                forward.SetZ(0.0f);
                if (forward.LengthSq() > 0.25f)
                    frame.mForward = forward.Normalized();
            }
            frame.mUp = JPH::Vec3::sAxisZ();
            frame.mRight = frame.mForward.Cross(frame.mUp);
            const osg::Vec3f position = getPtr().getRefData().getPosition().asVec3();
            frame.mPivot = JPH::RVec3(position.x(), position.y(), position.z() + mTip.mPivotHeight - tipPivotDrop());
            return frame;
        }
        unsigned mTipTraceRows = 0;
        unsigned mTraceRowsLeft = 0;
        bool mTraceHeld = false;
        // 2b: one row per stroke (swing identity) for OPENMW_RAGDOLL_SWING_TRACE:
        // how fast the command and the physical tip went and how much the
        // drag governor braked.
        struct StrokeTrace
        {
            std::uint64_t mSwing = 0;
            float mTime = 0.0f, mCommandPeak = 0.0f, mPhysicalPeak = 0.0f, mGovernMin = 1.0f, mGapMax = 0.0f;
            unsigned mModes = 0;
            std::optional<JPH::RVec3> mLastTip;
        } mStrokeTrace;
        float mTipGovernScale = 1.0f;
        // Physical tip to commanded tip, units, last step.
        float mTipGap = 0.0f;
        // Committed strokes since start; the game thread plays one swish per new one.
        // Blade-on-blade and blade-on-shield bounces this body's weapon made.
        unsigned mParryBounceCount = 0;
        unsigned mGlancingBlows = 0;
        unsigned mSelfStaggers = 0; // committed strokes that took the swinger's own balance
        // Death watch: the root body's position when the body died, and the step.
        std::optional<JPH::RVec3> mDeathWatchStart;
        std::uint64_t mDeathWatchStep = 0; // physical blows the hit roll turned aside
        int mDeathDragSteps = 0; // steps left of the corpse's slide drag (DEATH_DRAG)
        // Death watch, drawn: the actor's position at death, the drawn root
        // bone's first offset from its physics place and the largest change
        // of that offset since (units; the corpse dragged by its actor).
        std::optional<osg::Vec3f> mDeathWatchActorStart;
        std::optional<osg::Vec3f> mDeathDrawnOrigin;
        float mDeathDrawnOff = 0.0f;
        JPH::Vec3 mRenderShift = JPH::Vec3::sZero(); // this frame's render pose shift (world, RENDER_REBASE)
        unsigned mCommitSwishRequests = 0;
        unsigned mCommitSwishPlayed = 0;
        // SND-01 swing voice (game thread): armed until the tip passes the
        // whoosh speed; the whoosh playing, its record, age and peak speed.
        bool mSwingVoiceArmed = true;
        MWSound::Sound* mSwingVoice = nullptr;
        ESM::RefId mSwingVoiceId;
        float mSwingVoiceAge = 1.0e9f;
        float mSwingVoicePeak = 0.0f;
        std::uint64_t mSwingVoiceSwing = ~std::uint64_t(0); // the swing that last whooshed
        // Mouse travel (aim units, + right) a held drag asked for past the
        // grip's side limit; the game thread turns the player by it.
        float mTipEdgeOverflow = 0.0f;
        // 0..1: how big the stroke that last committed was (its mouse-driven
        // goal speed from the commit rate to twice it and more).
        float mCommitSwishSize = 1.0f;
        float mCommitFatigue = 1.0f; // the attack fatigue the last committed cut pays (HSC_CHAIN_FLOW)
        bool mFistClipLogged = false;
        void endTipControl(const RagdollCore::WeaponSwingProfile& profile, const RagdollCore::RagdollProfile& rigProfile)
        {
            if (!mTip.mActive)
                return;
            if (mRightArm && mSwingMotorsActive)
                requestArmMotors(rigProfile, *mRightArm, profile, false);
            mSwingMotorsActive = false;
            if (mRightArmTarget && !mRightArmTarget->mBrace)
                mRightArmTarget->mReleasing = true;
            mTipDirection.reset();
            mSwing = {};
            mTip = {};
        }
        // Returns true while it owns the player's weapon arm this step.
        bool stepPlayerTipControl(float duration, const RagdollCore::WeaponSwingProfile& profile,
            const RagdollCore::RagdollProfile& rigProfile)
        {
            const MWWorld::Ptr actor = getPtr();
            const bool recovering = mControllerOutput
                && !RagdollCore::isDrivenControllerMode(mControllerOutput->mMode);
            // Bare hands too: the drag steers the right hand (spec 2.1).
            static const auto fists_tuned = RagdollCore::tuned<bool>([] { return weaponDriveSetting("OPENMW_RAGDOLL_TIP_FISTS", 1.0f) > 0.0f; });
            static const auto& fists = fists_tuned.get();
            const bool bare = !mWeapon || !mWeapon->mAttached;
            // NPCs attack through the same controller (plan phase 4):
            // OPENMW_RAGDOLL_TIP_NPC=1. Their quick attacks start with the
            // attack clip and aim at the AI's strike point; no mouse.
            // On by default since alpha 0.4 item 3 (DUEL-W01: NPC blades flailed
            // between strikes, 64-80% of the time over 600 u/s relative to the
            // chest; 3-15% on the tip controller).
            static const auto npcTip_tuned = RagdollCore::tuned<bool>([] { return weaponDriveSetting("OPENMW_RAGDOLL_TIP_NPC", 1.0f) > 0.0f; });
            static const auto& npcTip = npcTip_tuned.get();
            const bool player = actor == MWMechanics::getPlayer();
            // Armed NPCs only: NPC fists through it lost the unarmed duel
            // to the death (DUEL-A03 timed out).
            // Short blades stay on the animation-driven arm: on the tip
            // controller NPC daggers landed 1-5 blows a duel against 10-11
            // (DUEL-A02, alpha 0.4 item 3); the flailing was the long weapons'.
            const bool npcLong = !bare && mWeapon->tipDistanceFromHand() > 30.0f;
            // The player's short blades on the hand drive (alpha 0.6 item 5,
            // user 2026-09-30: "it was wrist control rather than tip control
            // that I enjoyed" with the dagger): the drag moves the hand and
            // the wrist carries the blade (with HSC_DAGGER the wheel has them).
            const bool playerTip = player && (bare || npcLong);
            // A click with bare fists plays the vanilla punch clip and the arm
            // follows it with the attack drive, as NPC brawlers do (user
            // 2026-10-01, instead of the tip controller's straight jab). A drag
            // still steers the fist. OPENMW_RAGDOLL_FIST_CLICK_ANIM=0 = the jab.
            static const auto fistClickAnim_tuned = RagdollCore::tuned<bool>([] { return weaponDriveSetting("OPENMW_RAGDOLL_FIST_CLICK_ANIM", 1.0f) > 0.0f; });
            static const auto& fistClickAnim = fistClickAnim_tuned.get();
            const bool fistClip = player && bare && fistClickAnim
                && (mAnimationAttack.mPhase != MWMechanics::RagdollAttackPhase::Idle || mAnimationAttackMotors)
                && !(mTip.mActive && mTip.mMode == TipController::Mode::Drag);
            if (fistClip != mFistClipLogged)
            {
                mFistClipLogged = fistClip;
                Log(Debug::Info) << "RAGDOLL_FIST_CLIP " << (fistClip ? "start" : "end") << " phase="
                                 << static_cast<int>(mAnimationAttack.mPhase) << " type=" << mAnimationAttack.mAttackType;
            }
            const bool eligible = tipControllerEnabled() && (playerTip || (!player && npcTip && npcLong)) && !rangedWeaponDrawn() && mPowered && mRagdoll
                && !fistClip
                && (!bare || fists) && mRightArm && mCurrentPhysicsPoseCaptured && !recovering
                && mControllerOutput && mRagdoll->isRootKinematic()
                // A test fixture's arm yaw owns the arm (WPN-01, DEF-01).
                && !mWeaponFixtureYaw
                && actor.getClass().getCreatureStats(actor).getDrawState() == MWMechanics::DrawState::Weapon;
            if (!eligible)
            {
#ifdef OPENMW_RAGDOLL_DEV_API
                static const auto traceTip_tuned = RagdollCore::tuned<bool>([] { return RagdollCore::tuningText("OPENMW_RAGDOLL_TIP_TRACE") != nullptr; });
                static const auto& traceTip = traceTip_tuned.get();
                if (traceTip && !player && mTipTraceRows < 20)
                {
                    ++mTipTraceRows;
                    Log(Debug::Info) << "RAGDOLL_TIP_INELIGIBLE actor=" << actor.getCellRef().getRefId()
                                     << " enabled=" << tipControllerEnabled() << " npcTip=" << npcTip
                                     << " bare=" << bare << " powered=" << mPowered << " arm=" << mRightArm.has_value()
                                     << " pose=" << mCurrentPhysicsPoseCaptured << " recovering=" << recovering
                                     << " output=" << mControllerOutput.has_value()
                                     << " rootKin=" << (mRagdoll && mRagdoll->isRootKinematic())
                                     << " fixture=" << mWeaponFixtureYaw.has_value()
                                     << " draw=" << static_cast<int>(actor.getClass().getCreatureStats(actor).getDrawState());
                }
#endif
                endTipControl(profile, rigProfile);
                return false;
            }
            const ESM::Weapon* record = nullptr;
            if (actor.getClass().hasInventoryStore(actor))
            {
                const auto& inventory = actor.getClass().getInventoryStore(actor);
                const auto slot = inventory.getSlot(MWWorld::InventoryStore::Slot_CarriedRight);
                if (slot != inventory.end() && slot->getType() == ESM::Weapon::sRecordId)
                    record = slot->get<ESM::Weapon>()->mBase;
            }
            const auto geometry = mRagdoll->getHingeLegGeometry(mRightArm->mShoulder, mRightArm->mElbow, mRightArm->mHand);
            const auto reach = geometry ? RagdollCore::hingeChainReachRange(*geometry) : std::nullopt;
            const auto unit = mRagdoll->getWorldVector(JPH::Vec3::sAxisX());
            const auto hand = mRagdoll->getWorldBodyPosition(mCurrentPhysicsPose, mRightArm->mHand);
            const auto handRotation = mRagdoll->getWorldBodyRotation(mCurrentPhysicsPose, mRightArm->mHand);
            const auto rightShoulder = mRagdoll->getWorldBodyPosition(mCurrentPhysicsPose, mRightArm->mShoulder);
            const auto leftShoulder = mLeftArm
                ? mRagdoll->getWorldBodyPosition(mCurrentPhysicsPose, mLeftArm->mShoulder) : std::nullopt;
            if (!reach || !unit || !hand || !handRotation || !rightShoulder)
            {
                endTipControl(profile, rigProfile);
                return false;
            }
            const float armReach = reach->second * unit->Length();
            const float tipDistance = bare ? 0.0f : std::max(mWeapon->tipDistanceFromHand(), 0.0f);
            static const auto handFraction_tuned = RagdollCore::tuned<float>([] { return weaponDriveSetting("OPENMW_RAGDOLL_TIP_HAND", 0.8f); });
            static const auto& handFraction = handFraction_tuned.get();
            const float nominalRadius = tipDistance + handFraction * armReach;
            // Weapons longer than a short blade keep the arm at least this
            // extended (replays: warhammer tracking p90 79 -> 22 units, jitter
            // 0.086 -> 0.005); the grip-steered dagger tracked worse (17 -> 40).
            static const auto handMinLong_tuned = RagdollCore::tuned<float>([] { return weaponDriveSetting("OPENMW_RAGDOLL_TIP_HAND_MIN", 0.55f); });
            static const auto& handMinLong = handMinLong_tuned.get();
            const float handMin = tipDistance > 30.0f ? handMinLong : 0.35f;
            if (!mTip.mActive)
            {
                // Start from the weapon as it is (spec 2.3, 7.1).
                const JPH::RVec3 middle = leftShoulder ? *rightShoulder + (*leftShoulder - *rightShoulder) * 0.5
                                                       : *rightShoulder;
                const osg::Vec3f position = actor.getRefData().getPosition().asVec3();
                mTip = {};
                mTip.mPivotHeight = static_cast<float>(middle.GetZ()) - position.z();
                const TipFrame frame = tipFrame();
                const JPH::RVec3 tip = bare ? *hand : *hand + JPH::RVec3(*handRotation * mWeapon->mBladeAxis * tipDistance);
                const auto [az, el] = frame.angles(JPH::Vec3(tip - frame.mPivot));
                mTip.mAz = mTip.mGoalAz = az;
                mTip.mEl = mTip.mGoalEl = el;
                mTip.mRadius = mTip.mGoalRadius = nominalRadius;
                mTip.mActive = true;
                mTip.mAttackIdle = mAnimationAttack.mPhase == MWMechanics::RagdollAttackPhase::Idle;
                requestArmMotors(rigProfile, *mRightArm, profile, true);
                mSwingMotorsActive = true;
            }
            // Every step: a drag input arriving during a native attack cancels
            // it and puts the arm back on its hold budget behind our back
            // (driveRagdollWeaponSwing), and the spear then hung 20 units low.
            // OPENMW_RAGDOLL_TIP_ARM_MOTORS=1 keeps the stiff swing drive on the arm;
            // 0 leaves it on its authored hold budget so the weapon drive leads
            // and the arm follows through the grip instead of fighting it.
            static const auto stiffArm_tuned = RagdollCore::tuned<bool>([] { return weaponDriveSetting("OPENMW_RAGDOLL_TIP_ARM_MOTORS", 1.0f) > 0.0f; });
            static const auto& stiffArm = stiffArm_tuned.get();
            requestArmMotors(rigProfile, *mRightArm, profile, stiffArm);
            mSwingMotorsActive = true;
            const TipFrame frame = tipFrame();
            if (!player)
            {
                // An NPC's "crosshair" is its strike target: an eye ray from
                // between its shoulders to the AI's aim point (or straight
                // ahead), and no drag input.
                const JPH::RVec3 eye = leftShoulder ? *rightShoulder + (*leftShoulder - *rightShoulder) * 0.5 : *rightShoulder;
                mSwingAimRayOrigin = eye + JPH::RVec3(frame.mUp * 12.0f);
                mSwingAimRayDirection = mAiStrikeAimPoint
                    ? JPH::Vec3(*mAiStrikeAimPoint - *mSwingAimRayOrigin).NormalizedOr(frame.mForward)
                    : frame.mForward;
                mPlayerStrikeAimPoint = mAiStrikeAimPoint;
                mSwingInput.mAimRight = mSwingInput.mAimUp = 0.0f;
                mSwingInput.mHeld = false;
                mNativeStrikeInput = false;
                mNativeStrikePressLatch = false;
            }
            const float weight = record ? std::max(0.0f, record->mData.mWeight) : 0.0f;
            const float speed = !bare && std::isfinite(mWeapon->mItemSpeed) && mWeapon->mItemSpeed > 0.0f ? mWeapon->mItemSpeed : 1.0f;
            static const auto omegaBase_tuned = RagdollCore::tuned<float>([] { return weaponDriveSetting("OPENMW_RAGDOLL_TIP_OMEGA", 16.0f); });
            static const auto& omegaBase = omegaBase_tuned.get();
            static const auto alphaBase_tuned = RagdollCore::tuned<float>([] { return weaponDriveSetting("OPENMW_RAGDOLL_TIP_ALPHA", 300.0f); });
            static const auto& alphaBase = alphaBase_tuned.get();
            // From the record: spear 155, staff 342 rad/s^2 ("spear dragging is
            // slower than staff", play test 2026-09-23). OPENMW_RAGDOLL_TIP_ALPHA_MIN
            // floors it for every weapon (0 = the record alone); 250 since
            // 2026-09-24 ("spear dragging is still a bit slow": spear G8
            // 1 -> 3 of 5, all stress gates 139 -> 144 of 432).
            static const auto alphaMin_tuned = RagdollCore::tuned<float>([] { return weaponDriveSetting("OPENMW_RAGDOLL_TIP_ALPHA_MIN", 250.0f); });
            static const auto& alphaMin = alphaMin_tuned.get();
            // DMG-04: skill as control. A less skilled hand swings slower and
            // its aim wanders (below), so the blade glances or misses on its
            // own; full control (1) is the tuned drive.
            const float control = std::clamp(mWeaponControl, 0.2f, 1.0f);
            const float alpha = std::max(alphaMin, alphaBase / (1.0f + weight / 15.0f) * speed) * (0.6f + 0.4f * control);
            // Not scaled by the record's speed: a 1.5-speed dagger commanded 18
            // rad/s and its blade turned more than 20 degrees a step (G1).
            float omega = omegaBase * (0.7f + 0.3f * control);
            // Committed swings (2b, user 2026-09-28: "wind up - moving the mouse
            // fast enough = commit a swing"; swings felt slow and stopped dead).
            // Drags asked for about 3x the 16 rad/s cap (claymore command p50
            // 1720 units/s at the cap, physical tip 1.07 of it), so the cap and
            // not the body limited them. OPENMW_RAGDOLL_TIP_COMMIT="rate,omega,
            // alpha x,through deg,hold s"; rate 0 turns it off.
            static const auto commit_tuned = RagdollCore::tuned<std::array<float, 5>>([] {
                std::array<float, 5> v{ 20.0f, 26.0f, 2.0f, 35.0f, 0.25f };
                if (const char* text = RagdollCore::tuningText("OPENMW_RAGDOLL_TIP_COMMIT"))
                    std::sscanf(text, "%f,%f,%f,%f,%f", &v[0], &v[1], &v[2], &v[3], &v[4]);
                return v;
            });
            static const auto& commit = commit_tuned.get();
            // A drag released mid-commit keeps the committed speed through its
            // carry (Strike); a click's strike never has a commit timer.
            // (A click's strike at committed speed returned to the guard while
            // the blade still travelled - FIX-08 clicks 0 strikes; removed 10-12.)
            const bool committed = commit[0] > 0.0f && mTip.mCommitTimer > 0.0f
                && (mTip.mMode == TipController::Mode::Drag || mTip.mMode == TipController::Mode::Strike);
            // Screen travel: about 1500 counts (5.9 aim units at the default
            // camera sensitivity) sweep the 180-degree arc (spec 2.4).
            static const float perUnit = osg::PIf / (1500.0f / 256.0f);
            // A two-handed or spear grip cannot carry the blade as far across
            // the body: past about -75 degrees the support arm is at its reach
            // and the goal only ran into a dead zone (WRIST-01: the command
            // 18-47 units from the tip at -100). The goal stops at the grip's
            // edge instead. OPENMW_RAGDOLL_TIP_NARROW_LEFT degrees (-88 = old).
            static const auto narrowLeft_tuned = RagdollCore::tuned<float>([] { return weaponDriveSetting("OPENMW_RAGDOLL_TIP_NARROW_LEFT", -75.0f); });
            static const auto& narrowLeft = narrowLeft_tuned.get();
            const float leftLimit = osg::DegreesToRadians(narrowGrip() ? narrowLeft : -88.0f);
            // Two-handed grips reach less far to the right as well (play
            // 2026-09-30: the claymore tip sat 80-107 under a 110 goal).
            // OPENMW_RAGDOLL_TIP_NARROW_RIGHT degrees (110 = old; 90 gave no
            // steadier edge in EDGE-01).
            static const auto narrowRight_tuned = RagdollCore::tuned<float>([] { return weaponDriveSetting("OPENMW_RAGDOLL_TIP_NARROW_RIGHT", 110.0f); });
            static const auto& narrowRight = narrowRight_tuned.get();
            const float rightLimit = osg::DegreesToRadians(narrowGrip() ? narrowRight : 110.0f);
            // A held two-handed drag stops where the support arm folds (user
            // bookmarks 17-18: from ~85 degrees right the left elbow sat on its
            // flexion stop, both arms folded, the chest over-twisted 53 against
            // 35 and the claymore swung 50 degrees at 3-4 Hz under a goal at
            // 110). Past it the edge turn turns the body, as at the left edge.
            // Committed strokes, clicks and strikes keep rightLimit.
            // OPENMW_RAGDOLL_TIP_NARROW_DRAG_RIGHT degrees (0 = rightLimit).
            static const auto narrowDragRight_tuned = RagdollCore::tuned<float>([] { return weaponDriveSetting("OPENMW_RAGDOLL_TIP_NARROW_DRAG_RIGHT", 75.0f); });
            static const auto& narrowDragRight = narrowDragRight_tuned.get();
            // Low enough for the tip to reach knee height (spec 3.2).
            // An NPC striking a target lower than that (a downed foe, user
            // 2026-09-30: "enemies should be able to hit the player while he's
            // down") reaches down to the target's height, not below 5 units.
            float lowReach = 35.0f;
            if (!player && mAiStrikeAimPoint)
            {
                const float aimHeight = static_cast<float>(mAiStrikeAimPoint->GetZ())
                    - actor.getRefData().getPosition().pos[2];
                lowReach = std::clamp(aimHeight - 5.0f, 5.0f, 35.0f);
            }
            const float lowLimit = -std::asin(std::clamp((mTip.mPivotHeight - lowReach) / std::max(nominalRadius, 1.0f), 0.5f, 0.97f));
            const PoseMap* dragMap = mTip.mActive ? activePoseMap(bare) : nullptr;
            const float highLimit = osg::DegreesToRadians(dragMap ? dragMap->mEl.back() : 75.0f);
            // The tip at 30 degrees above the chest puts the blade (grip to tip)
            // about 45 degrees up, spec 6.1.
            // 20 since the low rest grip (2026-09-26): with the hands at the
            // waist, 36 stood a warhammer upright in front of the face.
            static const auto guardEl_tuned = RagdollCore::tuned<float>([] { return osg::DegreesToRadians(weaponDriveSetting("OPENMW_RAGDOLL_TIP_GUARD_ELEVATION", 20.0f)); });
            static const auto& guardEl = guardEl_tuned.get();
            // The lever geometry leaves the blade about 9 degrees left of the tip.
            static const auto guardAz_tuned = RagdollCore::tuned<float>([] { return osg::DegreesToRadians(weaponDriveSetting("OPENMW_RAGDOLL_TIP_GUARD_AZIMUTH", 9.0f)); });
            static const auto& guardAz = guardAz_tuned.get();

            // No low tip behind the weapon shoulder or far across the body:
            // the arm cannot follow it there (dagger: 45-degree blade jumps in
            // a vertical sweep behind the shoulder). Behind 45 degrees right
            // the floor rises to level by 90; across the body past -60 it
            // rises to -30 degrees.
            const auto lowFor = [&](float az) {
                const float back = std::clamp((az - osg::DegreesToRadians(45.0f)) / osg::DegreesToRadians(45.0f), 0.0f, 1.0f);
                const float across = std::clamp((osg::DegreesToRadians(-60.0f) - az) / osg::DegreesToRadians(28.0f), 0.0f, 1.0f);
                return std::max({ lowLimit, lowLimit + (0.0f - lowLimit) * back,
                    lowLimit + (osg::DegreesToRadians(-30.0f) - lowLimit) * across });
            };
            // A click pressed and released between two physics steps is
            // still a press (HIT-02: same-frame clicks barely moved the fist).
            const bool held = (mNativeStrikeInput ? mNativeStrikeHeld : mSwingInput.mHeld) || mNativeStrikePressLatch;
            mNativeStrikePressLatch = false;
            const float dx = mSwingInput.mAimRight, dy = mSwingInput.mAimUp;
            mSwingInput.mAimRight = mSwingInput.mAimUp = 0.0f;
            const bool attackIdle = player ? mAnimationAttack.mPhase == MWMechanics::RagdollAttackPhase::Idle
                                           : !mAiAttackIntent;
            const bool attackStarted = mTip.mAttackIdle && !attackIdle;
            mTip.mAttackIdle = attackIdle;
            mTip.mTimer += duration;
            const auto reached = [&](float az, float el) {
                return std::hypot(mTip.mAz - az, mTip.mEl - el) < osg::DegreesToRadians(8.0f);
            };
            // Charged release (OPENMW_RAGDOLL_TIP_CHARGE, not in spec v0.2; the
            // user's play tests asked for it): a release after a held drag
            // with the weapon wound up well away from the crosshair strikes
            // from there through the crosshair, like a quick attack without
            // its wind-up.
            static const auto chargeEnabled_tuned = RagdollCore::tuned<bool>([] { return weaponDriveSetting("OPENMW_RAGDOLL_TIP_CHARGE", 0.0f) > 0.0f; });
            static const auto& chargeEnabled = chargeEnabled_tuned.get();
            bool charge = false;
            // A press that is not a drag: the thrust button, or a hold released
            // that ends where it started (Morrowind's hold-and-release attack;
            // jitter that cancels out is not a swing).
            // Both used to leave the weapon in its guard: the held press became
            // a motionless drag, and thrusts were not implemented (FIX-08:
            // fists and dagger 0 of 3). OPENMW_RAGDOLL_TIP_HOLD_ATTACK=0 keeps
            // a motionless hold harmless.
            static const auto holdAttack_tuned = RagdollCore::tuned<bool>([] { return weaponDriveSetting("OPENMW_RAGDOLL_TIP_HOLD_ATTACK", 1.0f) > 0.0f; });
            static const auto& holdAttack = holdAttack_tuned.get();
            bool launch = false;
            bool thrust = false;
            // A press starts from the blade where it really is, when that is
            // far from the command. At rest the grip and wrist hold the blade
            // upright like the Mixamo guard while the command kept its guard
            // angles - 133 units away with the claymore (p50 at a press in
            // play; warhammer 58, staff 44, longsword 43, spear 35, dagger 4) -
            // so a claymore drag began by swinging the blade where the mouse
            // had not asked (aiming review 2026-09-30: cosine 0.34 over the
            // first 0.2 s). Seated at every press, the short blades got worse
            // (AIM-02: dagger 0.40 -> 0, longsword 0.96 -> 0.83).
            // OPENMW_RAGDOLL_TIP_SEAT_ON_PRESS = the gap in units above which
            // a press seats (0 = never).
            static const auto seatGap_tuned = RagdollCore::tuned<float>([] { return weaponDriveSetting("OPENMW_RAGDOLL_TIP_SEAT_ON_PRESS", 60.0f); });
            static const auto& seatGap = seatGap_tuned.get();
            const auto seatOnBlade = [&](bool position) {
                // The wander of a less skilled hand (up to 30 degrees, parts of
                // it at 2 Hz) was added to the goal from the first step, so the
                // command left the blade toward it, not the mouse (AIM-02
                // trace: a press moved the dagger's command 6.7 degrees up for
                // a mouse step of 4). It restarts from every press instead.
                const auto [wanderAz, wanderEl] = controlWander();
                const float wander = (1.0f - std::clamp(mWeaponControl, 0.2f, 1.0f)) * osg::DegreesToRadians(30.0f);
                mTip.mWanderBaseAz = wander * wanderAz;
                mTip.mWanderBaseEl = wander * wanderEl;
                if (!position || !(seatGap > 0.0f))
                    return;
                const JPH::RVec3 physicalTip
                    = bare ? *hand : *hand + JPH::RVec3(*handRotation * mWeapon->mBladeAxis * tipDistance);
                const JPH::RVec3 commanded = frame.mPivot + JPH::RVec3(frame.direction(mTip.mAz, mTip.mEl) * mTip.mRadius);
                if ((physicalTip - commanded).Length() < seatGap)
                    return;
                const JPH::Vec3 offset(physicalTip - frame.mPivot);
                const auto [az, el] = frame.angles(offset);
                mTip.mAz = std::clamp(az, leftLimit, rightLimit);
                mTip.mEl = std::clamp(el, lowLimit, highLimit);
                mTip.mRadius = offset.Length();
                mTip.mAzRate = mTip.mElRate = 0.0f;
            };
            mTip.mHoldTime = held ? mTip.mHoldTime + duration : mTip.mHoldTime;
            if (held && !mTip.mHeld && mNativeStrikeInput && mNativeThrust)
            {
                // A thrust goes straight to its wind-up on the aim line; seated,
                // the guided claymore thrust landed 2 of 3 (FIX-08, 3 of 3 before).
                seatOnBlade(false);
                launch = thrust = true;
                mTip.mMode = TipController::Mode::Guard;
            }
            else if (held && !mTip.mHeld)
            {
                // A press starts a drag where the weapon is.
                seatOnBlade(true);
                mTip.mHoldTime = 0.0f;
                mTip.mMode = TipController::Mode::Drag;
                mTip.mGoalAz = mTip.mAz;
                mTip.mGoalEl = mTip.mEl;
                mTip.mGoalRadius = nominalRadius;
                mTip.mDragStartAz = mTip.mAz;
                mTip.mDragStartEl = mTip.mEl;
                mTip.mDragStartRadius = mTip.mRadius;
                mTip.mDragSettle = 1.0f;
                mTip.mStrokeRate = mTip.mCommitTimer = 0.0f;
                // A new press starts without the last stroke's slip.
                mTip.mSlipArmed = false;
                mTip.mSlipRecovery = mTip.mSlipAz = mTip.mSlipEl = 0.0f;
                mTip.mGuided = false;
                mSwing = {};
                ++mSwingIdentity;
                mPlayerAttackType = "slash";
            }
            else if (!held && mTip.mHeld && mTip.mMode == TipController::Mode::Drag
                && holdAttack
                && std::hypot(mTip.mGoalAz - mTip.mDragStartAz, mTip.mGoalEl - mTip.mDragStartEl)
                    < osg::DegreesToRadians(12.0f))
            {
                launch = true;
                mTip.mMode = TipController::Mode::Guard;
            }
            else if (!held && mTip.mHeld && mTip.mMode == TipController::Mode::Drag)
            {
                // A committed swing carries through: a release while the weapon
                // is still travelling to where the mouse sent it finishes that
                // stroke (at most 0.35 s) before drifting back to the guard.
                // Returning at once cut every short swing before full speed
                // (G8, rhythm swings: heavy weapons 620-930 units/s).
                if (committed)
                {
                    mTip.mGoalAz = std::clamp(mTip.mGoalAz + mTip.mCommitAz * osg::DegreesToRadians(commit[3]), leftLimit, rightLimit);
                    mTip.mGoalEl = std::clamp(mTip.mGoalEl + mTip.mCommitEl * osg::DegreesToRadians(commit[3]), lowLimit, highLimit);
                }
                const float remaining = std::hypot(mTip.mGoalAz - mTip.mAz, mTip.mGoalEl - mTip.mEl);
                mTip.mMode = remaining > osg::DegreesToRadians(20.0f) ? TipController::Mode::Strike
                                                                        : TipController::Mode::Guard;
                // The stance the drag was released in (see TIP_STANCES). Low
                // below 8 degrees: in front the tip stops at the floor limit
                // (about 0), so the old -5 never chose the low guard
                // (STANCE-01: a drag to -55 ended at 0.04 degrees, middle).
                mTip.mStance = mTip.mGoalEl > osg::DegreesToRadians(40.0f) ? 1
                    : mTip.mGoalEl < osg::DegreesToRadians(8.0f)           ? 2
                                                                           : 0;
                mTip.mReleasedDrag = !committed;
                mTip.mTimer = std::max(0.0f, 1.0f / speed - 0.35f);
                charge = chargeEnabled && !bare && mTip.mHoldTime >= 0.3f;
            }
            mTip.mHeld = held;
            // One aim path for clicks (aiming review 2026-09-30). It replaces
            // three: a target in reach was commanded as the tip itself, the
            // bare crosshair ray was solved for the tip, and both were nudged
            // a fixed 9 degrees right for the lever. Now the blade's sweet
            // spot, OPENMW_RAGDOLL_TIP_SWEET of the way from the grip to the
            // tip, is put on the target through the lever the drive builds
            // (the grip on the shoulder's line to the commanded tip, a little
            // below it). Thrusts and punches drive the tip itself through the
            // target. The target stays in the world and is solved again every
            // step of the wind-up (the body turns and steps meanwhile), and
            // the strike keeps to the line from where it started through the
            // aim (see Strike). A target out of the sweet spot's reach is
            // swapped for the crosshair's point at that reach.
            // OPENMW_RAGDOLL_TIP_AIM_SOLVE=1; off by default: AIM-01 (7 loadouts
            // x 5 placements, 2 runs each) landed 87% either way, median miss
            // 26.1 vs 26.8 units, 75 vs 84 strikes, and third person 80% vs
            // 95% landed - no gain over the old paths yet.
            static const auto aimSolve_tuned = RagdollCore::tuned<bool>([] { return weaponDriveSetting("OPENMW_RAGDOLL_TIP_AIM_SOLVE", 0.0f) > 0.0f; });
            static const auto& aimSolve = aimSolve_tuned.get();
            static const auto sweet_tuned = RagdollCore::tuned<float>([] { return std::clamp(weaponDriveSetting("OPENMW_RAGDOLL_TIP_SWEET", 0.75f), 0.3f, 1.0f); });
            static const auto& sweet = sweet_tuned.get();
            static const auto aimGripDrop_tuned = RagdollCore::tuned<float>([] { return weaponDriveSetting("OPENMW_RAGDOLL_TIP_GRIP_DROP", 0.15f); });
            static const auto& aimGripDrop = aimGripDrop_tuned.get();
            const auto leverAim = [&] { return !bare && !mTip.mThrust && tipDistance > 30.0f; };
            const auto aimShoulder = [&] {
                return frame.mPivot
                    + JPH::RVec3(frame.mRight * mTip.mShoulderLocal.GetX() + frame.mForward * mTip.mShoulderLocal.GetY()
                        + frame.mUp * mTip.mShoulderLocal.GetZ());
            };
            // The command whose modelled sweet spot lies on `target`, and how
            // far that spot stays from it.
            const auto leverSolve = [&](JPH::RVec3Arg target) {
                const JPH::RVec3 shoulder = aimShoulder();
                const float handMax = 0.92f * armReach;
                JPH::RVec3 tip = target
                    + JPH::RVec3(JPH::Vec3(target - shoulder).NormalizedOr(frame.mForward) * ((1.0f - sweet) * tipDistance));
                JPH::RVec3 spot = tip;
                for (int i = 0; i < 8; ++i)
                {
                    const JPH::Vec3 fromShoulder(tip - shoulder);
                    const JPH::Vec3 along = fromShoulder.NormalizedOr(frame.mForward);
                    const float length
                        = std::clamp(fromShoulder.Length(), tipDistance + handMin * armReach, tipDistance + handMax);
                    tip = shoulder + JPH::RVec3(along * length);
                    JPH::RVec3 grip = shoulder + JPH::RVec3(along * (length - tipDistance) - frame.mUp * (aimGripDrop * armReach));
                    const float behind = JPH::Vec3(grip - shoulder).Dot(frame.mForward);
                    if (behind < -4.0f)
                        grip += JPH::RVec3(frame.mForward * (-4.0f - behind));
                    spot = grip + JPH::RVec3(JPH::Vec3(tip - grip).NormalizedOr(along) * (sweet * tipDistance));
                    tip += target - spot;
                }
                return std::pair<JPH::Vec3, float>(JPH::Vec3(tip - frame.mPivot), static_cast<float>((target - spot).Length()));
            };
            const auto solveAim = [&](JPH::RVec3Arg target) {
                JPH::Vec3 point(target - frame.mPivot);
                float radius = point.Length();
                if (leverAim())
                {
                    auto [command, miss] = leverSolve(target);
                    if (miss > 8.0f && mSwingAimRayOrigin)
                    {
                        // Out of reach (or inside the blade): the crosshair's
                        // point where the sweet spot reaches comfortably.
                        const JPH::RVec3 shoulder = aimShoulder();
                        const float spotReach = 0.8f * armReach + sweet * tipDistance;
                        const JPH::Vec3 ray = mSwingAimRayDirection.NormalizedOr(frame.mForward);
                        const JPH::Vec3 origin(*mSwingAimRayOrigin - shoulder);
                        const float b = origin.Dot(ray);
                        const float disc = b * b - (origin.LengthSq() - spotReach * spotReach);
                        const float along = disc >= 0.0f ? -b + std::sqrt(disc) : std::max(0.0f, -b);
                        command = leverSolve(*mSwingAimRayOrigin + JPH::RVec3(ray * along)).first;
                    }
                    point = command;
                    radius = std::max(point.Length(), 0.6f * nominalRadius);
                }
                const auto [az, el] = frame.angles(point);
                const float solvedAz = std::clamp(az, leftLimit, rightLimit);
                return std::array<float, 3>{ solvedAz, std::clamp(el, lowFor(solvedAz), highLimit), radius };
            };
            // The live target: the aim point (the player's crosshair at its
            // depth, an NPC's strike point), else the crosshair at the tip's
            // radius.
            const auto aimTarget = [&]() -> std::optional<JPH::RVec3> {
                if (mPlayerStrikeAimPoint)
                    return *mPlayerStrikeAimPoint;
                if (!mSwingAimRayOrigin)
                    return std::nullopt;
                const JPH::Vec3 origin(*mSwingAimRayOrigin - frame.mPivot);
                const JPH::Vec3 ray = mSwingAimRayDirection.NormalizedOr(frame.mForward);
                const float b = origin.Dot(ray);
                const float disc = b * b - (origin.LengthSq() - nominalRadius * nominalRadius);
                return *mSwingAimRayOrigin + JPH::RVec3(ray * (disc >= 0.0f ? -b + std::sqrt(disc) : std::max(0.0f, -b)));
            };
            if ((attackStarted || charge || launch) && mTip.mMode != TipController::Mode::Drag)
            {
                // Quick attack (spec 5): the weapon's strongest type in its
                // record, through the crosshair. Thrusts are deferred; a
                // thrust-first weapon strikes with its better of chop/slash.
                int chop = record ? record->mData.mChop[1] : 1;
                int slash = record ? record->mData.mSlash[1] : 0;
                mTip.mThrust = bare || thrust;
                mTip.mAttackType = mTip.mThrust ? "thrust" : chop >= slash ? "chop" : "slash";
                float aimAz = 0.0f, aimEl = 0.0f, aimRadius = nominalRadius;
                mTip.mGuided = false;
                const auto aimAt = aimSolve ? aimTarget() : std::nullopt;
                if (aimAt)
                {
                    const JPH::Vec3 shoulder(*rightShoulder - frame.mPivot);
                    mTip.mShoulderLocal
                        = JPH::Vec3(shoulder.Dot(frame.mRight), shoulder.Dot(frame.mForward), shoulder.Dot(frame.mUp));
                    mTip.mAimWorld = *aimAt;
                    mTip.mGuided = true;
                    const auto aim = solveAim(*aimAt);
                    aimAz = mTip.mAimAz = aim[0];
                    aimEl = mTip.mAimEl = aim[1];
                    aimRadius = mTip.mAimRadius = aim[2];
                }
                // The crosshair: the eye ray's point at the tip radius, or
                // the chosen strike point when it is within reach.
                else if (mSwingAimRayOrigin)
                {
                    const JPH::Vec3 origin(*mSwingAimRayOrigin - frame.mPivot);
                    const JPH::Vec3 ray = mSwingAimRayDirection.NormalizedOr(frame.mForward);
                    const float b = origin.Dot(ray);
                    const float c = origin.LengthSq() - nominalRadius * nominalRadius;
                    const float disc = b * b - c;
                    JPH::Vec3 point = origin + ray * (disc >= 0.0f ? -b + std::sqrt(disc) : std::max(0.0f, -b));
                    if (mPlayerStrikeAimPoint)
                    {
                        const JPH::Vec3 target(*mPlayerStrikeAimPoint - frame.mPivot);
                        const float distance = target.Length();
                        // Out to the arm's full reach: capped at the guard's
                        // bent-arm radius, an aimed dagger chop only grazed a
                        // chest one reach away (FIX-08: contact, no injury).
                        const float fullReach = tipDistance + armReach;
                        if (distance > tipDistance + 0.3f * armReach && distance < fullReach + 6.0f)
                        {
                            point = target;
                            aimRadius = std::min(distance + 4.0f, fullReach);
                        }
                    }
                    // The blade's tip is the end of a lever from the shoulder, not
                    // the commanded point itself: solve (a few fixed-point steps)
                    // for the command whose blade tip lies on the eye ray. Aimed
                    // directly, blades crossed 10-25 units beside the crosshair.
                    if (!bare && tipDistance > 30.0f && !mPlayerStrikeAimPoint)
                    {
                        static const auto drop_tuned = RagdollCore::tuned<float>([] { return weaponDriveSetting("OPENMW_RAGDOLL_TIP_GRIP_DROP", 0.15f); });
                        static const auto& drop = drop_tuned.get();
                        const JPH::RVec3 origin = *mSwingAimRayOrigin;
                        const JPH::Vec3 ray = mSwingAimRayDirection.NormalizedOr(frame.mForward);
                        const auto bladeTip = [&](JPH::RVec3Arg tip) {
                            const JPH::Vec3 fromShoulder(tip - *rightShoulder);
                            const JPH::Vec3 along = fromShoulder.NormalizedOr(frame.mForward);
                            const float hand = std::clamp(fromShoulder.Length() - tipDistance, handMin * armReach, 0.92f * armReach);
                            JPH::RVec3 grip = *rightShoulder + JPH::RVec3(along * hand - frame.mUp * (drop * armReach));
                            const float behind = JPH::Vec3(grip - *rightShoulder).Dot(frame.mForward);
                            if (behind < -4.0f)
                                grip += JPH::RVec3(frame.mForward * (-4.0f - behind));
                            return grip + JPH::RVec3(JPH::Vec3(tip - grip).NormalizedOr(along) * tipDistance);
                        };
                        JPH::RVec3 tip = frame.mPivot + JPH::RVec3(point);
                        for (int i = 0; i < 6; ++i)
                        {
                            const JPH::RVec3 blade = bladeTip(tip);
                            const float along = std::max(0.0f, static_cast<float>(JPH::Vec3(blade - origin).Dot(ray)));
                            tip += (origin + JPH::RVec3(ray * along)) - blade;
                        }
                        point = JPH::Vec3(tip - frame.mPivot);
                        aimRadius = std::clamp(point.Length(), 0.6f * nominalRadius, 1.2f * nominalRadius);
                    }
                    auto [az, el] = frame.angles(point);
                    // A long blade trails its commanded tip to the left by the
                    // guard's lever offset; aimed at a target point (the lever
                    // solve above is for the bare eye ray) the claymore chop
                    // came down 24 units left of the chest and only clipped
                    // the victim's side (FIX-08: 20-74 contacts, no strike).
                    // OPENMW_RAGDOLL_TIP_AIM_LEVER=0 disables it.
                    static const auto aimLever_tuned = RagdollCore::tuned<bool>([] { return weaponDriveSetting("OPENMW_RAGDOLL_TIP_AIM_LEVER", 1.0f) > 0.0f; });
                    static const auto& aimLever = aimLever_tuned.get();
                    if (aimLever && mPlayerStrikeAimPoint && !bare && tipDistance > 30.0f && !mTip.mThrust)
                        az += guardAz;
                    aimAz = std::clamp(az, leftLimit, rightLimit);
                    aimEl = std::clamp(el, lowLimit, highLimit);
                }
                const bool chargeStrike = charge && !attackStarted && !launch
                    && std::hypot(aimAz - mTip.mAz, aimEl - mTip.mEl) > osg::DegreesToRadians(40.0f);
                if (chargeStrike)
                    mTip.mAttackType = std::abs(aimEl - mTip.mEl) > std::abs(aimAz - mTip.mAz) ? "chop" : "slash";
                if (!charge || attackStarted || launch || chargeStrike)
                {
                float windAz = chargeStrike ? mTip.mAz : aimAz, windEl = chargeStrike ? mTip.mEl : aimEl;
                float windRadius = chargeStrike ? mTip.mRadius : nominalRadius;
                if (bare)
                {
                    // A punch: draw the fist back on the aim line, then drive it
                    // out through the crosshair to full reach.
                    windRadius = 0.45f * armReach;
                    aimRadius = std::max(aimRadius, 0.98f * armReach);
                }
                else if (mTip.mThrust)
                {
                    // A thrust: draw the tip back on the aim line, then drive
                    // it out through the crosshair with the arm extended.
                    windRadius = tipDistance + 0.45f * armReach;
                    aimRadius = std::max(aimRadius, tipDistance + 0.98f * armReach);
                }
                else if (chargeStrike)
                {
                }
                else if (mTip.mAttackType == "chop")
                {
                    windAz = aimAz + osg::DegreesToRadians(15.0f);
                    windEl = highLimit - osg::DegreesToRadians(5.0f);
                }
                else
                {
                    windAz = rightLimit - osg::DegreesToRadians(15.0f);
                    windEl = aimEl + osg::DegreesToRadians(10.0f);
                }
                // Follow through past the crosshair on the wind-up-to-aim
                // line, so the strike passes through it (5.4).
                const float lineAz = aimAz - windAz, lineEl = aimEl - windEl;
                const float line = std::hypot(lineAz, lineEl);
                const float through = osg::DegreesToRadians(50.0f);
                mTip.mStrikeAz = mTip.mThrust ? aimAz
                                      : std::clamp(aimAz + (line > 1e-3f ? lineAz / line * through : 0.0f), leftLimit, rightLimit);
                mTip.mStrikeEl = mTip.mThrust ? aimEl
                                      : std::clamp(aimEl + (line > 1e-3f ? lineEl / line * through : 0.0f), lowLimit, highLimit);
                mTip.mStrikeRadius = aimRadius;
                mTip.mMode = TipController::Mode::WindUp;
                mTip.mCommitTimer = 0.0f;
#ifdef OPENMW_RAGDOLL_DEV_API
                {
                    static const auto traceLaunch_tuned = RagdollCore::tuned<bool>([] { return RagdollCore::tuningText("OPENMW_RAGDOLL_TIP_TRACE") != nullptr; });
                    static const auto& traceLaunch = traceLaunch_tuned.get();
                    if (traceLaunch && !player)
                        Log(Debug::Info) << "RAGDOLL_TIP_LAUNCH actor=" << actor.getCellRef().getRefId()
                                         << " type=" << mTip.mAttackType << " aim=" << osg::RadiansToDegrees(aimAz) << ","
                                         << osg::RadiansToDegrees(aimEl) << "," << aimRadius
                                         << " target=" << (mAiStrikeAimPoint ? JPH::Vec3(*mAiStrikeAimPoint - frame.mPivot).Length() : -1.0f)
                                         << " started=" << attackStarted << " charge=" << charge << " launch=" << launch;
                }
#endif
                mTip.mGoalAz = windAz;
                mTip.mGoalEl = windEl;
                mTip.mGoalRadius = windRadius;
                mTip.mTimer = 0.0f;
                mSwing = {};
                ++mSwingIdentity;
                mPlayerAttackType = mTip.mAttackType;
                getPtr().getClass().getCreatureStats(getPtr()).setAttackType(mPlayerAttackType);
                if (chargeStrike)
                {
                    mTip.mMode = TipController::Mode::Strike;
                    mTip.mLineAz = mTip.mAz;
                    mTip.mLineEl = mTip.mEl;
                    mTip.mGoalAz = mTip.mStrikeAz;
                    mTip.mGoalEl = mTip.mStrikeEl;
                    mTip.mGoalRadius = mTip.mStrikeRadius;
                }
                }
            }
            // A punch's aim point is on its wind-up line, so both phases were
            // "reached" as soon as the radius closed: the command drew back and
            // shot out in 2-3 steps each and returned before the fist extended
            // (fists replay: 2 strike steps, no contact in 9 punches). Hold each
            // phase: OPENMW_RAGDOLL_TIP_PUNCH="wind-up,hold" seconds.
            static const auto punchTimes_tuned = RagdollCore::tuned<std::pair<float, float>>([] {
                std::pair<float, float> value(0.06f, 0.22f);
                if (const char* text = RagdollCore::tuningText("OPENMW_RAGDOLL_TIP_PUNCH"))
                    std::sscanf(text, "%f,%f", &value.first, &value.second);
                return value;
            });
            static const auto& punchTimes = punchTimes_tuned.get();
            const float punchWindUp = punchTimes.first, punchHold = punchTimes.second;
            // A guided strike (see solveAim): the aim solved again from the
            // target in the world, and the strike's end past it on the line
            // from where the strike started (the wind-up point until then).
            // OPENMW_RAGDOLL_TIP_STRIKE_LOOKAHEAD degrees ahead on the line.
            static const float strikeThrough = osg::DegreesToRadians(50.0f);
            static const auto strikeLookahead_tuned = RagdollCore::tuned<float>([] { return osg::DegreesToRadians(weaponDriveSetting("OPENMW_RAGDOLL_TIP_STRIKE_LOOKAHEAD", 45.0f)); });
            static const auto& strikeLookahead = strikeLookahead_tuned.get();
            const auto solveGuidedStrike = [&] {
                const auto aim = solveAim(mTip.mAimWorld);
                mTip.mAimAz = aim[0];
                mTip.mAimEl = aim[1];
                mTip.mAimRadius = bare ? std::max(aim[2], 0.98f * armReach)
                    : mTip.mThrust    ? std::max(aim[2], tipDistance + 0.98f * armReach)
                                      : aim[2];
                const bool striking = mTip.mMode == TipController::Mode::Strike;
                const float fromAz = striking ? mTip.mLineAz : mTip.mGoalAz;
                const float fromEl = striking ? mTip.mLineEl : mTip.mGoalEl;
                const float lineAz = mTip.mAimAz - fromAz, lineEl = mTip.mAimEl - fromEl;
                const float line = std::hypot(lineAz, lineEl);
                const bool pastAim = !mTip.mThrust && !bare && line > 1e-3f;
                mTip.mStrikeAz = std::clamp(mTip.mAimAz + (pastAim ? lineAz / line * strikeThrough : 0.0f), leftLimit, rightLimit);
                mTip.mStrikeEl = std::clamp(mTip.mAimEl + (pastAim ? lineEl / line * strikeThrough : 0.0f), lowLimit, highLimit);
                mTip.mStrikeRadius = mTip.mAimRadius;
            };
            switch (mTip.mMode)
            {
                case TipController::Mode::Drag:
                {
                    // A drag leaves the rest as it moves, not on a clock: the
                    // hands rose from the waist rest to the lever grip over the
                    // first 0.2 s whatever the mouse did, and the radius went out
                    // from the blade's to the guard's, so every drag began by
                    // lifting the blade (AIM-02: drags down went up, cosine
                    // -0.85 to -1.0). Over the first OPENMW_RAGDOLL_TIP_DRAG_SETTLE
                    // degrees of the command's travel the grip leaves the rest
                    // (see mRestGrip) and the radius goes from the blade's to the
                    // guard's (0 = the clock and the guard radius at once).
                    static const auto settleAngle_tuned = RagdollCore::tuned<float>([] { return osg::DegreesToRadians(weaponDriveSetting("OPENMW_RAGDOLL_TIP_DRAG_SETTLE", 30.0f)); });
                    static const auto& settleAngle = settleAngle_tuned.get();
                    if (settleAngle > 0.0f)
                    {
                        const float travel = std::hypot(mTip.mAz - mTip.mDragStartAz, mTip.mEl - mTip.mDragStartEl);
                        mTip.mDragSettle = std::min(mTip.mDragSettle, std::clamp(1.0f - travel / settleAngle, 0.0f, 1.0f));
                        // Squared: the radius comes late, so the first motion is
                        // the mouse's and not the arm reaching out.
                        mTip.mGoalRadius = nominalRadius
                            + (mTip.mDragStartRadius - nominalRadius) * mTip.mDragSettle * mTip.mDragSettle;
                    }
                    else
                        mTip.mDragSettle = 0.0f;
                    const float stepAz = dx * perUnit, stepEl = dy * perUnit;
                    // Past the side limit the body turns instead (user bookmark
                    // 12, 2026-09-30: "when reaching the limit, maybe we need to
                    // change to the body configuration twisting"; the claymore
                    // bounced 20-70 units off a goal parked at 110 degrees). The
                    // mouse travel beyond the limit turns the player as an
                    // ordinary mouse look would. OPENMW_RAGDOLL_TIP_EDGE_TURN =
                    // share of that travel (0 = off); 0.54 turns the body at the
                    // rate the tip moved (mouse look is 1.87x the tip's rate).
                    // 0.15 since the user's bookmark 12 (2026-09-30): "I like
                    // it but make the turn rate much much slower".
                    // EDGE-01: the turn follows, edge steadiness unchanged
                    // (claymore az std 2.5 -> 3.2, longsword 0.1 -> 0.8 deg).
                    static const auto edgeTurn_tuned = RagdollCore::tuned<float>([] { return weaponDriveSetting("OPENMW_RAGDOLL_TIP_EDGE_TURN", 0.15f); });
                    static const auto& edgeTurn = edgeTurn_tuned.get();
                    // Screen steering (user bookmarks 2026-10-01: from the raised
                    // guard a side drag became a chop, and mouse circles over the
                    // top made the arm flip): the mouse turns the tip toward the
                    // body's right and up from wherever it points, a fixed arc per
                    // mouse unit, instead of adding to azimuth and elevation (near
                    // vertical a whole azimuth sweep barely moved the tip, and a
                    // small circle there swung the azimuth 245 degrees in 0.6 s).
                    // It cannot pass over the top of the head.
                    // OPENMW_RAGDOLL_TIP_SCREEN_STEER=0 = the azimuth/elevation steps.
                    // 2 = the same height on screen: a side drag moves the tip
                    // along its height at one arc length per mouse unit (the
                    // great circle of mode 1 sloped down: the claymore's side
                    // drag dropped 44 units against 20).
                    static const auto screenSteerMode_tuned = RagdollCore::tuned<int>([] { return static_cast<int>(weaponDriveSetting("OPENMW_RAGDOLL_TIP_SCREEN_STEER", 1.0f)); });
                    static const auto& screenSteerMode = screenSteerMode_tuned.get();
                    const bool screenSteer = screenSteerMode == 1;
                    float wantAz = mTip.mGoalAz + stepAz;
                    float wantEl = mTip.mGoalEl + stepEl;
                    if (screenSteerMode == 2)
                        wantAz = mTip.mGoalAz
                            + stepAz / std::max(std::cos(mTip.mGoalEl), std::cos(osg::DegreesToRadians(75.0f)));
                    const float arc = std::hypot(stepAz, stepEl);
                    if (screenSteer && arc > 1e-6f)
                    {
                        const JPH::Vec3 d = frame.direction(mTip.mGoalAz, mTip.mGoalEl);
                        JPH::Vec3 toRight = frame.mRight - d * frame.mRight.Dot(d);
                        if (toRight.LengthSq() > 1e-6f)
                        {
                            toRight = toRight.Normalized();
                            const JPH::Vec3 toUp = toRight.Cross(d);
                            const JPH::Vec3 moved
                                = (d * std::cos(arc) + (toRight * stepAz + toUp * stepEl) * (std::sin(arc) / arc))
                                      .Normalized();
                            const auto [az, el] = frame.angles(moved);
                            float turn = az - mTip.mGoalAz;
                            while (turn > osg::PI) turn -= 2.0f * osg::PI;
                            while (turn < -osg::PI) turn += 2.0f * osg::PI;
                            // Passing the zenith flips the azimuth: stop at the top.
                            if (std::abs(turn) > osg::PI_2 && el > 0.5f)
                            {
                                wantAz = mTip.mGoalAz;
                                wantEl = highLimit;
                            }
                            else
                            {
                                wantAz = mTip.mGoalAz + turn;
                                wantEl = el;
                            }
                        }
                    }
                    // A goal already past the drag limit is not pulled back, only
                    // kept from growing.
                    const float dragRight = narrowGrip() && narrowDragRight > 0.0f
                        ? std::min(rightLimit, std::max(osg::DegreesToRadians(narrowDragRight), mTip.mGoalAz))
                        : rightLimit;
                    // The pose map keeps these side limits: past them the edge
                    // turn turns the body (EDGE-01 with the map's +-100: no turn
                    // at the right edge, the left hold wrapped to +93).
                    mTip.mGoalAz = std::clamp(wantAz, leftLimit, dragRight);
                    // Slow steering only: a fast stroke that runs into the limit
                    // is a swing, not a turn (FIX-08 drags: the body spun off
                    // the target). Measured as tip arc, not raw azimuth.
                    if (player && edgeTurn > 0.0f && !mHiltActive && !(mTip.mCommitTimer > 0.0f)
                        && !(commit[0] > 0.0f && mTip.mStrokeRate > 0.5f * commit[0]))
                        mTipEdgeOverflow += edgeTurn * (wantAz - mTip.mGoalAz) * std::cos(mTip.mGoalEl) / perUnit;
                    mTip.mGoalEl = std::clamp(wantEl, lowFor(mTip.mGoalAz), highLimit);
                    // Mouse input arrives in bursts: smooth the goal's speed
                    // over a few steps before it can commit a swing.
                    const float step = std::hypot(stepAz, stepEl);
                    const float rate = duration > 0.0f ? step / duration : 0.0f;
                    const float blend = std::min(1.0f, duration / 0.05f);
                    mTip.mStrokeRate += (rate - mTip.mStrokeRate) * blend;
                    mTip.mCommitTimer = std::max(0.0f, mTip.mCommitTimer - duration);
                    // Chamber (user bookmark 15, 2026-10-02: "it doesn't look like
                    // I'm revving up a hit because the elbows are straightened
                    // out"): a slow drag - positioning, winding up - draws the
                    // hands in, elbows bent; the stroke extends them as it gains
                    // speed, full reach at the commit rate and through the
                    // committed carry. OPENMW_RAGDOLL_TIP_CHAMBER = hand fraction
                    // of the arm's reach while slow (0 = off; the drag used
                    // OPENMW_RAGDOLL_TIP_HAND, 0.8, throughout).
                    static const auto chamber_tuned = RagdollCore::tuned<float>([] { return weaponDriveSetting("OPENMW_RAGDOLL_TIP_CHAMBER", 0.68f); });
                    static const auto& chamber = chamber_tuned.get();
                    if (!bare && chamber > 0.0f && chamber < handFraction && commit[0] > 0.0f)
                    {
                        const float speedShare = mTip.mCommitTimer > 0.0f
                            ? 1.0f : std::clamp(mTip.mStrokeRate / commit[0], 0.0f, 1.0f);
                        const float fraction = chamber + (handFraction - chamber) * speedShare;
                        mTip.mGoalRadius = tipDistance + std::max(handMin, fraction) * armReach;
                    }
                    if (commit[0] > 0.0f && mTip.mStrokeRate > commit[0] && step > 1e-5f)
                    {
                        // A new committed stroke whooshes like a vanilla attack
                        // (user 2026-09-28: "so I know it's a committed strike").
                        if (!(mTip.mCommitTimer > 0.0f)
                            || mTip.mCommitAz * (stepAz / step) + mTip.mCommitEl * (stepEl / step) < -0.3f)
                        {
                            // The user's strokes run 40-80 rad/s (recordings).
                            mCommitSwishSize = std::clamp((mTip.mStrokeRate - commit[0]) / (2.0f * commit[0]), 0.0f, 1.0f);
                            mCommitFatigue = 1.0f;
                            ++mCommitSwishRequests;
                            // Self-stagger (user 2026-09-30: "you can stagger
                            // yourself"): a committed stroke with a heavy weapon
                            // by an unskilled fighter takes its own balance, by
                            // weight x stroke size x missing control.
                            // OPENMW_RAGDOLL_SELF_STAGGER = impulse per weight
                            // unit at no control (0 = off).
                            static const auto selfStagger_tuned = RagdollCore::tuned<float>([] { return weaponDriveSetting("OPENMW_RAGDOLL_SELF_STAGGER", 40.0f); });
                            static const auto& selfStagger = selfStagger_tuned.get();
                            if (selfStagger > 0.0f && mWeapon)
                            {
                                const float missing = (1.0f - std::clamp(mWeaponControl, 0.2f, 1.0f)) / 0.8f;
                                const float impulse
                                    = selfStagger * mWeapon->mItemWeight * (0.5f + 0.5f * mCommitSwishSize) * missing;
                                if (impulse > 1.0f)
                                {
                                    // The stroke's weight carries the upper
                                    // body on along the facing (the bands'
                                    // price: 22 per u/s of body speed) and
                                    // PGC catches it, or not.
                                    const float yaw = getPtr().getRefData().getPosition().rot[2];
                                    const JPH::Vec3 forward(std::sin(yaw), std::cos(yaw), 0.0f);
                                    if (mRagdoll && mLeftLeg && mRightLeg)
                                    {
                                        std::vector<float> share(mRagdoll->getBodyCount(), 1.0f);
                                        for (const auto* leg : { &*mLeftLeg, &*mRightLeg })
                                            for (const std::size_t body : { leg->mHip, leg->mKnee, leg->mFoot })
                                                if (body < share.size())
                                                    share[body] = 0.0f;
                                        mRagdoll->addLinearVelocity(forward * std::min(impulse / 22.0f, 120.0f), share);
                                    }
                                    registerBlowV2(impulse, false);
                                    ++mSelfStaggers;
                                }
                            }
                        }
                        // The swing's direction follows the stroke; a reversal
                        // is a new committed stroke the other way.
                        mTip.mCommitAz = stepAz / step;
                        mTip.mCommitEl = stepEl / step;
                        mTip.mCommitTimer = commit[4];
                        mTip.mSlipArmed = true;
                    }
                    // Slip (user bookmark 2026-10-01: "when I swing the hammer
                    // from right to left very hard the arms should go with the
                    // hammer ... weapon skill affects how much this drag affects
                    // and how long it takes to recover - the weapon slips past
                    // its target"). When a committed stroke stops under a held
                    // button, the goal runs on along the stroke - farther for a
                    // heavier weapon, a bigger stroke and less skill - and comes
                    // back to the mouse, slower with less skill.
                    // OPENMW_RAGDOLL_TIP_SLIP = "degrees,recovery s" at full
                    // skill loss and a 20-weight weapon (0 = off).
                    static const auto slip_tuned = RagdollCore::tuned<std::array<float, 2>>([] {
                        std::array<float, 2> v{ 30.0f, 0.6f };
                        if (const char* text = RagdollCore::tuningText("OPENMW_RAGDOLL_TIP_SLIP"))
                            std::sscanf(text, "%f,%f", &v[0], &v[1]);
                        return v;
                    });
                    static const auto& slip = slip_tuned.get();
                    if (slip[0] > 0.0f && mTip.mSlipArmed && commit[0] > 0.0f
                        && mTip.mStrokeRate < 0.3f * commit[0])
                    {
                        mTip.mSlipArmed = false;
                        const float weight = mWeapon && mWeapon->mAttached ? mWeapon->mItemWeight : 5.0f;
                        const float mass = std::clamp(weight / 20.0f, 0.3f, 2.0f);
                        const float skillLoss = (1.0f - control) / 0.8f;
                        const float size = 0.5f + 0.5f * mCommitSwishSize;
                        const float degrees = slip[0] * mass * size * (0.35f + 0.65f * skillLoss);
                        mTip.mSlipGoalAz = mTip.mCommitAz * osg::DegreesToRadians(degrees);
                        mTip.mSlipGoalEl = mTip.mCommitEl * osg::DegreesToRadians(degrees);
                        mTip.mSlipRecovery = slip[1] * (0.35f + 0.65f * skillLoss) * std::sqrt(mass);
                        mTip.mSlipTime = 0.0f;
                    }
                    if (mTip.mSlipRecovery > 0.0f)
                    {
                        // Out in ~0.08 s, back over the recovery time.
                        mTip.mSlipTime += duration;
                        const float out = std::min(1.0f, mTip.mSlipTime / 0.08f);
                        const float back = std::exp(-std::max(0.0f, mTip.mSlipTime - 0.08f) / mTip.mSlipRecovery);
                        const float share = out * back;
                        // An offset on the drive's goal (like `through`), never
                        // written into the mouse goal: clamped at a limit, the
                        // way out was eaten and the way back was not, and the
                        // goal walked back up to 20 degrees on its own (review
                        // 2026-10-02).
                        mTip.mSlipAz = mTip.mSlipGoalAz * share;
                        mTip.mSlipEl = mTip.mSlipGoalEl * share;
                        if (mTip.mSlipTime > 0.08f + 4.0f * mTip.mSlipRecovery)
                            mTip.mSlipRecovery = mTip.mSlipAz = mTip.mSlipEl = 0.0f;
                    }
                    // (A leash holding the goal near a stalled blade cost the fast
                    // longsword drag blows - FIX-08 7 of 9 against 6 of 6; removed
                    // 10-12.)
                    break;
                }
                case TipController::Mode::WindUp:
                    if (mTip.mGuided)
                    {
                        if (const auto target = aimTarget())
                            mTip.mAimWorld = *target;
                        solveGuidedStrike();
                    }
                    if ((reached(mTip.mGoalAz, mTip.mGoalEl) && std::abs(mTip.mRadius - mTip.mGoalRadius) < 3.0f
                            && (!mTip.mThrust || mTip.mTimer >= punchWindUp))
                        || mTip.mTimer > 0.8f / speed)
                    {
                        mTip.mMode = TipController::Mode::Strike;
                        // The line starts where the wind-up got to, which is
                        // not always where it was sent (it times out).
                        mTip.mLineAz = mTip.mAz;
                        mTip.mLineEl = mTip.mEl;
                        if (mTip.mGuided)
                            solveGuidedStrike();
                        mTip.mGoalAz = mTip.mStrikeAz;
                        mTip.mGoalEl = mTip.mStrikeEl;
                        mTip.mGoalRadius = mTip.mStrikeRadius;
                        mTip.mTimer = 0.0f;
                    }
                    break;
                case TipController::Mode::Strike:
                    mTip.mCommitTimer = std::max(0.0f, mTip.mCommitTimer - duration);
                    if (mTip.mGuided)
                    {
                        solveGuidedStrike();
                        mTip.mGoalAz = mTip.mStrikeAz;
                        mTip.mGoalEl = mTip.mStrikeEl;
                        mTip.mGoalRadius = mTip.mStrikeRadius;
                        // Pursue the line from where the strike started
                        // through the aim, a little ahead of the blade's
                        // projection on it: aimed at the end point alone, the
                        // command curved off the line whenever it entered the
                        // strike still moving (or turned with the body), and
                        // passed beside the aim.
                        const float lineAz = mTip.mAimAz - mTip.mLineAz, lineEl = mTip.mAimEl - mTip.mLineEl;
                        const float toAim = std::hypot(lineAz, lineEl);
                        if (!mTip.mThrust && !bare && toAim > osg::DegreesToRadians(5.0f))
                        {
                            const float unitAz = lineAz / toAim, unitEl = lineEl / toAim;
                            const float progress = std::clamp(
                                (mTip.mAz - mTip.mLineAz) * unitAz + (mTip.mEl - mTip.mLineEl) * unitEl, 0.0f, toAim + strikeThrough);
                            const float ahead = std::min(toAim + strikeThrough, progress + strikeLookahead);
                            mTip.mGoalAz = std::clamp(mTip.mLineAz + unitAz * ahead, leftLimit, rightLimit);
                            mTip.mGoalEl = std::clamp(mTip.mLineEl + unitEl * ahead, lowLimit, highLimit);
                        }
                    }
                    // A held thrust stays out, pressed home, until released.
                    if (mTip.mThrust && !bare && held)
                        break;
                {
                    // The swing stays live until the blade gets there: its
                    // physical tip trails the command, and a strike ended on the
                    // command's arrival made the blade's contacts fall after the
                    // swing (none counted). OPENMW_RAGDOLL_TIP_STRIKE_ARRIVE =
                    // "gap units, extra seconds" (0 extra = off).
                    static const auto arrive_tuned = RagdollCore::tuned<std::pair<float, float>>([] {
                        std::pair<float, float> value(20.0f, 0.25f);
                        if (const char* text = RagdollCore::tuningText("OPENMW_RAGDOLL_TIP_STRIKE_ARRIVE"))
                            std::sscanf(text, "%f,%f", &value.first, &value.second);
                        return value;
                    });
                    static const auto& arrive = arrive_tuned.get();
                    const bool arrived = !(arrive.second > 0.0f) || mTipGap < arrive.first;
                    if ((reached(mTip.mGoalAz, mTip.mGoalEl) && std::abs(mTip.mRadius - mTip.mGoalRadius) < 3.0f
                            && (!mTip.mThrust || mTip.mTimer >= punchHold)
                            && (arrived || mTip.mTimer > 1.0f / speed + arrive.second))
                        || mTip.mTimer > 1.0f / speed + (arrived ? 0.0f : arrive.second))
                        mTip.mMode = TipController::Mode::Guard;
                }
                    break;
                case TipController::Mode::Guard:
                    break;
            }
            // Walking carries the weapon low instead of holding the guard out
            // (see playerWalkCarry). The body twist and lean below are taken
            // from this rest, so the carry does not bend the chest. Drag mode
            // (button held) is unchanged: it is about half of the armed moving
            // ticks and still has the hands raised in 23-43% of them.
            // OPENMW_RAGDOLL_TIP_WALK_CARRY="azimuth,elevation" degrees
            // (15,5 = a partial ready guard, for OPENMW_RAGDOLL_WALK_GUARD=2).
            const bool walkCarry = player && playerWalkCarry();
            static const auto carry_tuned = RagdollCore::tuned<std::pair<float, float>>([] {
                std::pair<float, float> value(20.0f, -30.0f);
                if (const char* text = RagdollCore::tuningText("OPENMW_RAGDOLL_TIP_WALK_CARRY"))
                    std::sscanf(text, "%f,%f", &value.first, &value.second);
                return value;
            });
            static const auto& carry = carry_tuned.get();
            // The rest eases between guard and carry instead of switching:
            // switched, the 66-degree step times the 0.3 lean gain put the
            // chest lean target on its +15/-20 degree clamps at every start
            // and stop (a nod). OPENMW_RAGDOLL_TIP_WALK_CARRY_RATE per second
            // (0 = switch at once).
            static const auto carryRate_tuned = RagdollCore::tuned<float>([] { return weaponDriveSetting("OPENMW_RAGDOLL_TIP_WALK_CARRY_RATE", 4.0f); });
            static const auto& carryRate = carryRate_tuned.get();
            {
                const float wanted = walkCarry ? 1.0f : 0.0f;
                const float step = carryRate * duration;
                mTip.mRestBlend = carryRate > 0.0f && std::abs(wanted - mTip.mRestBlend) > step
                    ? mTip.mRestBlend + std::copysign(step, wanted - mTip.mRestBlend)
                    : wanted;
            }
            const float carryAz = osg::DegreesToRadians(carry.first);
            const float carryEl = std::clamp(osg::DegreesToRadians(carry.second), lowFor(carryAz), highLimit);
            // Stances (Alpha 1.0, plan: "per weapon class a rest grip and guard
            // set (high, middle, low) ... chosen by the drag start"): a drag
            // released high leaves the weapon in a high guard (tip up, over the
            // shoulder line), released low in a low guard (tip toward the
            // floor in front), else the middle guard. OPENMW_RAGDOLL_TIP_STANCES:
            // 0 off, 1 high and middle (default since 2026-10-01: combat
            // stage 8/14 against 7/14 off), 2 adds the low guard (it cost
            // strikes, 4/14: guided warhammer and claymore start low).
            static const auto stances_tuned = RagdollCore::tuned<float>([] { return weaponDriveSetting("OPENMW_RAGDOLL_TIP_STANCES", 1.0f); });
            static const auto& stances = stances_tuned.get();
            float stanceAz = guardAz, stanceEl = guardEl;
            if (stances > 0.0f && !bare)
            {
                if (mTip.mStance == 1)
                {
                    stanceAz = osg::DegreesToRadians(25.0f);
                    stanceEl = std::min(osg::DegreesToRadians(55.0f), highLimit);
                }
                else if (mTip.mStance == 2 && stances >= 2.0f)
                {
                    stanceAz = osg::DegreesToRadians(5.0f);
                    stanceEl = std::max(osg::DegreesToRadians(-25.0f), lowFor(osg::DegreesToRadians(5.0f)));
                }
            }
            // The guard follows the look (alpha 0.9, user 2026-10-02: "map
            // should follow where I look, so we can aim up/down"): with the
            // pose map, the player's guard rises and falls with the view
            // pitch, so a drag starts at the height looked at.
            // OPENMW_RAGDOLL_POSE_LOOK = share of the pitch (0 = off; the
            // sign maps the actor's pitch to looking up).
            if (player && activePoseMap(bare))
            {
                static const auto lookShare_tuned = RagdollCore::tuned<float>([] { return weaponDriveSetting("OPENMW_RAGDOLL_POSE_LOOK", -1.0f); });
                static const auto& lookShare = lookShare_tuned.get();
                const float pitch = actor.getRefData().getPosition().rot[0];
                stanceEl = std::clamp(stanceEl + lookShare * pitch, lowLimit + osg::DegreesToRadians(10.0f),
                    osg::DegreesToRadians(60.0f));
            }
            const float restAz = stanceAz + mTip.mRestBlend * (carryAz - stanceAz);
            const float restEl = stanceEl + mTip.mRestBlend * (carryEl - stanceEl);
            if (mTip.mMode == TipController::Mode::Guard)
            {
                mTip.mGoalAz = restAz;
                mTip.mGoalEl = restEl;
                mTip.mGoalRadius = nominalRadius;
                // The return draws the blade back toward the body while it is far
                // from the guard: after a chop's follow-through the straight
                // climb back cut up through the target again.
                // OPENMW_RAGDOLL_TIP_WITHDRAW = radius fraction (1 = off).
                static const auto withdraw_tuned = RagdollCore::tuned<float>([] { return weaponDriveSetting("OPENMW_RAGDOLL_TIP_WITHDRAW", 0.6f); });
                static const auto& withdraw = withdraw_tuned.get();
                if (!bare && withdraw < 1.0f
                    && std::hypot(restAz - mTip.mAz, restEl - mTip.mEl) > osg::DegreesToRadians(20.0f))
                    mTip.mGoalRadius = std::max(tipDistance + handMin * armReach, withdraw * nominalRadius);
                // The physical guard key: a high block across the body, so the
                // stance is visible and puts the blade in the incoming line.
                // OPENMW_RAGDOLL_TIP_BLOCK="azimuth,elevation" degrees.
                if (mGuardActive && !bare)
                {
                    static const auto block_tuned = RagdollCore::tuned<std::pair<float, float>>([] {
                        std::pair<float, float> value(-20.0f, 55.0f);
                        if (const char* text = RagdollCore::tuningText("OPENMW_RAGDOLL_TIP_BLOCK"))
                            std::sscanf(text, "%f,%f", &value.first, &value.second);
                        return value;
                    });
                    static const auto& block = block_tuned.get();
                    mTip.mGoalAz = osg::DegreesToRadians(block.first);
                    mTip.mGoalEl = std::min(osg::DegreesToRadians(block.second), highLimit);
                    mTip.mGoalRadius = nominalRadius;
                    // Active guard: the blade into the incoming weapon's line.
                    if (mGuardThreat)
                    {
                        const auto [threatAz, threatEl] = frame.angles(JPH::Vec3(*mGuardThreat - frame.mPivot));
                        mTip.mGoalAz = std::clamp(threatAz, leftLimit, rightLimit);
                        mTip.mGoalEl = std::clamp(threatEl, lowFor(mTip.mGoalAz), highLimit);
                    }
                }
                // Drift back and settle within a second (spec 1, 7.1): at 6 rad/s
                // and governed, a draw still sat 5-15 units off the guard at 1 s.
                omega = std::min(omega, 8.0f);
            }
            // Tracking governor: the command may not run away from the weapon.
            // Near the edge of the arm's workspace and in fast flicks the
            // physical tip trailed the command by 30-130 units (G2); the
            // command now slows as that gap grows past OPENMW_RAGDOLL_TIP_GOVERN
            // ("start,stop" units, default 6,16) and waits for the weapon.
            if (mTipDesiredRotation)
            {
                // 25,70 since 2026-10-02 (user bookmark 13 "why are my swings so
                // slow?": play log, claymore drags governed to the 0.4 floor on
                // most strokes; FIX-08 drags/DRAG-01/AIM-02 claymore unchanged).
                static const auto govern_tuned = RagdollCore::tuned<std::pair<float, float>>([] {
                    std::pair<float, float> value(25.0f, 70.0f);
                    if (const char* text = RagdollCore::tuningText("OPENMW_RAGDOLL_TIP_GOVERN"))
                        std::sscanf(text, "%f,%f", &value.first, &value.second);
                    return value;
                });
                static const auto& govern = govern_tuned.get();
                const JPH::RVec3 physicalTip = bare ? *hand : *hand + JPH::RVec3(*handRotation * mWeapon->mBladeAxis * tipDistance);
                const float gap = static_cast<float>((physicalTip - mTipDesiredTip).Length());
                // Not a committed strike: slowed, a longsword slash ran out of
                // time behind the shoulder and never reached the crosshair.
                mTipGovernScale = 1.0f;
                if (govern.second > govern.first && mTip.mMode == TipController::Mode::Drag && !committed)
                    mTipGovernScale = std::clamp(1.0f - (gap - govern.first) / (govern.second - govern.first), 0.4f, 1.0f);
                omega *= mTipGovernScale;
                mTipGap = gap;
                mStrokeTrace.mGapMax = std::max(mStrokeTrace.mGapMax, gap);
            }
            // Impact (hit-stop and recoil, stepWeaponImpact): frozen, the
            // command sits on the blade where it struck; recoiling, it coasts
            // back along the bounce and eases out, deaf to the mouse.
            if (mImpactFreeze > 0.0f || mImpactRecoil > 0.0f)
            {
                if (mImpactFreeze > 0.0f)
                {
                    mTip.mAzRate = mTip.mElRate = 0.0f;
                    const JPH::RVec3 physicalTip
                        = bare ? *hand : *hand + JPH::RVec3(*handRotation * mWeapon->mBladeAxis * tipDistance);
                    const auto [az, el] = frame.angles(JPH::Vec3(physicalTip - frame.mPivot));
                    mTip.mAz = az;
                    mTip.mEl = std::clamp(el, lowLimit, highLimit);
                }
                else
                {
                    const float ease = std::exp(-duration / 0.1f);
                    mTip.mAzRate *= ease;
                    mTip.mElRate *= ease;
                }
                mTip.mAz += mTip.mAzRate * duration;
                mTip.mEl = std::clamp(mTip.mEl + mTip.mElRate * duration, lowLimit, highLimit);
            }
            else
            // Accelerate and brake toward the goal (spec 8.1): speed bounded
            // by the stopping distance, velocity change by the weight budget.
            {
                // Up to 30 degrees of slow aim wander at no control.
                const auto [wanderAz, wanderEl] = controlWander();
                const float wander = (1.0f - control) * osg::DegreesToRadians(30.0f);
                // The press's wander eases back in over half a second of guard.
                if (mTip.mMode == TipController::Mode::Guard)
                {
                    const float ease = std::exp(-duration / 0.5f);
                    mTip.mWanderBaseAz *= ease;
                    mTip.mWanderBaseEl *= ease;
                }
                // A committed swing aims past the mouse along its stroke, so the
                // blade drives through what it meets instead of braking on the
                // spot where the mouse stopped.
                const float through = committed && mTip.mMode == TipController::Mode::Drag
                    ? osg::DegreesToRadians(commit[3]) : 0.0f;
                const bool slipping = mTip.mMode == TipController::Mode::Drag && mTip.mSlipRecovery > 0.0f;
                stepParryKnock(duration);
                const float goalAz = std::clamp(mTip.mGoalAz + mTip.mCommitAz * through
                    + (slipping ? mTip.mSlipAz : 0.0f) + mTip.mKnockAz, leftLimit, rightLimit);
                const float goalEl = std::clamp(mTip.mGoalEl + mTip.mCommitEl * through
                    + (slipping ? mTip.mSlipEl : 0.0f) + mTip.mKnockEl, lowLimit, highLimit);
                const float ez = goalAz + wander * wanderAz - mTip.mWanderBaseAz - mTip.mAz;
                const float ee = goalEl + wander * wanderEl - mTip.mWanderBaseEl - mTip.mEl;
                const float distance = std::hypot(ez, ee);
                if (committed)
                    omega = std::max(omega, commit[1] * (0.7f + 0.3f * control));
                // A wounded weapon arm swings slower (alpha 0.4 item 7).
                omega *= armWoundScale() * tiredSwingScale();
                // A released drag drifts back to the guard instead of swinging
                // there (EDGE-01, user bookmarks 8/13: released at the reach
                // edge the blade swung 45-60 degrees past the guard, the
                // command itself braking on it). OPENMW_RAGDOLL_TIP_RELEASE_RETURN
                // = share of the speed until the command is back (1 = off). Off:
                // at 0.5 the overshoot grew (claymore 40 -> 73, longsword 57 -> 88).
                static const auto releaseReturn_tuned = RagdollCore::tuned<float>([] { return std::clamp(weaponDriveSetting("OPENMW_RAGDOLL_TIP_RELEASE_RETURN", 1.0f), 0.05f, 1.0f); });
                static const auto& releaseReturn = releaseReturn_tuned.get();
                if (mTip.mReleasedDrag)
                {
                    if (mTip.mMode != TipController::Mode::Guard || distance < osg::DegreesToRadians(5.0f))
                        mTip.mReleasedDrag = false;
                    else
                        omega *= releaseReturn;
                }
                const float accel = committed ? alpha * commit[2] : alpha;
                float wantAz = 0.0f, wantEl = 0.0f;
                if (distance > 1e-5f)
                {
                    const float rate
                        = std::min({ omega, std::sqrt(2.0f * accel * distance), distance / duration });
                    wantAz = ez / distance * rate;
                    wantEl = ee / distance * rate;
                }
                float changeAz = wantAz - mTip.mAzRate, changeEl = wantEl - mTip.mElRate;
                const float change = std::hypot(changeAz, changeEl);
                const float budget = accel * duration;
                if (change > budget)
                {
                    changeAz *= budget / change;
                    changeEl *= budget / change;
                }
                mTip.mAzRate += changeAz;
                mTip.mElRate += changeEl;
                // A held drag is one swing from press to release, and a swing
                // lands at most one localized strike per target: sweeping back
                // and forth through an opponent registered a single hit (play
                // test 2026-09-24 N7, staff: 676 fast eligible contacts, 2
                // strikes). Each stroke - the drag reversing direction at speed
                // - is a new swing for strike counting.
                // OPENMW_RAGDOLL_TIP_STROKE_SWINGS=0 keeps one swing per hold.
                static const auto strokeSwings_tuned = RagdollCore::tuned<bool>([] { return weaponDriveSetting("OPENMW_RAGDOLL_TIP_STROKE_SWINGS", 1.0f) > 0.0f; });
                static const auto& strokeSwings = strokeSwings_tuned.get();
                if (strokeSwings && mTip.mMode == TipController::Mode::Drag)
                {
                    const float rate = std::hypot(mTip.mAzRate, mTip.mElRate);
                    if (rate > 3.0f)
                    {
                        const float az = mTip.mAzRate / rate, el = mTip.mElRate / rate;
                        if (mTip.mStrokeAz * az + mTip.mStrokeEl * el < -0.3f)
                            ++mSwingIdentity;
                        mTip.mStrokeAz = az;
                        mTip.mStrokeEl = el;
                    }
                }
                mTip.mAz += mTip.mAzRate * duration;
                mTip.mEl = std::clamp(mTip.mEl + mTip.mElRate * duration, lowLimit, highLimit);
                // Drag strokes cost fatigue (alpha 0.4 item 9): the plain drag's
                // travel, charged on the game thread (updatePoweredAiStrikes).
                if (mTip.mMode == TipController::Mode::Drag && !committed && !bare)
                    mDragTravel += std::hypot(mTip.mAzRate, mTip.mElRate) * duration;
                const float radiusStep = 600.0f * duration;
                mTip.mRadius += std::clamp(mTip.mGoalRadius - mTip.mRadius, -radiusStep, radiusStep);
            }
            const JPH::RVec3 tipPoint = frame.mPivot + JPH::RVec3(frame.direction(mTip.mAz, mTip.mEl) * mTip.mRadius);
            // OPENMW_RAGDOLL_TIP_STEP_TRACE: the player's command, goal and
            // blade (degrees, units) for the first 20 steps of each drag or
            // click (aiming review 2026-09-30).
            static const auto stepTrace_tuned = RagdollCore::tuned<bool>([] { return RagdollCore::tuningText("OPENMW_RAGDOLL_TIP_STEP_TRACE") != nullptr; });
            static const auto& stepTrace = stepTrace_tuned.get();
            if (stepTrace && player && held && !mTraceHeld)
                mTraceRowsLeft = 30;
            mTraceHeld = held;
            if (stepTrace && player && mTraceRowsLeft > 0)
            {
                --mTraceRowsLeft;
                const JPH::RVec3 physicalTip = bare ? *hand : *hand + JPH::RVec3(*handRotation * mWeapon->mBladeAxis * tipDistance);
                const JPH::Vec3 offset(physicalTip - frame.mPivot);
                const auto [bladeAz, bladeEl] = frame.angles(offset);
                Log(Debug::Info) << "RAGDOLL_TIP_STEP mode=" << static_cast<int>(mTip.mMode) << " t=" << mTip.mTimer
                                 << " in=" << dx << "," << dy << " cmd=" << osg::RadiansToDegrees(mTip.mAz) << ","
                                 << osg::RadiansToDegrees(mTip.mEl) << "," << mTip.mRadius
                                 << " goal=" << osg::RadiansToDegrees(mTip.mGoalAz) << "," << osg::RadiansToDegrees(mTip.mGoalEl)
                                 << "," << mTip.mGoalRadius << " blade=" << osg::RadiansToDegrees(bladeAz) << ","
                                 << osg::RadiansToDegrees(bladeEl) << "," << offset.Length() << " rest=" << mTip.mRestGrip
                                 << " settle=" << mTip.mDragSettle << " low=" << osg::RadiansToDegrees(lowFor(mTip.mGoalAz))
                                 << " z=" << physicalTip.GetZ() << " held=" << held << " hold=" << mTip.mHoldTime
                                 << " dt=" << duration << " jolt=" << mCurrentContactPhysicsStep;
            }
            // The body winds up with the weapon: the Morrowind clips have no
            // wind-up for a drag, so the chest stayed square while the arm
            // alone reached around it (arms "locked", far-left drags, no speed
            // built). OPENMW_RAGDOLL_TIP_BODY="twist,lean": fractions of the
            // tip's azimuth and elevation from the guard (default 0,0 = off).
            {
                static const auto body_tuned = RagdollCore::tuned<std::pair<float, float>>([] {
                    std::pair<float, float> value = swingRigVersion() >= 2 ? std::pair<float, float>(0.5f, 0.3f)
                                                                           : std::pair<float, float>(0.0f, 0.0f);
                    if (const char* text = RagdollCore::tuningText("OPENMW_RAGDOLL_TIP_BODY"))
                        std::sscanf(text, "%f,%f", &value.first, &value.second);
                    return value;
                });
                static const auto& body = body_tuned.get();
                mTip.mBodyTwist = std::clamp(body.first * (mTip.mAz - restAz), osg::DegreesToRadians(-50.0f), osg::DegreesToRadians(50.0f));
                mTip.mBodyLean = std::clamp(body.second * (mTip.mEl - restEl), osg::DegreesToRadians(-20.0f), osg::DegreesToRadians(15.0f));
                // Chest turn (alpha 0.4 item 1, user 2026-09-30: "past that
                // edge the body turns instead of the wrists breaking"; "chest
                // should always rotate a bit"). The chest follows a share of
                // the command's azimuth always; past the arm's own window
                // (degrees from the chest, per grip) it takes all of the
                // excess, up to a cap. WRIST-01: across the body (-100) the
                // tip trailed its command 21 (claymore) to 41 (spear) units
                // against 6-14 in front, with the chest square.
                // OPENMW_RAGDOLL_TIP_CHEST="share,left,right,cap,share2" (cap 0
                // = off). Two-handed and spear grips (share2, no window): their
                // reach across the body is the support arm's, and turning the
                // chest past the window gained nothing (claymore -100: 21 ->
                // 18 units, spear 41 -> 47), so they only turn a little.
                if (swingRigVersion() < 2 && !bare)
                {
                    static const auto chest_tuned = RagdollCore::tuned<std::array<float, 5>>([] {
                        // Shares 0.5 / 0.35, cap 60 since 2026-09-30 (user: "the
                        // chest should move more, right now it's barely
                        // noticeable"); were 0.25 / 0.15, cap 45.
                        std::array<float, 5> value{ 0.5f, -60.0f, 75.0f, 60.0f, 0.35f };
                        if (const char* text = RagdollCore::tuningText("OPENMW_RAGDOLL_TIP_CHEST"))
                            std::sscanf(text, "%f,%f,%f,%f,%f", &value[0], &value[1], &value[2], &value[3], &value[4]);
                        return value;
                    });
                    static const auto& chest = chest_tuned.get();
                    const float cap = osg::DegreesToRadians(chest[3]);
                    if (cap > 0.0f)
                    {
                        const float offset = mTip.mAz - restAz;
                        float twist;
                        if (narrowGrip())
                            twist = chest[4] * offset;
                        else
                        {
                            twist = chest[0] * offset;
                            const float arm = mTip.mAz - twist;
                            const float left = osg::DegreesToRadians(chest[1]);
                            const float right = osg::DegreesToRadians(chest[2]);
                            if (arm > right)
                                twist += arm - right;
                            else if (arm < left)
                                twist += arm - left;
                        }
                        mTip.mBodyTwist = std::clamp(twist, -cap, cap);
                    }
                    // Pitch with the aim's height (user 2026-09-30: "we should
                    // also be able to pitch up or down"): back for a high blade,
                    // forward over a low one. OPENMW_RAGDOLL_TIP_CHEST_PITCH =
                    // share of the elevation (0 = off); lean is positive back.
                    static const auto pitchShare_tuned = RagdollCore::tuned<float>([] { return weaponDriveSetting("OPENMW_RAGDOLL_TIP_CHEST_PITCH", 0.35f); });
                    static const auto& pitchShare = pitchShare_tuned.get();
                    // Not at rest: resting, the guard's own elevation left the
                    // chest leaning (warhammer end lean after a get-up 10 -> 15
                    // degrees, sentinel).
                    if (pitchShare > 0.0f)
                        mTip.mBodyLean = std::clamp(pitchShare * (mTip.mEl - restEl), osg::DegreesToRadians(-25.0f),
                                             osg::DegreesToRadians(20.0f))
                            * (1.0f - std::clamp(mTip.mRestGrip, 0.0f, 1.0f));
                }
                // Hard swings lean the torso into them (user bookmark 14,
                // 2026-09-30: "torso should rotate but also lean a bit on hard
                // swings"): a committed stroke or a clicked strike pitches the
                // chest forward by up to this many degrees, by the stroke's
                // size. OPENMW_RAGDOLL_TIP_SWING_LEAN (0 = off; lean is
                // positive back). FIX-08 guided/fast-drag + SWING-02: 6/7 pass
                // at 8 and at 0 (the differing case flaky either way).
                static const auto swingLean_tuned = RagdollCore::tuned<float>([] { return osg::DegreesToRadians(weaponDriveSetting("OPENMW_RAGDOLL_TIP_SWING_LEAN", 8.0f)); });
                static const auto& swingLean = swingLean_tuned.get();
                if (swingLean > 0.0f && !bare && swingRigVersion() < 2)
                {
                    const bool hard = (mTip.mMode == TipController::Mode::Drag && mTip.mCommitTimer > 0.0f)
                        || mTip.mMode == TipController::Mode::Strike;
                    const float size = mTip.mMode == TipController::Mode::Strike ? 1.0f : 0.5f + 0.5f * mCommitSwishSize;
                    const float wanted = hard ? -swingLean * size : 0.0f;
                    const float rate = (hard ? 6.0f : 3.0f) * duration;
                    mTip.mSwingLean += std::clamp(wanted - mTip.mSwingLean, -rate, rate);
                    mTip.mBodyLean = std::clamp(mTip.mBodyLean + mTip.mSwingLean, osg::DegreesToRadians(-25.0f),
                        osg::DegreesToRadians(20.0f));
                }
                // A punch turns the body into it: the wind-up draws the right
                // shoulder back, the strike drives it forward past square
                // (play test 2026-09-24 C1: "punches with the right hand should
                // rotate the torso and hips for full extension").
                // OPENMW_RAGDOLL_TIP_PUNCH_TWIST degrees (0 = off). Twist is
                // positive to the right, i.e. right shoulder back.
                static const auto punchTwist_tuned = RagdollCore::tuned<float>([] { return osg::DegreesToRadians(weaponDriveSetting("OPENMW_RAGDOLL_TIP_PUNCH_TWIST", 15.0f)); });
                static const auto& punchTwist = punchTwist_tuned.get();
                if (bare && punchTwist > 0.0f)
                {
                    if (mTip.mMode == TipController::Mode::WindUp)
                        mTip.mBodyTwist = 0.4f * punchTwist;
                    else if (mTip.mMode == TipController::Mode::Strike)
                        mTip.mBodyTwist = -punchTwist;
                }
            }
            // The grip is on the weapon shoulder's line to the tip, a little
            // below it, so the arm is the lever and the wrist stays near
            // neutral. On the chest-to-tip line the hand sat on the body's
            // midline, the forearm pointed across the chest, and the wrist
            // limit turned the claymore blade 90 degrees to the left.
            static const auto gripDrop_tuned = RagdollCore::tuned<float>([] { return weaponDriveSetting("OPENMW_RAGDOLL_TIP_GRIP_DROP", 0.15f); });
            static const auto& gripDrop = gripDrop_tuned.get();
            const JPH::RVec3 anchor = *rightShoulder;
            const JPH::Vec3 fromShoulder(tipPoint - anchor);
            const float shoulderDistance = fromShoulder.Length();
            const JPH::Vec3 along = fromShoulder.NormalizedOr(frame.mForward);
            // A low or cross-body tip is close to the shoulder: at 0.35 of the
            // reach the hand folded against it and the elbow flared sideways
            // (longsword, 2026-09-23 play test). OPENMW_RAGDOLL_TIP_HAND_MIN.
            float handDistance = std::clamp(shoulderDistance - tipDistance, handMin * armReach, 0.92f * armReach);
            float drop = gripDrop * armReach;
            // A fist's reach is from its shoulder: measured from the chest a
            // "full reach" punch stopped 29-33 units out, bent, and below the
            // shoulder line (fists replay). OPENMW_RAGDOLL_TIP_PUNCH_REACH=0
            // restores the chest-measured fist.
            static const auto punchReach_tuned = RagdollCore::tuned<bool>([] { return weaponDriveSetting("OPENMW_RAGDOLL_TIP_PUNCH_REACH", 1.0f) > 0.0f; });
            static const auto& punchReach = punchReach_tuned.get();
            if (!bare && mTip.mThrust
                && (mTip.mMode == TipController::Mode::Strike || mTip.mMode == TipController::Mode::WindUp))
            {
                handDistance = std::clamp(shoulderDistance - tipDistance, handMin * armReach, 0.98f * armReach);
                drop = 0.0f;
            }
            if (bare && punchReach)
            {
                handDistance = std::clamp(mTip.mRadius, handMin * armReach, 0.98f * armReach);
                if (mTip.mMode == TipController::Mode::Strike || mTip.mMode == TipController::Mode::WindUp)
                    drop = 0.0f;
            }
            JPH::RVec3 grip = anchor + JPH::RVec3(along * handDistance - frame.mUp * drop);
            // Not behind the shoulder plane: reaching back there flipped the
            // IK elbow and the commanded tip jumped 30-40 units in a step.
            const float behind = JPH::Vec3(grip - anchor).Dot(frame.mForward);
            if (behind < -4.0f)
                grip += JPH::RVec3(frame.mForward * (-4.0f - behind));
            // Resting (guard or walking carry, not dragged, no attack): the
            // hands sit low and the blade points up from them to the tip, as
            // in the Mixamo guards (great sword: hands 0.4 arm lengths ahead,
            // 0.75 under the shoulder, 0.2 toward the midline; sword and
            // shield: the sword hand low beside the hip). On the tip line a
            // raised guard put the hands at the shoulders and the warhammer
            // over the head ("positions are kind of wrong and unnatural",
            // 2026-09-26). Eases in and out (5/s) so a drag starts from here.
            // OPENMW_RAGDOLL_TIP_REST_GRIP = ahead,up,inward (two hands),
            // _TIP_REST_GRIP_ONE = the same for one hand; arm lengths.
            if (!bare)
            {
                static const auto restTwo_tuned = RagdollCore::tuned<std::array<float, 3>>([] {
                    std::array<float, 3> v{ 0.40f, -0.70f, 0.20f };
                    if (const char* text = RagdollCore::tuningText("OPENMW_RAGDOLL_TIP_REST_GRIP"))
                        std::sscanf(text, "%f,%f,%f", &v[0], &v[1], &v[2]);
                    return v;
                });
                static const auto& restTwo = restTwo_tuned.get();
                static const auto restOne_tuned = RagdollCore::tuned<std::array<float, 3>>([] {
                    std::array<float, 3> v{ 0.30f, -0.60f, -0.30f };
                    if (const char* text = RagdollCore::tuningText("OPENMW_RAGDOLL_TIP_REST_GRIP_ONE"))
                        std::sscanf(text, "%f,%f,%f", &v[0], &v[1], &v[2]);
                    return v;
                });
                static const auto& restOne = restOne_tuned.get();
                // Back in the guard after a click the hands go straight to the
                // rest, while the attack clip is still finishing: waiting for it
                // carried the grip up the shoulder-to-tip line to shoulder
                // height and then dropped it to the waist, a second swing after
                // every chop (look attack 2026-09-26: the hand rose 33-37 units
                // after the strike's low point). OPENMW_RAGDOLL_TIP_REST_AFTER_STRIKE=0
                // waits for the clip.
                static const auto restAfterStrike_tuned = RagdollCore::tuned<bool>([] { return weaponDriveSetting("OPENMW_RAGDOLL_TIP_REST_AFTER_STRIKE", 1.0f) > 0.0f; });
                static const auto& restAfterStrike = restAfterStrike_tuned.get();
                const bool resting = mTip.mMode == TipController::Mode::Guard && !held && (attackIdle || restAfterStrike);
                const float step = 5.0f * duration;
                const float wanted = resting ? 1.0f : 0.0f;
                if (mTip.mMode == TipController::Mode::Drag && mTip.mDragSettle > 0.0f)
                    mTip.mRestGrip = std::min(mTip.mRestGrip, mTip.mDragSettle); // leaves as the drag moves
                else
                    mTip.mRestGrip = std::abs(wanted - mTip.mRestGrip) > step
                        ? mTip.mRestGrip + std::copysign(step, wanted - mTip.mRestGrip)
                        : wanted;
                if (mTip.mRestGrip > 0.0f)
                {
                    const auto& rest = mWeapon->mTwoHanded ? restTwo : restOne;
                    const JPH::RVec3 restPoint = *rightShoulder
                        + JPH::RVec3((frame.mForward * rest[0] + frame.mUp * rest[1] - frame.mRight * rest[2]) * armReach);
                    grip += (restPoint - grip) * mTip.mRestGrip;
                }
            }
            JPH::Vec3 direction = JPH::Vec3(tipPoint - grip).NormalizedOr(along);
            // Pose map (see activePoseMap): in a drag the grip, blade, elbow
            // pole and chest twist come from the map at the commanded tip.
            std::optional<JPH::Vec3> mapPole;
            {
                const PoseMap* map = activePoseMap(bare);
                // OPENMW_RAGDOLL_POSE_MAP=2: committed strokes go back to the
                // strike solve (the map's closer grip slowed the fast
                // longsword drag under the strike threshold: FIX-08 0 strikes
                // from 26 contacts on two of three attacks).
                static const auto mapStrokes_tuned = RagdollCore::tuned<bool>([] {
                    const char* text = RagdollCore::tuningText("OPENMW_RAGDOLL_POSE_MAP");
                    return !(text && std::atoi(text) == 2);
                });
                static const auto& mapStrokes = mapStrokes_tuned.get();
                const bool wanted = map && mTip.mMode == TipController::Mode::Drag && (mapStrokes || !committed);
                mPoseMapBlend = std::clamp(mPoseMapBlend + (wanted ? 1.0f : -1.0f) * duration / 0.15f, 0.0f, 1.0f);
                if (map && mPoseMapBlend > 0.0f)
                {
                    const PoseMapCell cell
                        = map->sample(osg::RadiansToDegrees(mTip.mAz), osg::RadiansToDegrees(mTip.mEl));
                    const auto toWorld = [&](JPH::Vec3Arg v) {
                        return frame.mRight * v.GetX() + frame.mForward * v.GetY() + frame.mUp * v.GetZ();
                    };
                    const osg::Vec3f feet = actor.getRefData().getPosition().asVec3();
                    const JPH::RVec3 mapGrip = JPH::RVec3(feet.x(), feet.y(), feet.z()) + JPH::RVec3(toWorld(cell.mGrip));
                    const float w = mPoseMapBlend;
                    // OPENMW_RAGDOLL_POSE_PARTS bits: 1 grip, 2 blade, 4 elbow, 8 twist.
                    static const auto parts_tuned = RagdollCore::tuned<int>([] {
                        const char* text = RagdollCore::tuningText("OPENMW_RAGDOLL_POSE_PARTS");
                        return text ? std::atoi(text) : 15;
                    });
                    static const auto& parts = parts_tuned.get();
                    // The hands keep the strike lever's reach in the guard
                    // heights (the captured grips sit ~15 units before the
                    // chest: the fast longsword drag lost its strikes, FIX-08
                    // 0/3); the map takes the grip over toward the wind-ups.
                    const float gripShare = std::clamp((osg::RadiansToDegrees(mTip.mEl) - 40.0f) / 50.0f, 0.0f, 1.0f);
                    if (parts & 1)
                        grip += (mapGrip - grip) * (w * gripShare);
                    // The blade direction too: the strike lever points it at the
                    // commanded tip, which the fast drags need to land.
                    const float bladeShare = w * gripShare;
                    if (parts & 2)
                        direction = (direction * (1.0f - bladeShare) + toWorld(cell.mBlade) * bladeShare).NormalizedOr(direction);
                    if (parts & 4)
                        mapPole = toWorld(cell.mPole);
                    if (parts & 8)
                        mTip.mBodyTwist += (osg::DegreesToRadians(cell.mTwist) - mTip.mBodyTwist) * w;
                }
            }
            // Hilt control (alpha 0.9.1, user 2026-10-02: "the pointing of the
            // tip ... is on a 2D plane but it should traverse a sphere ... the
            // arms should only extend when a sharp motion is made"; "a full
            // wind up would have the blade be reaching almost 180 degrees";
            // control the hands, the blade follows). In a drag the mouse turns
            // the hands' direction from the shoulders like a trackball (local
            // yaw and pitch, the roll levelled away from the vertical): no
            // azimuth/elevation, so nothing flips over the top, and the hands
            // go over the head and round behind either shoulder; only the
            // body itself stops them. The arms stay bent (half the reach)
            // until the motion is sharp; the blade points out along the hands
            // and trails their motion; the chest turns with the hands' side
            // and the elbows rise overhead. OPENMW_RAGDOLL_HILT=1 on.
            {
                // 1 = one-handed weapons (the two-handed support arm held the
                // claymore back chaotically: side reach 42-135 degrees between
                // runs), 2 = every weapon, 0 = off.
                // Two-handed (2) only with the shoulders open from the guard
                // (claymore side reach 16-66 -> 140 degrees, wind-up behind
                // -0.02 -> 0.62), which costs the claymore's click attacks
                // (FIX-08 guided claymore 0/2): opt-in.
                static const auto hiltMode_tuned = RagdollCore::tuned<int>([] { return static_cast<int>(weaponDriveSetting("OPENMW_RAGDOLL_HILT", 1.0f)); });
                static const auto& hiltMode = hiltMode_tuned.get();
                const bool hiltWanted = hiltMode > 0 && !bare && (hiltMode >= 2 || !narrowGrip())
                    && mTip.mMode == TipController::Mode::Drag;
                const auto toBody = [&](JPH::Vec3Arg v) {
                    return JPH::Vec3(v.Dot(frame.mRight), v.Dot(frame.mForward), v.Dot(frame.mUp));
                };
                const auto toWorldFrame = [&](JPH::Vec3Arg v) {
                    return frame.mRight * v.GetX() + frame.mForward * v.GetY() + frame.mUp * v.GetZ();
                };
                if (hiltWanted && !mHiltActive)
                {
                    const JPH::Vec3 start = toBody(JPH::Vec3(*hand - frame.mPivot)).NormalizedOr(JPH::Vec3::sAxisY());
                    mHiltRotation = JPH::Quat::sFromTo(JPH::Vec3::sAxisY(), start);
                    mHiltReach = static_cast<float>((*hand - frame.mPivot).Length());
                    mHiltStartBlade = toBody(*handRotation * mWeapon->mBladeAxis).NormalizedOr(JPH::Vec3::sAxisZ());
                    mHiltTravel = 0.0f;
                    mHiltPrevious = start;
                    mHiltRate = 0.0f;
                    mHiltVelocity = JPH::Vec3::sZero();
                    mHiltActive = true;
                }
                else if (!hiltWanted)
                    mHiltActive = false;
                if (!mHiltActive)
                    mHiltWeight = 0.0f;
                mHiltBlend = std::clamp(mHiltBlend + (mHiltActive ? 1.0f : -1.0f) * duration / 0.12f, 0.0f, 1.0f);
                if (mHiltActive && duration > 0.0f)
                {
                    const JPH::Quat before = mHiltRotation;
                    float yaw = -dx * perUnit, pitch = dy * perUnit;
                    // No faster than a committed swing (the excess mouse travel
                    // is dropped, as the old command's rate limit did): a
                    // 288-degree flick in 0.1 s ran the hands round behind the
                    // other shoulder far ahead of the blade (FIX-08 fast drag).
                    const float turnMax = std::max(commit[1], 8.0f) * duration;
                    const float turn = std::hypot(yaw, pitch);
                    if (turn > turnMax)
                    {
                        yaw *= turnMax / turn;
                        pitch *= turnMax / turn;
                    }
                    mHiltTravel += std::min(turn, turnMax);
                    if (yaw != 0.0f)
                        mHiltRotation = (JPH::Quat::sRotation(mHiltRotation * JPH::Vec3::sAxisZ(), yaw) * mHiltRotation).Normalized();
                    if (pitch != 0.0f)
                        mHiltRotation = (JPH::Quat::sRotation(mHiltRotation * JPH::Vec3::sAxisX(), pitch) * mHiltRotation).Normalized();
                    JPH::Vec3 d = mHiltRotation * JPH::Vec3::sAxisY();
                    // Not through the body: behind the chest at chest height or
                    // below, or down into the legs.
                    const bool intoBody = (d.GetY() < -0.15f && std::abs(d.GetX()) < 0.55f && d.GetZ() < 0.25f)
                        || (d.GetZ() < -0.75f && d.GetY() < 0.35f);
                    if (intoBody)
                    {
                        mHiltRotation = before;
                        d = mHiltRotation * JPH::Vec3::sAxisY();
                    }
                    // Level the roll away from the vertical (right stays right).
                    if (std::abs(d.GetZ()) < 0.85f)
                    {
                        const JPH::Vec3 level = d.Cross(JPH::Vec3::sAxisZ()).NormalizedOr(JPH::Vec3::sAxisX());
                        const JPH::Vec3 right = mHiltRotation * JPH::Vec3::sAxisX();
                        const float roll = std::atan2(right.Cross(level).Dot(d), right.Dot(level));
                        mHiltRotation = (JPH::Quat::sRotation(d, roll * std::min(1.0f, 4.0f * duration)) * mHiltRotation).Normalized();
                    }
                    const JPH::Vec3 velocity = (d - mHiltPrevious) / duration;
                    const float k = std::min(1.0f, duration / 0.05f);
                    mHiltVelocity += (velocity - mHiltVelocity) * k;
                    mHiltRate += (velocity.Length() - mHiltRate) * k;
                    mHiltPrevious = d;
                    // Bent until sharp: half the reach slow, nearly full at the
                    // commit rate and through a committed stroke.
                    const float sharp = mTip.mCommitTimer > 0.0f ? 1.0f
                        : commit[0] > 0.0f ? std::clamp(mHiltRate / commit[0], 0.0f, 1.0f) : 0.5f;
                    // Behind the shoulders the arm cannot reach as far: shorter
                    // there, or the hands trailed the goal by 40-56 units.
                    const float behind = std::clamp(-d.GetY(), 0.0f, 1.0f);
                    static const auto behindShorten_tuned = RagdollCore::tuned<float>([] { return weaponDriveSetting("OPENMW_RAGDOLL_HILT_BEHIND", 0.35f); });
                    static const auto& behindShorten = behindShorten_tuned.get();
                    const float wantReach = armReach * (0.5f + 0.42f * sharp) * (1.0f - behindShorten * behind);
                    // Eased from where the hands are (AIM-02: drawn straight in
                    // to half the reach, every drag first moved the tip toward
                    // the body, a drag up went down, cos -0.78); out fast for a
                    // sharp stroke, in slower.
                    const float easeRate = armReach * (wantReach > mHiltReach ? 4.0f : 1.5f) * duration;
                    mHiltReach += std::clamp(wantReach - mHiltReach, -easeRate, easeRate);
                    const JPH::RVec3 hiltGrip = frame.mPivot + JPH::RVec3(toWorldFrame(d) * mHiltReach);
                    // The blade out along the hands, a little up in the guards,
                    // trailing the motion when it is sharp.
                    JPH::Vec3 trail = mHiltVelocity.NormalizedOr(JPH::Vec3::sZero()) * (0.6f * sharp);
                    const float over = std::clamp((d.GetZ() - 0.3f) / 0.6f, 0.0f, 1.0f);
                    // The blade is the hands' direction turned up by an angle
                    // that shrinks slowly as the hands rise - 35 degrees from
                    // low hands, 15 level, 0 overhead - so raising the hands
                    // always raises the tip. (Along the hands' own line, low
                    // hands turned the blade down: AIM-02 drag up cos -0.37; a
                    // fast-shrinking lift tilted a claymore's long blade down
                    // faster than the hands rose: cos -0.92.)
                    const float dz = std::clamp(d.GetZ(), -1.0f, 1.0f);
                    const float raise = osg::DegreesToRadians(dz < 0.0f ? 15.0f + 20.0f * std::min(1.0f, -dz / 0.8f)
                                                                         : 15.0f * (1.0f - dz));
                    const JPH::Vec3 raiseAxis = d.Cross(JPH::Vec3::sAxisZ());
                    const JPH::Vec3 raised = raiseAxis.LengthSq() > 1e-6f
                        ? JPH::Quat::sRotation(raiseAxis.Normalized(), raise) * d : d;
                    JPH::Vec3 bladeBody = (raised - trail).NormalizedOr(raised);
                    // The wrist only cocks so far: the blade is half the forearm's
                    // line (POSEMAP-02 with the blade along the hands alone:
                    // wrist excess p90 7-24 degrees). OPENMW_RAGDOLL_HILT_WRIST =
                    // the forearm's share (0 = off).
                    static const auto wristShare_tuned = RagdollCore::tuned<float>([] { return weaponDriveSetting("OPENMW_RAGDOLL_HILT_WRIST", 0.5f); });
                    static const auto& wristShare = wristShare_tuned.get();
                    if (wristShare > 0.0f && mCurrentPhysicsPoseCaptured)
                        if (const auto elbow = mRagdoll->getWorldBodyPosition(mCurrentPhysicsPose, mRightArm->mElbow))
                        {
                            // Only in the front guards: overhead and behind the
                            // wind-up needs the blade round (with the forearm's
                            // line everywhere the claymore went 14 degrees to
                            // the side instead of 160).
                            const float windup = std::max(behind, over);
                            const float share = wristShare * (1.0f - windup);
                            const JPH::Vec3 forearm = toBody(JPH::Vec3(*hand - *elbow)).NormalizedOr(bladeBody);
                            bladeBody = (bladeBody * (1.0f - share) + forearm * share).NormalizedOr(bladeBody);
                        }
                    // Elbows down and out in the guards, up and out overhead.
                    const JPH::Vec3 poleBody = (JPH::Vec3(0.45f, 0.0f, -0.9f) * (1.0f - over)
                        + JPH::Vec3(0.8f, -0.2f, 0.55f) * over).NormalizedOr(JPH::Vec3(0.45f, 0.0f, -0.9f));
                    // The old drag takes the first 30 degrees of travel (it
                    // leaves the rest the mouse's way, AIM-02); the hilt fades
                    // in over them.
                    // Two-handed grips (shoulders open from the guard) take the
                    // hilt at once: the old start ran with the open shoulders and
                    // drove a drag up downward (AIM-02 claymore up cos -0.93).
                    const float w = mHiltBlend
                        * (narrowGrip() ? 1.0f : std::clamp(mHiltTravel / osg::DegreesToRadians(30.0f), 0.0f, 1.0f));
                    mHiltWeight = w;
                    grip += (hiltGrip - grip) * w;
                    direction = (direction * (1.0f - w) + toWorldFrame(bladeBody) * w).NormalizedOr(direction);
                    mapPole = mapPole ? (*mapPole * (1.0f - w) + toWorldFrame(poleBody) * w).NormalizedOr(*mapPole)
                                      : toWorldFrame(poleBody);
                    // The chest turns toward the hands' side (up to 60 degrees).
                    const float twist = std::clamp(std::asin(std::clamp(d.GetX(), -1.0f, 1.0f)) * 0.8f,
                        osg::DegreesToRadians(-60.0f), osg::DegreesToRadians(60.0f));
                    mTip.mBodyTwist += (twist - mTip.mBodyTwist) * w;
                    // The angle state follows the hilt below the vertical (the
                    // aim indicator, edge logic and tests read it).
                    if (std::abs(d.GetZ()) < 0.97f)
                    {
                        const JPH::Vec3 tipFromPivot = JPH::Vec3(grip - frame.mPivot) + direction * tipDistance;
                        const auto [hiltAz, hiltEl] = frame.angles(tipFromPivot);
                        mTip.mAz = hiltAz;
                        mTip.mEl = hiltEl;
                    }
                }
            }
            const auto shape = bare ? std::optional<RagdollCore::WeaponShapeProfile>() : RagdollCore::weaponShapeProfile(mWeapon->mRecordId);
            const RagdollCore::WeaponStrikeAxes axes{ bare ? JPH::Vec3::sAxisY() : mWeapon->mBladeAxis,
                shape ? shape->mEdgeAxis : bare ? JPH::Vec3::sAxisX() : mWeapon->mEdgeAxis };
            // Which edge leads is read from the authored hold only while the
            // weapon rests in the guard: during a strike the attack clip
            // swings the animation hand around, the reading flipped and the
            // commanded weapon rolled 130-170 degrees in one step (play test
            // 2026-09-24: warhammer/axe "rotates the hammer around").
            if (!bare && mTip.mMode == TipController::Mode::Guard && mAnimationAttack.mPhase == MWMechanics::RagdollAttackPhase::Idle)
                updateCanonicalEdgeSign(axes, frame.mRight, frame.mUp);
            std::optional<JPH::Quat> world = bare ? std::optional<JPH::Quat>(*handRotation)
                                                  : canonicalWeaponHandRotation(axes, direction, frame.mRight, frame.mUp, JPH::Vec3::sZero());
            // An edge leads the stroke (2b): the handshake roll puts the edge
            // in the body's sagittal plane, so a sideways sweep - most drags -
            // struck with the flat (user session 2026-09-28: 53% of claymore
            // hits flat, haft or glancing, 19% clean). The stroke is the
            // controller's own rate-limited tip velocity, not the bursty mouse
            // that made the 2026-09-23 stroke roll jump; the roll stays within
            // 90 degrees of the handshake (forearm twist), keeps its side when
            // the stroke is exactly sideways, and turns at a bounded rate.
            // Blades only: an axe or hammer head has a front and a back.
            // OPENMW_RAGDOLL_TIP_EDGE_LEAD="full speed units/s,turn deg/s" (0 = off).
            static const auto edgeLead_tuned = RagdollCore::tuned<std::array<float, 2>>([] {
                std::array<float, 2> value{ 400.0f, 540.0f };
                if (const char* text = RagdollCore::tuningText("OPENMW_RAGDOLL_TIP_EDGE_LEAD"))
                    std::sscanf(text, "%f,%f", &value[0], &value[1]);
                return value;
            });
            static const auto& edgeLead = edgeLead_tuned.get();
            if (!bare && edgeLead[0] > 0.0f)
            {
                const JPH::Vec3 blade = direction.NormalizedOr(JPH::Vec3::sZero());
                const JPH::Vec3 handshake = canonicalWeaponEdge(blade, frame.mRight, frame.mUp) * mCanonicalEdgeSign;
                float wanted = 0.0f;
                JPH::Vec3 across = mSwing.mVelocity - blade * mSwing.mVelocity.Dot(blade);
                const float speed = across.Length();
                if (!handshake.IsNearZero() && speed > 1e-3f)
                {
                    across /= speed;
                    float angle = std::atan2(blade.Dot(handshake.Cross(across)), handshake.Dot(across));
                    if (!shape)
                    {
                        // Either edge of a blade may lead: stay within the
                        // forearm's twist.
                        if (angle > 0.5f * osg::PIf)
                            angle -= osg::PIf;
                        else if (angle < -0.5f * osg::PIf)
                            angle += osg::PIf;
                        if (std::abs(std::abs(angle) - 0.5f * osg::PIf) < osg::DegreesToRadians(15.0f)
                            && angle * mTip.mRoll < 0.0f)
                            angle = -angle;
                    }
                    else
                    {
                        // An axe or hammer head has one striking face: turn it
                        // into the stroke while the forearm can (up to 90
                        // degrees); a stroke behind it is a backhand that leads
                        // with the back of the head, so the grip stays put.
                        if (std::abs(angle) > osg::DegreesToRadians(100.0f))
                            angle = 0.0f;
                        angle = std::clamp(angle, -0.5f * osg::PIf, 0.5f * osg::PIf);
                    }
                    wanted = angle * std::clamp(speed / edgeLead[0], 0.0f, 1.0f);
                }
                const float turn = osg::DegreesToRadians(edgeLead[1]) * duration;
                mTip.mRoll += std::clamp(wanted - mTip.mRoll, -turn, turn);
                if (!handshake.IsNearZero() && !blade.IsNearZero())
                    world = RagdollCore::alignedStrikeHandRotation(
                        axes, blade, JPH::Quat::sRotation(blade, mTip.mRoll) * handshake);
            }
            // Wrist comfort at rest (user 2026-09-28: "I can't get the proper
            // wrists ... a good % of the time"). Built backwards from the blade,
            // the resting hand took whatever bend pointed the blade: in a
            // settled guard the weapon wrist was more than 45 degrees off the
            // animation's wrist 79-100% of the time with long weapons (dagger
            // 0-27%). Resting (the low rest grip), the hand blends toward the
            // animation's wrist bend on the physical forearm, and the blade
            // points where that puts it; drags and strikes keep the tip.
            // OPENMW_RAGDOLL_TIP_WRIST_COMFORT = blend at full rest (0 = off).
            static const auto wristComfort_tuned = RagdollCore::tuned<float>([] { return weaponDriveSetting("OPENMW_RAGDOLL_TIP_WRIST_COMFORT", 0.8f); });
            static const auto& wristComfort = wristComfort_tuned.get();
            if (!bare && world && wristComfort > 0.0f && mTip.mRestGrip > 0.0f && mRightArm)
            {
                const auto forearm = mRagdoll->getWorldBodyRotation(mCurrentPhysicsPose, mRightArm->mElbow);
                const auto animationForearm = mRagdoll->getWorldBodyRotation(mMotorTargetPose, mRightArm->mElbow);
                const auto animationHand = mRagdoll->getWorldBodyRotation(mMotorTargetPose, mRightArm->mHand);
                if (forearm && animationForearm && animationHand)
                {
                    JPH::Quat natural = (*forearm * animationForearm->Conjugated() * *animationHand).Normalized();
                    if (natural.Dot(*world) < 0.0f)
                        natural = -natural;
                    world = world->SLERP(natural, std::clamp(wristComfort * mTip.mRestGrip, 0.0f, 1.0f)).Normalized();
                }
            }
            const auto model = world ? mRagdoll->getModelRotation(*world) : std::nullopt;
            if (!mRightArmTarget)
                mRightArmTarget.emplace();
            auto& request = *mRightArmTarget;
            request.mBrace = request.mWeaponSupport = request.mReleasing = false;
            claimArm(request, ArmOwner::Tip);
            request.mWorldTarget = grip;
            // The elbow follows the blade around the shoulder (user bookmarks
            // 16/17, 2026-09-30: "why is the elbow always pointing inside with
            // the sword? it should be able to rotate around the shoulder", "it
            // looks like I'm getting kimura'd"): the pole was always down and a
            // little out. Flaring it during drags cost strikes (FIX-08 fast drag
            // longsword 0/5 with, 2/2 without; removed 10-12) - only the
            // resting guard flares (below); a drag keeps the flaring pole's
            // weight with no flare.
            // Only a weapon steered slowly or resting: fists and fast strokes
            // keep the old pole (the flare cost those strikes, bisect 10-01).
            const bool flareAllowed = !bare && !(mTip.mCommitTimer > 0.0f)
                && (mTip.mMode == TipController::Mode::Drag || mTip.mMode == TipController::Mode::Guard);
            // The resting guard alone (ELBOW-01, 2026-10-01: a guard left
            // high after a drag had the elbow in across the chest on 30% of
            // frames; play 53% with the tip back over the right shoulder). No
            // strike starts from a flared pole: any drag or commit drops it.
            // OPENMW_RAGDOLL_TIP_GUARD_FLARE = scale (0 = off). On (1) since
            // 2026-10-01: ELBOW-01 guard inward 0.30 -> 0.14 (back-right spot
            // 0.87 -> 0.41, unwound within ~0.8 s); combat stage 7/14 against
            // 15/28 off.
            static const auto guardFlare_tuned = RagdollCore::tuned<float>([] { return weaponDriveSetting("OPENMW_RAGDOLL_TIP_GUARD_FLARE", 1.0f); });
            static const auto& guardFlare = guardFlare_tuned.get();
            const bool guardFlareAllowed = guardFlare > 0.0f && !bare && !(mTip.mCommitTimer > 0.0f)
                && mTip.mMode == TipController::Mode::Guard && !held;
            // Only a guard turned well right (past 45 degrees, full at 90; the
            // inward guards are the tip back over the right shoulder): the
            // default guard faces forward and is where drags and strikes
            // start, and a flare there cost them (combat stage 0/7 and 2/7
            // against 3/7 and 4/7: fast and held longsword drags).
            // Unwinding after a drag that went back past 100 degrees right
            // (ELBOW-01: the guard after it kept the arm wound in across the
            // chest on 87% of frames, though its tip was back at the front;
            // the pole weight had no effect, only the pole's direction):
            // for a second in the guard after such a drag, the pole flares.
            if (mTip.mMode != TipController::Mode::Guard)
            {
                if (mTip.mAz > osg::DegreesToRadians(100.0f))
                    mTipWoundBack = true;
                mTipUnwindTimer = 0.0f;
            }
            else if (mTipWoundBack)
            {
                mTipWoundBack = false;
                mTipUnwindTimer = 1.0f;
            }
            mTipUnwindTimer = std::max(0.0f, mTipUnwindTimer - duration);
            // Only the unwind: a guard flared whenever it turned past 45
            // degrees right cost strikes (combat stage 9/28 against 15/28 -
            // FIX-08's drags wind to ~72 degrees and the next blow started
            // from a flared guard).
            const float guardRight = mTipUnwindTimer > 0.0f ? 1.0f : 0.0f;
            const float flare = guardFlareAllowed ? guardFlare * guardRight : 0.0f;
            const bool flaring = guardFlareAllowed || flareAllowed;
            const float flareRight
                = flaring ? std::clamp(mTip.mAz / osg::DegreesToRadians(90.0f), 0.0f, 1.0f) : 0.0f;
            const float flareHigh
                = flaring ? std::clamp(mTip.mEl / osg::DegreesToRadians(60.0f), 0.0f, 1.0f) : 0.0f;
            request.mWorldBend = (frame.mRight * (0.35f + flare * (0.9f * flareRight + 0.8f * flareHigh))
                - frame.mUp * (1.0f - flare * 0.8f * flareHigh))
                                     .NormalizedOr(-frame.mUp);
            if (mapPole)
                request.mWorldBend
                    = (request.mWorldBend * (1.0f - mPoseMapBlend) + *mapPole * mPoseMapBlend).NormalizedOr(*mapPole);
            // A short blade (dagger) is steered by its grip alone and carried
            // on the forearm: ordered to a blade direction its wrist sat 22-25
            // degrees past the limit and the blade jumped on flicks, where the
            // approved build's forearm-carried dagger stayed inside (G1, G6).
            static const auto orientLength_tuned = RagdollCore::tuned<float>([] { return weaponDriveSetting("OPENMW_RAGDOLL_TIP_ORIENT_LENGTH", 30.0f); });
            static const auto& orientLength = orientLength_tuned.get();
            // A thrusting short blade points along the thrust: carried on the
            // forearm it sat off the line and never touched the target
            // (FIX-08 dagger: 0 contacts in 9 thrusts).
            const bool thrusting = mTip.mThrust && mTip.mMode != TipController::Mode::Guard;
            const bool orient = tipDistance > orientLength || (thrusting && !bare);
            mTipOrients = orient;
            if (!orient)
            {
                request.mHandRotation.reset();
                request.mHandAimOffset = JPH::Vec3::sZero();
            }
            else if (model)
                request.mHandRotation = *model;
            // The IK prices the wrist as tool-tip distance; without the aim
            // offset it ignored the blade direction and the one-handed guards
            // drifted 60-90 degrees to the left.
            if (const auto tip = mRagdoll->getModelVector(direction * tipDistance); tip && orient)
                request.mHandAimOffset = axes.mLongAxis * tip->Length();
            request.mRequestedWeight = 1.0f;
            request.mBlendRate = profile.mBlendRate;
            mTipDirection = direction;
            mTipDesiredGrip = grip;
            // A grip-steered short blade's command is its grip; its tip is
            // wherever the forearm points the blade.
            mTipDesiredTip = bare ? grip
                                  : grip + JPH::RVec3((mTipOrients ? direction : *handRotation * mWeapon->mBladeAxis) * tipDistance);
            mTipDesiredRotation = world;
            mSwingArmIsRight = true;
            // Contact bookkeeping keeps its meaning: a drag or a strike is a
            // swing; the guard is not.
            const bool swinging = mTip.mMode != TipController::Mode::Guard;
            mSwing.mSwinging = swinging;
            // A swinging bare fist is a physical strike, as on the old path.
            mPlayerStrikeActive = swinging && bare;
            mSwing.mHeld = held;
            mSwing.mVelocity = frame.direction(mTip.mAz + 0.5f * osg::PIf, 0.0f) * (mTip.mAzRate * mTip.mRadius)
                + frame.mUp * (mTip.mElRate * mTip.mRadius);
            if (!swinging)
                mPlayerAttackType.clear();
#ifdef OPENMW_RAGDOLL_DEV_API
            static const auto traceStrokes_tuned = RagdollCore::tuned<bool>([] { return RagdollCore::tuningText("OPENMW_RAGDOLL_SWING_TRACE") != nullptr; });
            static const auto& traceStrokes = traceStrokes_tuned.get();
            if (traceStrokes)
            {
                auto& t = mStrokeTrace;
                const bool ended = t.mSwing != mSwingIdentity || !swinging;
                if (ended && t.mModes != 0 && t.mCommandPeak > 50.0f)
                    Log(Debug::Info) << "RAGDOLL_STROKE weapon=" << (bare ? std::string("fists") : mWeapon->mRecordId)
                                     << " modes=" << t.mModes << " time=" << t.mTime
                                     << " command_peak=" << t.mCommandPeak << " physical_peak=" << t.mPhysicalPeak
                                     << " govern_min=" << t.mGovernMin << " gap_max=" << t.mGapMax
                                     << " control=" << control << " omega=" << omega << " alpha=" << alpha;
                if (ended)
                {
                    const auto last = t.mLastTip;
                    t = {};
                    t.mSwing = mSwingIdentity;
                    t.mLastTip = last;
                }
                const JPH::RVec3 physicalTip
                    = bare ? *hand : *hand + JPH::RVec3(*handRotation * mWeapon->mBladeAxis * tipDistance);
                if (swinging)
                {
                    t.mModes |= 1u << static_cast<unsigned>(mTip.mMode);
                    if (committed)
                        t.mModes |= 16u;
                    t.mTime += duration;
                    t.mCommandPeak = std::max(t.mCommandPeak, std::hypot(mTip.mAzRate, mTip.mElRate) * mTip.mRadius);
                    if (t.mLastTip && duration > 0.0f)
                        t.mPhysicalPeak = std::max(t.mPhysicalPeak,
                            static_cast<float>((physicalTip - *t.mLastTip).Length()) / duration);
                    if (mTip.mMode == TipController::Mode::Drag)
                        t.mGovernMin = std::min(t.mGovernMin, mTipGovernScale);
                }
                t.mLastTip = physicalTip;
            }
#endif
            return true;
        }

        // Arm reseat on draw (user 2026-09-28: "the wrist gets twisted, then it
        // won't come back even after wielding/unwielding multiple times",
        // claymore). The recording showed the support hand's forearm wound the
        // other way round: 30-110 degrees off its command for seconds, and after
        // a fresh draw 42 degrees off a correct command that the motor could not
        // unwind. Starting a draw puts both arms (upper arm, forearm, hand) at
        // the animation's arm pose about the physical chest, moving with it, and
        // carries the held weapon along with its hand. OPENMW_RAGDOLL_ARM_RESEAT=0
        // turns it off.
        // Put one arm (upper arm, forearm, hand) at a pose about the physical
        // collarbone, moving with it, and carry the held weapon rigidly along.
        void seatArmAtPose(const RagdollArmChain& arm, const RagdollCore::RagdollPose& pose)
        {
            const auto frame = mRagdoll->getWorldBodyPosition(mCurrentPhysicsPose, arm.mFrame);
            const auto frameRotation = mRagdoll->getWorldBodyRotation(mCurrentPhysicsPose, arm.mFrame);
            const auto poseFrame = mRagdoll->getWorldBodyPosition(pose, arm.mFrame);
            const auto poseFrameRotation = mRagdoll->getWorldBodyRotation(pose, arm.mFrame);
            const auto oldHand = mRagdoll->getWorldBodyPosition(mCurrentPhysicsPose, arm.mHand);
            const auto oldHandRotation = mRagdoll->getWorldBodyRotation(mCurrentPhysicsPose, arm.mHand);
            if (!frame || !frameRotation || !poseFrame || !poseFrameRotation || !oldHand || !oldHandRotation)
                return;
            const JPH::Quat toPhysical = (*frameRotation * poseFrameRotation->Conjugated()).Normalized();
            std::optional<JPH::RVec3> newHand;
            std::optional<JPH::Quat> newHandRotation;
            for (const std::size_t body : { arm.mShoulder, arm.mElbow, arm.mHand })
            {
                const auto position = mRagdoll->getWorldBodyPosition(pose, body);
                const auto rotation = mRagdoll->getWorldBodyRotation(pose, body);
                if (!position || !rotation)
                    return;
                const JPH::RVec3 seated = *frame + JPH::RVec3(toPhysical * JPH::Vec3(*position - *poseFrame));
                const JPH::Quat seatedRotation = (toPhysical * *rotation).Normalized();
                if (!mRagdoll->setBodyWorldTransform(body, seated, seatedRotation, arm.mFrame))
                    return;
                if (body == arm.mHand)
                {
                    newHand = seated;
                    newHandRotation = seatedRotation;
                }
            }
            if (mWeapon && mWeapon->mAttached && mWeapon->mHandBody == arm.mHand && newHand && newHandRotation)
            {
                const auto weapon = mRagdoll->getWorldBodyPosition(mCurrentPhysicsPose, mWeapon->mWeaponBody);
                const auto weaponRotation = mRagdoll->getWorldBodyRotation(mCurrentPhysicsPose, mWeapon->mWeaponBody);
                if (weapon && weaponRotation)
                {
                    const JPH::Quat delta = (*newHandRotation * oldHandRotation->Conjugated()).Normalized();
                    mRagdoll->setBodyWorldTransform(mWeapon->mWeaponBody,
                        *newHand + JPH::RVec3(delta * JPH::Vec3(*weapon - *oldHand)), (delta * *weaponRotation).Normalized(),
                        arm.mFrame);
                }
            }
        }
        bool mReseatDrawn = false;
        void reseatArmsOnDraw()
        {
            static const auto enabled_tuned = RagdollCore::tuned<bool>([] { return weaponDriveSetting("OPENMW_RAGDOLL_ARM_RESEAT", 1.0f) > 0.0f; });
            static const auto& enabled = enabled_tuned.get();
            const MWWorld::Ptr actor = getPtr();
            if (actor.isEmpty() || !actor.getClass().isActor())
                return;
            const bool drawn = actor.getClass().getCreatureStats(actor).getDrawState() == MWMechanics::DrawState::Weapon;
            const bool starting = drawn && !mReseatDrawn;
            mReseatDrawn = drawn;
            if (!enabled || !starting || !mRagdoll || !mPowered || !mCurrentPhysicsPoseCaptured)
                return;
            const RagdollCore::RagdollPose& animation = mMotorTargetPose;
            for (const auto* arm : { mLeftArm ? &*mLeftArm : nullptr, mRightArm ? &*mRightArm : nullptr })
            {
                if (!arm)
                    continue;
                const auto frame = mRagdoll->getWorldBodyPosition(mCurrentPhysicsPose, arm->mFrame);
                const auto frameRotation = mRagdoll->getWorldBodyRotation(mCurrentPhysicsPose, arm->mFrame);
                const auto animationFrame = mRagdoll->getWorldBodyPosition(animation, arm->mFrame);
                const auto animationFrameRotation = mRagdoll->getWorldBodyRotation(animation, arm->mFrame);
                if (!frame || !frameRotation || !animationFrame || !animationFrameRotation)
                    continue;
                const JPH::Quat toPhysical = (*frameRotation * animationFrameRotation->Conjugated()).Normalized();
                const auto oldHand = mRagdoll->getWorldBodyPosition(mCurrentPhysicsPose, arm->mHand);
                const auto oldHandRotation = mRagdoll->getWorldBodyRotation(mCurrentPhysicsPose, arm->mHand);
                std::optional<JPH::RVec3> newHand;
                std::optional<JPH::Quat> newHandRotation;
                bool complete = true;
                for (const std::size_t body : { arm->mShoulder, arm->mElbow, arm->mHand })
                {
                    const auto position = mRagdoll->getWorldBodyPosition(animation, body);
                    const auto rotation = mRagdoll->getWorldBodyRotation(animation, body);
                    if (!position || !rotation)
                    {
                        complete = false;
                        break;
                    }
                    const JPH::RVec3 seated = *frame + JPH::RVec3(toPhysical * JPH::Vec3(*position - *animationFrame));
                    const JPH::Quat seatedRotation = (toPhysical * *rotation).Normalized();
                    if (!mRagdoll->setBodyWorldTransform(body, seated, seatedRotation, arm->mFrame))
                    {
                        complete = false;
                        break;
                    }
                    if (body == arm->mHand)
                    {
                        newHand = seated;
                        newHandRotation = seatedRotation;
                    }
                }
                // The weapon is jointed to its hand: carry it rigidly along.
                if (complete && mWeapon && mWeapon->mAttached && mWeapon->mHandBody == arm->mHand && oldHand
                    && oldHandRotation && newHand && newHandRotation)
                {
                    const auto weapon = mRagdoll->getWorldBodyPosition(mCurrentPhysicsPose, mWeapon->mWeaponBody);
                    const auto weaponRotation = mRagdoll->getWorldBodyRotation(mCurrentPhysicsPose, mWeapon->mWeaponBody);
                    if (weapon && weaponRotation)
                    {
                        const JPH::Quat delta = (*newHandRotation * oldHandRotation->Conjugated()).Normalized();
                        mRagdoll->setBodyWorldTransform(mWeapon->mWeaponBody,
                            *newHand + JPH::RVec3(delta * JPH::Vec3(*weapon - *oldHand)),
                            (delta * *weaponRotation).Normalized(), arm->mFrame);
                    }
                }
            }
            // Controller memory of the old wrist goes with it.
            mSwingHandRotation.reset();
            ++mArmReseatCount;
        }
