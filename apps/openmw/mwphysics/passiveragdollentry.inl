            // missed (or armed for) starts it here.
            if (rollOwnsBody())
                return;
            if (dropRollSettings().mOn)
            {
                if (mRollPhase == RollPhase::Armed)
                {
                    if (impact >= 0.85f * dropRollFrom() && dropRollCanRun())
                    {
                        beginDropRoll(impact);
                        return;
                    }
                    resetDropRoll("light");
                }
                else if (impact >= dropRollFrom() && dropRollArm(impact, 0.0f))
                {
                    beginDropRoll(impact);
                    return;
                }
            }
            const auto& l = smartLanding();
            if (!l.mOn)
                return;
            mLandingCrouchPeak = std::min(l.mMaximum, std::max(0.0f, impact) * l.mPerSpeed);
            mLandingCrouchAge = 0.0f;
            // A bad landing: the momentum carries the body past its feet.
            if (mSituationKnown && mSituation.mSupported && mSituation.mCaptureMargin < -l.mStumbleMargin)
            {
                const JPH::Vec3 command(mRawTargetHorizontalVelocity.GetX(), mRawTargetHorizontalVelocity.GetY(), 0.0f);
                JPH::Vec3 carried(mSituationVelocity.GetX(), mSituationVelocity.GetY(), 0.0f);
