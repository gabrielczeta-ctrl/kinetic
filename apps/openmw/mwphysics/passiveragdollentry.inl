        RagdollCore::CatchCapability pgcCapability() const
        {
            RagdollCore::RecoveryStats stats;
            if (!getPtr().isEmpty() && getPtr().getClass().isActor())
            {
                const auto& creature = getPtr().getClass().getCreatureStats(getPtr());
                stats.mAgility = creature.getAttribute(ESM::Attribute::Agility).getModified();
                stats.mAcrobatics = getPtr().getClass().isNpc()
                    ? getPtr().getClass().getSkill(getPtr(), ESM::Skill::Acrobatics)
                    : stats.mAgility;
            }
            RagdollCore::CatchCapability capability = RagdollCore::catchCapability(stats);
            // State on top of skill (10-09, PGC robustness step 6): a tired
            // body steps shorter, slower and later; a loaded one (encumbrance
            // against capacity: armour, a heavy pack) swings its feet slower.
            // Fresh and unloaded changes nothing.
            // OPENMW_RAGDOLL_PGC_STATS=1 (0 = skill only, the old).
            static const auto stateScaled_tuned = RagdollCore::tuned<bool>([] { return weaponDriveSetting("OPENMW_RAGDOLL_PGC_STATS", 0.0f) > 0.0f; });
            static const auto& stateScaled = stateScaled_tuned.get();
            if (stateScaled && !getPtr().isEmpty() && getPtr().getClass().isActor())
            {
                const auto& creature = getPtr().getClass().getCreatureStats(getPtr());
                const auto& fatigue = creature.getFatigue();
                const float tired = fatigue.getModified() > 0.0f
                    ? 1.0f - std::clamp(fatigue.getCurrent() / fatigue.getModified(), 0.0f, 1.0f)
                    : 0.0f;
                const float capacity = getPtr().getClass().getCapacity(getPtr());
                const float load = capacity > 0.0f
                    ? std::clamp(getPtr().getClass().getEncumbrance(getPtr()) / capacity, 0.0f, 1.0f)
                    : 0.0f;
                capability.mReachFraction *= 1.0f - 0.2f * tired;
                const float slower = (1.0f + 0.35f * tired) * (1.0f + 0.25f * load);
                capability.mMinimumSwingTime *= slower;
                capability.mMaximumSwingTime *= slower;
                capability.mSwingFootSpeed /= slower;
                capability.mReactionDelay += 0.06f * tired;
            }
            return capability;
        }
