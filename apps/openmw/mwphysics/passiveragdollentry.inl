// The powered/passive ragdoll entry of one actor: its bodies, controllers,
// weapon, arms, tip control and every per-actor ragdoll state.
// Included once, inside namespace MWPhysics, by physicssystem.cpp (it relies
// on the helpers defined above the include there); not a standalone header.

    struct PassiveRagdollEntry final : PtrHolder
    {
        using SurfaceQuery = std::function<std::optional<std::pair<JPH::RVec3, JPH::Vec3>>(
            JPH::RVec3Arg, JPH::Vec3Arg, float)>;

        // Soft-root fighters: apart from hands and weapons, two different
        // powered bodies do not collide. Their capsules keep them a capsule-width
        // apart while the bodies are wider, so they always overlapped and each
        // balance spring shoved its body into the other (shaking, drift, falls).
        // Arms, hands and weapons still hit everything.
        std::vector<JPH::BodyID> mSoftRootCoreBodies; // sorted
        bool isSoftRootCoreBody(const JPH::BodyID& id) const
        {
            return std::binary_search(mSoftRootCoreBodies.begin(), mSoftRootCoreBodies.end(), id);
        }
        // A blade left embedded in another fighter when its swing is over
        // (a fast chop rotates through a torso within one step; LinearCast
        // sweeps only linear motion) passes out of the body instead of being
        // pinned there, where the solver's push-out read as a ~300 u/s strike
        // (FIX-08 longsword). OPENMW_RAGDOLL_EMBED_RELEASE_DEPTH, units; 0 = off.
        std::atomic<bool> mContactSwinging{ false };
        std::atomic<std::uint32_t> mContactWeaponBody{ JPH::BodyID::cInvalidBodyID };
        // The weapon body follows the equipped slot, not the draw state: a
        // sheathed weapon is invisible but stayed on the hand as a solid body
        // that could catch the walking legs (2026-09-24 play test: tripping,
        // crossed feet and a stuck gait only with the battle axe sheathed).
        // It touches nothing until drawn.
        std::atomic<bool> mContactWeaponSheathed{ false };
        // A sheathed weapon also weighs (nearly) nothing: its full mass left
        // on the swinging hand twisted the upper spine +-22 degrees while
        // walking, against +-8.5 drawn (2026-09-24 play test Q1).
        std::optional<float> mWeaponDrawnMass;
        bool mWeaponMassSheathed = false;
        void updateSheathedWeaponMass(bool sheathed)
        {
            if (!mWeapon || !mRagdoll)
                return;
            // A released (dropped) weapon keeps its body: give it its mass back.
            if (!mWeapon->mAttached)
                sheathed = false;
            static const auto enabled_tuned = RagdollCore::tuned<bool>([] {
                const char* text = RagdollCore::tuningText("OPENMW_RAGDOLL_SHEATHED_MASS");
                return !(text && std::atoi(text) == 0);
            });
            static const auto& enabled = enabled_tuned.get();
            if (!enabled || sheathed == mWeaponMassSheathed)
                return;
            const auto& masses = mRagdoll->getBodyMasses();
            if (!mWeaponDrawnMass && mWeapon->mWeaponBody < masses.size())
                mWeaponDrawnMass = masses[mWeapon->mWeaponBody];
            if (!mWeaponDrawnMass)
                return;
            if (mRagdoll->setBodyMass(mWeapon->mWeaponBody, sheathed ? 0.02f * *mWeaponDrawnMass : *mWeaponDrawnMass))
                mWeaponMassSheathed = sheathed;
        }
        // The weapon arm's springs are raised for the weapon's weight when the
        // rig is built (RAGDOLL_WEAPON_ARM_LOAD: a claymore's right arm up to
        // 1000-1240 Hz) and stayed so sheathed, where the weapon weighs 2%: the
        // stiff right arm followed the run clip's swing while the left lagged
        // (user 10-30 play: "one arm moves more than the other when running";
        // a sheathed warhammer swung the left hand 20 units, the right 31).
        // Sheathed, the right arm takes the left arm's springs; drawn, its own
        // again. OPENMW_RAGDOLL_SHEATHED_ARM=0 = off.
        bool mSheathedArmMirrored = false;
        void updateSheathedArmSprings(bool sheathed)
        {
            static const auto enabled_tuned = RagdollCore::tuned<bool>([] {
                const char* text = RagdollCore::tuningText("OPENMW_RAGDOLL_SHEATHED_ARM");
                return !(text && std::atoi(text) == 0);
            });
            if (!enabled_tuned.get() || !mRagdoll || !mRuntimeProfile || !mLeftArm || !mRightArm || mFallProtectRunning)
                return;
            if (!mWeapon || !mWeapon->mAttached)
                sheathed = false;
            if (!sheathed && !mSheathedArmMirrored)
                return;
            const auto& bodies = mRuntimeProfile->mBodies;
            const std::array<std::pair<std::size_t, std::size_t>, 3> pairs{ { { mRightArm->mShoulder, mLeftArm->mShoulder },
                { mRightArm->mElbow, mLeftArm->mElbow }, { mRightArm->mHand, mLeftArm->mHand } } };
            for (const auto& [right, left] : pairs)
            {
                const std::size_t from = sheathed ? left : right;
                if (right >= bodies.size() || from >= bodies.size() || !bodies[from].mConstraint
                    || !bodies[right].mConstraint)
                    continue;
                const auto& motor = bodies[from].mConstraint->mMotor;
                mRagdoll->setMotorSpring(right, motor.mFrequency, motor.mDamping);
            }
            mSheathedArmMirrored = sheathed;
        }
        void publishContactState()
        {
            if (!getPtr().isEmpty() && getPtr().getClass().isActor())
            {
                const auto& stats = getPtr().getClass().getCreatureStats(getPtr());
                const float weight = (stats.getAttribute(ESM::Attribute::Strength).getModified()
                                         + stats.getAttribute(ESM::Attribute::Endurance).getModified())
                    / 100.0f;
                mContactBodyWeight.store(std::clamp(weight, 0.5f, 2.0f), std::memory_order_relaxed);
            }
            mContactSwinging.store(mSwing.mSwinging, std::memory_order_relaxed);
            mContactWeaponSheathed.store(mWeapon && mWeapon->mAttached && !getPtr().isEmpty()
                    && getPtr().getClass().isActor()
                    && getPtr().getClass().getCreatureStats(getPtr()).getDrawState() != MWMechanics::DrawState::Weapon,
                std::memory_order_relaxed);
            updateSheathedWeaponMass(mContactWeaponSheathed.load(std::memory_order_relaxed));
            updateSheathedArmSprings(mContactWeaponSheathed.load(std::memory_order_relaxed));
            mContactWeaponBody.store(mWeapon && mWeapon->mAttached && mRagdoll
                    ? mRagdoll->getBodyId(mWeapon->mWeaponBody).GetIndexAndSequenceNumber()
                    : JPH::BodyID::cInvalidBodyID,
                std::memory_order_relaxed);
        }
        void onContactSettings(const JPH::Body& selfBody, const JPH::Body& withBody,
            const JPH::ContactManifold& manifold, JPH::ContactSettings& ioSettings) override
        {
            static const auto embedDepth_tuned = RagdollCore::tuned<float>([] {
                const char* text = RagdollCore::tuningText("OPENMW_RAGDOLL_EMBED_RELEASE_DEPTH");
                return text ? static_cast<float>(std::atof(text)) : 1.0f;
            });
            static const auto& embedDepth = embedDepth_tuned.get();
            if (selfBody.GetID().GetIndexAndSequenceNumber() != mContactWeaponBody.load(std::memory_order_relaxed)
                || !withBody.IsDynamic())
                return;
            static const auto trace_tuned = RagdollCore::tuned<bool>([] { return RagdollCore::tuningText("OPENMW_RAGDOLL_EMBED_TRACE") != nullptr; });
            static const auto& trace = trace_tuned.get();
            if (trace)
            {
                static std::atomic<int> rows{ 0 };
                if (rows.fetch_add(1) < 3000)
                    Log(Debug::Info) << "RAGDOLL_EMBED depth=" << manifold.mPenetrationDepth
                                     << " swinging=" << mContactSwinging.load(std::memory_order_relaxed)
                                     << " other=" << (withBody.GetUserData() != selfBody.GetUserData());
            }
            if (embedDepth <= 0.0f || manifold.mPenetrationDepth <= embedDepth
                || mContactSwinging.load(std::memory_order_relaxed))
                return;
            PtrHolder* other = Misc::Convert::toPointerFromUserData<PtrHolder>(withBody.GetUserData());
            if (other != nullptr && other != this && dynamic_cast<const PassiveRagdollEntry*>(other) != nullptr)
                ioSettings.mIsSensor = true;
        }

        // Body against body (user bookmark 15, 2026-09-30: "strength or some
        // other stat - endurance? - should define how much a ragdoll pushes
        // another when they come into contact"): in a contact with another
        // fighter's body each side's limbs weigh (Strength + Endurance) / 100,
        // 0.5..2, so the stronger body shoves and the weaker gives way.
        // OPENMW_RAGDOLL_BODY_PUSH_STATS=0 turns it off.
        std::atomic<float> mContactBodyWeight{ 1.0f };
        void onContactSettingsSided(const JPH::Body& selfBody, const JPH::Body& withBody,
            const JPH::ContactManifold& manifold, JPH::ContactSettings& ioSettings, bool selfIsFirst) override
        {
            onContactSettings(selfBody, withBody, manifold, ioSettings);
            static const auto enabled_tuned = RagdollCore::tuned<bool>([] {
                // On: BODYPUSH-01 x2 - strong into weak shoves it 284-298 u in
                // 3 s (83-85 with equal masses), weak into strong 3-5 u (79-83).
                const char* text = RagdollCore::tuningText("OPENMW_RAGDOLL_BODY_PUSH_STATS");
                return !(text && std::atoi(text) == 0);
            });
            static const auto& enabled = enabled_tuned.get();
            if (!enabled || ioSettings.mIsSensor || !withBody.IsDynamic()
                || selfBody.GetID().GetIndexAndSequenceNumber() == mContactWeaponBody.load(std::memory_order_relaxed))
                return;
            PtrHolder* other = Misc::Convert::toPointerFromUserData<PtrHolder>(withBody.GetUserData());
            const auto* otherEntry = other != nullptr && other != this ? dynamic_cast<const PassiveRagdollEntry*>(other) : nullptr;
            if (otherEntry == nullptr
                || withBody.GetID().GetIndexAndSequenceNumber() == otherEntry->mContactWeaponBody.load(std::memory_order_relaxed))
                return;
            // Relative to the other body: equal fighters keep their own masses
            // (scale 1); the stronger side is heavier only against a weaker one.
            const float selfWeight = std::max(0.25f, mContactBodyWeight.load(std::memory_order_relaxed));
            const float otherWeight = std::max(0.25f, otherEntry->mContactBodyWeight.load(std::memory_order_relaxed));
            const float inverse = 2.0f * otherWeight / (selfWeight + otherWeight);
            if (selfIsFirst)
            {
                ioSettings.mInvMassScale1 = inverse;
                ioSettings.mInvInertiaScale1 = inverse;
            }
            else
            {
                ioSettings.mInvMassScale2 = inverse;
                ioSettings.mInvInertiaScale2 = inverse;
            }
        }

        bool onContactValidatePair(const JPH::Body& selfBody, const JPH::Body& withBody) override
        {
            if (mContactWeaponSheathed.load(std::memory_order_relaxed)
                && selfBody.GetID().GetIndexAndSequenceNumber() == mContactWeaponBody.load(std::memory_order_relaxed))
                return false;
            if (mSoftRootCoreBodies.empty() || !isSoftRootCoreBody(selfBody.GetID()))
                return true;
            PtrHolder* other = Misc::Convert::toPointerFromUserData<PtrHolder>(withBody.GetUserData());
            if (other == nullptr || other == this)
                return true;
            const auto* otherEntry = dynamic_cast<const PassiveRagdollEntry*>(other);
            return otherEntry == nullptr || !otherEntry->isSoftRootCoreBody(withBody.GetID());
        }

        explicit PassiveRagdollEntry(
            const MWWorld::Ptr& ptr, std::uint64_t serial, MWRender::JoltDebugDrawer* debugDrawer)
            : PtrHolder(ptr, ptr.getRefData().getPosition().asVec3())
            , mDebugDrawer(debugDrawer)
            , mSerial(serial)
        {
        }

        void onContactAdded(const JPH::Body&, const JPH::ContactManifold& manifold, JPH::ContactSettings&) override
        {
            if (mDebugDrawer == nullptr)
                return;
            JPH::RVec3 position = manifold.mBaseOffset;
            if (!manifold.mRelativeContactPointsOn1.empty() && !manifold.mRelativeContactPointsOn2.empty())
            {
                const JPH::RVec3 point1 = manifold.GetWorldSpaceContactPointOn1(0);
                const JPH::RVec3 point2 = manifold.GetWorldSpaceContactPointOn2(0);
                position = point1 + (point2 - point1) * 0.5f;
            }
            mDebugDrawer->addCollision(
                Misc::Convert::toOsg(position), Misc::Convert::toOsg(manifold.mWorldSpaceNormal));
        }

        void onContactObserved(const JPH::Body& selfBody, const JPH::Body& withBody,
            const JPH::ContactManifold& manifold, bool firstBody, float friction) override
        {
            if (mRagdoll && (firstBody || selfBody.GetUserData() != withBody.GetUserData()) && mFixedSteps < 16
                && RagdollCore::tuningText("OPENMW_RAGDOLL_REPLAY_POSE_TRACE"))
            {
                int first = -1, second = -1;
                for (std::size_t i = 0; i < mRagdoll->getBodyCount(); ++i)
                {
                    if (mRagdoll->getBodyId(i) == selfBody.GetID()) first = static_cast<int>(i);
                    if (mRagdoll->getBodyId(i) == withBody.GetID()) second = static_cast<int>(i);
                }
                if (!firstBody) std::swap(first, second);
                const auto& one = firstBody ? selfBody : withBody;
                const auto& two = firstBody ? withBody : selfBody;
                Log(Debug::Info) << std::dec << std::setprecision(17)
                    << "RAGDOLL_STARTUP_CONTACT step=" << mFixedSteps << " first=" << first << " second=" << second
                    << " first_id=" << one.GetID().GetIndexAndSequenceNumber()
                    << " second_id=" << two.GetID().GetIndexAndSequenceNumber()
                    << " sub1=" << manifold.mSubShapeID1.GetValue() << " sub2=" << manifold.mSubShapeID2.GetValue()
                    << " points=" << manifold.mRelativeContactPointsOn1.size() << " depth=" << manifold.mPenetrationDepth
                    << " normal=" << manifold.mWorldSpaceNormal.GetX() << ',' << manifold.mWorldSpaceNormal.GetY() << ',' << manifold.mWorldSpaceNormal.GetZ();
            }
            if (mRagdoll && mFixedSteps < 16 && withBody.IsStatic())
                if (const char* directory = RagdollCore::tuningText("OPENMW_RAGDOLL_REPLAY_SHAPE_DIR"))
                {
                    std::scoped_lock lock(mContactMutex);
                    const auto id = withBody.GetID().GetIndexAndSequenceNumber();
                    if (mReplayShapeIds.size() < 8 && std::find(mReplayShapeIds.begin(), mReplayShapeIds.end(), id) == mReplayShapeIds.end())
                    {
                        mReplayShapeIds.push_back(id);
                        const auto path = std::filesystem::path(directory) / ("ground-" + std::to_string(id) + ".jolt");
                        std::ofstream file(path, std::ios::binary);
                        JPH::StreamOutWrapper stream(file);
                        JPH::Shape::ShapeToIDMap shapes;
                        JPH::Shape::MaterialToIDMap materials;
                        withBody.GetShape()->SaveWithChildren(stream, shapes, materials);
                        const auto p = withBody.GetPosition(); const auto q = withBody.GetRotation();
                        Log(Debug::Info) << std::dec << std::setprecision(17)
                            << "RAGDOLL_REPLAY_GROUND body_id=" << id << " saved=" << !stream.IsFailed()
                            << " position=" << p.GetX() << ',' << p.GetY() << ',' << p.GetZ()
                            << " rotation=" << q.GetX() << ',' << q.GetY() << ',' << q.GetZ() << ',' << q.GetW()
                            << " friction=" << withBody.GetFriction() << " restitution=" << withBody.GetRestitution();
                    }
                }
            if (mRagdoll == nullptr)
                return;
            if (selfBody.GetUserData() == withBody.GetUserData())
            {
                // Self contact. Count leg-against-leg contacts: a swing leg
                // that brushes the stance leg is held back by it, which is
                // invisible in every other channel.
                const auto indexOf = [&](const JPH::BodyID& id) -> std::optional<std::size_t> {
                    for (std::size_t i = 0; i < mRagdoll->getBodyCount(); ++i)
                        if (mRagdoll->getBodyId(i) == id)
                            return i;
                    return std::nullopt;
                };
                const auto inLeg = [](const std::optional<RagdollLegChain>& leg, std::size_t body) {
                    return leg && (body == leg->mHip || body == leg->mKnee || body == leg->mFoot);
                };
                const auto self = indexOf(selfBody.GetID());
                const auto other = indexOf(withBody.GetID());
                // A retained dropped weapon still shares userData, but is no
                // longer in the measured actor assembly. Its contacts can
                // support a foot. Observe only this external-assembly pair in
                // the BAL meter; preserve the production self-contact path.
                if (balanceMeasurementEnabled() && self && other && mWeapon && !mWeapon->mAttached
                    && *other == mWeapon->mWeaponBody)
                {
                    std::scoped_lock lock(mContactMutex);
                    observeBalanceContact(*self, selfBody, withBody, manifold, firstBody, friction);
                }
#ifdef OPENMW_RAGDOLL_DEV_API
                // Observe the two-hand grip without suppressing any collision.
                // The normal contact channel intentionally excludes self contacts.
                if (self && other && mWeapon
                    && (*self == mWeapon->mWeaponBody || *other == mWeapon->mWeaponBody)
                    && (RagdollCore::tuningText("OPENMW_RAGDOLL_TWO_HAND_TRACE")
                        || RagdollCore::tuningText("OPENMW_RAGDOLL_WEAPON_GEOMETRY_TRACE")))
                {
                    std::scoped_lock lock(mContactMutex);
                    const std::uint64_t traceRow = mWeaponSelfTraceRows++;
                    if (traceRow < 2048)
                    {
                        Log(Debug::Info) << "RAGDOLL_WEAPON_SELF_CONTACT actor=" << mSerial
                            << " step=" << mCurrentContactPhysicsStep << " first=" << *self
                            << " second=" << *other << " depth=" << manifold.mPenetrationDepth
                            << " support=" << mWeaponSupportActive;
                        // Emit once per canonical manifold orientation. These are
                        // collision-time transforms, not the later solved telemetry.
                        if (firstBody && RagdollCore::tuningText("OPENMW_RAGDOLL_WEAPON_GEOMETRY_TRACE"))
                        {
                            std::ostringstream row;
                            row << std::dec << std::setprecision(17)
                                << "RAGDOLL_WEAPON_CONTACT_GEOMETRY schema=1 actor_serial=" << mSerial
                                << " geometry_id=" << mWeapon->mGeometryTraceId
                                << " step=" << mCurrentContactPhysicsStep << " trace_row=" << traceRow
                                << " timing=narrowphase_before_solve first=" << *self << " second=" << *other
                                << " first_id=" << selfBody.GetID().GetIndexAndSequenceNumber()
                                << " second_id=" << withBody.GetID().GetIndexAndSequenceNumber()
                                << " sub1=" << manifold.mSubShapeID1.GetValue()
                                << " sub2=" << manifold.mSubShapeID2.GetValue()
                                << " depth=" << manifold.mPenetrationDepth
                                << " normal_1_to_2=" << manifold.mWorldSpaceNormal.GetX() << ','
                                << manifold.mWorldSpaceNormal.GetY() << ',' << manifold.mWorldSpaceNormal.GetZ()
                                << " points=" << manifold.mRelativeContactPointsOn1.size();
                            unsigned bodyNumber = 1;
                            for (const JPH::Body* body : { &selfBody, &withBody })
                            {
                                const auto p = body->GetPosition();
                                const auto com = body->GetCenterOfMassPosition();
                                const auto q = body->GetRotation();
                                const auto bounds = body->GetShape()->GetLocalBounds();
                                row << " body" << bodyNumber << "_origin=" << p.GetX() << ',' << p.GetY() << ',' << p.GetZ()
                                    << " body" << bodyNumber << "_com=" << com.GetX() << ',' << com.GetY() << ',' << com.GetZ()
                                    << " body" << bodyNumber << "_quat_xyzw=" << q.GetX() << ',' << q.GetY() << ',' << q.GetZ() << ',' << q.GetW()
                                    << " body" << bodyNumber << "_shape_subtype=" << static_cast<unsigned>(body->GetShape()->GetSubType())
                                    << " body" << bodyNumber << "_shape_com=" << body->GetShape()->GetCenterOfMass().GetX() << ','
                                    << body->GetShape()->GetCenterOfMass().GetY() << ',' << body->GetShape()->GetCenterOfMass().GetZ()
                                    << " body" << bodyNumber << "_local_min=" << bounds.mMin.GetX() << ',' << bounds.mMin.GetY() << ',' << bounds.mMin.GetZ()
                                    << " body" << bodyNumber << "_local_max=" << bounds.mMax.GetX() << ',' << bounds.mMax.GetY() << ',' << bounds.mMax.GetZ();
                                ++bodyNumber;
                            }
                            Log(Debug::Info) << row.str();
                            for (JPH::uint point = 0; point < manifold.mRelativeContactPointsOn1.size(); ++point)
                            {
                                const auto one = manifold.GetWorldSpaceContactPointOn1(point);
                                const auto two = manifold.GetWorldSpaceContactPointOn2(point);
                                Log(Debug::Info) << std::dec << std::setprecision(17)
                                    << "RAGDOLL_WEAPON_CONTACT_POINT schema=1 actor_serial=" << mSerial
                                    << " geometry_id=" << mWeapon->mGeometryTraceId
                                    << " step=" << mCurrentContactPhysicsStep << " trace_row=" << traceRow
                                    << " point=" << point
                                    << " world1=" << one.GetX() << ',' << one.GetY() << ',' << one.GetZ()
                                    << " world2=" << two.GetX() << ',' << two.GetY() << ',' << two.GetZ();
                            }
                        }
                    }
                    else if (traceRow == 2048 && RagdollCore::tuningText("OPENMW_RAGDOLL_WEAPON_GEOMETRY_TRACE"))
                        Log(Debug::Info) << std::dec << "RAGDOLL_WEAPON_CONTACT_GEOMETRY_TRUNCATED schema=1 actor_serial="
                            << mSerial << " geometry_id=" << mWeapon->mGeometryTraceId
                            << " step=" << mCurrentContactPhysicsStep << " callback_row_cap=2048";
                }
#endif
                if (self && other
                    && ((inLeg(mLeftLeg, *self) && inLeg(mRightLeg, *other))
                        || (inLeg(mRightLeg, *self) && inLeg(mLeftLeg, *other))))
                {
                    std::scoped_lock lock(mContactMutex);
                    ++mLegSelfContacts;
                    mLegSelfContactDepth = std::max(mLegSelfContactDepth, manifold.mPenetrationDepth);
                }
                return;
            }
            std::optional<std::size_t> bodyIndex;
            for (std::size_t i = 0; i < mRagdoll->getBodyCount(); ++i)
            {
                if (mRagdoll->getBodyId(i) == selfBody.GetID())
                {
                    bodyIndex = i;
                    break;
                }
            }
            if (!bodyIndex)
                return;
#ifdef OPENMW_RAGDOLL_DEV_API
            // Hand-strike contact diagnosis: why a fist contact does or does
            // not become a published strike event.
            if (mRightArm && *bodyIndex == mRightArm->mHand
                && RagdollCore::tuningText("OPENMW_RAGDOLL_HAND_CONTACT_TRACE"))
            {
                static unsigned handRows = 0;
                if (handRows < 300)
                {
                    ++handRows;
                    Log(Debug::Info) << "RAGDOLL_HAND_CONTACT ai_strike=" << mAiStrikeActive
                        << " player_strike=" << mPlayerStrikeActive
                        << " weapon=" << (mWeapon ? 1 : 0)
                        << " with_layer=" << static_cast<int>(withBody.GetObjectLayer())
                        << " with_static=" << withBody.IsStatic()
                        << " swing=" << mSwing.mSwinging
                        << " self_layer=" << static_cast<int>(selfBody.GetObjectLayer());
                }
            }
#endif
            std::scoped_lock lock(mContactMutex);
            if (withBody.GetObjectLayer() == Layers::RAGDOLL || withBody.GetObjectLayer() == Layers::DEBRIS)
                ++mOtherRagdollContacts;
            // A strike surface is the weapon when one is held, otherwise the
            // striking hand itself: an unarmed fighter's fist must publish
            // contacts just like a blade does, or a hand-to-hand duel has no
            // way to land a blow. An AI strike publishes from the right hand
            // it drives; the player's mouse-driven strike publishes from
            // whichever hand the swing owns.
            const bool weaponStrike
                = mWeapon && mWeapon->mCallbackArmed && *bodyIndex == mWeapon->mWeaponBody;
            std::optional<std::size_t> strikeHand;
            if ((mAiStrikeActive || mHscFistStrike) && mRightArm)
                strikeHand = mRightArm->mHand;
            else if (mPlayerStrikeActive)
            {
                const auto& arm = mSwingArmIsRight ? mRightArm : mLeftArm;
                if (arm)
                    strikeHand = arm->mHand;
            }
            // FIST-02: the jab's left fist strikes beside the wheel's right one.
            const bool jabStrike = mLeftJabStriking && mLeftArm && *bodyIndex == mLeftArm->mHand;
            if (jabStrike && withBody.GetObjectLayer() == Layers::RAGDOLL)
                Log(Debug::Info) << "RAGDOLL_FIST_JAB_CONTACT actor=" << getPtr().getCellRef().getRefId()
                                 << " jab=" << mJabCount;
            const bool handStrike = !weaponStrike && ((strikeHand && *bodyIndex == *strikeHand) || jabStrike);
            if (weaponStrike || handStrike)
            {
                if (weaponStrike)
                {
                    ++mWeapon->mContacts;
                    if (withBody.IsStatic())
                        ++mWeapon->mGroundContacts;
                    if (withBody.GetObjectLayer() == Layers::RAGDOLL
                        || withBody.GetObjectLayer() == Layers::DEBRIS)
                        ++mWeapon->mOtherRagdollContacts;
                }
                JPH::RVec3 point = manifold.mBaseOffset;
                if (!manifold.mRelativeContactPointsOn1.empty() && !manifold.mRelativeContactPointsOn2.empty())
                {
                    const JPH::RVec3 first = manifold.GetWorldSpaceContactPointOn1(0);
                    const JPH::RVec3 second = manifold.GetWorldSpaceContactPointOn2(0);
                    point = first + (second - first) * 0.5f;
                }
                const JPH::Vec3 normal
                    = firstBody ? manifold.mWorldSpaceNormal : -manifold.mWorldSpaceNormal;
                const JPH::Vec3 relativeVelocity
                    = selfBody.GetPointVelocity(point) - withBody.GetPointVelocity(point);
                const PtrHolder* targetHolder
                    = Misc::Convert::toPointerFromUserData<PtrHolder>(withBody.GetUserData());
                const auto* targetActor = dynamic_cast<const PassiveRagdollEntry*>(targetHolder);
                const std::optional<std::uint64_t> targetIdentity
                    = targetActor && targetActor != this ? std::optional(targetActor->mSerial) : std::nullopt;
                // DMG-01 region snapshot: which anatomical body on the target
                // was hit, resolved now against the target's own registry. The
                // consumer drops the event when the target's generation has
                // changed since, so a late event can never disable a fresh
                // body that inherited the actor.
                std::uint32_t targetBodyIndex = RagdollCore::WeaponContactEvent::sInvalidBodyIndex;
                RagdollCore::AnatomicalRegion targetRegion = RagdollCore::AnatomicalRegion::Unknown;
                if (targetActor)
                {
                    for (std::size_t i = 0; i < targetActor->mRagdoll->getBodyCount(); ++i)
                    {
                        if (targetActor->mRagdoll->getBodyId(i).GetIndexAndSequenceNumber()
                            == withBody.GetID().GetIndexAndSequenceNumber())
                        {
                            targetBodyIndex = static_cast<std::uint32_t>(i);
                            break;
                        }
                    }
                    if (targetBodyIndex < targetActor->mBodyRegions.size())
                        targetRegion = targetActor->mBodyRegions[targetBodyIndex];
                }
                RagdollCore::WoundContactSnapshot wound;
                if (handStrike
                    || (weaponStrike && mWeapon->mWoundProfile.mClass != RagdollCore::WoundClass::None))
                {
                    JPH::RVec3 weaponPoint = point;
                    JPH::RVec3 targetPoint = point;
                    if (!manifold.mRelativeContactPointsOn1.empty() && !manifold.mRelativeContactPointsOn2.empty())
                    {
                        weaponPoint = firstBody ? manifold.GetWorldSpaceContactPointOn1(0)
                                                : manifold.GetWorldSpaceContactPointOn2(0);
                        targetPoint = firstBody ? manifold.GetWorldSpaceContactPointOn2(0)
                                                : manifold.GetWorldSpaceContactPointOn1(0);
                    }
                    wound.mKind = RagdollCore::WoundKind::Bruise;
                    JPH::Vec3 tangent = relativeVelocity - normal * relativeVelocity.Dot(normal);
                    if (weaponStrike)
                    {
                        // Measured in the weapon's own axes (blade toward the
                        // tip, edge across it), for every weapon class.
                        // A measured head shape (claymore, axe, hammer) gives the
                        // striking axes and where the head starts.
                        const JPH::Quat inverse = selfBody.GetRotation().Conjugated();
                        const float gripToTip = mWeapon->tipDistanceFromHand();
                        const auto shape = RagdollCore::weaponShapeProfile(mWeapon->mRecordId);
                        const JPH::Vec3 bladeAxis = shape ? shape->mStrikeAxis : mWeapon->mBladeAxis;
                        const JPH::Vec3 edgeAxis = shape ? shape->mEdgeAxis : mWeapon->mEdgeAxis;
                        const JPH::Vec3 flatAxis = shape ? bladeAxis.Cross(edgeAxis).Normalized() : mWeapon->mFlatAxis;
                        RagdollCore::WoundProfile woundProfile = mWeapon->mWoundProfile;
                        if (shape && woundProfile.mClass == RagdollCore::WoundClass::Axe)
                            woundProfile.mStrikeStart = shape->mStrikeStart;
                        const JPH::Vec3 local = inverse * JPH::Vec3(weaponPoint - selfBody.GetCenterOfMassPosition())
                            + mWeapon->mCenterFromHand;
                        const JPH::Vec3 n = inverse * normal;
                        const JPH::Vec3 v = inverse * relativeVelocity;
                        wound.mKind = std::isfinite(gripToTip) && gripToTip > 0.0f
                            ? RagdollCore::classifyWeaponContact({ local.Dot(bladeAxis) / gripToTip,
                                  n.Dot(bladeAxis), n.Dot(edgeAxis), n.Dot(flatAxis),
                                  v.Dot(bladeAxis), relativeVelocity.Length(), relativeVelocity.Dot(normal) },
                                woundProfile)
                            : RagdollCore::WoundKind::None;
#ifdef OPENMW_RAGDOLL_DEV_API
                        if (RagdollCore::tuningText("OPENMW_RAGDOLL_WOUND_TRACE"))
                            Log(Debug::Info) << "RAGDOLL_WOUND_CLASS weapon=" << mWeapon->mRecordId
                                             << " along=" << local.Dot(bladeAxis) / gripToTip
                                             << " n_tip=" << n.Dot(bladeAxis) << " n_edge=" << n.Dot(edgeAxis)
                                             << " n_flat=" << n.Dot(flatAxis) << " kind="
                                             << RagdollCore::woundKindName(wound.mKind);
#endif
                        if (tangent.LengthSq() < 1e-4f)
                            tangent = selfBody.GetRotation() * JPH::Vec3::sAxisZ();
                    }
                    if (tangent.LengthSq() < 1e-4f)
                        tangent = normal.Cross(JPH::Vec3::sAxisX());
                    if (tangent.LengthSq() < 1e-4f)
                        tangent = JPH::Vec3::sAxisZ();
                    const JPH::Quat targetInverse = withBody.GetRotation().Conjugated();
                    wound.mTargetLocalPoint = targetInverse * JPH::Vec3(targetPoint - withBody.GetCenterOfMassPosition());
                    wound.mTargetLocalNormal = targetInverse * -normal;
                    wound.mTargetLocalTangent = targetInverse * tangent.Normalized();
                    wound.mRelativeVelocity = relativeVelocity;
                }
                const auto contactIdentity = ++mWeaponContactIdentity;
                mStepWeaponResponses.emplace(contactIdentity, std::pair{
                    JPH::SubShapeIDPair(firstBody ? selfBody.GetID() : withBody.GetID(), manifold.mSubShapeID1,
                        firstBody ? withBody.GetID() : selfBody.GetID(), manifold.mSubShapeID2),
                    static_cast<JPH::uint>(std::min(manifold.mRelativeContactPointsOn1.size(),
                        manifold.mRelativeContactPointsOn2.size())) });
                mPendingWeaponContacts.publish(RagdollCore::WeaponContactEvent(contactIdentity,
                    mSerial, targetIdentity, weaponStrike ? mWeapon->mRecordId : std::string(),
                    selfBody.GetID().GetIndexAndSequenceNumber(),
                    withBody.GetID().GetIndexAndSequenceNumber(), mCurrentContactPhysicsStep, mSwingIdentity,
                    mSwing.mSwinging || hasPhysicalFollowThrough(), point, normal, relativeVelocity.Dot(normal),
                    relativeVelocity.Length(),
                    contactAxisEffectiveMass(selfBody, withBody, point, normal),
                    targetBodyIndex, targetRegion, targetActor ? targetActor->mSerial : 0, wound));
            }
            observeBalanceContact(*bodyIndex, selfBody, withBody, manifold, firstBody, friction);
            RagdollCore::appendGroundContactObservations(mStepContacts, *bodyIndex,
                firstBody ? selfBody : withBody, firstBody ? withBody : selfBody, manifold, firstBody, friction);
        }


        // BAL-01: diagnostic data only. Contact collection and cache publication
        // never move bodies, change motor targets or consume a control budget.
        static bool balanceTelemetryEnabled()
        {
#ifdef OPENMW_RAGDOLL_DEV_API
            static const auto enabled_tuned = RagdollCore::tuned<bool>([] { return RagdollCore::tuningText("OPENMW_RAGDOLL_BALANCE_TRACE") != nullptr; });
            static const auto& enabled = enabled_tuned.get();
            return enabled;
#else
            return false;
#endif
        }

        static bool balanceAuthorityEnabled()
        {
#ifdef OPENMW_RAGDOLL_DEV_API
            static const auto enabled_tuned = RagdollCore::tuned<bool>([] {
                const char* value = RagdollCore::tuningText("OPENMW_RAGDOLL_BALANCE_AUTHORITY");
                return value != nullptr && std::string_view(value) != "0";
            });
            static const auto& enabled = enabled_tuned.get();
            return enabled;
#else
            return false;
#endif
        }

        static bool balanceMeasurementEnabled()
        {
            return balanceTelemetryEnabled() || balanceAuthorityEnabled();
        }

