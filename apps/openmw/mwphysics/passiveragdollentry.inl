                        std::array<float, 3> value{ 7.0f, 15.0f, 0.5f };
                        if (const char* text = RagdollCore::tuningText("OPENMW_RAGDOLL_PGC_TILT_HOLD"))
                            std::sscanf(text, "%f,%f,%f", &value[0], &value[1], &value[2]);
