        // actor's velocity so the existing physical controller takes over.
        void updateKinematicRoot(const RagdollCore::ActiveControllerProfile& profile, float duration,
            const JPH::PhysicsSystem& physics)
        {
            const bool routeMatches
                = profile.mLocomotionRoute == RagdollCore::LocomotionRoute::KinematicRoot;
            // Leg-against-leg self contacts recorded by the contact listener
            // since the previous update (diagnostic, consumed every step).
            std::uint32_t legContacts = 0;
            float legDepth = 0.0f;
            {
                std::scoped_lock contactLock(mContactMutex);
                legContacts = mLegSelfContacts;
                legDepth = mLegSelfContactDepth;
                mLegSelfContacts = 0;
                mLegSelfContactDepth = 0.0f;
            }
            const JPH::Quat facingRotation = Misc::Convert::toJolt(poweredActorRotation(getPtr()));
            // Bounded root yaw. The camera can spin the actor thousands of
            // degrees per second; a root that mirrors that in one fixed step
            // gets an angular velocity that flings the limbs. The body turns
            // toward the actor's facing at the profile rate and catches up
            // when the spin stops.
            JPH::Quat actorRotation = facingRotation;
            const float maximumYawRate = mRagdoll && mRagdoll->getSoftRoot().mEnabled
                ? mRagdoll->getSoftRoot().mBody.mMaximumYawRate * (JPH::JPH_PI / 180.0f)
                : profile.mKinematicRootMaximumYawRate;
            if (routeMatches && mKinematicRootFollowedRotation && duration > 0.0f && maximumYawRate > 0.0f)
            {
                const JPH::Quat delta
                    = (facingRotation * mKinematicRootFollowedRotation->Conjugated()).Normalized().EnsureWPositive();
                JPH::Vec3 axis;
                float angle = 0.0f;
                delta.GetAxisAngle(axis, angle);
                const float maximum = maximumYawRate * duration;
                if (angle > maximum)
                    actorRotation
                        = mKinematicRootFollowedRotation->SLERP(facingRotation, maximum / angle).Normalized();
            }
            const JPH::RVec3 actorPosition = Misc::Convert::toJolt<JPH::RVec3>(
                getPtr().getRefData().getPosition().asVec3());
            // Smoothed actual actor velocity: the engine integrates the actor
            // movement, so these deltas are ground truth for the clip speed.
            if (mKinematicRootHasLastPosition && duration > 0.0f)
            {
                JPH::Vec3 raw(actorPosition - mKinematicRootLastActorPosition);
                // The vertical share is kept separately: a release must carry
                // it, otherwise a body leaving the root mid-fall restarts from
                // zero vertical speed and the fall reads as floaty.
                mKinematicRootActualVerticalVelocity
                    = mKinematicRootActualVerticalVelocity * 0.65f + (raw.GetZ() / duration) * 0.35f;
                raw.SetZ(0.0f);
                // A stop carry's handoff is no travel: read as a 660 u/s
                // step it re-aimed a stopping foot at a run's landing (30
                // units past the body). The first delta holding most of what
                // is pending drops it; it lapses after 0.2 s.
                if (!mStopHandoffPending.IsNearZero())
                {
                    if (raw.Dot(mStopHandoffPending) > 0.5f * mStopHandoffPending.LengthSq())
                    {
                        raw -= mStopHandoffPending;
                        mStopHandoffPending = JPH::Vec3::sZero();
                        mStopHandoffAge = 0.0f;
                    }
                    else if ((mStopHandoffAge += duration) > 0.2f)
                    {
                        mStopHandoffPending = JPH::Vec3::sZero();
                        mStopHandoffAge = 0.0f;
                    }
                }
                raw /= duration;
                mKinematicRootActualVelocity
                    = mKinematicRootActualVelocity * 0.65f + raw * 0.35f;
            }
            mKinematicRootHasLastPosition = true;
            mKinematicRootLastActorPosition = actorPosition;
            // Hard-landing release: track the actor's vertical speed. A landing
            // above the registered threshold hands the root to the passive
            // ragdoll so the impact and recovery are physical; softer landings
            // stay kinematic and are absorbed by the limbs. The root is
            // re-taken once the body is standing and slow again.
            if (routeMatches && mPowered && !mLocomotionInterrupted)
            {
                const float actorZ = static_cast<float>(actorPosition.GetZ());
                float verticalSpeed = 0.0f;
                if (mKinematicRootHasLastZ && duration > 0.0f)
                    verticalSpeed = (actorZ - mKinematicRootLastActorZ) / duration;
                mKinematicRootHasLastZ = true;
                mKinematicRootLastActorZ = actorZ;
                mKinematicRootSmoothedFallSpeed
                    = mKinematicRootSmoothedFallSpeed * 0.9f - verticalSpeed * 0.1f;
                const float hardLandingSpeed = profile.mKinematicRootHardLandingSpeed;
                if (!mKinematicRootLandingReleased)
                {
