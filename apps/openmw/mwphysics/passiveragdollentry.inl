#endif
            // Hips share the chest's turn and the weight goes into big swings
            // (alpha 0.4 item 2, user 2026-09-30: "spread the turn over hips,
            // spine and chest ... step in and shift weight on big swings").
            const auto [hipTurn, swingShift] = swingHipsAndWeight(duration);
            const JPH::Quat targetRotation = (JPH::Quat::sRotation(JPH::Vec3::sAxisZ(), -hipTurn) * actorRotation
                * *mKinematicRootLocalRotation).Normalized();
            if (mRagdoll->getSoftRoot().mEnabled)
            {
