                // the moving weapon by IK alone it cycled through too-far and
                // too-fast for seconds after a redraw (claymore, staff never
                // regripped). While it acquires, pull it to its latched anchor on
                // the weapon with the anchor's own velocity fed forward.
                if (mTip.mActive && mLeftArm && mSupportGripFrame && !(mSupportGrip && mSupportGrip->attached())
                    && mLeftArm->mHand < telemetry.mBodies.size())
                {
                    const auto& weaponBody = telemetry.mBodies[mWeapon->mWeaponBody];
                    const auto& supportHand = telemetry.mBodies[mLeftArm->mHand];
                    const JPH::RVec3 anchor = weaponBody.mCenterOfMass
                        + JPH::RVec3(weaponBody.mRotation * mSupportGripFrame->mRequest.mSecondLocalAnchor);
                    driveBodyToward(telemetry, mLeftArm->mHand, anchor, supportHand.mRotation, mBodyDriveHistory[3],
                        JPH::Vec3::sAxisY(), supportHand.mMass * 16.0f, supportHand.mMass * 16.0f, duration);
                }
