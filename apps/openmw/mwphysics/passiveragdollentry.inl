                    Log(Debug::Info) << "RAGDOLL_WEAPON_INERTIA record=" << mWeapon->mRecordId << " mass=" << mass
                                     << " weight=" << mWeapon->mItemWeight << " carried=" << carriedMass
                                     << " length=" << mWeapon->mLength
                                     << " center_from_hand=" << mWeapon->mCenterFromHand.Length()
                                     << " grip_inertia=" << gripInertia << " momentum_alpha="
