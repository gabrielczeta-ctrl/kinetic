                // which the rule above never sees: at toe-off of every running
                // step the clip lifts the sole grounded foot, it took the whole
                // routed share and stayed on the floor for 80-95% of its lift
                // frames at 700-1000 normal impulse (stance feet 70-320),
                // 23-28 units under the clip, lifting 117-142 ms late
                // (weightless armed legs: 15% of frames, 42 ms); it then
                // whipped through and brushed down again, 4.1 contact onsets
                // a second against the clip's 3.0 (warhammer run straight,
                // runtime-SOFT-r2 vs -wb, 2026-09-25). A foot the clip holds
                // this many units above its stance level takes no routed
                // weight. The cause is not established (stance grounding and
                // phase lag are the other candidates): an experiment arm.
                // OPENMW_RAGDOLL_SOFT_ROOT_LIFT_UNROUTE="lift,rise,hold" (lift
                // in units, 0 = off; rise = how fast the stance level may
                // climb, u/s, default 40; hold = longest time the sole
                // touching foot goes unrouted, s, default 0.08).
                static const auto liftUnroute_tuned = RagdollCore::tuned<std::array<float, 3>>([] {
                    std::array<float, 3> value{ 0.0f, 40.0f, 0.08f };
                    if (const char* text = RagdollCore::tuningText("OPENMW_RAGDOLL_SOFT_ROOT_LIFT_UNROUTE"))
                        std::sscanf(text, "%f,%f,%f", &value[0], &value[1], &value[2]);
                    return value;
                });
                static const auto& liftUnroute = liftUnroute_tuned.get();
                if (liftUnroute[0] > 0.0f && mKinematicTargetFeetSeeded && !(mSoftRootJumpWindow > 0.0f))
                {
                    // Actor-relative, so a stair step of the capsule is no lift.
                    // The level follows the lower clip foot down at once and up
                    // at the rise rate: the run clip holds its stance foot ~6
                    // units above the walk's, a lifting foot rises at 150-600.
                    // A step of more than 3 units in the lower clip foot (a clip
                    // change) reseeds it, so the creep never lags a new clip.
                    const float left = static_cast<float>(mKinematicTargetLeftFoot.GetZ() - actorPosition.GetZ());
                    const float right = static_cast<float>(mKinematicTargetRightFoot.GetZ() - actorPosition.GetZ());
                    const float lowest = std::min(left, right);
                    if (!mClipFootFloor || !mClipFootLowest || std::abs(lowest - *mClipFootLowest) > 3.0f)
                        mClipFootFloor = lowest;
                    else
                        mClipFootFloor = std::min(lowest, *mClipFootFloor + liftUnroute[1] * duration);
                    mClipFootLowest = lowest;
                    const bool leftLifted = left - *mClipFootFloor >= liftUnroute[0];
                    const bool rightLifted = right - *mClipFootFloor >= liftUnroute[0];
                    bool left0 = leftGrounded && !leftLifted;
                    bool right0 = rightGrounded && !rightLifted;
                    // No grounded foot while a foot still touches only for a
                    // bounded time: the replay of both unroute rules left none
                    // for 0.25-0.27 s, past the 0.12 s air catch, which then
                    // carries the whole body (the float). The share goes to
                    // the other foot at once if it touches unlifted. When only
                    // lifted feet touch (toe-off of the sole grounded foot,
                    // the case this rule is for) none is routed for up to the
                    // hold time, then the lower touching foot takes it back.
                    // The hold adds to any stride flight that follows before
                    // the air catch sees it, so it stays below 0.12 s.
                    const bool leftTouches = mSupportEstimate && mSupportEstimate->mLeftFootSupported;
                    const bool rightTouches = mSupportEstimate && mSupportEstimate->mRightFootSupported;
                    if (left0 || right0 || (!leftTouches && !rightTouches))
                        mLiftUnrouteNoneTimer = 0.0f;
                    else if (rightTouches && !rightLifted)
                    {
                        right0 = true;
                        mLiftUnrouteNoneTimer = 0.0f;
                    }
                    else if (leftTouches && !leftLifted)
                    {
                        left0 = true;
                        mLiftUnrouteNoneTimer = 0.0f;
                    }
                    else
                    {
                        // Keeps running once past the hold, so the forced foot
                        // stays grounded until a foot is grounded on its own
                        // or none touches.
                        mLiftUnrouteNoneTimer += duration;
                        if (mLiftUnrouteNoneTimer > liftUnroute[2])
                        {
                            if (leftTouches && (!rightTouches || left <= right))
                                left0 = true;
                            else
                                right0 = true;
                        }
                    }
                    leftGrounded = left0;
                    rightGrounded = right0;
                }
                else
                {
                    mClipFootFloor.reset();
                    mClipFootLowest.reset();
                    mLiftUnrouteNoneTimer = 0.0f;
                }
