        // A flat-ground dodge roll along `travel` (the drop roll entered at its
        // absorb phase, no fall): false when the roll may not run or the lane
        // ahead is not clear and level.
        bool beginDodgeRoll(JPH::Vec3Arg travel, float speed)
        {
            const auto& s = dropRollSettings();
            if (!dropRollCanRun() || !mSurfaceQuery || !mSituationKnown)
                return false;
            const auto down = mSurfaceQuery(mSituationCom, -JPH::Vec3::sAxisZ(), 200.0f);
            if (!down)
                return false;
            const double ground = down->first.GetZ();
            for (const float ahead : { 40.0f, 80.0f, 120.0f })
            {
                const JPH::RVec3 from(mSituationCom.GetX(), mSituationCom.GetY(), ground + 40.0);
                const auto hit = mSurfaceQuery(from + JPH::RVec3(travel * ahead), -JPH::Vec3::sAxisZ(), 90.0f);
                if (!hit || hit->second.GetZ() < 0.85f || std::abs(hit->first.GetZ() - ground) > 20.0)
                    return false;
            }
            if (const auto wall = mSurfaceQuery(JPH::RVec3(mSituationCom.GetX(), mSituationCom.GetY(), ground + 30.0), travel, 150.0f);
                wall && std::abs(wall->second.GetZ()) < 0.5f)
                return false;
            mRollTravel = travel;
            mRollLand = JPH::RVec3(mSituationCom.GetX(), mSituationCom.GetY(), ground);
            mRollGround = ground;
            mRollSide = (mWeapon && mWeapon->mAttached) || rollArmBusy(1) ? -1.0f : 1.0f;
            mRollAxis = (JPH::Vec3::sAxisZ().Cross(travel) + travel * (mRollSide * s.mShoulder)).Normalized();
            mRollToBack = false;
            mRollSkill = acroRollSettings().mOn ? acroSkill() : -1.0f;
            mRollEntrySpeed = speed;
            mRollPredicted = speed;
            beginDropRoll(speed);
            Log(Debug::Info) << "RAGDOLL_DODGE roll actor=" << getPtr().getCellRef().getRefId() << " speed=" << speed
                             << " side=" << mRollSide;
            return true;
        }
