                    continue;
                const float mass = telemetry.mBodies[arm->mHand].mMass;
                mWeaponDriveActive |= driveBodyToward(telemetry, arm->mHand, *hand, handRotation->Normalized(),
                    mBodyDriveHistory[side + 1], JPH::Vec3::sAxisY(), mass * 16.0f, mass * 16.0f, duration);
            }
