        // PLAY-04 weapon roll. The roll of a held weapon about its own long
        // axis used to be integrated from history: a drag turned the edge into
        // every change of mouse direction, the first-person rest kept its own
        // previous roll, and a one-shot opposite-roll test read the current
        // arm. Circles wound the forearm (commanded weapon 84-165 degrees from
        // the first rest 1.4 s after release, native tangle witness), the rest
        // inherited it, and only a redraw read a fresh animation hand. The
        // roll is now a function of the blade direction: the edge lies in the
        // body's sagittal plane, as in a handshake grip. Turning it toward the
        // stroke (OPENMW_RAGDOLL_STROKE_ROLL degrees, default 0) follows the
        // mouse direction, which arrives in bursts: replayed 2026-09-23 drags
        // commanded >20 degree hand jumps on 12-21% of ticks at 45 and on 2%
        // at 0 (axe, claymore, warhammer).
        static float weaponStrokeRollLimit()
        {
            static const auto limit_tuned = RagdollCore::tuned<float>([] {
                const char* text = RagdollCore::tuningText("OPENMW_RAGDOLL_STROKE_ROLL");
                const float value = text ? static_cast<float>(std::atof(text)) : 0.0f;
                return std::isfinite(value) ? std::clamp(value, 0.0f, 90.0f) * osg::PIf / 180.0f : 0.0f;
            });
            static const auto& limit = limit_tuned.get();
            return limit;
        }
        // The edge direction the canonical roll gives a blade pointing along
        // `blade`, before its per-weapon sign. Continuous except for a blade
        // pointing sideways and back.
        static JPH::Vec3 canonicalWeaponEdge(JPH::Vec3Arg blade, JPH::Vec3Arg right, JPH::Vec3Arg up)
        {
            const JPH::Vec3 sagittal = right.Cross(blade);
            const float lateral = 1.0f - std::min(1.0f, sagittal.Length());
            JPH::Vec3 edge = sagittal + (up - blade * up.Dot(blade)) * (lateral * lateral);
            edge -= blade * edge.Dot(blade);
            return edge.NormalizedOr(JPH::Vec3::sZero());
        }
        // Which of the two sagittal edges this weapon's hold presents. Read
        // from the authored animation hand; kept while that reading is
        // ambiguous (edge near the lateral axis).
        float mCanonicalEdgeSign = 1.0f;
        void updateCanonicalEdgeSign(const RagdollCore::WeaponStrikeAxes& axes, JPH::Vec3Arg right, JPH::Vec3Arg up)
        {
            if (!mRightArm)
                return;
            const auto animation = mRagdoll->getWorldBodyRotation(mMotorTargetPose, mRightArm->mHand);
            if (!animation)
                return;
            const JPH::Vec3 blade = (*animation * axes.mLongAxis).NormalizedOr(JPH::Vec3::sZero());
            const JPH::Vec3 edge = *animation * axes.mEdgeAxis;
            const float agreement = edge.Dot(canonicalWeaponEdge(blade, right, up));
            if (std::abs(agreement) > 0.3f)
                mCanonicalEdgeSign = agreement >= 0.0f ? 1.0f : -1.0f;
        }
        // World hand rotation that points the long axis along `direction`
        // with the canonical roll, turned toward `stroke` (a world velocity).
        std::optional<JPH::Quat> canonicalWeaponHandRotation(const RagdollCore::WeaponStrikeAxes& axes,
            JPH::Vec3Arg direction, JPH::Vec3Arg right, JPH::Vec3Arg up, JPH::Vec3Arg stroke) const
        {
            const JPH::Vec3 blade = direction.NormalizedOr(JPH::Vec3::sZero());
            if (blade.IsNearZero())
                return std::nullopt;
            JPH::Vec3 edge = canonicalWeaponEdge(blade, right, up) * mCanonicalEdgeSign;
            const float limit = weaponStrokeRollLimit();
            JPH::Vec3 across = stroke - blade * stroke.Dot(blade);
            const float speed = across.Length();
            if (!edge.IsNearZero() && limit > 0.0f && speed > 1e-3f)
            {
                across /= speed;
                if (across.Dot(edge) < 0.0f)
                    across = -across;
                // Slow strokes barely roll: a pause is not a new direction.
                const float weight = std::clamp(speed / 60.0f, 0.0f, 1.0f);
                const float angle = std::clamp(
                    std::atan2(blade.Dot(edge.Cross(across)), edge.Dot(across)) * weight, -limit, limit);
                edge = JPH::Quat::sRotation(blade, angle) * edge;
            }
            return RagdollCore::alignedStrikeHandRotation(axes, blade, edge);
        }
        // Bound how fast a drag may turn the commanded weapon. Mouse input
        // reaches the physics step in bursts (13-18% of ticks empty, p90 about
        // 227 counts), and near the tip-control pivot a small hand move swings
        // the blade direction a long way: the staff replay asked for 29
        // degrees in a tick. OPENMW_RAGDOLL_WRIST_SLEW, degrees per second.
        static float swingHandSlewRate()
        {
            static const auto rate_tuned = RagdollCore::tuned<float>([] {
                const char* text = RagdollCore::tuningText("OPENMW_RAGDOLL_WRIST_SLEW");
                const float value = text ? static_cast<float>(std::atof(text)) : 720.0f;
                return std::isfinite(value) && value > 0.0f ? value * osg::PIf / 180.0f : 0.0f;
            });
            static const auto& rate = rate_tuned.get();
            return rate;
        }
        float mSwingHandSlewDuration = 1.0f / 60.0f;
        std::optional<JPH::Quat> slewSwingHandRotation(const std::optional<JPH::Quat>& wanted) const
        {
            const float limit = swingHandSlewRate() * mSwingHandSlewDuration;
            if (!wanted || !mSwingHandRotation || !(limit > 0.0f))
                return wanted;
            const JPH::Quat previous = *mSwingHandRotation;
            const float dot = std::clamp(std::abs(previous.Dot(*wanted)), 0.0f, 1.0f);
            const float angle = 2.0f * std::acos(dot);
            if (angle <= limit)
                return wanted;
            const JPH::Quat target = previous.Dot(*wanted) < 0.0f ? -*wanted : *wanted;
            return previous.SLERP(target, limit / angle).Normalized();
        }

