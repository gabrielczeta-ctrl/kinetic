        void setWristOpening(int side, float open)
        {
            const auto& arm = side == 1 ? mRightArm : mLeftArm;
            const auto& base = mReseatWrist[static_cast<std::size_t>(side)];
            if (!arm || !base || !mRagdoll)
                return;
            static const auto wide_tuned = RagdollCore::tuned<float>([] { return osg::DegreesToRadians(
                std::clamp(weaponDriveSetting("OPENMW_RAGDOLL_HSC_RESEAT_WRIST", 150.0f), 30.0f, 175.0f)); });
            static const auto& wide = wide_tuned.get();
            const auto mix = [open](float a, float b) { return a + (b - a) * open; };
            mRagdoll->setSwingTwistJointLimits(arm->mHand,
                mix(base->mNormalHalfConeAngle, std::max(base->mNormalHalfConeAngle, wide)),
                mix(base->mPlaneHalfConeAngle, std::max(base->mPlaneHalfConeAngle, wide)),
                mix(base->mTwistMinimum, std::min(base->mTwistMinimum, -wide)),
                mix(base->mTwistMaximum, std::max(base->mTwistMaximum, wide)));
