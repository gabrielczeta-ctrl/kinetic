            const auto& feetState = mFootfallLibrary->feet();
            // The second foot follows once the lead has landed.
            if (mDodgeFollow && !feetState[0].mSwinging && !feetState[1].mSwinging)
            {
                const std::size_t side = *mDodgeFollow;
                mDodgeFollow.reset();
                const JPH::RVec3 from = feetState[side].mPin;
                JPH::RVec3 landing = from + JPH::RVec3(mDodgeDirection * (0.8f * mDodgeLength));
                const auto ground = input.mGround(landing, input.mActorZ);
                landing.SetZ(ground ? *ground : from.GetZ());
                RagdollCore::FootfallCommand command;
                command.mHoldClock = true;
                command.mSwingNow = side;
                command.mSwingTime = std::max(0.15f, s[3]);
                command.mLanding[side] = landing;
                commandFootfall(command);
                return true;
            }
            if (mDodgeFollow || (mDodgeTime > 0.0f && (feetState[0].mSwinging || feetState[1].mSwinging)))
            {
                RagdollCore::FootfallCommand command;
                command.mHoldClock = true;
                commandFootfall(command);
                return true;
            }
            if (!wanted || !(s[0] > 0.0f) || !mControllerOutput
                || mControllerOutput->mMode != RagdollCore::ActiveControllerMode::Standing || mHitStun.active()
                || mStaggerPlan.active() || rollOwnsBody() || mJumpAirborne
                || getPtr().getClass().getCreatureStats(getPtr()).getKnockedDown())
                return false;
            auto& stats = getPtr().getClass().getCreatureStats(getPtr());
            auto fatigue = stats.getFatigue();
            const float cost = dodgeFatigueCost();
            if (fatigue.getCurrent() < cost)
            {
                Log(Debug::Info) << "RAGDOLL_DODGE tired actor=" << getPtr().getCellRef().getRefId()
                                 << " fatigue=" << fatigue.getCurrent() << " cost=" << cost;
                return false;
            }
            const float yaw = getPtr().getRefData().getPosition().rot[2];
            const JPH::Vec3 facing(std::sin(yaw), std::cos(yaw), 0.0f);
            JPH::Vec3 direction = mDodgeWantedDirection.value_or(
                JPH::Vec3(mRawTargetHorizontalVelocity.GetX(), mRawTargetHorizontalVelocity.GetY(), 0.0f));
            direction.SetZ(0.0f);
            direction = direction.Length() > 1e-3f ? direction.Normalized() : -facing;
            const float speed = mSituationKnown ? JPH::Vec3(mSituationVelocity.GetX(), mSituationVelocity.GetY(), 0.0f).Length() : 0.0f;
            fatigue.setCurrent(fatigue.getCurrent() - cost);
            stats.setFatigue(fatigue);
            ++mDodges;
            if (speed >= s[5] && direction.Dot(facing) >= 0.7f && beginDodgeRoll(direction, speed))
            {
                ++mDodgeRolls;
                return true;
            }
            const float agility = stats.getAttribute(ESM::Attribute::Agility).getModified();
            mDodgeLength = (s[1] + s[2] * std::clamp(agility, 0.0f, 100.0f) / 100.0f) * stats.getFatigueTerm();
            mDodgeDirection = direction;
            mDodgeTime = std::max(0.05f, s[4]);
            // The lead: sideways the foot on that side, else the foot behind along it.
            const JPH::Vec3 right(facing.GetY(), -facing.GetX(), 0.0f);
            const float across = direction.Dot(right);
            std::size_t lead;
            if (std::abs(across) > 0.5f)
                lead = across > 0.0f ? 1 : 0;
            else
            {
                const float a = JPH::Vec3(feetState[0].mPin).Dot(direction), b = JPH::Vec3(feetState[1].mPin).Dot(direction);
                lead = a <= b ? 0 : 1;
            }
            mDodgeFollow = 1 - lead;
            JPH::RVec3 landing = feetState[lead].mPin + JPH::RVec3(direction * mDodgeLength);
            const auto ground = input.mGround(landing, input.mActorZ);
            landing.SetZ(ground ? *ground : feetState[lead].mPin.GetZ());
            RagdollCore::FootfallCommand command;
            command.mHoldClock = true;
            command.mSwingNow = lead;
            command.mSwingTime = std::max(0.15f, s[3]);
            command.mLanding[lead] = landing;
            commandFootfall(command);
            Log(Debug::Info) << "RAGDOLL_DODGE step actor=" << getPtr().getCellRef().getRefId() << " length=" << mDodgeLength
                             << " dir=" << direction.GetX() << "," << direction.GetY() << " lead=" << lead << " cost=" << cost;
            return true;
        }
        static const RagdollCore::StepArbiter::Order& stepOrder()
        {
            static const auto value_tuned = RagdollCore::tuned<RagdollCore::StepArbiter::Order>([] {
                const char* text = RagdollCore::tuningText("OPENMW_RAGDOLL_STEP_ORDER");
                if (text && *text)
                {
                    if (const auto order = RagdollCore::StepArbiter::parseOrder(text))
                        return *order;
                    Log(Debug::Warning) << "RAGDOLL_TUNING_WARNING OPENMW_RAGDOLL_STEP_ORDER \"" << text
                                        << "\" must name stuck, landing, moving, standing and stage once each";
                }
                return RagdollCore::StepArbiter::defaultOrder();
            });
            return value_tuned.get();
        }
        RagdollCore::StepArbiter mStepArbiter;
        const char* mStepWhy = "no step";
        // A balance behaviour's command to Footfall, noting what it asked for.
        void commandFootfall(const RagdollCore::FootfallCommand& command)
        {
            mStepWhy = command.mSwingNow ? "swing"
                : (command.mLanding[0] || command.mLanding[1]) ? "aim"
                : command.mHoldClock ? "hold"
                : "none";
            mFootfallLibrary->command(command);
        }
        void noteStepOwner(std::optional<RagdollCore::StepSource> source)
        {
            const bool changed = source ? mStepArbiter.claim(*source, mStepWhy) : mStepArbiter.idle();
            static const auto trace_tuned = RagdollCore::tuned<int>([] {
                const char* text = RagdollCore::tuningText("OPENMW_RAGDOLL_STEP_TRACE");
                return !text ? 0 : text[0] == 'n' ? 2 : 1;
            });
            const int trace = trace_tuned.get();
            if (!changed || trace == 0 || (getPtr() == MWMechanics::getPlayer()) != (trace == 1))
                return;
            Log(Debug::Info) << "RAGDOLL_STEP_OWNER actor=" << getPtr().getCellRef().getRefId() << " owner="
                             << (source ? RagdollCore::stepSourceName(*source) : "gait") << " why="
                             << (source ? mStepWhy : "-") << " step=" << mFixedSteps;
        }
        void updateCatchSteps(const RagdollCore::FootfallInput& input)
        {
            using namespace RagdollCore;
            // STEP_ORDER (item 13): whoever takes this step is logged; nobody = Footfall's own gait.
            bool claimed = false;
            const auto claimStep = [&](StepSource source) {
                claimed = true;
                noteStepOwner(source);
            };
            struct IdleOnExit
            {
                std::function<void()> mDone;
                ~IdleOnExit() { mDone(); }
            } idleOnExit{ [&] {
                if (!claimed)
                    noteStepOwner(std::nullopt);
            } };
            mStepWhy = "no step";
            stepStumble(input.mDt);
            // STEP-01 S4: a stagger that gave up takes no more steps for a
            // moment - no new plan, no catch, no gait step - so the body
            // falls (the steps of a skid plan right after it caught it again
            // and the fall was held back up, FALL-01 cap x3).
            if (staggerGaveUp() && staggerPlanCanRun() && mFootfallLibrary)
            {
                RagdollCore::FootfallCommand command;
                command.mHoldClock = true;
                command.mNoAnchorSettle = true;
                commandFootfall(command);
                claimStep(StepSource::GaveUp);
                return;
            }
            if (stepStaggerPlan(input))
            {
                claimStep(StepSource::Stagger);
                return;
            }
            if (stepDodge(input))
            {
                claimStep(StepSource::Dodge);
                return;
            }
            // On hits (user 2026-09-28: "what triggers PGC? shouldn't we be
            // triggering it on every hit?"): while a hit has weakened the balance
            // helper, and until the recovery it started ends, the catch steps run
            // even when not enabled for all time. OPENMW_RAGDOLL_CATCH_ON_HIT=1.
            // Off by default: with Footfall and the full helper, the push and
            // knockdown cases were the same either way (52/52, drift and
            // recovery equal; 94 catch steps taken) and the helper saturated
            // more on some standing warhammer pushes - it pays only with a
            // weaker helper (offline level 2), which is a feel decision.
            static const auto catchOnHit_tuned = RagdollCore::tuned<bool>([] {
                const char* text = RagdollCore::tuningText("OPENMW_RAGDOLL_CATCH_ON_HIT");
                return text && std::atoi(text) != 0;
            });
            static const auto& catchOnHit = catchOnHit_tuned.get();
            // While the player asks to move, the gait keeps stepping after a
            // hit (user bookmarks 1-3, 2026-09-30: "after getting hit while
            // running the legs stay straight"; recording: both feet pinned
            // 1.7 s at full root force - the catch held Footfall's clock until
            // the body counted as caught, which a running body never does).
            // Pushes while walking/running (CATCH_ON_HIT=1): longest
            // both-feet-down stretch, mean 0.32 -> 0.23 s, walk side 0.9-1.1 ->
            // 0.43-0.48 s.
            const bool requestMoving = pgcRequestSpeed() >= 15.0f;
            // The hit part only: landing catches and swing footwork keep
            // their steps while moving (excluding them too broke the walk
            // course, stepT 9 -> 40, stepL 6 -> 45). Narrowed: course walk
            // stepT 28.5/30.5 against 28.5/30.0 with the old hold (noise
            // around the bar); pushes both-feet-down mean 0.32 -> 0.23 s.
            const bool hitWindow = (catchOnHit
                                       && (mSoftRootStrength < 0.98f || mHitStun.active() || mCatchRecovering
                                           || bearingsStumble() > 0.0f)
                                       && !requestMoving)
                || swingFootworkActive();
            const bool pgcCatch = pgcKnobs()[1] && pgcRequestSpeed() < 15.0f;
            if (!pgcCatch)
                mPgcCatch.reset();
            // Moving catch (alpha 0.6 item 3, PGC session 7be4106892): catch
            // steps while walking or running, beside Footfall's gait - the
            // swing in flight lands to turn an overspeed or sideways error
            // around, and a stance foot left far behind the body steps now
            // (user bookmarks 1/14/16: running backward the body "almost falls
            // on its butt but won't fall", "the backstep should be quicker";
            // the recording sat on a stance foot 60 units behind for 1.3 s).
            // OPENMW_RAGDOLL_PGC_MOVING_CATCH = gain (0 = off; 0.5 offline).
            static const auto landingEnabled_tuned = RagdollCore::tuned<bool>([] { return weaponDriveSetting("OPENMW_RAGDOLL_PGC_LANDING", 1.0f) > 0.0f; });
            static const auto& landingEnabled = landingEnabled_tuned.get();
            const bool pgcLanding = landingEnabled && (mLandingTouchdown || mPgcLanding.active());
            if (!pgcLanding)
                mLandingRootFloor = 0.0f;
            static const auto movingGain_tuned = RagdollCore::tuned<float>([] { return weaponDriveSetting("OPENMW_RAGDOLL_PGC_MOVING_CATCH", 0.0f); });
            static const auto& movingGain = movingGain_tuned.get();
            const bool pgcMoving = movingGain > 0.0f && pgcKnobs()[1] && !pgcCatch && !hitWindow;
            if (!pgcMoving)
                mPgcMovingCatch.reset();
            if (!(catchStepsEnabled() || hitWindow || pgcCatch || pgcMoving || pgcLanding) || !mFootfallLibrary || !input.mEligible || !mControllerInput
                || !input.mGround || !input.mLegs[0] || !input.mLegs[1] || !mPelvisBodyIndex)
            {
                mCatchRecovering = false;
                return;
            }
            const float dt = input.mDt;
            const auto pelvis = mRagdoll->getWorldBodyPosition(mCurrentPhysicsPose, *mPelvisBodyIndex);
            if (!pelvis || !(dt > 0.0f))
                return;
            std::array<JPH::RVec3, 2> footWorld;
            std::array<BalanceVec2, 2> feet;
            std::array<bool, 2> supported{ false, false };
            float legReach = 0.0f;
            for (std::size_t side = 0; side < 2; ++side)
            {
                const auto foot = mRagdoll->getWorldBodyPosition(mCurrentPhysicsPose, input.mLegs[side]->mFoot);
                if (!foot)
                    return;
                footWorld[side] = *foot;
                feet[side] = { static_cast<float>(foot->GetX()), static_cast<float>(foot->GetY()) };
                const auto ground = input.mGround(*foot, input.mActorZ);
                supported[side] = ground && foot->GetZ() - *ground < 12.0;
                // A foot in contact with supporting ground stands, whatever
                // the probe says: the probe looks in a window around the
                // capsule's height, and a body sagging under the capsule on a
                // slope read both planted feet as floating, so the catch could
                // step neither and released (Balmora hill stop, about 1 run in
                // 3; the contacts held both feet). OPENMW_RAGDOLL_PGC_CONTACT_SUPPORT=0 = off.
                static const auto contactSupport_tuned = RagdollCore::tuned<bool>([] {
                    const char* text = RagdollCore::tuningText("OPENMW_RAGDOLL_PGC_CONTACT_SUPPORT");
                    return !(text && std::atoi(text) == 0);
                });
                if (contactSupport_tuned.get() && mSupportEstimate
                    && (side == 0 ? mSupportEstimate->mLeftFootSupported : mSupportEstimate->mRightFootSupported))
                    supported[side] = true;
                if (const auto& geometry = input.mLegs[side]->mGeometry)
                    legReach = std::max(legReach,
                        (geometry->mUpperOffset.Length() + geometry->mLowerOffset.Length())
                            / std::max(input.mFrame.mInverseUniformScale, 1e-3f));
            }
            if (!(legReach > 0.0f))
                legReach = 70.0f;
            const auto ground = input.mGround(*pelvis, input.mActorZ);
            const double floorZ = ground ? *ground : input.mActorZ;
            JPH::Vec3 disturbance = mControllerInput->mCenterOfMassVelocity - input.mCommandVelocity;
            disturbance.SetZ(0.0f);
            BalanceState state;
            state.mCenterOfMass = { static_cast<float>(pelvis->GetX()), static_cast<float>(pelvis->GetY()) };
            state.mVelocity = { disturbance.GetX(), disturbance.GetY() };
            state.mHeight = static_cast<float>(pelvis->GetZ() - floorZ) + 15.0f;
            // The body's mass-weighted centre (the situation's, held weapon
            // included) instead of the pelvis + 15 u (STEPPING audit 11-01,
            // item 14: a two-hander held out or a crouch moves it).
            // OPENMW_RAGDOLL_PGC_REAL_COM=1 (0 = the pelvis, the old).
            static const auto realCom_tuned = RagdollCore::tuned<bool>([] { return weaponDriveSetting("OPENMW_RAGDOLL_PGC_REAL_COM", 0.0f) > 0.0f; });
            if (realCom_tuned.get() && mSituationKnown)
            {
                state.mCenterOfMass = { static_cast<float>(mSituationCom.GetX()), static_cast<float>(mSituationCom.GetY()) };
                state.mHeight = std::max(20.0f, static_cast<float>(mSituationCom.GetZ() - floorZ));
            }
            state.mGravity = RagdollCore::UnitModel::GravityUnitsPerSecondSquared;
            const auto capture = capturePoint(state);
            if (!capture)
                return;
            const auto stuckStep = [&]() -> bool {
                // Stuck lean (10-10 PGC matrix: ~1 in 24 near pushes of 8000 ended
                // 37-52 deg over for 5-6 s - feet together 47 u beside the pelvis,
                // the root holding the pelvis, the lean short of the topple line
                // (up 0.5), so nothing stepped and nothing fell; user bookmark 5:
                // "PGC trying to stand itself up ... if not found, it should fall").
                // Still and leaning past `upDot` for `stepAfter` s: the foot
                // farthest from the pelvis steps under it; still leaning at
                // `fallAfter` s: PGC decides a fall.
                // OPENMW_RAGDOLL_PGC_STUCK = "upDot,stepAfter,fallAfter" (unset = off).
                {
                    static const auto stuck_tuned = RagdollCore::tuned<std::array<float, 3>>([] {
                        std::array<float, 3> value{ 0.0f, 0.8f, 2.0f };
                        if (const char* text = RagdollCore::tuningText("OPENMW_RAGDOLL_PGC_STUCK"))
                            std::sscanf(text, "%f,%f,%f", &value[0], &value[1], &value[2]);
                        return value;
                    });
                    static const auto& stuck = stuck_tuned.get();
                    const auto& feetNow = mFootfallLibrary->feet();
                    const bool leaning = stuck[0] > 0.0f && mControllerInput->mTorsoUpDot < stuck[0]
                        && std::hypot(state.mVelocity.mX, state.mVelocity.mY) < 20.0f && pgcRequestSpeed() < 15.0f
                        && !feetNow[0].mSwinging && !feetNow[1].mSwinging && (supported[0] || supported[1]);
                    mStuckLeanTime = leaning ? mStuckLeanTime + dt : 0.0f;
                    if (!leaning)
                        mStuckStepped = false;
                    if (leaning && mStuckLeanTime >= stuck[2])
                    {
                        decideFall("stuck", { state.mCenterOfMass.mX - 0.5f * (feet[0].mX + feet[1].mX),
                                                state.mCenterOfMass.mY - 0.5f * (feet[0].mY + feet[1].mY) });
                        ++mStuckFalls;
                        mStuckLeanTime = 0.0f;
                        return true;
                    }
                    if (leaning && mStuckLeanTime >= stuck[1] && !mStuckStepped && supported[0] && supported[1])
                    {
                        const std::size_t swing
                            = std::hypot(feet[0].mX - state.mCenterOfMass.mX, feet[0].mY - state.mCenterOfMass.mY)
                                >= std::hypot(feet[1].mX - state.mCenterOfMass.mX, feet[1].mY - state.mCenterOfMass.mY)
                            ? 0
                            : 1;
                        // Under the pelvis, kept a half stance width to its own side
                        // of the line from the other foot to the pelvis.
                        const JPH::Vec3 other(feet[1 - swing].mX, feet[1 - swing].mY, 0.0f);
                        const JPH::Vec3 body(state.mCenterOfMass.mX, state.mCenterOfMass.mY, 0.0f);
                        const JPH::Vec3 toBody = body - other;
                        const JPH::Vec3 across = JPH::Vec3(-toBody.GetY(), toBody.GetX(), 0.0f).NormalizedOr(JPH::Vec3::sAxisX());
                        const JPH::Vec3 own(feet[swing].mX - other.GetX(), feet[swing].mY - other.GetY(), 0.0f);
                        const float sign = own.Dot(across) >= 0.0f ? 1.0f : -1.0f;
                        const JPH::Vec3 point = body + across * (sign * 6.0f);
                        const JPH::RVec3 at(point.GetX(), point.GetY(), floorZ);
                        const auto landingGround = input.mGround(at, input.mActorZ);
                        FootfallCommand command;
                        command.mHoldClock = true;
                        command.mSwingNow = swing;
                        command.mSwingTime = 0.3f;
                        command.mLanding[swing] = JPH::RVec3(at.GetX(), at.GetY(), landingGround ? *landingGround : floorZ);
                        commandFootfall(command);
                        mStuckStepped = true;
                        ++mStuckSteps;
                        ++mCatchStepCount;
                        Log(Debug::Info) << "RAGDOLL_PGC_STUCK step actor=" << getPtr().getCellRef().getRefId()
                                         << " foot=" << swing << " up=" << mControllerInput->mTorsoUpDot;
                        return true;
                    }
                }
                return false;
            };
            const auto landingStep = [&]() -> bool {
                // (Skid steps live in the stagger plan now - STAGGER_PLAN's skid
                // speed, PGC-03 B5; the old SKID_STEP was removed 10-12.)
                if (pgcLanding)
                {
                    const auto& footState = mFootfallLibrary->feet();
                    LandingInput landing;
                    landing.mState = state;
                    // Relative landing (10-09 PGC trace, SAVE-01 push landing: the
                    // landing walked on at 170 u/s with the request, its capture
                    // point from the absolute speed sat 100 u past the feet and the
                    // run-out released a walking body into a fall, 2 of 2): while
                    // the player asks to move, the run-out reads the body's speed
                    // against the request (state.mVelocity, like the catches).
                    // OPENMW_RAGDOLL_PGC_LANDING_RELATIVE=1 (0 = absolute, the old).
                    static const auto landingRelative_tuned = RagdollCore::tuned<bool>([] { return weaponDriveSetting("OPENMW_RAGDOLL_PGC_LANDING_RELATIVE", 0.0f) > 0.0f; });
                    static const auto& landingRelative = landingRelative_tuned.get();
                    if (!(landingRelative && requestMoving))
                        landing.mState.mVelocity = { mControllerInput->mCenterOfMassVelocity.GetX(),
                            mControllerInput->mCenterOfMassVelocity.GetY() };
                    for (std::size_t side = 0; side < 2; ++side)
                    {
                        auto& foot = landing.mFeet[side];
                        foot.mPosition = feet[side];
                        foot.mSupported = supported[side];
                        foot.mPinned = mFootfallLibraryOutput.mPinned[side];
                        foot.mSwinging = footState[side].mSwinging;
                        foot.mTarget = { static_cast<float>(footState[side].mTarget.GetX()),
                            static_cast<float>(footState[side].mTarget.GetY()) };
                        foot.mPhase = footState[side].mPhase;
                        foot.mDuration = footState[side].mDuration;
                    }
                    const CaptureStepLimits limits = catchStepLimits(pgcCapability(), legReach);
                    landing.mDt = dt;
                    landing.mReach = limits.mMaximumReach;
                    landing.mMinimumSwingTime = limits.mMinimumSwingTime;
                    landing.mTouchdown = mLandingTouchdown;
                    landing.mImpactSpeed = mLandingImpactSpeed;
                    mLandingTouchdown = false;
                    const auto landingResult = mPgcLanding.update(landing);
                    pgcTrace("landing", dt, landing.mState, feet, supported, -1, landingResult ? landingResult->mSteps : -1,
                        landingResult && landingResult->mSwingNow, landingResult && landingResult->mRelease);
                    if (const auto& result = landingResult)
                    {
                        mLandingRootFloor = result->mRootStrengthFloor;
                        if (result->mRelease)
                        {
                            decideFall("landing", {});
                            mPgcLanding.reset();
                            mLandingRootFloor = 0.0f;
                            return true;
                        }
                        FootfallCommand command;
                        command.mHoldClock = result->mHoldClock;
                        command.mSwingNow = result->mSwingNow;
                        command.mSwingTime = result->mSwingTime;
                        for (std::size_t side = 0; side < 2; ++side)
                            if (result->mLanding[side])
                            {
                                const JPH::RVec3 point(result->mLanding[side]->mX, result->mLanding[side]->mY, floorZ);
                                const auto landingGround = input.mGround(point, input.mActorZ);
                                command.mLanding[side]
                                    = JPH::RVec3(point.GetX(), point.GetY(), landingGround ? *landingGround : floorZ);
                            }
                        if (result->mSwingNow)
                            ++mCatchStepCount;
                        commandFootfall(command);
                    }
                    else
                        mLandingRootFloor = 0.0f;
                    return true;
                }
                return false;
            };
            const auto movingStep = [&]() -> bool {
                if (pgcMoving)
                {
                    const auto& footState = mFootfallLibrary->feet();
                    MovingCatchInput moving;
                    moving.mState = state;
                    moving.mState.mVelocity = { mControllerInput->mCenterOfMassVelocity.GetX(),
                        mControllerInput->mCenterOfMassVelocity.GetY() };
                    moving.mCommandedVelocity = { input.mCommandVelocity.GetX(), input.mCommandVelocity.GetY() };
                    for (std::size_t side = 0; side < 2; ++side)
                    {
                        auto& foot = moving.mFeet[side];
                        foot.mPosition = feet[side];
                        foot.mSupported = supported[side];
                        foot.mPinned = mFootfallLibraryOutput.mPinned[side];
                        foot.mSwinging = footState[side].mSwinging;
                        foot.mTarget = { static_cast<float>(footState[side].mTarget.GetX()),
                            static_cast<float>(footState[side].mTarget.GetY()) };
                        foot.mPhase = footState[side].mPhase;
                        foot.mDuration = footState[side].mDuration;
                    }
                    moving.mDt = dt;
                    moving.mReach = catchStepLimits(pgcCapability(), legReach).mMaximumReach;
                    moving.mSettings.mGain = movingGain;
                    // No release in the game yet (PGC session: start with it off).
                    moving.mSettings.mRelease = false;
                    const auto movingResult = mPgcMovingCatch.update(moving);
                    pgcTrace("moving", dt, moving.mState, feet, supported, -1, -1, movingResult && movingResult->mSwingNow,
                        movingResult && movingResult->mRelease);
                    if (const auto& result = movingResult)
                    {
                        FootfallCommand command;
                        command.mSwingNow = result->mSwingNow;
                        command.mSwingTime = result->mSwingTime;
                        bool any = result->mSwingNow.has_value();
                        for (std::size_t side = 0; side < 2; ++side)
                            if (result->mLanding[side])
                            {
                                const JPH::RVec3 point(result->mLanding[side]->mX, result->mLanding[side]->mY, floorZ);
                                const auto landingGround = input.mGround(point, input.mActorZ);
                                command.mLanding[side]
                                    = JPH::RVec3(point.GetX(), point.GetY(), landingGround ? *landingGround : floorZ);
                                any = true;
                            }
                        if (result->mTrail)
                            ++mPgcMovingTrails;
                        if (result->mSwingNow)
                            ++mCatchStepCount;
                        if (any)
                            commandFootfall(command);
                    }
                    return true;
                }
                return false;
            };
            const auto catchStep = [&]() -> bool {
                if (pgcCatch)
                {
                    const auto& footState = mFootfallLibrary->feet();
                    const RagdollCore::CatchCapability capability = pgcCapability();
                    CatchStepInput catchInput;
                    catchInput.mState = state;
                    catchInput.mState.mVelocity = { mControllerInput->mCenterOfMassVelocity.GetX(),
                        mControllerInput->mCenterOfMassVelocity.GetY() };
                    catchInput.mReferenceVelocity = { input.mCommandVelocity.GetX(), input.mCommandVelocity.GetY() };
                    catchInput.mBodyForward = { std::sin(input.mYaw), std::cos(input.mYaw) };
                    for (std::size_t side = 0; side < 2; ++side)
                    {
                        auto& foot = catchInput.mFeet[side];
                        foot.mPosition = feet[side];
                        foot.mSupported = supported[side];
                        foot.mSwinging = footState[side].mSwinging;
                        foot.mTargetHeld = footState[side].mTargetHeld;
                        foot.mPhase = footState[side].mPhase;
                        foot.mDuration = footState[side].mDuration;
                    }
                    catchInput.mDt = dt;
                    catchInput.mLimits = catchStepLimits(capability, legReach);
                    catchInput.mReactionDelay = capability.mReactionDelay;
                    if (pgcKnobs()[3])
                    {
                        catchInput.mStepFreeFoot = true;
                        catchInput.mReleaseWhenUncatchable = true;
                        catchInput.mReleaseAfterSteps = pgcReleaseAfterSteps();
                        catchInput.mArmDriven = mTip.mActive;
                        catchInput.mMaximumHoverTime = 0.5f;
                        const JPH::Vec3 request(mRawTargetHorizontalVelocity.GetX(), mRawTargetHorizontalVelocity.GetY(), 0.0f);
                        if (request.Length() > 1.0f)
                            catchInput.mDirectionBias = { request.GetX() / request.Length(), request.GetY() / request.Length() };
                    }
                    applyStumble(catchInput);
                    const auto result = mPgcCatch.update(catchInput);
                    countStumble(result);
                    pgcTrace("catch", dt, catchInput.mState, feet, supported, result ? static_cast<int>(result->mStage) : -1,
                        static_cast<int>(mPgcCatch.stepsStarted()), result && result->mSwingNow, result && result->mRelease);
                    if (result && result->mRelease)
                    {
                        // An upright body that is not moving off its request is
                        // not falling: the hover release (no step for 0.5 s)
                        // dropped two NPCs every 0.6 s for minutes while they stood
                        // at up 0.999 (10-30 play, Zainsipilu: 108 and 86 "catch"
                        // falls; the root let go each time and they flailed). The
                        // catch ends instead. OPENMW_RAGDOLL_CATCH_VETO = "least up,
                        // most speed u/s" (0 = off).
                        static const auto veto_tuned = RagdollCore::tuned<std::array<float, 2>>([] {
                            std::array<float, 2> v{ 0.93f, 40.0f };
                            if (const char* text = RagdollCore::tuningText("OPENMW_RAGDOLL_CATCH_VETO"))
                                std::sscanf(text, "%f,%f", &v[0], &v[1]);
                            return v;
                        });
                        const auto& veto = veto_tuned.get();
                        const JPH::Vec3 off(mControllerInput->mCenterOfMassVelocity.GetX() - input.mCommandVelocity.GetX(),
                            mControllerInput->mCenterOfMassVelocity.GetY() - input.mCommandVelocity.GetY(), 0.0f);
                        if (veto[0] > 0.0f && mControllerInput->mTorsoUpDot >= veto[0] && off.Length() <= veto[1])
                        {
                            if (++mCatchVetoes <= 20 || mCatchVetoes % 100 == 0)
                                Log(Debug::Info) << "RAGDOLL_CATCH_VETO actor=" << getPtr().getCellRef().getRefId()
                                                 << " up=" << mControllerInput->mTorsoUpDot << " speed=" << off.Length()
                                                 << " count=" << mCatchVetoes;
                            mPgcCatch.reset();
                            return true;
                        }
                        // No step can catch it: fall now, as a topple does.
                        decideFall("catch", result->mFallDirection);
                        ++mPgcReleases;
                        mPgcCatch.reset();
                        return true;
                    }
                    if (result && result->mHoldClock)
                    {
                        FootfallCommand command;
                        command.mHoldClock = true;
                        command.mSwingNow = result->mSwingNow;
                        command.mSwingTime = result->mSwingTime;
                        for (std::size_t side = 0; side < 2; ++side)
                            if (result->mLanding[side])
                            {
                                const JPH::RVec3 point(result->mLanding[side]->mX, result->mLanding[side]->mY, floorZ);
                                const auto landingGround = input.mGround(point, input.mActorZ);
                                command.mLanding[side]
                                    = JPH::RVec3(point.GetX(), point.GetY(), landingGround ? *landingGround : floorZ);
                            }
                        if (result->mSwingNow)
                            ++mCatchStepCount;
                        commandFootfall(command);
                    }
                    return true;
                }
                return false;
            };
            const auto stageStep = [&]() -> bool {
                BalanceStageInput stageInput;
                stageInput.mCapturePoint = *capture;
                stageInput.mLeftFoot = feet[0];
                stageInput.mRightFoot = feet[1];
                stageInput.mLeftSupported = supported[0];
                stageInput.mRightSupported = supported[1];
                stageInput.mPrevious = mCatchStage;
                stageInput.mTimeInPrevious = mCatchStageTime;
                stageInput.mLimits = { 6.0f, 8.0f, 1.5f, 0.3f };
                if (const auto decision = classifyBalanceStage(stageInput))
                {
                    mCatchStageTime = decision->mStage == mCatchStage ? mCatchStageTime + dt : 0.0f;
                    mCatchStage = decision->mStage;
                }
                if (!mCatchRecovering && mCatchStage == BalanceStage::Step)
                {
                    mCatchRecovering = true;
                    mCatchRecoveryTime = 0.0f;
                    mCatchHeld = 0.0f;
                }
                pgcTrace("hitcatch", dt, state, feet, supported, static_cast<int>(mCatchStage), mCatchRecovering ? 1 : 0,
                    false, false);
                if (!mCatchRecovering)
                    return false;
                mCatchRecoveryTime += dt;
                const auto& footState = mFootfallLibrary->feet();
                RecoveryEndInput endInput;
                endInput.mCapturePoint = *capture;
                endInput.mVelocity = state.mVelocity;
                endInput.mLeftFoot = feet[0];
                endInput.mRightFoot = feet[1];
                endInput.mLeftSupported = supported[0];
                endInput.mRightSupported = supported[1];
                endInput.mHeld = mCatchHeld;
                endInput.mDt = dt;
                endInput.mLimits = { 6.0f, 2.0f, 25.0f, 0.2f };
                const auto end = evaluateRecoveryEnd(endInput);
                mCatchHeld = end ? end->mHeld : 0.0f;
                const bool swinging = footState[0].mSwinging || footState[1].mSwinging;
                if ((end && end->mCaught && !swinging) || mCatchRecoveryTime > 3.0f)
                {
                    mCatchRecovering = false;
                    return false;
                }
                FootfallCommand command;
                command.mHoldClock = true;
                CaptureStepLimits limits;
                limits.mFootRadius = 6.0f;
                limits.mMaximumReach = 0.8f * legReach;
                limits.mMinimumWidth = 8.0f;
                limits.mMinimumSwingTime = 0.2f;
                limits.mMaximumSwingTime = 0.45f;
                limits.mSwingFootSpeed = 400.0f;
                limits.mCrossoverClearance = 0.0f;
                limits.mBrakeMargin = 0.0f;
                const float yaw = input.mYaw;
                const BalanceVec2 forward{ std::sin(yaw), std::cos(yaw) };
                const auto planFor = [&](std::size_t swing, std::optional<float> timeToTouchdown) {
                    CaptureStepInput stepInput;
                    stepInput.mState = state;
                    stepInput.mStanceFoot = feet[1 - swing];
                    stepInput.mSwingFoot = feet[swing];
                    stepInput.mBodyForward = forward;
                    stepInput.mSwingIsLeft = swing == 0;
                    stepInput.mTimeToTouchdown = timeToTouchdown;
                    stepInput.mLimits = limits;
                    return planRecoverySteps(stepInput, 3);
                };
                const auto landingAt = [&](BalanceVec2 at) {
                    const JPH::RVec3 point(at.mX, at.mY, floorZ);
                    const auto landingGround = input.mGround(point, input.mActorZ);
                    return JPH::RVec3(at.mX, at.mY, landingGround ? *landingGround : floorZ);
                };
                std::optional<std::size_t> inFlight;
                for (std::size_t side = 0; side < 2; ++side)
                    if (footState[side].mSwinging)
                        inFlight = side;
                if (inFlight)
                {
                    if (!footState[*inFlight].mTargetHeld && supported[1 - *inFlight])
                    {
                        const float remaining = std::max(
                            0.05f, (1.0f - footState[*inFlight].mPhase) * footState[*inFlight].mDuration);
                        if (const auto plan = planFor(*inFlight, remaining); plan && plan->mCount > 0)
                            command.mLanding[*inFlight] = landingAt(plan->mSteps[0].mLanding);
                    }
                }
                else if (supported[0] && supported[1] && mCatchStage == BalanceStage::Step)
                {
                    std::optional<RecoveryPlan> best;
                    std::size_t bestSide = 0;
                    for (std::size_t side = 0; side < 2; ++side)
                    {
                        const auto plan = planFor(side, std::nullopt);
                        if (!plan || plan->mCount == 0)
                            continue;
                        const auto better = [](const RecoveryPlan& a, const RecoveryPlan& b) {
                            if (a.mCaptured != b.mCaptured)
                                return a.mCaptured;
                            if (a.mCount != b.mCount)
                                return a.mCount < b.mCount;
                            return a.mSteps[a.mCount - 1].mResidual < b.mSteps[b.mCount - 1].mResidual;
                        };
                        if (!best || better(*plan, *best))
                        {
                            best = plan;
                            bestSide = side;
                        }
                    }
                    if (best)
                    {
                        command.mSwingNow = bestSide;
                        command.mSwingTime = best->mSteps[0].mSwingTime;
                        command.mLanding[bestSide] = landingAt(best->mSteps[0].mLanding);
                        ++mCatchStepCount;
                    }
                }
                commandFootfall(command);
    #ifdef OPENMW_RAGDOLL_DEV_API
                static const auto trace_tuned = RagdollCore::tuned<bool>([] { return RagdollCore::tuningText("OPENMW_RAGDOLL_HELPER_TRACE") != nullptr; });
                static const auto& trace = trace_tuned.get();
                if (trace && getPtr() == MWMechanics::getPlayer())
                    Log(Debug::Info) << "RAGDOLL_CATCH stage=" << static_cast<int>(mCatchStage) << " cp=" << capture->mX << ','
                                     << capture->mY << " pelvis=" << pelvis->GetX() << ',' << pelvis->GetY()
                                     << " v=" << state.mVelocity.mX << ',' << state.mVelocity.mY
                                     << " now=" << (command.mSwingNow ? static_cast<int>(*command.mSwingNow) : -1)
                                     << " steps=" << mCatchStepCount;
    #endif
                return true;
            };
            // The balance catches in their declared order; the first that takes
            // the step owns it (OPENMW_RAGDOLL_STEP_ORDER, default the old code order).
            for (const StepSource source : stepOrder())
            {
                bool took = false;
                switch (source)
                {
                    case StepSource::Stuck:
                        took = stuckStep();
                        break;
                    case StepSource::Landing:
                        took = landingStep();
                        break;
                    case StepSource::MovingCatch:
                        took = movingStep();
                        break;
                    case StepSource::StandingCatch:
                        took = catchStep();
                        break;
                    case StepSource::StageCatch:
                        took = stageStep();
                        break;
                    default:
                        break;
                }
                if (took)
                {
                    claimStep(source);
                    return;
                }
            }
        }

        // The library's inputs.
        // The velocity the legs step for: the capsule's (running a landing
        // out at the body's speed made no difference to JUMP-01; removed 10-12).
        JPH::Vec3 gaitCommandVelocity() const
        {
            return JPH::Vec3(mKinematicRootActualVelocity.GetX(), mKinematicRootActualVelocity.GetY(), 0.0f);
        }
        // PGC-03 A2: the situation, read once per physics step for every
        // powered body (the ground fan under and ahead of the feet, the
        // support and capture point, edges, airborne, the capsule's slip).
        // Every balance behaviour reads mSituation. OPENMW_RAGDOLL_SITUATION_TRACE=1
        // logs it for the player twice a second.
        RagdollCore::SituationReader mSituationReader;
        RagdollCore::Situation mSituation;
        bool mSituationKnown = false;
        JPH::RVec3 mSituationCom = JPH::RVec3::sZero();
        JPH::Vec3 mSituationVelocity = JPH::Vec3::sZero();
        unsigned mSituationTraceStep = 0;
        void updateSituation(float dt, bool capsuleFresh = true)
        {
            mSituationKnown = false;
            stepLandingCrouch(dt);
            // OPENMW_RAGDOLL_SITUATION=0 (diagnostic): no situation reading.
            static const auto situationOn_tuned = RagdollCore::tuned<bool>([] {
                const char* text = RagdollCore::tuningText("OPENMW_RAGDOLL_SITUATION");
                return !(text && std::atoi(text) == 0);
            });
            static const auto& situationOn = situationOn_tuned.get();
            if (!situationOn || !mPowered || !mRagdoll || !mLeftLeg || !mRightLeg || !mCurrentPhysicsPoseCaptured
                || !mSurfaceQuery || !(dt > 0.0f))
                return;
            RagdollCore::SituationInput in;
            const auto left = mRagdoll->getWorldBodyPosition(mCurrentPhysicsPose, mLeftLeg->mFoot);
            const auto right = mRagdoll->getWorldBodyPosition(mCurrentPhysicsPose, mRightLeg->mFoot);
            if (!left || !right)
                return;
            in.mFeet = { *left, *right };
            if (mSupportEstimate)
                in.mFootContact = { mSupportEstimate->mLeftFootSupported, mSupportEstimate->mRightFootSupported };
            // The centre of mass from the pose and the body masses.
            const auto& masses = mRagdoll->getBodyMasses();
            double mass = 0.0;
            JPH::RVec3 com = JPH::RVec3::sZero();
            for (std::size_t body = 0; body < masses.size(); ++body)
            {
                if (isDetachedWeaponBody(body))
                    continue;
                if (const auto p = mRagdoll->getWorldBodyPosition(mCurrentPhysicsPose, body))
                {
                    com += *p * masses[body];
                    mass += masses[body];
                }
            }
            if (!(mass > 0.0))
                return;
            com /= mass;
            in.mVelocity = mSituationKnown || mSituationCom != JPH::RVec3::sZero()
                ? JPH::Vec3((com - mSituationCom) / dt) : JPH::Vec3::sZero();
            // A teleport or a first step: no velocity.
            if (in.mVelocity.Length() > 2000.0f)
                in.mVelocity = JPH::Vec3::sZero();
            mSituationVelocity += (in.mVelocity - mSituationVelocity) * std::min(1.0f, dt / 0.03f);
            in.mVelocity = mSituationVelocity;
            mSituationCom = com;
            in.mCenterOfMass = com;
            in.mCommandVelocity = JPH::Vec3(mRawTargetHorizontalVelocity.GetX(), mRawTargetHorizontalVelocity.GetY(), 0.0f);
            const float yaw = getPtr().getRefData().getPosition().rot[2];
            in.mFacing = JPH::Vec3(std::sin(yaw), std::cos(yaw), 0.0f);
            const auto& position = getPtr().getRefData().getPosition().pos;
            in.mCapsule = JPH::RVec3(position[0], position[1], position[2]);
            in.mCapsuleFresh = capsuleFresh;
            MWBase::World* world = MWBase::Environment::get().getWorld();
            in.mCapsuleOnGround = world->isOnGround(getPtr());
            in.mGravity = RagdollCore::UnitModel::GravityUnitsPerSecondSquared;
            in.mDt = dt;
            const SurfaceQuery query = mSurfaceQuery;
            mSituation = mSituationReader.read(in, [&query](const JPH::RVec3& from, float length)
                -> std::optional<RagdollCore::GroundHit> {
                const auto hit = query(from, -JPH::Vec3::sAxisZ(), length);
                if (!hit)
                    return std::nullopt;
                return RagdollCore::GroundHit{ hit->first, hit->second };
            });
            mSituationKnown = true;
            updateBalanceBehaviours(dt);
            static const auto trace_tuned = RagdollCore::tuned<bool>([] { return RagdollCore::tuningText("OPENMW_RAGDOLL_SITUATION_TRACE") != nullptr; });
            static const auto& trace = trace_tuned.get();
            if (trace && getPtr() == MWMechanics::getPlayer() && ++mSituationTraceStep % 30 == 0)
            {
                const auto& t = mSituation;
                Log(Debug::Info) << "RAGDOLL_SITUATION supported=" << t.mSupported << " margin=" << t.mCaptureMargin
                                 << " slope=" << t.mSlopeDegrees << " edge=" << t.mEdgeAhead << "@" << t.mEdgeDistance
                                 << " drop=" << t.mEdgeDrop << " air=" << t.mAirborne << " t_air=" << t.mAirTime
                                 << " touchdown=" << t.mTimeToTouchdown << "/" << t.mTouchdownSpeed
                                 << " slip=" << t.mCapsuleSlip << " sliding=" << t.mCapsuleSliding
                                 << " above=" << t.mBodyAboveGround << " rays=" << mSituationReader.raysCast();
            }
        }

        void footfallLibraryInput(RagdollCore::FootfallInput& input, const RagdollCore::RagdollPose& clipPose, float dt)
        {
            using Mode = RagdollCore::ActiveControllerMode;
            MWBase::World* world = MWBase::Environment::get().getWorld();
            input.mDt = dt;
            // The library's own trace (landings, lifts, per-step feet with
            // pin and target heights) for the player: OPENMW_RAGDOLL_FOOTFALL_TRACE
            // ("npc": the NPCs' instead, RAMP-01).
            static const auto traceLibrary_tuned = RagdollCore::tuned<int>([] {
                const char* text = RagdollCore::tuningText("OPENMW_RAGDOLL_FOOTFALL_TRACE");
                return !text ? 0 : text[0] == 'n' ? 2 : 1;
            });
            static const auto& traceLibrary = traceLibrary_tuned.get();
            if (traceLibrary != 0 && (getPtr() == MWMechanics::getPlayer()) == (traceLibrary == 1))
            {
                input.mTrace = [id = getPtr().getCellRef().getRefId().toDebugString()](const std::string& line) {
                    Log(Debug::Info) << line << " actor=" << id;
                };
                // Ground contact per foot this step, to time landings against
                // the swings in the lines that follow.
                if (mSupportEstimate)
                    Log(Debug::Info) << "RAGDOLL_FOOTFALL_CONTACT left=" << mSupportEstimate->mLeftFootSupported
                                     << " right=" << mSupportEstimate->mRightFootSupported;
            }
            input.mEligible = footfallEnabled() && mLeftLeg && mRightLeg && mPelvisBodyIndex
                && mCurrentPhysicsPoseCaptured && mSurfaceQuery && mRagdoll->getSoftRoot().mEnabled
                && (mRagdoll->isRootKinematic() || mBracingPgcActive) && mControllerOutput
                && (mControllerOutput->mMode == Mode::Standing || mControllerOutput->mMode == Mode::Bracing)
                // A braced body's legs may catch it inside a jump window or
                // with the capsule just off the ground (user bookmarks 7/21, the
                // "smooth criminal" lean; play log: every PGC brace skip was the
                // jump window held open past a landing, 10 of 16 with the
                // capsule airborne). OPENMW_RAGDOLL_PGC_BRACE_AIR=0 = old rule.
                && ((!(mSoftRootJumpWindow > 0.0f) && world->isOnGround(getPtr())) || (mBracingPgcActive && braceAir()))
                && !world->isSwimming(getPtr()) && !world->isFlying(getPtr()) && dt > 0.0f && !rollOwnsLegs();
            if (!mPelvisBodyIndex || !mLeftLeg || !mRightLeg)
            {
                input.mEligible = false;
                return;
            }
            input.mPelvis = *mPelvisBodyIndex;
            const std::array<const RagdollLegChain*, 2> legs{ &*mLeftLeg, &*mRightLeg };
            for (std::size_t side = 0; side < 2; ++side)
                input.mLegs[side] = RagdollCore::FootfallLeg{ legs[side]->mHip, legs[side]->mKnee, legs[side]->mFoot,
                    mRagdoll->getHingeLegGeometry(legs[side]->mHip, legs[side]->mKnee, legs[side]->mFoot) };
            input.mSpine = mSpineBodyIndices;
            const float slopeCrouch = mSlopeStance * slopeStanceSettings().mCrouch;
            input.mExtraCrouch = (mHscActive ? mHscLow * hscLowStance()[1] * 0.3f : 0.0f) + mLandingCrouch + slopeCrouch;
            input.mExtraKnee = (mHscActive ? mHscLow * hscLowStance()[1] : 0.0f) + (mLandingCrouch + slopeCrouch) * 2.0f;
            // The stair drop reaches the root only through the library's pelvis
            // drop (not again at the root target). Its knee bend shortens the
            // stance legs by the whole drop (the hinge leg's law of cosines; 2
            // deg/u as above gave only ~6 of 24 units).
            if (mStairDrop > 0.0f)
            {
                input.mExtraCrouch += mStairDrop;
                if (const auto& geometry = input.mLegs[0]->mGeometry)
                {
                    const float a = geometry->mUpperOffset.Length();
                    const float b = geometry->mLowerOffset.Length();
                    if (a > 0.0f && b > 0.0f)
                    {
                        // The legs are posed in model units.
                        const float length = std::max(a + b - mStairDrop * mRagdoll->getInverseUniformScale(), 0.0f);
                        const float cosine
                            = std::clamp((length * length - a * a - b * b) / (2.0f * a * b), -1.0f, 1.0f);
                        input.mExtraKnee += std::min(std::acos(cosine) * 180.0f / 3.14159265f, 100.0f);
                    }
                }
            }
            input.mChestCarried = mChestCarried;
            input.mPhysicsPose = &mCurrentPhysicsPose;
            input.mClipPose = &clipPose;
            // The model frame, bit for bit the ragdoll's own. A rotation rebuilt
            // through getModelRotation is renormalised and a scale read off a
            // rotated unit vector rounds: the suspected source of the one lift
            // that split in the shadow run (course long, step 2805).
            input.mFrame.mReferencePosition = mRagdoll->getReferencePosition();
            input.mFrame.mInverseReferenceRotation = mRagdoll->getInverseReferenceRotation();
            input.mFrame.mInverseUniformScale = mRagdoll->getInverseUniformScale();
            if (mSurfaceQuery)
            {
                const SurfaceQuery query = mSurfaceQuery;
                input.mGround = [query](const JPH::RVec3& point, double reference) -> std::optional<double> {
                    const auto hit = query(JPH::RVec3(point.GetX(), point.GetY(), reference + 30.0),
                        -JPH::Vec3::sAxisZ(), 70.0f);
                    if (!hit || hit->second.GetZ() < 0.7f)
                        return std::nullopt;
                    return hit->first.GetZ();
                };
                // The same probe's surface normal (WALK-02 slopes).
                input.mGroundNormal = [query](const JPH::RVec3& point, double reference) -> std::optional<JPH::Vec3> {
                    const auto hit = query(JPH::RVec3(point.GetX(), point.GetY(), reference + 30.0),
                        -JPH::Vec3::sAxisZ(), 70.0f);
                    if (!hit || hit->second.GetZ() < 0.7f)
                        return std::nullopt;
                    return hit->second;
                };
            }
            input.mActorZ = getPtr().getRefData().getPosition().pos[2];
            input.mYaw = getPtr().getRefData().getPosition().rot[2];
            input.mCommandVelocity = gaitCommandVelocity();
            input.mArmed = getPtr().getClass().getCreatureStats(getPtr()).getDrawState() == MWMechanics::DrawState::Weapon;
            input.mSneaking = getPtr().getClass().getCreatureStats(getPtr()).getStance(MWMechanics::CreatureStats::Stance_Sneak);
            const auto& table = footfallGaitTable();
            input.mGaitTable = table ? &*table : nullptr;
            input.mLoadPolicyActive = updateScopedRecovery(dt);
            // A stop asked for: the landing goes where the pelvis comes to rest
            // (FOOTFALL_STOP_LEAD, ported from the retired adapter).
            input.mStopping = mStopAbsorbOpen && (mStopBraking || stopAsked());
            // Each foot's ground contact (FOOTFALL_CONTACT_LAND lands a swing on it).
            if (mSupportEstimate)
                input.mFootContact = std::array<bool, 2>{ mSupportEstimate->mLeftFootSupported,
                    mSupportEstimate->mRightFootSupported };
            // Stagger steps clear the floor (Codex round 4 game candidate,
            // analysis-artifacts/codex-reactions-2026-10-05/PORT-STAGGER.md):
            // during a hit's scoped recovery episode a swing lifts at least
            // OPENMW_RAGDOLL_STAGGER_STEP_LIFT units (0 = off, the default;
            // Codex's recipe 12). Swung low, a stagger foot glided instead of
            // stepping (user 10-05: "more stepping").
            static const auto staggerLift_tuned = RagdollCore::tuned<float>([] { return weaponDriveSetting("OPENMW_RAGDOLL_STAGGER_STEP_LIFT", 0.0f); });
            static const auto& staggerLift = staggerLift_tuned.get();
            input.mMinimumSwingLift = input.mLoadPolicyActive && staggerLift > 0.0f ? staggerLift : 0.0f;
            // STEP-01 S3: a stagger plan's swings clear the floor.
            if (const auto& step = step01Settings(); step.mChain && mStaggerPlan.active())
                input.mMinimumSwingLift = std::max(input.mMinimumSwingLift, std::min(step.mLift, 20.0f));
        }

        // Shadow mode 2: the library's leg springs, applied over the adapter's
        // (which ran first on its own copy of the pose).
        void applyFootfallLibrarySprings()
        {
            if (!mRagdoll || !mRuntimeProfile)
                return;
            for (std::size_t side = 0; side < 2; ++side)
            {
                if (mFootfallLibraryOutput.mSpringsChanged[side])
                    mFootfallLibrarySprings[side] = mFootfallLibraryOutput.mSprings[side];
                const auto& springs = mFootfallLibrarySprings[side];
                // Off the profile's springs: applied every step (other drives
                // set the leg motors too).
                const bool scaled = std::abs(springs.mStiffness - 1.0f) > 1e-4f
                    || std::abs(springs.mDamping - 1.0f) > 1e-4f || std::abs(springs.mKneeGive - 1.0f) > 1e-4f;
                if (!mFootfallLibraryOutput.mSpringsChanged[side] && !scaled)
                    continue;
                const auto& leg = side == 0 ? mLeftLeg : mRightLeg;
                if (!leg)
                    continue;
                for (const std::size_t body : { leg->mHip, leg->mKnee })
                    if (body < mRuntimeProfile->mBodies.size() && mRuntimeProfile->mBodies[body].mConstraint)
                    {
                        const auto& motor = mRuntimeProfile->mBodies[body].mConstraint->mMotor;
                        const float give = body == leg->mKnee ? springs.mKneeGive : 1.0f;
                        mRagdoll->setMotorSpring(
                            body, motor.mFrequency * springs.mStiffness * give, motor.mDamping * springs.mDamping);
                    }
            }
        }

        void applyFootfall(RagdollCore::RagdollPose& drivePose, const RagdollCore::RagdollPose& clipPose, float dt)
        {
            claimBody(ChannelLegs, BodyOwner::Footfall);
            if (!mFootfallLibrary)
                mFootfallLibrary.emplace(footfallLibrarySettings());
            RagdollCore::FootfallInput input;
            footfallLibraryInput(input, clipPose, dt);
            updateCatchSteps(input);
            mFootfallLibraryOutput = {};
            mFootfallLibrary->setFullSettle(mTip.mActive);
            mFootfallLibrary->setStanceHolds(stanceHoldsWanted());
            mFootfallLibrary->step(input, drivePose, mFootfallLibraryOutput);
            applyFootfallLibrarySprings();
            applyScopedAnkles();
            applyPgcSwingSpring();
            applyLegsLead(input);
            checkLegsHealth(dt);
        }

        // Legs that cannot settle (user 11-01: "go back to default if cant
        // move"; bookmarks 5-11, the right foot re-stepped every 0.6 s for
        // minutes while standing because the leg could not reach its target).
        // Standing still (requested and actual speed under 10 u/s, no hit or
        // scoped episode) for `grace` s, `steps` more steps mean the legs
        // fail: mLegsFailing asks the population for a rebuild where it
        // stands (a second failure within 20 s: 3 s on the default animation
        // first). A healthy stand settles in 0-2 steps inside the grace.
        // OPENMW_RAGDOLL_LEGS_HEALTH = "grace, steps" (0 = off).
        bool mLegsFailing = false;
        float mLegsStillTime = 0.0f;
        unsigned mLegsStillSteps = 0;
        void checkLegsHealth(float dt)
        {
            static const auto value_tuned = RagdollCore::tuned<std::array<float, 2>>([] {
                std::array<float, 2> v{ 1.5f, 4.0f };
                RagdollCore::tuningList("OPENMW_RAGDOLL_LEGS_HEALTH", v);
                return v;
            });
            const auto& settings = value_tuned.get();
            if (settings[0] <= 0.0f || mLegsFailing)
                return;
            float bodySpeed = 0.0f;
            if (mControllerInput)
            {
                const auto& v = mControllerInput->mCenterOfMassVelocity;
                bodySpeed = std::hypot(v.GetX(), v.GetY());
            }
            if (pgcRequestSpeed() > 10.0f || bodySpeed > 10.0f || mHitStun.active() || mScopedEpisode)
            {
                mLegsStillTime = 0.0f;
                mLegsStillSteps = 0;
                return;
            }
            mLegsStillTime += dt;
            if (mLegsStillTime < settings[0])
                return;
            for (const bool started : mFootfallLibraryOutput.mSwingStarted)
                mLegsStillSteps += started ? 1 : 0;
            if (mLegsStillSteps >= static_cast<unsigned>(std::max(1.0f, settings[1])))
            {
                mLegsFailing = true;
                Log(Debug::Info) << "RAGDOLL_LEGS_HEALTH failing actor=" << getPtr().getCellRef().getRefId()
                                 << " still=" << mLegsStillTime << " steps=" << mLegsStillSteps;
            }
        }

        // The legs set the speed (STEPPING audit 11-01, item 16; a
        // body-led model): walking on the ground, calm and held, the capsule follows the
        // body (as BODY_LEADS does in the air), the root's horizontal pull drops
        // to `root share`, and the body is pushed toward the movement request
        // by a friction-capped force through the planted feet (the stance
        // force's pair: the feet are pushed back as the body goes forward), at
        // most `friction share` x its weight, `damping` 1/s toward the request.
        // A body whose legs cannot keep up moves slower instead of being dragged.
        // OPENMW_RAGDOLL_LEGS_LEAD = "on, root share, friction share, damping"
        // (on 0 = off: the capsule leads, the root pulls).
        static const std::array<float, 4>& legsLeadSettings()
        {
            static const auto value_tuned = RagdollCore::tuned<std::array<float, 4>>([] {
                std::array<float, 4> v{ 0.0f, 0.1f, 0.35f, 6.0f };
                RagdollCore::tuningList("OPENMW_RAGDOLL_LEGS_LEAD", v);
                return v;
            });
            return value_tuned.get();
        }
        bool mLegsLeading = false;
        unsigned mLegsLeadSteps = 0;
        void applyLegsLead(const RagdollCore::FootfallInput& input)
        {
            const auto& s = legsLeadSettings();
            const bool was = mLegsLeading;
            mLegsLeading = false;
            // A dodge's burst rides on the same push (OPENMW_RAGDOLL_DODGE).
            const bool dodging = mDodgeTime > 0.0f && mDodgeLength > 0.0f;
            if (!(s[0] > 0.0f || dodging) || !input.mEligible || !mControllerOutput || !mControllerInput || !mRagdoll
                || mControllerOutput->mMode != RagdollCore::ActiveControllerMode::Standing || mJumpAirborne
                || mSoftRootStrength < 0.98f || mStaggerPlan.active() || mHitStun.active() || !mLeftLeg || !mRightLeg
                || !mSituationKnown || mSituation.mAirborne
                // Not on uneven ground: the push is horizontal and friction-capped,
                // so slopes, stairs and climbs keep the capsule leading and the
                // climb hold (11-01: with it on, the player could not walk up
                // the ship ramp).
                || mSituation.mSlopeDegrees > 10.0f || mSlopeStance > 0.0f || mStairDrop > 0.0f
                || std::abs(mKinematicRootActualVerticalVelocity) > 25.0f)
            {
                if (was)
                    Log(Debug::Info) << "RAGDOLL_LEGS_LEAD actor=" << getPtr().getCellRef().getRefId() << " on=0";
                return;
            }
            const JPH::Vec3 request = dodging
                ? mDodgeDirection * (mDodgeLength / std::max(0.05f, dodgeSettings()[4]))
                : JPH::Vec3(mRawTargetHorizontalVelocity.GetX(), mRawTargetHorizontalVelocity.GetY(), 0.0f);
            RagdollCore::RagdollTelemetry telemetry;
            if (request.Length() < 15.0f || !mRagdoll->captureTelemetry(telemetry))
                return;
            RagdollCore::StanceForceInput stance;
            stance.mCenterOfMass = { static_cast<float>(mSituationCom.GetX()), static_cast<float>(mSituationCom.GetY()) };
            stance.mVelocity
                = { mControllerInput->mCenterOfMassVelocity.GetX(), mControllerInput->mCenterOfMassVelocity.GetY() };
            stance.mRequestVelocity = { request.GetX(), request.GetY() };
            const std::array<std::size_t, 2> footBodies{ mLeftLeg->mFoot, mRightLeg->mFoot };
            for (std::size_t side = 0; side < 2; ++side)
            {
                const bool supported = mSupportEstimate
                    && (side == 0 ? mSupportEstimate->mLeftFootSupported : mSupportEstimate->mRightFootSupported);
                if (supported && footfallPinnedAt(side))
                    if (const auto foot = mRagdoll->getWorldBodyPosition(mCurrentPhysicsPose, footBodies[side]))
                        stance.mPlantedFeet[side]
                            = RagdollCore::BalanceVec2{ static_cast<float>(foot->GetX()), static_cast<float>(foot->GetY()) };
            }
            stance.mTotalMass = telemetry.mTotalMass;
            stance.mGravity = RagdollCore::UnitModel::GravityUnitsPerSecondSquared;
            stance.mSettings.mFrictionShare = std::max(0.0f, dodging ? std::max(s[2], 0.6f) : s[2]);
            stance.mSettings.mDamping = std::max(0.0f, s[3]);
            // Between two planted steps the body coasts: the capsule still follows it.
            mLegsLeading = true;
            if (!was)
                Log(Debug::Info) << "RAGDOLL_LEGS_LEAD actor=" << getPtr().getCellRef().getRefId() << " on=1";
            const auto force = RagdollCore::computeStanceForce(stance);
            if (!force || !force->mActive)
                return;
            ++mLegsLeadSteps;
            std::vector<bool> leg(telemetry.mBodies.size(), false);
            for (const auto* chain : { &*mLeftLeg, &*mRightLeg })
                for (const std::size_t body : { chain->mHip, chain->mKnee, chain->mFoot })
                    if (body < leg.size())
                        leg[body] = true;
            float upperMass = 0.0f;
            for (std::size_t i = 0; i < telemetry.mBodies.size(); ++i)
                if (!leg[i] && !isDetachedWeaponBody(i))
                    upperMass += telemetry.mBodies[i].mMass;
            if (!(upperMass > 0.0f))
                return;
            for (std::size_t i = 0; i < telemetry.mBodies.size(); ++i)
                if (!leg[i] && !isDetachedWeaponBody(i))
                {
                    const float share = telemetry.mBodies[i].mMass / upperMass;
                    mRagdoll->applyExternalBodyWrench(
                        i, JPH::Vec3(force->mBodyForce.mX * share, force->mBodyForce.mY * share, 0.0f), JPH::Vec3::sZero());
                }
            for (std::size_t side = 0; side < 2; ++side)
                if (stance.mPlantedFeet[side])
                    mRagdoll->applyExternalBodyWrench(footBodies[side],
                        JPH::Vec3(force->mFootForce[side].mX, force->mFootForce[side].mY, 0.0f), JPH::Vec3::sZero());
        }

        // Bracing with the root released (user bookmark 5: "this falling
        // floating state ... should be the Physical Gait Controller trying to
        // stand itself up ... if not found, it should fall immediately"; PGC
        // package f6937be9bf). The legs alone carry the body: Footfall keeps
        // the feet planted and holds the pelvis over them (leaning it by a
        // posture loop so the torso stands up), a friction-capped stance
        // force pairs the upper body with the planted feet, catch steps take
        // what a step can catch and anything else falls at once, swinging
        // feet get the swing spring. OPENMW_RAGDOLL_PGC_BRACE=1 (0 = off).
        bool mBracingPgcActive = false;
        RagdollCore::PostureController mBracingPosture;
        RagdollCore::CatchStepController mBracingCatch;
        unsigned mBracingReleases = 0;
        unsigned mBracingSkipLogged = 0;
        static bool braceAir()
        {
            static const auto value_tuned = RagdollCore::tuned<bool>([] { return weaponDriveSetting("OPENMW_RAGDOLL_PGC_BRACE_AIR", 1.0f) > 0.0f; });
            static const auto& value = value_tuned.get();
            return value;
        }
        void applyBracingPgc(RagdollCore::RagdollPose& drivePose, const RagdollCore::RagdollPose& clipPose, float dt)
        {
            using Mode = RagdollCore::ActiveControllerMode;
            static const auto enabled_tuned = RagdollCore::tuned<bool>([] { return weaponDriveSetting("OPENMW_RAGDOLL_PGC_BRACE", 0.0f) > 0.0f; });
            static const auto& enabled = enabled_tuned.get();
            const bool active = enabled && mRagdoll && mControllerOutput && mControllerOutput->mMode == Mode::Bracing
                && !mRagdoll->isRootKinematic() && mTorsoBodyIndex && mPelvisBodyIndex && mLeftLeg && mRightLeg
                && mCurrentPhysicsPoseCaptured && dt > 0.0f;
            if (!active)
            {
                if (mBracingPgcActive)
                {
                    mBracingPosture.reset();
                    mBracingCatch.reset();
                }
                mBracingPgcActive = false;
                return;
            }
            claimBody(ChannelLegs, BodyOwner::Balance);
            if (!mBracingPgcActive)
                Log(Debug::Info) << "RAGDOLL_PGC_BRACE begin actor=" << getPtr().getCellRef().getRefId();
            mBracingPgcActive = true;
            if (!mFootfallLibrary)
                mFootfallLibrary.emplace(footfallLibrarySettings());
            RagdollCore::FootfallInput input;
            footfallLibraryInput(input, clipPose, dt);
            if (!input.mEligible)
            {
                // Why the legs could not take a braced body (user bookmarks
                // 7/21: the "smooth criminal" lean - Bracing with the root
                // released and no leg drive, 1.8 s of slow topple).
                if (mBracingSkipLogged < 40)
                {
                    ++mBracingSkipLogged;
                    MWBase::World* world = MWBase::Environment::get().getWorld();
                    Log(Debug::Info) << "RAGDOLL_PGC_BRACE skip actor=" << getPtr().getCellRef().getRefId()
                                     << " footfall=" << footfallEnabled() << " pose=" << mCurrentPhysicsPoseCaptured
                                     << " surface=" << (mSurfaceQuery != nullptr)
                                     << " softroot=" << mRagdoll->getSoftRoot().mEnabled
                                     << " jumpwin=" << (mSoftRootJumpWindow > 0.0f)
                                     << " ground=" << world->isOnGround(getPtr());
                }
                return;
            }
            // The legs do not walk while bracing (offline: walking the capsule
            // away from an unsupported body felled it in 0.68 s).
            input.mCommandVelocity = JPH::Vec3::sZero();
            RagdollCore::RagdollTelemetry telemetry;
            if (!mRagdoll->captureTelemetry(telemetry) || *mTorsoBodyIndex >= telemetry.mBodies.size())
                return;
            const JPH::Vec3 torsoUp = (telemetry.mBodies[*mTorsoBodyIndex].mRotation * mTorsoLocalUp).Normalized();
            const RagdollCore::BalanceVec2 lean
                = mBracingPosture.update(RagdollCore::uprightTilt(torsoUp.GetX(), torsoUp.GetY(), torsoUp.GetZ()), dt);
            RagdollCore::FootfallCommand command;
            command.mStanceHoldsPelvis = true;
            // The root is let go while bracing: stepping toward the anchor
            // walked the feet out from under the body (PGC viewer: 52-65 u
            // backsteps). OPENMW_RAGDOLL_PGC_BRACE_NO_ANCHOR=1.
            static const auto braceNoAnchor_tuned = RagdollCore::tuned<bool>([] { return weaponDriveSetting("OPENMW_RAGDOLL_PGC_BRACE_NO_ANCHOR", 1.0f) > 0.0f; });
            static const auto& braceNoAnchor = braceNoAnchor_tuned.get();
            command.mNoAnchorSettle = braceNoAnchor;
            command.mPelvisLean = JPH::Vec3(lean.mX, lean.mY, 0.0f);
            // Catch steps, stat scaled; release when nothing can catch it.
            const auto& footState = mFootfallLibrary->feet();
            std::array<bool, 2> supported{ mSupportEstimate && mSupportEstimate->mLeftFootSupported,
                mSupportEstimate && mSupportEstimate->mRightFootSupported };
            std::array<RagdollCore::BalanceVec2, 2> feet;
            float legReach = 0.0f;
            for (std::size_t side = 0; side < 2; ++side)
            {
                const auto& leg = side == 0 ? *mLeftLeg : *mRightLeg;
                if (leg.mFoot >= telemetry.mBodies.size())
                    return;
                const JPH::RVec3 foot = telemetry.mBodies[leg.mFoot].mCenterOfMass;
                feet[side] = { static_cast<float>(foot.GetX()), static_cast<float>(foot.GetY()) };
                if (const auto& geometry = input.mLegs[side] ? input.mLegs[side]->mGeometry : std::nullopt)
                    legReach = std::max(legReach, (geometry->mUpperOffset.Length() + geometry->mLowerOffset.Length())
                            / std::max(input.mFrame.mInverseUniformScale, 1e-3f));
            }
            if (!(legReach > 0.0f))
                legReach = 70.0f;
            const JPH::RVec3 com = telemetry.mCenterOfMass;
            const auto ground = input.mGround(com, input.mActorZ);
            const double floorZ = ground ? *ground : input.mActorZ;
            RagdollCore::CatchStepInput catchInput;
            catchInput.mState.mCenterOfMass = { static_cast<float>(com.GetX()), static_cast<float>(com.GetY()) };
            const JPH::Vec3 comVelocity = mControllerInput ? mControllerInput->mCenterOfMassVelocity : JPH::Vec3::sZero();
            catchInput.mState.mVelocity = { comVelocity.GetX(), comVelocity.GetY() };
            catchInput.mState.mHeight = static_cast<float>(com.GetZ() - floorZ);
            catchInput.mState.mGravity = RagdollCore::UnitModel::GravityUnitsPerSecondSquared;
            catchInput.mBodyForward = { std::sin(input.mYaw), std::cos(input.mYaw) };
            for (std::size_t side = 0; side < 2; ++side)
            {
                auto& foot = catchInput.mFeet[side];
                foot.mPosition = feet[side];
                foot.mSupported = supported[side];
                foot.mSwinging = footState[side].mSwinging;
                foot.mTargetHeld = footState[side].mTargetHeld;
                foot.mPhase = footState[side].mPhase;
                foot.mDuration = footState[side].mDuration;
            }
            const RagdollCore::CatchCapability capability = pgcCapability();
            catchInput.mDt = dt;
            catchInput.mLimits = RagdollCore::catchStepLimits(capability, legReach);
            catchInput.mReactionDelay = capability.mReactionDelay;
            catchInput.mStepFreeFoot = true;
            catchInput.mReleaseWhenUncatchable = true;
            catchInput.mReleaseAfterSteps = pgcReleaseAfterSteps();
            catchInput.mArmDriven = mTip.mActive;
            catchInput.mMaximumHoverTime = 0.5f;
            const JPH::Vec3 request(mRawTargetHorizontalVelocity.GetX(), mRawTargetHorizontalVelocity.GetY(), 0.0f);
            if (request.Length() > 1.0f)
                catchInput.mDirectionBias = { request.GetX() / request.Length(), request.GetY() / request.Length() };
            applyStumble(catchInput);
            const auto braceResult = mBracingCatch.update(catchInput);
            countStumble(braceResult);
            pgcTrace("brace", dt, catchInput.mState, feet, supported, braceResult ? static_cast<int>(braceResult->mStage) : -1,
                static_cast<int>(mBracingCatch.stepsStarted()), braceResult && braceResult->mSwingNow,
                braceResult && braceResult->mRelease);
            if (const auto& result = braceResult)
            {
                if (result->mRelease)
                {
                    // Nothing can catch it: fall now, as a topple does.
                    decideFall("brace", result->mFallDirection);
                    ++mBracingReleases;
                    Log(Debug::Info) << "RAGDOLL_PGC_BRACE release actor=" << getPtr().getCellRef().getRefId();
                    mBracingCatch.reset();
                    mBracingPosture.reset();
                    return;
                }
                if (result->mHoldClock)
                {
                    command.mHoldClock = true;
                    command.mSwingNow = result->mSwingNow;
                    command.mSwingTime = result->mSwingTime;
                    for (std::size_t side = 0; side < 2; ++side)
                        if (result->mLanding[side])
                        {
                            const JPH::RVec3 point(result->mLanding[side]->mX, result->mLanding[side]->mY, floorZ);
                            const auto landingGround = input.mGround(point, input.mActorZ);
                            command.mLanding[side]
                                = JPH::RVec3(point.GetX(), point.GetY(), landingGround ? *landingGround : floorZ);
                        }
                }
            }
            mFootfallLibrary->command(command);
            mFootfallLibraryOutput = {};
            mFootfallLibrary->setFullSettle(mTip.mActive);
            mFootfallLibrary->step(input, drivePose, mFootfallLibraryOutput);
            applyFootfallLibrarySprings();
            applyScopedAnkles();
            // The stance force: the upper body toward the middle of the
            // planted feet, braked, capped inside the friction cone, with the
            // opposite force on the planted feet (an internal pair).
            RagdollCore::StanceForceInput stance;
            stance.mCenterOfMass = catchInput.mState.mCenterOfMass;
            stance.mVelocity = catchInput.mState.mVelocity;
            for (std::size_t side = 0; side < 2; ++side)
                if (supported[side] && !footState[side].mSwinging)
                    stance.mPlantedFeet[side] = feet[side];
            stance.mTotalMass = telemetry.mTotalMass;
            stance.mGravity = RagdollCore::UnitModel::GravityUnitsPerSecondSquared;
            if (const auto force = RagdollCore::computeStanceForce(stance); force && force->mActive)
            {
                std::vector<bool> leg(telemetry.mBodies.size(), false);
                for (const auto* chain : { &*mLeftLeg, &*mRightLeg })
                    for (const std::size_t body : { chain->mHip, chain->mKnee, chain->mFoot })
                        if (body < leg.size())
                            leg[body] = true;
                float upperMass = 0.0f;
                for (std::size_t i = 0; i < telemetry.mBodies.size(); ++i)
                    if (!leg[i])
                        upperMass += telemetry.mBodies[i].mMass;
                if (upperMass > 0.0f)
                    for (std::size_t i = 0; i < telemetry.mBodies.size(); ++i)
                        if (!leg[i])
                        {
                            const float share = telemetry.mBodies[i].mMass / upperMass;
                            mRagdoll->applyExternalBodyWrench(i,
                                JPH::Vec3(force->mBodyForce.mX * share, force->mBodyForce.mY * share, 0.0f),
                                JPH::Vec3::sZero());
                        }
                for (std::size_t side = 0; side < 2; ++side)
                    if (stance.mPlantedFeet[side])
                        mRagdoll->applyExternalBodyWrench(side == 0 ? mLeftLeg->mFoot : mRightLeg->mFoot,
                            JPH::Vec3(force->mFootForce[side].mX, force->mFootForce[side].mY, 0.0f), JPH::Vec3::sZero());
            }
            applyPgcSwingSpring(true);
        }

        // PGC knob D: a spring pulls each swinging foot along its swing (the
        // opposite force on the pelvis, so the pair is internal).
        void applyPgcSwingSpring(bool force = false)
        {
            if (!(pgcKnobs()[2] || force) || !mFootfallLibrary || !mRagdoll || !mPelvisBodyIndex || !mLeftLeg || !mRightLeg)
                return;
            RagdollCore::RagdollTelemetry telemetry;
            if (!mRagdoll->captureTelemetry(telemetry))
                return;
            const auto& masses = mRagdoll->getBodyMasses();
            const RagdollCore::CatchCapability capability = pgcCapability();
            const auto& feet = mFootfallLibrary->feet();
            for (std::size_t side = 0; side < 2; ++side)
            {
                if (!feet[side].mSwinging)
                    continue;
                const auto& leg = side == 0 ? *mLeftLeg : *mRightLeg;
                if (leg.mFoot >= telemetry.mBodies.size() || leg.mFoot >= masses.size() || leg.mKnee >= masses.size()
                    || leg.mHip >= masses.size())
                    continue;
                const auto& foot = telemetry.mBodies[leg.mFoot];
                RagdollCore::SwingSpringInput spring;
                spring.mFoot = { static_cast<float>(foot.mCenterOfMass.GetX()), static_cast<float>(foot.mCenterOfMass.GetY()) };
                spring.mFootVelocity = { foot.mMotion.mLinearVelocity.GetX(), foot.mMotion.mLinearVelocity.GetY() };
                spring.mLiftOff = { static_cast<float>(feet[side].mPin.GetX()), static_cast<float>(feet[side].mPin.GetY()) };
                spring.mLanding = { static_cast<float>(feet[side].mTarget.GetX()), static_cast<float>(feet[side].mTarget.GetY()) };
                spring.mPhase = feet[side].mPhase;
                spring.mDuration = feet[side].mDuration;
                spring.mLegMass = masses[leg.mHip] + masses[leg.mKnee] + masses[leg.mFoot];
                spring.mGravity = RagdollCore::UnitModel::GravityUnitsPerSecondSquared;
                spring.mSettings = { capability.mSwingSpringFrequency, 1.0f, 3.0f };
                // Scoped recovery: the spring follows the leg motors' foot goal
                // (velocity filtered 0.03 s, at most 400 u/s, zero as a swing
                // starts) and is implicit over the step.
                const auto& goal = mFootfallLibraryOutput.mMotorFootGoal[side];
                if (mScopedEpisode && goal && mScopedDt > 0.0f && *mPelvisBodyIndex < masses.size())
                {
                    JPH::Vec3& velocity = mScopedGoalVelocity[side];
                    if (mFootfallLibraryOutput.mSwingStarted[side])
                        velocity = JPH::Vec3::sZero();
                    else
                    {
                        JPH::Vec3 raw = mFootfallLibraryOutput.mMotorFootVelocity[side];
                        raw.SetZ(0.0f);
                        velocity += (raw - velocity) * (1.0f - std::exp(-mScopedDt / 0.03f));
                        if (velocity.Length() > 400.0f)
                            velocity = velocity.Normalized() * 400.0f;
                    }
                    spring.mGoal = RagdollCore::BalanceVec2{ static_cast<float>(goal->GetX()),
                        static_cast<float>(goal->GetY()) };
                    spring.mGoalVelocity = RagdollCore::BalanceVec2{ velocity.GetX(), velocity.GetY() };
                    const float footMass = masses[leg.mFoot], pelvisMass = masses[*mPelvisBodyIndex];
                    spring.mImplicitDt = mScopedDt;
                    spring.mEffectiveMass = footMass * pelvisMass / std::max(1e-3f, footMass + pelvisMass);
                }
                else
                    mScopedGoalVelocity[side] = JPH::Vec3::sZero();
                const auto out = RagdollCore::computeSwingSpring(spring);
                if (!out)
                    continue;
                mRagdoll->applyExternalBodyWrench(
                    leg.mFoot, JPH::Vec3(out->mFootForce.mX, out->mFootForce.mY, 0.0f), JPH::Vec3::sZero());
                mRagdoll->applyExternalBodyWrench(*mPelvisBodyIndex,
                    JPH::Vec3(out->mPelvisForce.mX, out->mPelvisForce.mY, 0.0f), JPH::Vec3::sZero());
            }
        }

        bool applyBalanceLegCorrection(RagdollCore::RagdollPose& drivePose,
            const RagdollCore::RagdollPose& animationPose,
            const RagdollCore::ActiveControllerProfile& profile)
        {
            if (!balanceAuthorityEnabled())
                return false;
            const float authority = mBalanceAuthorityStep.mAuthority;
            if (!std::isfinite(authority) || authority <= 0.0f)
            {
                mBalanceAuthorityCorrection = "zero-authority";
                return false;
            }
            if (!mBalanceSnapshot || !mCurrentPhysicsPoseCaptured || !mPelvisBodyIndex
                || !mLeftLeg || !mRightLeg
                || mBalanceSnapshot->mActorSerial != mSerial
                || mBalanceSnapshot->mLifecycleEpoch != mBalanceLifecycleEpoch
                || mBalanceSnapshot->mPhysicsStep == std::numeric_limits<std::uint64_t>::max()
                || mBalanceSnapshot->mPhysicsStep + 1 != mCurrentContactPhysicsStep)
            {
                mBalanceFootAnchors = {};
                mBalanceAuthorityCorrection = "missing-previous-step-snapshot";
                return false;
            }
            if (mControllerOutput->mMode != RagdollCore::ActiveControllerMode::Standing
                || !mRagdoll->isRootKinematic())
            {
                mBalanceFootAnchors = {};
                mBalanceAuthorityCorrection = "ownership-ineligible";
                return false;
            }
            if (drivePose.mBodyTransforms.size() != animationPose.mBodyTransforms.size()
                || drivePose.mBodyTransforms.size() != mCurrentPhysicsPose.mBodyTransforms.size())
            {
                mBalanceFootAnchors = {};
                mBalanceAuthorityCorrection = "pose-size-mismatch";
                return false;
            }

            const std::array<const RagdollLegChain*, 2> legs{ &*mLeftLeg, &*mRightLeg };
            const std::array<std::optional<std::size_t>, 2> feet{ mLeftFootBodyIndex, mRightFootBodyIndex };
            std::array<bool, 2> eligible{};
            const auto woundOwns = [&](const RagdollLegChain& leg) {
                for (const auto body : { leg.mHip, leg.mKnee, leg.mFoot })
                {
                    if (body >= mBodyRegions.size())
                        return true;
                    const auto region = mBodyRegions[body];
                    const auto index = static_cast<std::size_t>(region);
                    if (index < mWoundReactions.size() && body == mWoundBodies[index]
                        && mWoundReactions[index].angle(region) > 0.00001f)
                        return true;
                }
                return false;
            };

            for (std::size_t side = 0; side < 2; ++side)
            {
                if (!feet[side] || woundOwns(*legs[side]))
                {
                    mBalanceFootAnchors[side].reset();
                    continue;
                }
                std::optional<JPH::BodyID> surfaceBody;
                JPH::RVec3 centroid = JPH::RVec3::sZero();
                double totalLoad = 0.0;
                bool stationary = true;
                for (std::size_t i = 0; i < mBalanceSnapshot->mContacts.size(); ++i)
                {
                    const auto& contact = mBalanceSnapshot->mContacts[i].mContact;
                    if (contact.mBodyIndex != *feet[side] || !contact.mNormalImpulse
                        || *contact.mNormalImpulse <= 0.0f
                        || contact.mNormal.Normalized().GetZ() < profile.mSupportNormalMinimumDot)
                        continue;
                    if (i >= mBalanceSnapshot->mContactSources.size())
                    {
                        stationary = false;
                        break;
                    }
                    const auto& source = mBalanceSnapshot->mContactSources[i];
                    if (!source.mSurfaceStatic || !*source.mSurfaceStatic || !source.mSurfacePoint
                        || (surfaceBody && *surfaceBody != source.mSurfaceBodyId))
                    {
                        stationary = false;
                        break;
                    }
                    surfaceBody = source.mSurfaceBodyId;
                    const double load = *contact.mNormalImpulse;
                    centroid += *source.mSurfacePoint * load;
                    totalLoad += load;
                }
                if (!stationary || !surfaceBody || !std::isfinite(totalLoad) || totalLoad <= 0.0)
                {
                    mBalanceFootAnchors[side].reset();
                    continue;
                }
                centroid /= totalLoad;
                if (!mBalanceFootAnchors[side]
                    || mBalanceFootAnchors[side]->mSurfaceBody != *surfaceBody)
                {
                    const auto origin = mRagdoll->getWorldBodyPosition(mCurrentPhysicsPose, *feet[side]);
                    const auto rotation = mRagdoll->getWorldBodyRotation(mCurrentPhysicsPose, *feet[side]);
                    if (!origin || !rotation)
                    {
                        mBalanceFootAnchors[side].reset();
                        continue;
                    }
                    mBalanceFootAnchors[side] = BalanceFootAnchor{ *surfaceBody, centroid,
                        rotation->Conjugated() * JPH::Vec3(centroid - *origin) };
                }
                eligible[side] = true;
            }
            if (!eligible[0] && !eligible[1])
            {
                mBalanceAuthorityCorrection = "no-stationary-loaded-foot";
                return false;
            }

            const auto referenceLeg = [&](const RagdollLegChain& chain) {
                RagdollCore::ReferenceGaitLeg result{ chain.mHip, chain.mKnee, chain.mFoot,
                    mRagdoll->getHingeLegGeometry(chain.mHip, chain.mKnee, chain.mFoot) };
                result.mHipGeometry = mRagdoll->getSwingTwistJointGeometry(chain.mHip);
                result.mAnkleGeometry = mRagdoll->getSwingTwistJointGeometry(chain.mFoot);
                return result;
            };
            const auto leftReference = referenceLeg(*mLeftLeg);
            const auto rightReference = referenceLeg(*mRightLeg);
            if (!leftReference.mHingeGeometry || !leftReference.mHipGeometry || !leftReference.mAnkleGeometry
                || !rightReference.mHingeGeometry || !rightReference.mHipGeometry || !rightReference.mAnkleGeometry)
            {
                mBalanceAuthorityCorrection = "missing-native-leg-geometry";
                return false;
            }

            const auto angle = [](JPH::QuatArg first, JPH::QuatArg second) {
                const JPH::Quat relative = (first * second.Conjugated()).Normalized();
                return 2.0f * std::atan2(relative.GetXYZ().Length(), std::abs(relative.GetW()));
            };
            constexpr float pi = 3.14159265358979323846f;
            const float maximumAngle
                = mBalanceAuthorityProfile.mMaximumAnimationDeviationDegrees * pi / 180.0f * authority + 1e-4f;
            const float maximumDistance
                = mBalanceAuthorityProfile.mMaximumAnimationDeviationUnits * authority + 1e-4f;
            const auto withinBudget = [&](const RagdollCore::RagdollPose& candidate,
                                          const RagdollCore::RagdollPose& baseline) {
                for (std::size_t side = 0; side < 2; ++side)
                {
                    if (!eligible[side])
                        continue;
                    const auto& leg = *legs[side];
                    const std::array<std::size_t, 3> bodies{ leg.mHip, leg.mKnee, leg.mFoot };
                    std::size_t parent = *mPelvisBodyIndex;
                    for (const auto body : bodies)
                    {
                        if (body >= candidate.mBodyTransforms.size() || parent >= candidate.mBodyTransforms.size())
                            return false;
                        const auto candidatePosition = mRagdoll->getWorldBodyPosition(candidate, body);
                        const auto animationPosition = mRagdoll->getWorldBodyPosition(animationPose, body);
                        const auto baselinePosition = mRagdoll->getWorldBodyPosition(baseline, body);
                        const auto candidateRotation = mRagdoll->getWorldBodyRotation(candidate, body);
                        const auto animationRotation = mRagdoll->getWorldBodyRotation(animationPose, body);
                        const auto baselineRotation = mRagdoll->getWorldBodyRotation(baseline, body);
                        if (!candidatePosition || !animationPosition || !baselinePosition
                            || !candidateRotation || !animationRotation || !baselineRotation
                            || JPH::Vec3(*candidatePosition - *animationPosition).Length() > maximumDistance
                            || JPH::Vec3(*candidatePosition - *baselinePosition).Length() > maximumDistance
                            || angle(*candidateRotation, *animationRotation) > maximumAngle
                            || angle(*candidateRotation, *baselineRotation) > maximumAngle)
                            return false;
                        const auto relative = [&](const RagdollCore::RagdollPose& pose) {
                            return pose.mBodyTransforms[parent].mRotation.Conjugated()
                                * pose.mBodyTransforms[body].mRotation;
                        };
                        if (angle(relative(candidate), relative(animationPose)) > maximumAngle
                            || angle(relative(candidate), relative(baseline)) > maximumAngle)
                            return false;
                        parent = body;
                    }
                }
                return true;
            };
            if (!withinBudget(drivePose, drivePose))
            {
                mBalanceAuthorityCorrection = "baseline-outside-deviation-budget";
                return false;
            }

            for (int iteration = 0; iteration < 8; ++iteration)
            {
                const float fraction = authority * std::ldexp(1.0f, -iteration);
                RagdollCore::RagdollPose candidate = drivePose;
                bool solved = true;
                for (std::size_t side = 0; side < 2 && solved; ++side)
                {
                    if (!eligible[side])
                        continue;
                    const auto desiredOrigin = mRagdoll->getWorldBodyPosition(candidate, *feet[side]);
                    const auto desiredRotation = mRagdoll->getWorldBodyRotation(candidate, *feet[side]);
                    if (!desiredOrigin || !desiredRotation)
                    {
                        solved = false;
                        break;
                    }
                    RagdollCore::StanceContactPositionInput positionInput;
                    positionInput.mAnchorPosition = mBalanceFootAnchors[side]->mSurfacePoint;
                    positionInput.mDesiredFootOrigin = *desiredOrigin;
                    positionInput.mDesiredFootRotation = *desiredRotation;
                    positionInput.mContactOffsetInFoot = mBalanceFootAnchors[side]->mContactOffsetInFoot;
                    // Solve the complete bounded anchor request first. The
                    // authority fraction is applied to the articulated result
                    // below, so it scales both translation and rotation and
                    // cannot be squared by the endpoint adapter.
                    positionInput.mCorrectionFraction = 1.0f;
                    positionInput.mMaximumEndpointCorrection
                        = mBalanceAuthorityProfile.mMaximumAnimationDeviationUnits;
                    const auto target = RagdollCore::calculateStanceContactPositionTarget(positionInput);
                    // Ground contact already owns the vertical axis. Stage C
                    // opposes measured material-point slip in the support
                    // plane; feeding the several-unit sole-height offset into
                    // leg IK produced a large normal impulse despite a bounded
                    // final pose.
                    std::optional<JPH::RVec3> targetWorld;
                    if (target)
                    {
                        JPH::Vec3 tangent = target->mEndpointCorrection;
                        tangent.SetZ(0.0f);
                        targetWorld = *desiredOrigin + tangent;
                    }
                    const auto targetModel
                        = targetWorld ? mRagdoll->getModelPosition(*targetWorld) : std::nullopt;
                    const auto& leg = *legs[side];
                    const auto hinge = mRagdoll->getHingeLegGeometry(leg.mHip, leg.mKnee, leg.mFoot);
                    JPH::Vec3 preferredBend = JPH::Vec3::sAxisY();
                    if (targetModel && hinge && leg.mHip < candidate.mBodyTransforms.size())
                    {
                        const auto& hip = candidate.mBodyTransforms[leg.mHip];
                        const auto line = (*targetModel - hip.mTranslation).NormalizedOr(JPH::Vec3::sAxisZ());
                        auto hingePlane = hip.mRotation * hinge->mHingeAxis;
                        hingePlane -= line * hingePlane.Dot(line);
                        if (!hingePlane.IsNearZero())
                            // The fixed-hinge solver compares direction cross
                            // preferredBend with its hinge-plane direction.
                            preferredBend = hingePlane.Normalized().Cross(line)
                                .NormalizedOr(JPH::Vec3::sAxisY());
                    }
                    const RagdollCore::TwoBoneLegTargetInput legInput{ leg.mHip, leg.mKnee, leg.mFoot,
                        targetModel.value_or(JPH::Vec3::sZero()), preferredBend, hinge };
                    solved = targetModel
                        && RagdollCore::applyTwoBoneLegTarget(candidate.mBodyTransforms, legInput);
                }
                if (!solved)
                    continue;
                const auto projected = RagdollCore::projectReferenceLegPosture(candidate.mBodyTransforms,
                    *mPelvisBodyIndex, leftReference, rightReference);
                if (!projected)
                    continue;
                RagdollCore::RagdollPose blended = drivePose;
                for (std::size_t side = 0; side < 2; ++side)
                {
                    if (!eligible[side])
                        continue;
                    const auto& leg = *legs[side];
                    for (const auto body : { leg.mHip, leg.mKnee, leg.mFoot })
                    {
                        const auto& from = drivePose.mBodyTransforms[body];
                        const auto& to = projected->mBodyTransforms[body];
                        blended.mBodyTransforms[body].mTranslation
                            = from.mTranslation + (to.mTranslation - from.mTranslation) * fraction;
                        blended.mBodyTransforms[body].mRotation
                            = from.mRotation.SLERP(to.mRotation, fraction).Normalized();
                    }
                }
                // Re-project after blending. A full IK endpoint is valid, but
                // quaternion interpolation across a swing/twist cone is not
                // itself proof that every intermediate joint remains valid.
                const auto bounded = RagdollCore::projectReferenceLegPosture(blended.mBodyTransforms,
                    *mPelvisBodyIndex, leftReference, rightReference);
                if (!bounded)
                    continue;
                RagdollCore::RagdollPose masked = drivePose;
                for (std::size_t side = 0; side < 2; ++side)
                {
                    if (!eligible[side])
                        continue;
                    const auto& leg = *legs[side];
                    for (const auto body : { leg.mHip, leg.mKnee, leg.mFoot })
                        masked.mBodyTransforms[body] = bounded->mBodyTransforms[body];
                }
                if (!withinBudget(masked, drivePose))
                    continue;
                drivePose = std::move(masked);
                mBalanceAppliedAuthority = fraction;
                mBalanceCorrectedLegMask = (eligible[0] ? 1u : 0u) | (eligible[1] ? 2u : 0u);
                mBalanceAuthorityCorrection = "applied-stationary-support";
                return true;
            }
            mBalanceAuthorityCorrection = "no-feasible-bounded-leg-pose";
            return false;
        }

        void beginContactStep(std::uint64_t physicsStep, float duration)
        {
            std::scoped_lock lock(mContactMutex);
            mCurrentContactPhysicsStep = physicsStep;
            mContactStepDuration = duration;
            stepBalanceAuthority(physicsStep, duration);
            mStepContacts.clear();
            mBalanceContactObservations.clear();
            mBalanceFootGeometryComplete = { true, true };
            mBalanceComposedStep.reset();
            mBalanceComposedAngles = {};
            mBalanceComposedFeet = {};
            mBalanceComposedSource = "none";
            mStepWeaponResponses.clear();
        }

        // PhysicsSystem::Update has joined every callback job before this is
        // called. This is the single game-thread transfer of event ownership.
        bool hasPhysicalFollowThrough() const
        {
            return mAnimationPlaybackComplete && mAnimationAttack.mPhase == MWMechanics::RagdollAttackPhase::Idle
                && mAnimationAttackMotors && mAnimationAttackBraking > 0.0f
                && mPowered && mWeapon && mWeapon->mAttached;
        }

        MWMechanics::RagdollAttackPhase contactAttackPhase() const
        {
            return hasPhysicalFollowThrough() ? MWMechanics::RagdollAttackPhase::FollowThrough
                                             : mAnimationAttack.mPhase;
        }

        bool permitsNativeAttackContact(const RagdollCore::WeaponContactEvent& contact) const
        {
            // Hand control's own swings and cuts strike whatever phase
            // the native attack a click started is in.
            if (mHscActive)
                return contact.swingActive() && contact.swingIdentity() == mSwingIdentity
                    // The player's cuts only: NPC attacks do not run through
                    // the wheel's cut stage the same way, and the window shut
                    // every NPC blow out (NPCHIT-01: 0-1 blows on the player in
                    // 30 s against 4-6; user build 62: "NPCs can't hit me").
                    && (!connectSettings().mOn || getPtr() != MWMechanics::getPlayer() || hscStrikeOpen());
            return MWMechanics::permitsRagdollAttackContact(mAnimationAttackOwned,
                contactAttackPhase(), contact.swingActive(), contact.swingIdentity(), mSwingIdentity);
        }

        // AI-02 item 1, measuring NPC accuracy (OPENMW_RAGDOLL_AI_AIM_TRACE=1,
        // logging only): an NPC cut on the wheel from its start to the
        // recovery (at most 0.8 s): the flat gap and azimuth to the foe's chest
        // at the start, the line, and the closest the blade (hand -> tip) came
        // to that chest. tools/body/analysis/npcaim.py pairs the BEGIN/END
        // lines with the contacts logged between them.
        bool mAiCutTracing = false, mAiCutArmed = true, mAiCutWinding = false;
        float mAiCutTime = 0.0f, mAiCutCutTime = 0.0f, mAiCutClosest = 0.0f;
        unsigned mAiCutCount = 0;
        float bladeDistance(JPH::RVec3Arg point) const
        {
            if (!mWeapon || !mWeapon->mAttached || mWeapon->mHandBody >= mRagdoll->getBodyCount())
                return std::numeric_limits<float>::infinity();
            const auto hand = mRagdoll->getWorldBodyPosition(mCurrentPhysicsPose, mWeapon->mHandBody);
            const auto turn = mRagdoll->getWorldBodyRotation(mCurrentPhysicsPose, mWeapon->mHandBody);
            if (!hand || !turn)
                return std::numeric_limits<float>::infinity();
            const JPH::Vec3 ab(*turn * mWeapon->mBladeAxis * std::max(mWeapon->tipDistanceFromHand(), 0.0f));
            const float lengthSq = ab.LengthSq();
            const float u
                = lengthSq > 1e-6f ? std::clamp(JPH::Vec3(point - *hand).Dot(ab) / lengthSq, 0.0f, 1.0f) : 0.0f;
            return static_cast<float>((point - (*hand + JPH::RVec3(ab * u))).Length());
        }
        void traceAiCut(float dt)
        {
            static const auto trace_tuned = RagdollCore::tuned<bool>([] { return weaponDriveSetting("OPENMW_RAGDOLL_AI_AIM_TRACE", 0.0f) > 0.0f; });
            static const auto& trace = trace_tuned.get();
            if (!trace || getPtr() == MWMechanics::getPlayer())
                return;
            const bool cutting = mHscActive && mAttackStage == AttackStage::Cut;
            const auto& id = getPtr().getCellRef().getRefId();
            if (!cutting && !mAiCutTracing)
                mAiCutArmed = true;
            const bool winding = mHscActive && mAttackStage == AttackStage::Wind;
            if (winding && !mAiCutWinding && mHscFoe)
            {
                const JPH::Vec3 to(*mHscFoe - mRagdoll->getReferencePosition());
                Log(Debug::Info) << "RAGDOLL_AI_WIND actor=" << id << " gap=" << std::hypot(to.GetX(), to.GetY());
            }
            mAiCutWinding = winding;
            if (cutting && !mAiCutTracing && mAiCutArmed)
            {
                mAiCutArmed = false;
                mAiCutTracing = true;
                mAiCutTime = 0.0f;
                mAiCutClosest = std::numeric_limits<float>::infinity();
                ++mAiCutCount;
                float gap = -1.0f, az = 0.0f, dz = 0.0f;
                if (mHscFoe)
                {
                    const JPH::RVec3 self = mRagdoll->getReferencePosition();
                    const JPH::Vec3 to(*mHscFoe - self);
                    gap = std::hypot(to.GetX(), to.GetY());
                    const float yaw = getPtr().getRefData().getPosition().rot[2];
                    const float fx = std::sin(yaw), fy = std::cos(yaw);
                    az = osg::RadiansToDegrees(std::atan2(to.GetX() * fy - to.GetY() * fx, to.GetX() * fx + to.GetY() * fy));
                    dz = to.GetZ();
                }
                Log(Debug::Info) << "RAGDOLL_AI_CUT_BEGIN actor=" << id << " n=" << mAiCutCount
                                 << " line=" << osg::RadiansToDegrees(mAttackAngle) << " foe=" << (mHscFoe ? 1 : 0)
                                 << " gap=" << gap << " az=" << az << " dz=" << dz << " assist=" << mHscFoeAssist
                                 << " el=" << mHscAimElevation << " control=" << mWeaponControl;
            }
            if (!mAiCutTracing)
                return;
            mAiCutTime += dt;
            if (cutting)
                mAiCutCutTime = mAiCutTime;
            if (mHscFoe)
                mAiCutClosest = std::min(mAiCutClosest, bladeDistance(*mHscFoe));
            // To the recovery's end, at most 1.5 s (one cut is one line,
            // however long its stage lasts).
            const bool over = (!cutting && mAttackStage != AttackStage::Recover) || mAiCutTime > 1.5f;
            if (over)
            {
                mAiCutTracing = false;
                Log(Debug::Info) << "RAGDOLL_AI_CUT_END actor=" << id << " n=" << mAiCutCount
                                 << " closest=" << (std::isfinite(mAiCutClosest) ? mAiCutClosest : -1.0f)
                                 << " time=" << mAiCutTime << " cut_time=" << mAiCutCutTime;
            }
        }

        // GUARD-COVER: how far a contact point lies from what this body
        // guards with - its weapon (hand to tip), its shield, or with no
        // weapon its hands. Infinite when none is known.
        float guardCoverDistance(JPH::RVec3Arg point) const
        {
            float best = std::numeric_limits<float>::infinity();
            const auto pointTo = [&](JPH::RVec3Arg a, JPH::RVec3Arg b) {
                const JPH::Vec3 ab(b - a);
                const float lengthSq = ab.LengthSq();
                const float u = lengthSq > 1e-6f
                    ? std::clamp(JPH::Vec3(point - a).Dot(ab) / lengthSq, 0.0f, 1.0f) : 0.0f;
                best = std::min(best, static_cast<float>((point - (a + JPH::RVec3(ab * u))).Length()));
            };
            if (mShield && mShield->mShieldBody < mRagdoll->getBodyCount())
                if (const auto shield = mRagdoll->getWorldBodyPosition(mCurrentPhysicsPose, mShield->mShieldBody))
                    pointTo(*shield, *shield);
            if (mWeapon && mWeapon->mAttached && mWeapon->mHandBody < mRagdoll->getBodyCount())
            {
                const auto hand = mRagdoll->getWorldBodyPosition(mCurrentPhysicsPose, mWeapon->mHandBody);
                const auto turn = mRagdoll->getWorldBodyRotation(mCurrentPhysicsPose, mWeapon->mHandBody);
                if (hand && turn)
                    pointTo(*hand,
                        *hand + JPH::RVec3(*turn * mWeapon->mBladeAxis * std::max(mWeapon->tipDistanceFromHand(), 0.0f)));
            }
            else
                for (const auto* arm : { &mLeftArm, &mRightArm })
                    if (*arm)
                        if (const auto hand = mRagdoll->getWorldBodyPosition(mCurrentPhysicsPose, (*arm)->mHand))
                            pointTo(*hand, *hand);
            return best;
        }

        // RXN-02 M2: what this body was doing when a blow landed.
        RagdollCore::BlowVictimState blowVictimState() const
        {
            RagdollCore::BlowVictimState state;
            state.mWindingUp = mHscActive && mAttackStage == AttackStage::Wind;
            state.mAttacking = state.mWindingUp || (mHscActive && mAttackStage == AttackStage::Cut)
                || mSwing.mSwinging || mAiStrikeActive;
            state.mGuarding = mGuardActive;
            state.mMoving = !mTargetHorizontalVelocity.IsNearZero();
            state.mReacting = mHitStun.active();
            if (mControllerOutput)
            {
                const auto mode = mControllerOutput->mMode;
                state.mDown = mode == RagdollCore::ActiveControllerMode::Falling
                    || mode == RagdollCore::ActiveControllerMode::Fallen
                    || mode == RagdollCore::ActiveControllerMode::GettingUp;
            }
            if (mControllerInput)
            {
                const JPH::Vec3 velocity = mControllerInput->mCenterOfMassVelocity;
                state.mSpeed = std::hypot(velocity.GetX(), velocity.GetY());
            }
            return state;
        }

        // RXN-02 V2 (docs/ragdoll/designs/RXN-02-reaction-controller.md):
        // the reaction controller answers every blow - the struck chain's
        // give, the snap, the region reflexes, the interrupt, the bearings.
        // (M8 10-07: the only path; the user kept it after build 67.)
        // The controller's sizes, tunable without a build:
        // OPENMW_RAGDOLL_REACTION_V2_TUNE = "head away, trunk fold, trunk
        // turn, arm fling, knee bend (rad at a heavy blow), head snap, trunk
        // snap (rad/s), give floor heavy, reflex onset (s)" (empty fields keep
        // the defaults).
        static RagdollCore::ReactionSettings reactionSettingsV2()
        {
            RagdollCore::ReactionSettings settings;
            if (const char* text = RagdollCore::tuningText("OPENMW_RAGDOLL_REACTION_V2_TUNE"))
            {
                float* fields[] = { &settings.mHeadAway, &settings.mTrunkFold, &settings.mTrunkTurn, &settings.mArmFling,
                    &settings.mKneeBend, &settings.mSnapHead, &settings.mSnapTrunk, &settings.mGiveFloorHeavy,
                    &settings.mReflexOnset };
                std::string spec(text);
                std::size_t field = 0, start = 0;
                while (field < std::size(fields) && start <= spec.size())
                {
                    const std::size_t end = std::min(spec.find(',', start), spec.size());
                    const std::string item = spec.substr(start, end - start);
                    if (!item.empty())
                        *fields[field] = static_cast<float>(std::atof(item.c_str()));
                    ++field;
                    start = end + 1;
                }
            }
            // How long a covering reflex holds (user 10-10: "I see them hold
            // their head for a bit after a hit but they should stay there a
            // little bit longer"): OPENMW_RAGDOLL_REACTION_V2_COVER_HOLD =
            // seconds the arms stay up over the face (before visibility's
            // sqrt(k); default 0.35).
            if (const char* text = RagdollCore::tuningText("OPENMW_RAGDOLL_REACTION_V2_COVER_HOLD"))
                if (const float value = static_cast<float>(std::atof(text)); value > 0.0f && value < 5.0f)
                    settings.mArmsUpHold = value;
            // Visibility (user 10-07 on build 67: "the hit reactions ... are
            // barely doing anything"; REACT-05: an armed fighter's reaction
            // drowns in its own fighting): sizes and snaps x k (within caps),
            // holds longer by sqrt(k). The push scales with it
            // (applyBlowReaction). OPENMW_RAGDOLL_REACTION_V2_VIS = k (1 = off).
            if (const float k = reactionVisibility(); k != 1.0f)
            {
                settings.mHeadAway = std::min(settings.mHeadAway * k, 1.3f);
                settings.mTrunkFold = std::min(settings.mTrunkFold * k, 1.1f);
                settings.mTrunkTurn = std::min(settings.mTrunkTurn * k, 0.9f);
                settings.mArmFling = std::min(settings.mArmFling * k, 2.5f);
                settings.mKneeBend = std::min(settings.mKneeBend * k, 1.1f);
                settings.mSnapHead = std::min(settings.mSnapHead * k, settings.mHeadSpinCap);
                settings.mSnapTrunk = std::min(settings.mSnapTrunk * k, 10.0f);
                const float hold = std::sqrt(std::max(k, 0.1f));
                settings.mReflexHold *= hold;
                settings.mArmsUpHold *= hold;
                settings.mArmFlingHold *= hold;
                settings.mReflexRelease *= hold;
            }
            // M5 leg give-out (injury): a leg blow costing `share` of the
            // victim's health gives the leg out fully (onBlowV2 passes the
            // damage as a percentage of health). OPENMW_RAGDOLL_REACTION_V2_LEG
            // = "share, dip units, weakness, seconds, knee rad" (share 0 = off).
            // Bearings (user 10-07: "the opponent should take a second to get
            // their bearings ... stagger logic based on stamina and health").
            // OPENMW_RAGDOLL_REACTION_V2_BEARINGS = "base s, s per severity,
            // tired, hurt, poise floor, blunt" (base 0 = off).
            if (const char* text = RagdollCore::tuningText("OPENMW_RAGDOLL_REACTION_V2_BEARINGS"))
                std::sscanf(text, "%f,%f,%f,%f,%f,%f", &settings.mBearingsBase, &settings.mBearingsPerSeverity,
                    &settings.mBearingsTired, &settings.mBearingsHurt, &settings.mPoiseFloor,
                    &settings.mBluntConcussion);
            settings.mLegInjuryDamage = legGiveOutSettings()[0] * 100.0f;
            settings.mLegGiveOutWeakness = legGiveOutSettings()[2];
            settings.mLegGiveOutTime = legGiveOutSettings()[3];
            settings.mLegGiveOutKnee = legGiveOutSettings()[4];
            return settings;
        }
        static float reactionVisibility()
        {
            static const auto value_tuned = RagdollCore::tuned<float>([] {
                const char* text = RagdollCore::tuningText("OPENMW_RAGDOLL_REACTION_V2_VIS");
                const float k = text ? static_cast<float>(std::atof(text)) : 1.0f;
                return std::isfinite(k) ? std::clamp(k, 0.5f, 3.0f) : 1.0f;
            });
            static const auto& value = value_tuned.get();
            return value;
        }
        static const std::array<float, 5>& legGiveOutSettings()
        {
            static const auto value_tuned = RagdollCore::tuned<std::array<float, 5>>([] {
                std::array<float, 5> v{ 0.0f, 24.0f, 0.15f, 1.2f, 1.3f };
                if (const char* text = RagdollCore::tuningText("OPENMW_RAGDOLL_REACTION_V2_LEG"))
                    std::sscanf(text, "%f,%f,%f,%f,%f", &v[0], &v[1], &v[2], &v[3], &v[4]);
                return v;
            });
            static const auto& value = value_tuned.get();
            return value;
        }
        RagdollCore::ReactionController mReactionV2{ reactionSettingsV2() };
        std::uint64_t mReactionV2Tuning = 0; // tuning generation the settings were built at
        RagdollCore::ReactionStepOutput mReactionV2Step;
        // M1: the body's channel leases (the reaction's compliance first).
        RagdollCore::BodyLeaseTable mLeases;
        std::array<RagdollCore::LeaseId, RagdollCore::sBodyChannelCount> mReactionLeases{};
        std::array<RagdollCore::LeaseId, RagdollCore::sBodyChannelCount> mReflexLeases{};

        RagdollCore::ReactionVictim reactionVictimV2() const
        {
            RagdollCore::ReactionVictim victim;
            const RagdollCore::BlowVictimState state = blowVictimState();
            victim.mAttacking = state.mAttacking;
            victim.mCutting = mHscActive && mAttackStage == AttackStage::Cut;
            victim.mWindShare = mHscActive && mAttackStage == AttackStage::Wind ? std::clamp(mAttackWind, 0.0f, 1.0f) : 0.0f;
            victim.mGuarding = state.mGuarding;
            victim.mDown = state.mDown;
            // Staggering = getting its bearings (PGC owns balance; no bands).
            victim.mStaggering = mLastBearings > 0.0f;
            const auto& stats = getPtr().getClass().getCreatureStats(getPtr());
            const auto ratio = [](const auto& stat) {
                return stat.getModified() > 0.0f ? std::clamp(stat.getCurrent() / stat.getModified(), 0.0f, 1.0f) : 1.0f;
            };
            victim.mFatigue = ratio(stats.getFatigue());
            victim.mHealth = ratio(stats.getHealth());
            return victim;
        }

        // The body's facing (from the actor's yaw) and up, world space.
        JPH::Vec3 reactionForward() const
        {
            const float yaw = getPtr().getRefData().getPosition().rot[2];
            return JPH::Vec3(std::sin(yaw), std::cos(yaw), 0.0f);
        }

        // A counted blow: `impulse` is what the strike gave the struck part
        // (world), `com` and `mass` the whole body's.
        // PGC-03 B4-B7: the stagger plan (ragdollcore/staggerplan.hpp).
        // OPENMW_RAGDOLL_STAGGER_PLAN = "on, flinch dv, 3rd-step dv, 4th-step
        // dv, heavy dv, step per dv, swing s, under-recover share, lean rad,
        // arms rad, head rad, skid u/s" (unset or first 0 = off).
        static const RagdollCore::StaggerSettings& staggerSettings()
        {
            static const auto value_tuned = RagdollCore::tuned<RagdollCore::StaggerSettings>([] {
                RagdollCore::StaggerSettings s;
                if (const char* text = RagdollCore::tuningText("OPENMW_RAGDOLL_STAGGER_PLAN"))
                {
                    float on = 0.0f;
                    std::sscanf(text, "%f,%f,%f,%f,%f,%f,%f,%f,%f,%f,%f,%f", &on, &s.mFlinchDv, &s.mStaggerDv[1],
                        &s.mStaggerDv[2], &s.mHeavyDv, &s.mStepPerDv, &s.mSwingTime, &s.mUnderRecover, &s.mLean,
                        &s.mArms, &s.mHead, &s.mSkidSpeed);
                    s.mEnabled = on > 0.0f;
                }
                return s;
            });
            static const auto& value = value_tuned.get();
            return value;
        }
        RagdollCore::StaggerPlan mStaggerPlan;
        unsigned mStaggerPlans = 0, mStaggerPlanSteps = 0;
        // The plan steps only on the upright, powered body (Footfall's
        // branch): a fall, get-up or release ends it - kept, it froze and
        // stepped the old way after the get-up, holding the walk request.
        bool staggerPlanCanRun() const
        {
            if (!mPowered || !mControllerOutput)
                return false;
            const auto mode = mControllerOutput->mMode;
            return mode == RagdollCore::ActiveControllerMode::Standing
                || mode == RagdollCore::ActiveControllerMode::Bracing
                || mode == RagdollCore::ActiveControllerMode::Stumbling;
        }
        float mSkidTimer = 0.0f;
        float mS5TraceTime = 0.0f;
        // S4: the last decided fall was a stagger's give-up; for 1.5 s after
        // it no plan starts, no step is taken and the feet are not held.
        bool mStaggerGaveUp = false;
        bool staggerGaveUp() const { return mStaggerGaveUp && mFallDecidedTime < 1.5f; }
        // S5, the slump: a body that gave up its balance loses the strength
        // to haul itself back over its feet. Without it the bracing legs
        // pulled the planted feet back under the hips and levered a body
        // falling backward (centre of mass 60 u behind the feet) upright
        // again within 0.6 s, the root already released (FALL-01, 10-29).
        // Leg and trunk torque drop to the switch's slump share for the
        // give-up window, then fade back.
        std::array<RagdollCore::LeaseId, 3> mSlumpLeases{};
        void slumpAfterGiveUp()
        {
            const float slump = step01Settings().mSlump;
            if (!(slump < 0.999f))
                return;
            RagdollCore::LeaseRequest request;
            request.mTorqueScale = std::clamp(slump, 0.0f, 1.0f);
            RagdollCore::LeaseTiming timing;
            timing.mDuration = 1.5f;
            timing.mFadeIn = 0.1f;
            timing.mFadeOut = 0.5f;
            const std::array<RagdollCore::BodyChannel, 3> channels{ RagdollCore::BodyChannel::LeftLeg,
                RagdollCore::BodyChannel::RightLeg, RagdollCore::BodyChannel::Trunk };
            for (std::size_t i = 0; i < channels.size(); ++i)
            {
                if (mLeases.live(mSlumpLeases[i]))
                    mLeases.releaseNow(mSlumpLeases[i]);
                mSlumpLeases[i] = mLeases.acquire(channels[i], RagdollCore::BodyOwner::Balance, request, timing);
            }
        }
        void beginStaggerPlan(RagdollCore::ReactionTier tier, JPH::Vec3Arg comVelocityChange, const char* cause)
        {
            RagdollCore::StaggerSettings settings = staggerSettings();
            if (const auto& step = step01Settings(); step.mChain)
            {
                settings.mChain = true;
                settings.mChainRecover = step.mRecover;
                settings.mMaximumReach = step.mReach;
                settings.mStepBudget = step.mBudget;
                settings.mGiveUp = step.mGiveUp;
                settings.mAbortRatio = step.mAbort;
                settings.mGiveUpMargin = step.mGiveUpMargin;
            }
            if (!settings.mEnabled || !staggerPlanCanRun() || staggerGaveUp())
                return;
            RagdollCore::StaggerStart start;
            start.mTier = tier;
            const JPH::Vec3 flat(comVelocityChange.GetX(), comVelocityChange.GetY(), 0.0f);
            start.mDv = flat.Length();
            start.mDirection = flat.NormalizedOr(reactionForward());
            const auto& stats = getPtr().getClass().getCreatureStats(getPtr());
            const auto& fatigue = stats.getFatigue();
            start.mFatigue = fatigue.getModified() > 0.0f
                ? std::clamp(fatigue.getCurrent() / fatigue.getModified(), 0.0f, 1.0f) : 1.0f;
            start.mSkill = std::clamp(mWeaponControl, 0.0f, 1.0f);
            start.mFacing = reactionForward();
            start.mAgility = stats.getAttribute(ESM::Attribute::Agility).getModified();
            const auto& health = stats.getHealth();
            start.mHealth = health.getModified() > 0.0f
                ? std::clamp(health.getCurrent() / health.getModified(), 0.0f, 1.0f) : 1.0f;
            const bool was = mStaggerPlan.active();
            if (mStaggerPlan.begin(start, settings))
            {
                if (!was)
                    ++mStaggerPlans;
                Log(Debug::Info) << "RAGDOLL_STAGGER_PLAN actor=" << getPtr().getCellRef().getRefId() << " cause=" << cause
                                 << " tier=" << RagdollCore::reactionTierName(tier) << " dv=" << start.mDv
                                 << " steps=" << mStaggerPlan.stepsLeft() << " fatigue=" << start.mFatigue
                                 << " skill=" << start.mSkill << " agility=" << start.mAgility;
            }
        }
        // One step of the plan inside the catch steps (Footfall commands);
        // true when it owns the feet this step.
        bool stepStaggerPlan(const RagdollCore::FootfallInput& input)
        {
            const auto& settings = staggerSettings();
            if (!settings.mEnabled || !mFootfallLibrary || !mSituationKnown || !input.mLegs[0] || !input.mLegs[1])
                return false;
            const auto& feetNow = mFootfallLibrary->feet();
            std::array<RagdollCore::StaggerFoot, 2> feet;
            for (std::size_t side = 0; side < 2; ++side)
            {
                const auto p = mRagdoll->getWorldBodyPosition(mCurrentPhysicsPose, input.mLegs[side]->mFoot);
                if (!p)
                    return false;
                feet[side].mPosition = *p;
                feet[side].mSwinging = feetNow[side].mSwinging;
                feet[side].mContact = side == 0 ? mSupportEstimate && mSupportEstimate->mLeftFootSupported
                                                : mSupportEstimate && mSupportEstimate->mRightFootSupported;
            }
            // B5, skid: a planted foot dragged along with no walk asked for
            // starts a short plan along the drag - after a hit only (the
            // sentinel walk stage, 10-12: ordinary stops skid too, and each
            // became a stumble - course step timing 37.6 against a bar of 28,
            // push recovery 1.1-2.5 s against 0.9).
            const bool afterHit = mScopedEpisode || mHitStun.active() || mSoftRootStrength < 0.98f;
            // The player's (or AI's) own input, not the request a hit holds
            // at zero: a walking body pushed from the front got a skid step
            // that held its walk again (push walk front 2000 settled in
            // 1.15-1.35 s against build 82's 0.62-0.75).
            if (!mStaggerPlan.active() && settings.mSkidSpeed > 0.0f && afterHit && mQueuedInputSpeed < 15.0f)
            {
                float fastest = 0.0f;
                JPH::Vec3 drag = JPH::Vec3::sZero();
                for (std::size_t side = 0; side < 2; ++side)
                {
                    if (!feet[side].mContact || feetNow[side].mSwinging || !mSkidLast[side])
                        continue;
                    const JPH::Vec3 moved(feet[side].mPosition - *mSkidLast[side]);
                    const float speed = std::hypot(moved.GetX(), moved.GetY()) / std::max(input.mDt, 1e-3f);
                    if (speed > fastest)
                    {
                        fastest = speed;
                        drag = JPH::Vec3(moved.GetX(), moved.GetY(), 0.0f);
                    }
                }
                mSkidTimer = fastest > settings.mSkidSpeed ? mSkidTimer + input.mDt : 0.0f;
                if (mSkidTimer >= 0.05f)
                {
                    mSkidTimer = 0.0f;
                    // One step (the flinch tier): as a stagger, a skid of 160+ u/s
                    // planned 4 and a 2000 walking push took 2.4 s to settle.
                    beginStaggerPlan(RagdollCore::ReactionTier::Flinch, drag.NormalizedOr(reactionForward()) * fastest, "skid");
                }
            }
            for (std::size_t side = 0; side < 2; ++side)
                mSkidLast[side] = feet[side].mPosition;
            const auto& t = mSituation;
            const JPH::RVec3 capture(t.mCapturePoint.mX, t.mCapturePoint.mY, 0.0);
            const float speed = std::hypot(mSituationVelocity.GetX(), mSituationVelocity.GetY());
            const bool wasActive = mStaggerPlan.active();
            const int taken = mStaggerPlan.stepsTaken();
            // The actor's own movement input (not the request the plan holds).
            mStaggerPlan.holdGiveUp(mQueuedInputSpeed >= 15.0f);
            const auto next = mStaggerPlan.step(input.mDt, feet, mSituationCom, capture, speed);
            if (!mStaggerPlan.active())
            {
                if (wasActive)
                {
                    const char* gaveUp = mStaggerPlan.gaveUp();
                    Log(Debug::Info) << "RAGDOLL_STAGGER_PLAN_END actor=" << getPtr().getCellRef().getRefId()
                                     << " steps=" << taken << " capture_outside=" << mStaggerPlan.captureOutside()
                                     << " speed=" << speed << " capture_off=" << mStaggerPlan.captureDistance()
                                     << " lean=" << mStaggerPlan.maximumLean() << " gave_up=" << (gaveUp ? gaveUp : "-")
                                     << " com=" << mSituationCom.GetX() << "," << mSituationCom.GetY() << "," << mSituationCom.GetZ()
                                     << " cap=" << capture.GetX() << "," << capture.GetY()
                                     << " l=" << feet[0].mPosition.GetX() << "," << feet[0].mPosition.GetY() << "," << feet[0].mPosition.GetZ()
                                     << " r=" << feet[1].mPosition.GetX() << "," << feet[1].mPosition.GetY() << "," << feet[1].mPosition.GetZ()
                                     << " contact=" << feet[0].mContact << feet[1].mContact;
                    // S4: the balance is lost; the body falls and the catch
                    // (fall protection) takes over.
                    if (gaveUp)
                    {
                        decideFall(gaveUp, { static_cast<float>(capture.GetX() - mSituationCom.GetX()),
                                               static_cast<float>(capture.GetY() - mSituationCom.GetY()) });
                        mStaggerGaveUp = true;
                        slumpAfterGiveUp();
                    }
                }
                return false;
            }
            RagdollCore::FootfallCommand command;
            command.mHoldClock = true;
            command.mNoAnchorSettle = true;
            if (next)
            {
                const auto ground = input.mGround(next->mLanding, input.mActorZ);
                command.mSwingNow = next->mFoot;
                command.mSwingTime = next->mSwingTime;
                command.mLanding[next->mFoot] = JPH::RVec3(next->mLanding.GetX(), next->mLanding.GetY(),
                    ground ? *ground : feet[next->mFoot].mPosition.GetZ());
                ++mStaggerPlanSteps;
                ++mCatchStepCount;
            }
            commandFootfall(command);
            return true;
        }
        std::array<std::optional<JPH::RVec3>, 2> mSkidLast;
        float mQueuedInputSpeed = 0.0f; // the actor's own movement input this frame, u/s
        RagdollCore::ReactionEvent onBlowV2(const RagdollCore::Blow& blow, JPH::Vec3Arg impulse, JPH::RVec3Arg com,
            float mass, float partMass)
        {
            const auto disturbance = RagdollCore::blowDisturbance(impulse, JPH::Vec3(blow.mPoint - com), mass, partMass,
                reactionForward(), JPH::Vec3::sAxisZ());
            // Damage as a percentage of the victim's health (the leg give-out).
            RagdollCore::Blow priced = blow;
            const float health = getPtr().getClass().getCreatureStats(getPtr()).getHealth().getModified();
            priced.mDamage = health > 0.0f && std::isfinite(blow.mDamage) ? blow.mDamage / health * 100.0f : 0.0f;
            const auto event = mReactionV2.onBlow(priced, disturbance, reactionVictimV2());
            beginStaggerPlan(event.mTier, disturbance.mComVelocityChange, "blow");
            noteWound(blow);
            // The player feels a blow taken: the view nods back and tilts away
            // from the blow's side, by how hard it struck the part (a head
            // blow harder).
            if (getPtr() == MWMechanics::getPlayer() && event.mTier >= RagdollCore::ReactionTier::Flinch)
            {
                const JPH::Vec3 forward = reactionForward();
                const JPH::Vec3 right = forward.Cross(JPH::Vec3::sAxisZ());
                const JPH::Vec3 into = blow.mDirection.IsNearZero() ? -forward : blow.mDirection.Normalized();
                const bool head = blow.mRegion == RagdollCore::AnatomicalRegion::Head
                    || blow.mRegion == RagdollCore::AnatomicalRegion::Neck;
                const float strength = std::clamp(
                    (0.3f + 0.7f * std::max(event.mLocalSeverity, 0.5f * event.mBalanceSeverity)) * (head ? 1.3f : 1.0f),
                    0.0f, 1.0f);
                mCameraKick = std::max(mCameraKick, strength * (into.Dot(forward) < 0.0f ? 1.0f : 0.6f));
                const float roll = -into.Dot(right) * strength;
                if (std::abs(roll) > std::abs(mCameraRoll))
                    mCameraRoll = roll;
            }
            Log(Debug::Info) << "RAGDOLL_RXN2_BLOW actor=" << getPtr().getCellRef().getRefId() << " blow=" << blow.mId
                             << " region=" << RagdollCore::regionName(blow.mRegion)
                             << " tier=" << RagdollCore::reactionTierName(event.mTier) << " scale=" << event.mScale
                             << " reflex=" << event.mReflex << " interrupt=" << event.mInterrupt
                             << " balance=" << event.mBalanceSeverity << " local=" << event.mLocalSeverity
                             << " dv=" << disturbance.mComVelocityChange.Length()
                             << " part_dv=" << disturbance.mPartVelocityChange << " injury=" << event.mInjury;
            return event;
        }

        // One fixed step of the controller. Returns the snaps to add (world
        // angular velocity: trunk, head); interrupts and the compliance
        // leases are handled here.
        std::uint64_t mLeaseTraceSteps = 0;
        std::uint64_t mReflexTraceSteps = 0;
        std::pair<JPH::Vec3, JPH::Vec3> stepReactionV2(float dt)
        {
            mLeases.step(dt);
            // The audit: writes by owners without a lease on the channel,
            // and the gate's blocks, every 10 s (OPENMW_RAGDOLL_LEASE_TRACE).
            // The value is the interval in steps (1 = every 600).
            static const auto leaseTrace_tuned = RagdollCore::tuned<int>([] {
                const char* text = RagdollCore::tuningText("OPENMW_RAGDOLL_LEASE_TRACE");
                const int steps = text ? std::atoi(text) : 0;
                return steps <= 0 ? 0 : steps == 1 ? 600 : steps;
            });
            static const auto& leaseTrace = leaseTrace_tuned.get();
            if (leaseTrace > 0 && leasesOn() && ++mLeaseTraceSteps % leaseTrace == 0)
            {
                std::ostringstream conflicts;
                for (std::size_t c = 0; c < RagdollCore::sBodyChannelCount; ++c)
                    for (std::size_t o = 0; o < RagdollCore::sBodyOwnerCount; ++o)
                        if (const auto n = mLeases.conflicts(static_cast<RagdollCore::BodyChannel>(c),
                                static_cast<RagdollCore::BodyOwner>(o)))
                            conflicts << ' ' << RagdollCore::bodyChannelName(static_cast<RagdollCore::BodyChannel>(c))
                                      << '/' << RagdollCore::bodyOwnerName(static_cast<RagdollCore::BodyOwner>(o)) << '=' << n;
                Log(Debug::Info) << "RAGDOLL_LEASES actor=" << getPtr().getCellRef().getRefId()
                                 << " leases=" << mLeases.size() << " composed_steps=" << mComposerSteps
                                 << " writes=" << mComposerTotals.mWrites
                                 << " inversions=" << mComposerTotals.mInversions
                                 << " fading=" << mComposerTotals.mFading
                                 << " max_move=" << mComposerTotals.mMaxTranslation
                                 << " max_turn=" << mComposerTotals.mMaxAngle
                                 << " composer=" << composerEnabled()
                                 << " conflicts=" << mLeases.conflicts() << conflicts.str();
                for (const auto& [key, count] : mComposerInversions)
                    Log(Debug::Info) << "RAGDOLL_COMPOSER_INVERSION actor=" << getPtr().getCellRef().getRefId()
                                     << " channel=" << RagdollCore::bodyChannelName(static_cast<RagdollCore::BodyChannel>(std::get<0>(key)))
                                     << " sequential=" << RagdollCore::bodyOwnerName(static_cast<RagdollCore::BodyOwner>(std::get<1>(key)))
                                     << " composed=" << RagdollCore::bodyOwnerName(static_cast<RagdollCore::BodyOwner>(std::get<2>(key)))
                                     << " bodies=" << count;
            }
            if (!mPowered || !mRagdoll)
                return { JPH::Vec3::sZero(), JPH::Vec3::sZero() };
            if (const std::uint64_t generation = RagdollCore::tuningGeneration(); generation != mReactionV2Tuning)
            {
                mReactionV2Tuning = generation;
                mReactionV2.setSettings(reactionSettingsV2());
            }
            mReactionV2Step = mReactionV2.step(dt, reactionVictimV2());
            const auto& out = mReactionV2Step;
            // Getting the bearings back: no guard and no attack meanwhile.
            if (out.mBearings > 0.0f)
            {
                if (out.mBearings > mLastBearings + 0.05f)
                    Log(Debug::Info) << "RAGDOLL_RXN2_BEARINGS actor=" << getPtr().getCellRef().getRefId()
                                     << " seconds=" << out.mBearings;
                mClashLockout = std::max(mClashLockout, out.mBearings);
            }
            mLastBearings = out.mBearings;
            traceAiCut(dt);
            mWeaponKnock = std::max(0.0f, mWeaponKnock - dt);
            // The compliance: one Reaction lease per channel, its torque
            // scale this step (resolved and committed before the Update).
            for (std::size_t c = 0; c < RagdollCore::sBodyChannelCount; ++c)
            {
                const auto channel = static_cast<RagdollCore::BodyChannel>(c);
                RagdollCore::LeaseRequest request;
                request.mTorqueScale = out.mTorqueScale[c];
                if (request.mTorqueScale < 0.999f)
                {
                    if (!mLeases.live(mReactionLeases[c]))
                        mReactionLeases[c] = mLeases.acquire(channel, RagdollCore::BodyOwner::Reaction, request);
                    else
                        mLeases.update(mReactionLeases[c], request);
                }
                else if (mLeases.live(mReactionLeases[c]))
                {
                    mLeases.release(mReactionLeases[c]);
                    mReactionLeases[c] = RagdollCore::sNoLease;
                }
            }
            // The reflex: an additive Reaction pose lease on each channel it
            // moves (above the claims: it bends what they hold).
            {
                const auto& r = out.mReflex;
                const std::array<bool, RagdollCore::sBodyChannelCount> moves{ false,
                    r.mKneeBend[0] > 1e-3f, r.mKneeBend[1] > 1e-3f, r.mTrunk.LengthSq() > 1e-6f,
                    r.mHead.LengthSq() > 1e-6f, r.mArm[0].LengthSq() > 1e-6f || r.mArmsUp > 1e-3f,
                    r.mArm[1].LengthSq() > 1e-6f || r.mArmsUp > 1e-3f };
                for (std::size_t c = 0; c < RagdollCore::sBodyChannelCount; ++c)
                {
                    if (!moves[c])
                        continue;
                    if (mLeases.live(mReflexLeases[c]))
                        mLeases.renew(mReflexLeases[c], 0.05f);
                    else
                    {
                        RagdollCore::LeaseRequest request;
                        request.mPose = true;
                        request.mAdditive = true;
                        mReflexLeases[c] = mLeases.acquire(static_cast<RagdollCore::BodyChannel>(c),
                            RagdollCore::BodyOwner::Reaction, request, { 0.05f, 0.0f, 0.0f });
                    }
                }
            }
            // The interrupt: the victim's own attack on the wheel breaks,
            // the hand thrown back along the last blow.
            if (out.mInterrupt && mHscActive
                && (mAttackStage == AttackStage::Wind || mAttackStage == AttackStage::Cut))
            {
                JPH::Vec3 push = -reactionForward();
                beginHscKnock(push * 24.0f, true);
                mSinceInterrupt = 0.0f;
                ++mInterruptCount;
                Log(Debug::Info) << "RAGDOLL_INTERRUPT actor=" << getPtr().getCellRef().getRefId() << " v2=1";
            }
            return { out.mTrunkSnap, out.mHeadSnap };
        }

        // The reflex pose: additive offsets on the composed pose (in place
        // of applyWoundReactions), each a rotation at the base of a chain
        // carried by its descendants.
        void applyReflexPoseV2(RagdollCore::RagdollPose& pose)
        {
            mLocalReactionAngle = 0.0f;
            // PGC-03 B4: the stagger's posture rides on the reflex - the torso
            // leads into the stagger, the arms fly out, the head drops.
            auto reflex = mReactionV2Step.mReflex;
            if (mRagdoll)
                balancePostureOverlay(reflex);
            if (!reflex.any() || !mRagdoll)
                return;
            const JPH::Vec3 forward = reactionForward();
            const JPH::Vec3 up = JPH::Vec3::sAxisZ();
            const JPH::Vec3 right = forward.Cross(up);
            const auto& skeleton = mReplayCreationSkeleton;
            const auto rotateChain = [&](std::size_t base, JPH::Vec3Arg bodyFrame, float share) {
                const float angle = bodyFrame.Length() * share;
                if (angle < 1e-4f || base >= pose.mBodyTransforms.size())
                    return;
                const JPH::Vec3 world = right * bodyFrame.GetX() + forward * bodyFrame.GetY() + up * bodyFrame.GetZ();
                const auto model = mRagdoll->getModelVector(world);
                if (!model || model->LengthSq() < 1e-8f)
                    return;
                const JPH::Quat rotation = JPH::Quat::sRotation(model->Normalized(), angle);
                const auto pivot = pose.mBodyTransforms[base].mTranslation;
                for (std::size_t child = base; child < pose.mBodyTransforms.size(); ++child)
                {
                    int ancestor = static_cast<int>(child);
                    while (ancestor > 0 && ancestor != static_cast<int>(base))
                        ancestor = skeleton.mBones[ancestor].mParent;
                    if (ancestor != static_cast<int>(base))
                        continue;
                    auto& transform = pose.mBodyTransforms[child];
                    transform.mRotation = (rotation * transform.mRotation).Normalized();
                    transform.mTranslation = pivot + rotation * (transform.mTranslation - pivot);
                }
                mLocalReactionAngle = std::max(mLocalReactionAngle, angle);
            };
            const auto bodiesOf = [&](RagdollCore::AnatomicalRegion region) {
                std::vector<std::size_t> found;
                for (std::size_t body = 1; body < mBodyRegions.size() && body < pose.mBodyTransforms.size(); ++body)
                    if (mBodyRegions[body] == region)
                        found.push_back(body);
                return found;
            };
            // Trunk: spread over the spine (abdomen and chest bodies).
            std::vector<std::size_t> spine = bodiesOf(RagdollCore::AnatomicalRegion::Abdomen);
            for (std::size_t body : bodiesOf(RagdollCore::AnatomicalRegion::Chest))
                spine.push_back(body);
            for (std::size_t body : spine)
                rotateChain(body, reflex.mTrunk, 1.0f / static_cast<float>(spine.size()));
            // Head: 40% at the neck, 60% at the head.
            for (std::size_t body : bodiesOf(RagdollCore::AnatomicalRegion::Neck))
                rotateChain(body, reflex.mHead, 0.4f);
            for (std::size_t body : bodiesOf(RagdollCore::AnatomicalRegion::Head))
                rotateChain(body, reflex.mHead, 0.6f);
            // Arms: the fling at the shoulder; covering the face lifts the
            // upper arms forward and folds the forearms up (rad at full
            // cover). OPENMW_RAGDOLL_REACTION_V2_ARMS = "shoulder, elbow".
            static const auto armsUpAngles_tuned = RagdollCore::tuned<std::array<float, 2>>([] {
                std::array<float, 2> value{ 1.6f, 1.9f };
                if (const char* text = RagdollCore::tuningText("OPENMW_RAGDOLL_REACTION_V2_ARMS"))
                    std::sscanf(text, "%f,%f", &value[0], &value[1]);
                return value;
            });
            static const auto& armsUpAngles = armsUpAngles_tuned.get();
            const std::array<RagdollCore::AnatomicalRegion, 2> upper{ RagdollCore::AnatomicalRegion::LeftUpperArm,
                RagdollCore::AnatomicalRegion::RightUpperArm };
            const std::array<RagdollCore::AnatomicalRegion, 2> fore{ RagdollCore::AnatomicalRegion::LeftForearm,
                RagdollCore::AnatomicalRegion::RightForearm };
            for (std::size_t side = 0; side < 2; ++side)
            {
                const auto& arm = side == 0 ? mLeftArm : mRightArm;
                // An arm the attack wheel or a guard holds keeps its target;
                // only a fling (a struck arm) moves it.
                const bool held = mArmOwner[side] == ArmOwner::HandControl || mArmOwner[side] == ArmOwner::Guard
                    || mArmOwner[side] == ArmOwner::Tip || mArmOwner[side] == ArmOwner::Support;
                // An armed arm covers part way (VIS > 1): pulled in toward the
                // face with its weapon, then back to the guard.
                const float cover = !held ? 1.0f : std::clamp(0.35f * (reactionVisibility() - 1.0f), 0.0f, 0.5f);
                for (std::size_t body : bodiesOf(upper[side]))
                {
                    rotateChain(body, reflex.mArm[side], 1.0f);
                    if (cover > 0.0f && arm)
                        rotateChain(body, JPH::Vec3(armsUpAngles[0] * reflex.mArmsUp * cover, 0.0f, 0.0f), 1.0f);
                }
                if (cover > 0.0f && arm)
                    for (std::size_t body : bodiesOf(fore[side]))
                        rotateChain(body, JPH::Vec3(armsUpAngles[1] * reflex.mArmsUp * cover, 0.0f, 0.0f), 1.0f);
            }
            static const auto reflexTrace_tuned = RagdollCore::tuned<bool>([] { return RagdollCore::tuningText("OPENMW_RAGDOLL_RXN2_TRACE") != nullptr; });
            static const auto& reflexTrace = reflexTrace_tuned.get();
            if (reflexTrace && ++mReflexTraceSteps % 6 == 0)
                Log(Debug::Info) << "RAGDOLL_RXN2_REFLEX actor=" << getPtr().getCellRef().getRefId()
                                 << " head=" << reflex.mHead.Length() << " trunk=" << reflex.mTrunk.Length()
                                 << " arm_l=" << reflex.mArm[0].Length() << " arm_r=" << reflex.mArm[1].Length()
                                 << " arms_up=" << reflex.mArmsUp << " knee_l=" << reflex.mKneeBend[0]
                                 << " owner_l=" << armOwnerName(mArmOwner[0]) << " owner_r=" << armOwnerName(mArmOwner[1])
                                 << " has_l=" << bool(mLeftArm) << " has_r=" << bool(mRightArm)
                                 << " angle=" << mLocalReactionAngle << " blocked=" << mGateBlocked;
            // Knees: the shank swings back.
            const std::array<RagdollCore::AnatomicalRegion, 2> calves{ RagdollCore::AnatomicalRegion::LeftCalf,
                RagdollCore::AnatomicalRegion::RightCalf };
            for (std::size_t side = 0; side < 2; ++side)
                for (std::size_t body : bodiesOf(calves[side]))
                    rotateChain(body, JPH::Vec3(-reflex.mKneeBend[side], 0.0f, 0.0f), 1.0f);
        }

        // The resolved channel compliance, before the Update (restored
        // after by restoreReactionMotors).
        // RXN-02 M1, compliance through the leases (OPENMW_RAGDOLL_LEASE_COMPLIANCE=1):
        // the gait route's leg torque scales (a wounded leg's limp, the swing
        // leg's boost) are Locomotion leases resolved in the one commit below,
        // with the reaction's, instead of absolute writes the reaction then
        // scaled. Same torques (both scale the limits symmetrically).
        static bool leaseCompliance()
        {
            static const auto on_tuned = RagdollCore::tuned<bool>([] {
                const char* text = RagdollCore::tuningText("OPENMW_RAGDOLL_LEASE_COMPLIANCE");
                return text && std::atoi(text) != 0;
            });
            static const auto& on = on_tuned.get();
            return on;
        }
        std::array<RagdollCore::LeaseId, 2> mLocomotionLegLeases{};
        bool mLocomotionLegFresh = false; // set by the gait route since the last commit
        // This step's leg torque scales ([0] left); a lease lives one step
        // unless renewed, so a step without the gait route has none.
        void setLocomotionLegScales(float left, float right)
        {
            const std::array<float, 2> scales{ left, right };
            mLocomotionLegFresh = true;
            for (std::size_t side = 0; side < 2; ++side)
            {
                RagdollCore::LeaseRequest request;
                request.mTorqueScale = scales[side];
                auto& id = mLocomotionLegLeases[side];
                if (mLeases.live(id))
                {
                    mLeases.update(id, request);
                    mLeases.renew(id, 0.02f);
                }
                else
                {
                    RagdollCore::LeaseTiming timing;
                    timing.mDuration = 0.02f;
                    id = mLeases.acquire(side == 0 ? RagdollCore::BodyChannel::LeftLeg : RagdollCore::BodyChannel::RightLeg,
                        RagdollCore::BodyOwner::Locomotion, request, timing);
                }
            }
        }

        void commitLeaseComplianceV2()
        {
            if (!mPowered || !mRagdoll)
                return;
            // Leg scales count only in the step the gait route set them.
            if (!mLocomotionLegFresh)
                for (auto& id : mLocomotionLegLeases)
                    if (mLeases.live(id))
                        mLeases.releaseNow(id);
            mLocomotionLegFresh = false;
            std::array<float, RagdollCore::sBodyChannelCount> scale{};
            bool any = false;
            for (std::size_t c = 0; c < RagdollCore::sBodyChannelCount; ++c)
            {
                scale[c] = mLeases.resolve(static_cast<RagdollCore::BodyChannel>(c)).mTorqueScale;
                any = any || std::abs(scale[c] - 1.0f) > 0.001f;
            }
            if (!any)
                return;
            for (std::size_t body = 1; body < mBodyRegions.size(); ++body)
            {
                const auto channel = RagdollCore::bodyChannelForRegion(mBodyRegions[body]);
                if (!channel || isDetachedWeaponBody(body))
                    continue;
                const float s = scale[static_cast<std::size_t>(*channel)];
                if (std::abs(s - 1.0f) <= 0.001f)
                    continue;
                RagdollCore::MotorTargetTelemetry motor;
                mRagdoll->captureMotorTargetTelemetry(body, motor);
                if (motor.mDrive
                    && mRagdoll->setMotorTorqueLimits(body, motor.mDrive->mMinimumTorque * s, motor.mDrive->mMaximumTorque * s))
                    mReactionMotorLimits.push_back({ body, motor.mDrive->mMinimumTorque, motor.mDrive->mMaximumTorque });
            }
        }

        // CONNECT-01: hand control strikes only in the cut and the trailing
        // window after it, not in the guard or the wind-up.
        bool hscStrikeOpen() const
        {
            return mAttackStage == AttackStage::Cut || mHscSinceCut <= connectSettings().mTrailing;
        }
        std::vector<RagdollCore::WeaponContactEvent> consumeWeaponContacts(const JPH::PhysicsSystem& physics)
        {
            if (connectSettings().mOn && !mConnectConfigured)
            {
                mLocalizedStrikes.setSelectionWindow(connectSettings().mWindow);
                mLocalizedStrikes.setMinimumApproachSpeed(connectSettings().mApproach);
                mConnectConfigured = true;
            }
            // Slices (point-blank, the video's top complaint; FIX-08 10-07: a
            // claymore resting in the target after the last blow, 575
            // contacts, no strike): a blade dragged through a body it already
            // touches strikes by its sliding speed, priced at `share` of it.
            // OPENMW_RAGDOLL_SLICE = "sliding speed u/s, share" (0 = off).
            static const auto slice_tuned = RagdollCore::tuned<std::array<float, 2>>([] {
                std::array<float, 2> value{ 0.0f, 0.6f };
                if (const char* text = RagdollCore::tuningText("OPENMW_RAGDOLL_SLICE"))
                    std::sscanf(text, "%f,%f", &value[0], &value[1]);
                return value;
            });
            static const auto& slice = slice_tuned.get();
            if (slice[0] > 0.0f && !mSliceConfigured)
            {
                mLocalizedStrikes.setSlice(slice[0], slice[1]);
                mSliceConfigured = true;
            }
            auto contacts = mPendingWeaponContacts.consume();
            mConsumedWeaponContactCount += contacts.size();
            for (auto& contact : contacts)
            {
                const auto response = mStepWeaponResponses.find(contact.contactIdentity());
                if (response == mStepWeaponResponses.end()) continue;
                float totalImpulse = 0;
                bool known = response->second.second > 0;
                for (JPH::uint point = 0; point < response->second.second; ++point)
                {
                    float impulse = 0;
                    if (!physics.GetContactNormalImpulse(response->second.first, point, impulse)) known = false;
                    else totalImpulse += std::max(0.0f, impulse);
                }
                if (known) contact = contact.withNormalImpulse(totalImpulse);
            }
            // DMG-01 deterministic aggregation: every qualifying observation
            // is recorded, then one strike per target actor commits from the
            // earliest contacting step with stable tie breakers. Raw arrival
            // order cannot decide which body was hit or produce a second hit.
            std::vector<RagdollCore::WeaponContactEvent> eligibleContacts;
            eligibleContacts.reserve(contacts.size());
            for (const auto& contact : contacts)
                if (permitsNativeAttackContact(contact))
                    eligibleContacts.push_back(contact);
            // Ineligible native phases cannot spend impact credit or bank
            // cutting work. Keep raw observations for diagnostics and keep
            // episode lifetime tied to geometric separation, not button edges.
            // Pressure cuts (point-blank: a cut that starts with the blade
            // already against the body pushes the body along, so the contact
            // never approaches fast; FIX-08 10-07). During the cut stage a
            // contact under the approach speed strikes when the blade itself
            // is swung at `speed` or more (the commanded tip), priced at
            // `share` of it. OPENMW_RAGDOLL_PRESS_CUT = "tip speed u/s, share"
            // (0 = off).
            static const auto pressCut_tuned = RagdollCore::tuned<std::array<float, 2>>([] {
                std::array<float, 2> value{ 0.0f, 0.5f };
                if (const char* text = RagdollCore::tuningText("OPENMW_RAGDOLL_PRESS_CUT"))
                    std::sscanf(text, "%f,%f", &value[0], &value[1]);
                return value;
            });
            static const auto& pressCut = pressCut_tuned.get();
            const float tipSpeed = mSwing.mVelocity.Length();
            const bool pressing = pressCut[0] > 0.0f && mHscActive && mAttackStage == AttackStage::Cut
                && std::isfinite(tipSpeed) && tipSpeed >= pressCut[0];
            for (const auto& contact : eligibleContacts)
                if (!contact.weaponRecordId().empty() && !RagdollCore::bladeSurfaceProfile(contact.weaponRecordId()))
                {
                    if (pressing && contact.relativeNormalSpeed() < connectSettings().mApproach)
                        mLocalizedStrikes.observe(contact.withSliceSpeed(pressCut[1] * tipSpeed));
                    else
                        mLocalizedStrikes.observe(contact);
                }
            std::vector<RagdollCore::WeaponContactEvent> strikes
                = mLocalizedStrikes.consume(mCurrentContactPhysicsStep);
            auto physical = mContactDamage.consume(eligibleContacts, mCurrentContactPhysicsStep, mContactStepDuration);
            strikes.insert(strikes.end(), physical.begin(), physical.end());
            if (ManualDiagnostics::recorder().enabled() && getPtr() == MWMechanics::getPlayer())
                for (const auto& contact : contacts)
                    ManualDiagnostics::recorder().contact(contact.physicsStep(), mSerial,
                        contact.targetActorIdentity().value_or(0), contact.relativeNormalSpeed(),
                        permitsNativeAttackContact(contact),
                        std::any_of(strikes.begin(), strikes.end(), [&](const auto& strike) {
                            return strike.contactIdentity() == contact.contactIdentity();
                        }), Misc::Convert::toOsg(contact.point()));
#ifdef OPENMW_RAGDOLL_DEV_API
            // Calibration input for the contact work profile: every raw
            // observation against an actor, whether or not it was paid.
            if (RagdollCore::tuningText("OPENMW_RAGDOLL_CONTACT_WORK_TRACE"))
            {
                static unsigned contactRows = 0;
                for (const auto& contact : contacts)
                {
                    if (!contact.targetActorIdentity() || contactRows >= 6000)
                        continue;
                    ++contactRows;
                    const float approach
                        = RagdollCore::UnitModel::toMeters(std::max(0.0f, contact.relativeNormalSpeed()));
                    const JPH::Vec3 tangent = contact.wound().mRelativeVelocity
                        - contact.normal() * contact.wound().mRelativeVelocity.Dot(contact.normal());
                    Log(Debug::Info) << std::dec << std::setprecision(4) << "RAGDOLL_CONTACT_WORK attacker=" << mSerial
                        << " step=" << contact.physicsStep() << " swing=" << contact.swingActive()
                        << " weapon=" << contact.weaponRecordId() << " identity=" << contact.swingIdentity()
                        << " phase=" << static_cast<int>(contactAttackPhase())
                        << " hsc=" << mHscActive << " swinging_now=" << mSwing.mSwinging
                        << " eligible=" << permitsNativeAttackContact(contact)
                        << " fist=" << contact.weaponRecordId().empty()
                        << " region=" << RagdollCore::regionName(contact.region())
                        << " approach=" << contact.relativeNormalSpeed() << " tangent=" << tangent.Length()
                        << " mass=" << contact.effectiveMass()
                        << " energy=" << 0.5f * contact.effectiveMass() * approach * approach
                        << " normal_impulse=" << contact.normalImpulse().value_or(-1)
                        << " selected=" << std::count_if(strikes.begin(), strikes.end(), [&](const auto& selected) {
                               return selected.contactIdentity() == contact.contactIdentity();
                           })
                        << " paid=" << std::count_if(physical.begin(), physical.end(), [&](const auto& paid) {
                               return paid.contactIdentity() == contact.contactIdentity();
                           });
                }
            }
#endif
            for (const auto& strike : strikes)
            {
                ++mConsumedWeaponStrikeCount;
                mLastConsumedWeaponStrike = strike;
            }
#ifdef OPENMW_RAGDOLL_DEV_API
            if (mContactWindowAuditEnabled && mWeapon)
            {
                ContactWindowObservation sample;
                sample.mPhysicsStep = mCurrentContactPhysicsStep;
                sample.mActorSerial = mSerial;
                sample.mLifecycleEpoch = mBalanceLifecycleEpoch;
                if (mWeapon->mWeaponBody < mRagdoll->getBodyCount())
                    sample.mWeaponBodyIdentity = mRagdoll->getBodyId(mWeapon->mWeaponBody).GetIndexAndSequenceNumber();
                else
                    sample.mOverflow = true;
                sample.mAttack = mAnimationAttack;
                sample.mAttack.mPhase = contactAttackPhase();
                sample.mSwingIdentity = mSwingIdentity;
                sample.mNativeOwned = mAnimationAttackOwned;
                const auto copyBounded = [&](const auto& source, auto& destination) {
                    for (const auto& contact : source)
                        if (contact.targetActorIdentity())
                        {
                            if (destination.size() == 64) { sample.mOverflow = true; break; }
                            destination.push_back(contact);
                        }
                };
                copyBounded(contacts, sample.mContacts);
                copyBounded(strikes, sample.mStrikes);
                if (mContactWindowObservations.size() == 96)
                {
                    mContactWindowObservations.erase(mContactWindowObservations.begin());
                    ++mContactWindowsEvictedCount;
                }
                mContactWindowObservations.push_back(std::move(sample));
            }
#endif
            for (auto& contact : contacts)
                mLastConsumedWeaponContact = std::move(contact);
            return strikes;
        }

        bool initializeControllerObservation()
        {
            if (!mPelvisBodyIndex || !mTorsoBodyIndex)
                return false;
            RagdollCore::RagdollTelemetry telemetry;
            if (!mRagdoll->captureTelemetry(telemetry) || *mPelvisBodyIndex >= telemetry.mBodies.size()
                || *mTorsoBodyIndex >= telemetry.mBodies.size())
                return false;
            mPelvisLocalUp = telemetry.mBodies[*mPelvisBodyIndex].mRotation.Conjugated() * JPH::Vec3::sAxisZ();
            mTorsoLocalUp = telemetry.mBodies[*mTorsoBodyIndex].mRotation.Conjugated() * JPH::Vec3::sAxisZ();
            // BUILD_FRAMES: "up" from the skeleton's standing pose (model
            // space, z up) rather than the build pose (a body built mid-run
            // took the run's forward lean as upright and held it: "rebuild
            // mid-run" ended 23-25 deg over, without the rebuild 0).
            if (const auto pelvis = mStandingBodyRotations.find(*mPelvisBodyIndex),
                torso = mStandingBodyRotations.find(*mTorsoBodyIndex);
                pelvis != mStandingBodyRotations.end() && torso != mStandingBodyRotations.end())
            {
                mPelvisLocalUp = (pelvis->second.Conjugated() * JPH::Vec3::sAxisZ()).Normalized();
                mTorsoLocalUp = (torso->second.Conjugated() * JPH::Vec3::sAxisZ()).Normalized();
            }
            // Which way the pelvis pointed while the actor still stood. The
            // recovery hands a position back to gameplay but never a heading,
            // so this is what lets the two be compared afterwards: the body
            // tumbles as it falls while the gameplay actor keeps its yaw.
            const osg::Vec3f armingLook = actorLookDirection(getPtr());
            mPelvisLocalForward = telemetry.mBodies[*mPelvisBodyIndex].mRotation.Conjugated()
                * JPH::Vec3(armingLook.x(), armingLook.y(), 0.0f);
            mTorsoLocalForward = telemetry.mBodies[*mTorsoBodyIndex].mRotation.Conjugated()
                * JPH::Vec3(armingLook.x(), armingLook.y(), 0.0f);
            mControllerObservationInitialized = mPelvisLocalUp.IsNormalized() && mTorsoLocalUp.IsNormalized()
                && mPelvisLocalForward.IsNormalized() && mTorsoLocalForward.IsNormalized();
            // These axes assume the actor stands while it is powered. The
            // manual hub re-powers a player it has just resurrected while the
            // animation still lies in the death pose (play test 2026-09-29, "I
            // cant get up"): the axes then read an upright body as tipped
            // about 70 degrees, every get-up ended in a fall, for 7 minutes.
            // A pose whose chest is not above its pelvis takes its axes from
            // the animation each step until the animation stands.
            const JPH::Vec3 spine(telemetry.mBodies[*mTorsoBodyIndex].mPosition
                - telemetry.mBodies[*mPelvisBodyIndex].mPosition);
            mObservationAxesFromAnimation = spine.LengthSq() < 1e-4f || spine.Normalized().GetZ() < 0.7f;
            mObservationUprightTime = 0.0f;
            return mControllerObservationInitialized;
        }

        void updateObservationAxesFromAnimation(float duration)
        {
            if (!mObservationAxesFromAnimation || !mPelvisBodyIndex || !mTorsoBodyIndex)
                return;
            const auto pelvisPosition = mRagdoll->getWorldBodyPosition(mMotorTargetPose, *mPelvisBodyIndex);
            const auto torsoPosition = mRagdoll->getWorldBodyPosition(mMotorTargetPose, *mTorsoBodyIndex);
            const auto pelvisRotation = mRagdoll->getWorldBodyRotation(mMotorTargetPose, *mPelvisBodyIndex);
            const auto torsoRotation = mRagdoll->getWorldBodyRotation(mMotorTargetPose, *mTorsoBodyIndex);
            if (!pelvisPosition || !torsoPosition || !pelvisRotation || !torsoRotation)
                return;
            const osg::Vec3f look = actorLookDirection(getPtr());
            const JPH::Vec3 flatLook(look.x(), look.y(), 0.0f);
            if (!flatLook.IsNormalized())
                return;
            mPelvisLocalUp = pelvisRotation->Conjugated() * JPH::Vec3::sAxisZ();
            mTorsoLocalUp = torsoRotation->Conjugated() * JPH::Vec3::sAxisZ();
            mPelvisLocalForward = pelvisRotation->Conjugated() * flatLook;
            mTorsoLocalForward = torsoRotation->Conjugated() * flatLook;
            // Frozen once the clip has stood still upright for 0.3 s (the idle
            // spine reads 1.00): frozen mid-rise at 25 degrees, the body then
            // stood leaning 25-28 degrees (powered lying, 2026-09-29).
            const JPH::Vec3 spine(*torsoPosition - *pelvisPosition);
            const bool upright = spine.LengthSq() > 1e-4f && spine.Normalized().GetZ() >= 0.98f;
            mObservationUprightTime = upright ? mObservationUprightTime + duration : 0.0f;
            if (mObservationUprightTime < 0.3f)
                return;
            mObservationAxesFromAnimation = false;
            Log(Debug::Info) << "RAGDOLL_OBSERVATION_AXES actor=" << getPtr().getCellRef().getRefId()
                             << " source=standing-animation";
        }

        const RagdollCore::RagdollPose& motorBasePose() const
        {
            const bool recovering = mControllerOutput
                && (mControllerOutput->mMode == RagdollCore::ActiveControllerMode::GettingUp
                    || mControllerOutput->mMode == RagdollCore::ActiveControllerMode::BlendBack);
            if (recovering && mRecoveryReferencePose) return *mRecoveryReferencePose;
            if (!recovering && mAnimationAssistedActuation) return mMotorTargetPose;
            return !recovering && mLocomotionBasePose ? *mLocomotionBasePose : mMotorTargetPose;
        }

        bool standingMotorPose(RagdollCore::RagdollPose& target) const
        {
            RagdollCore::RagdollPose standingPose = motorBasePose();
            if (mStandingLegPose && mPelvisBodyIndex && mLeftLeg && mRightLeg)
            {
                const std::array<std::size_t, 6> legs{ mLeftLeg->mHip, mLeftLeg->mKnee, mLeftLeg->mFoot,
                    mRightLeg->mHip, mRightLeg->mKnee, mRightLeg->mFoot };
                if (!RagdollCore::applyGaitMeasuredLegTargets(standingPose.mBodyTransforms,
                        mStandingLegPose->mBodyTransforms, *mPelvisBodyIndex, legs,
                        RagdollCore::GaitMeasuredPoseFrame::Joint))
                    return false;
            }
            target = standingPose;
            return !mHandover.active()
                || mHandover.blendPose(standingPose, mExperimentalReferenceProfile, target);
        }

        bool capturePoweredTarget(std::uint64_t nextPhysicsStep)
        {
            mSupportGripReadySample = false;
            if (!mPowered || mPoseBinding == nullptr)
                return false;
            std::vector<RagdollCore::Transform> target;
            const bool recovering = mControllerOutput
                && (mControllerOutput->mMode == RagdollCore::ActiveControllerMode::GettingUp
                    || mControllerOutput->mMode == RagdollCore::ActiveControllerMode::BlendBack);
            const bool motorsReleased = mControllerOutput
                && (mControllerOutput->mMode == RagdollCore::ActiveControllerMode::Falling
                    || mControllerOutput->mMode == RagdollCore::ActiveControllerMode::Fallen);
            bool authoredTargetCaptured = false;
            if (recovering && mSampledRecoveryTarget)
                target = *mSampledRecoveryTarget;
            else if (!(authoredTargetCaptured = mPoseBinding->captureAnimationPose(target))
                && !mPoseBinding->capturePose(target))
            {
                // Animation groups can change on the same frame that the
                // physical controller enters a fall. Falling and Fallen do
                // not consume a motor target at all, so preserve the last
                // validated target until a driven mode resumes. In a driven
                // mode the same gap remains bounded and fails safely.
                if (motorsReleased && mMotorTargetCaptured)
                    return true;
                if (mMotorTargetCaptured && ++mPoweredTargetCaptureFailureCount <= 6)
                    return true;
                return false;
            }
            if (target.size() != mPoseBindingBodyCount)
                return false;
            if (mWeapon)
            {
                RagdollCore::Transform weapon;
                if (mWeapon->mAttached)
                {
                    if (mWeapon->mHandBody >= target.size())
                        return false;
                    weapon = target[mWeapon->mHandBody];
                    weapon.mTranslation += weapon.mRotation * mWeapon->mCenterFromHand;
                    weapon.mRotation = (weapon.mRotation * mMurderTurn).Normalized(); // GRIP-05 murder-stroke
                }
                else
                {
                    if (!mCurrentPhysicsPoseCaptured
                        || mWeapon->mWeaponBody >= mCurrentPhysicsPose.mBodyTransforms.size())
                        return false;
                    // The detached body remains owned by this ragdoll until
                    // actor cleanup. Preserve its last physical pose only to
                    // keep the full target transaction well-formed; its
                    // disabled grip constraint consumes no target or force.
                    weapon = mCurrentPhysicsPose.mBodyTransforms[mWeapon->mWeaponBody];
                }
                target.push_back(weapon);
            }
            if (mShield)
            {
                if (mShield->mForearmBody >= target.size())
                    return false;
                RagdollCore::Transform shield = target[mShield->mForearmBody];
                shield.mTranslation += shield.mRotation * mShield->mCenterFromForearm;
                target.push_back(shield);
            }
            if (target.size() != mRagdoll->getBodyCount())
                return false;
            mPoweredTargetCaptureFailureCount = 0;
            if (mMotorTargetCaptured)
                mPreviousMotorTargetPose = mMotorTargetPose;
            mMotorTargetPose.mBodyTransforms = std::move(target);
            mMotorTargetCaptured = true;
            observeBalanceAnimationInput(authoredTargetCaptured, recovering && mSampledRecoveryTarget.has_value(), nextPhysicsStep);
            if (mSupportGripEnabled)
            {
                const auto* animation = MWBase::Environment::get().getWorld()->getAnimation(getPtr());
                mSupportGripReadySample = authoredTargetCaptured && animation && animation->upperBodyReady()
                    && mAnimationAttack.mPhase == MWMechanics::RagdollAttackPhase::Idle;
            }
#ifdef OPENMW_RAGDOLL_DEV_API
            if (RagdollCore::tuningText("OPENMW_RAGDOLL_ANIMATION_INPUT_TRACE"))
            {
                ++mAnimationInputSerial;
                if (mAnimationInputSerial <= 3600)
                {
                    const auto tracePose = [&](const RagdollCore::RagdollPose& pose, std::uint64_t serial) {
                        for (std::size_t body = 0; body < pose.mBodyTransforms.size(); ++body)
                        {
                            const auto& t = pose.mBodyTransforms[body];
                            Log(Debug::Info) << std::dec << std::setprecision(17)
                                << "RAGDOLL_ANIMATION_INPUT schema=1 player=" << (getPtr() == MWMechanics::getPlayer())
                                << " actor=" << getPtr().getCellRef().getRefId()
                                << " serial=" << serial << " next_step=" << nextPhysicsStep
                                << " body=" << body << " bodies=" << pose.mBodyTransforms.size()
                                << " position=" << t.mTranslation.GetX() << ',' << t.mTranslation.GetY() << ',' << t.mTranslation.GetZ()
                                << " rotation=" << t.mRotation.GetX() << ',' << t.mRotation.GetY() << ',' << t.mRotation.GetZ() << ',' << t.mRotation.GetW();
                        }
                    };
                    if (mAnimationInputSerial == 1 && mPreviousMotorTargetPose)
                        tracePose(*mPreviousMotorTargetPose, 0);
                    tracePose(mMotorTargetPose, mAnimationInputSerial);
                }
                else if (mAnimationInputSerial == 3601)
                    Log(Debug::Info) << "RAGDOLL_ANIMATION_INPUT_TRUNCATED player=" << (getPtr() == MWMechanics::getPlayer());
            }
#endif
            return true;
        }

        bool captureLocomotionTarget(const Actor& actor, float frameDuration,
            std::uint64_t nextPhysicsStep, unsigned renderFrame)
        {
            mLocomotionInterrupted = false;
            if (balanceMeasurementEnabled())
                clearPendingBalanceIntent("uncaptured");
            if (mStaggerPlan.active() && !staggerPlanCanRun())
                mStaggerPlan.reset();
            if (!mPowered)
                return false;
            const osg::Vec3f velocity = actor.getQueuedWorldVelocity();
            if (!velocity.valid())
            {
                if (balanceMeasurementEnabled())
                    clearPendingBalanceIntent("invalid-queued-velocity");
                return false;
            }
            observeBalanceQueuedIntent(velocity, nextPhysicsStep, renderFrame);
            // The actor's own intent: its movement settings (the player's
            // keys, the AI's command) as well as the queued velocity - a hit
            // state zeroes the queued velocity while the player still holds
            // forward (sentinel: a skid step after a walking push, 3.05 s).
            {
                const auto& movement = getPtr().getClass().getMovementSettings(getPtr());
                mQueuedInputSpeed = std::max(std::hypot(velocity.x(), velocity.y()),
                    128.0f * std::hypot(movement.mPosition[0], movement.mPosition[1]));
            }
            // A hit interrupts: hold the request at zero while the stun
            // lasts, so the victim stops driving forward and spends the
            // moment balancing. Balance authority is untouched, so the
            // physics still decides whether it absorbs, staggers or falls.
            // The interruption lasts exactly as long as the stun. Flagging the
            // frame on which the stun runs out left one tick that was
            // interrupted but no longer stunned, and the kinematic root reads
            // that combination as a knock-down: every stagger ended in a fall.
            if (mHitStun.active())
                mHitStun.step(frameDuration);
            if (mHitStun.active())
            {
                mLocomotionInterrupted = true;
                mRawTargetHorizontalVelocity = JPH::Vec3::sZero();
                return true;
            }
            decayHitReaction(frameDuration);
            if (mStaggerPlan.active() || mantling() || rollOwnsBody())
            {
                mRawTargetHorizontalVelocity = JPH::Vec3::sZero();
                return true;
            }
            constexpr float locomotionDeadZone = 1.0f;
            const bool wasLocomoting
                = mRawTargetHorizontalVelocity.LengthSq() > locomotionDeadZone * locomotionDeadZone;
            JPH::Vec3 target(velocity.x(), velocity.y(), 0.0f);
            if (mDazeTime > 0.0f)
                target *= 0.5f;
            const bool isLocomoting = target.LengthSq() > locomotionDeadZone * locomotionDeadZone;
            if (!isLocomoting)
                target = JPH::Vec3::sZero();
            if (!wasLocomoting && isLocomoting && mMotorTargetCaptured)
            {
                mLocomotionBasePose = mPreviousMotorTargetPose ? *mPreviousMotorTargetPose : mMotorTargetPose;
                if (RagdollCore::tuningText("OPENMW_RAGDOLL_STEP_TRACE"))
                {
                    static unsigned samples = 0;
                    for (std::size_t body = 0; body < mLocomotionBasePose->mBodyTransforms.size() && samples < 128; ++body)
                    {
                        ++samples;
                        const auto& pose = mLocomotionBasePose->mBodyTransforms[body];
                        Log(Debug::Info) << "RAGDOLL_START_REFERENCE actor=" << getPtr().getCellRef().getRefId()
                            << " step=" << mFixedSteps << " body=" << body
                            << " previous=" << mPreviousMotorTargetPose.has_value()
                            << " position=" << pose.mTranslation.GetX() << ',' << pose.mTranslation.GetY()
                            << ',' << pose.mTranslation.GetZ()
                            << " rotation=" << pose.mRotation.GetX() << ',' << pose.mRotation.GetY()
                            << ',' << pose.mRotation.GetZ() << ',' << pose.mRotation.GetW();
                    }
                }
            }
            else if (wasLocomoting && !isLocomoting)
                // Holding this until the FILTERED velocity also reached zero
                // was tried and measured neutral: the scripted-path stop
                // passed 1 of 5 either way. The discontinuity is real - the
                // steering filter keeps braking after the raw request drops,
                // so the plan's reference pose does change mid-deceleration -
                // but it is not what fails that test. See
                // docs/ragdoll/history/stop-base-pose-2026-09-07.txt.
                mLocomotionBasePose.reset();
            mRawTargetHorizontalVelocity = target;
            return true;
        }

        static const std::array<bool, 3>& bodyLeadsSettings()
        {
            static const auto value_tuned = RagdollCore::tuned<std::array<bool, 3>>([] {
                std::array<bool, 3> v{ false, false, false };
                if (const char* text = RagdollCore::tuningText("OPENMW_RAGDOLL_BODY_LEADS"))
                {
                    int a = 0, b = 0, c = 0;
                    const int n = std::sscanf(text, "%d,%d,%d", &a, &b, &c);
                    v = { n >= 1 && a != 0, n >= 2 ? b != 0 : n >= 1 && a != 0, n >= 3 ? c != 0 : n >= 1 && a != 0 };
                }
                return v;
            });
            static const auto& value = value_tuned.get();
            return value;
        }
        bool mBodyLeading = false;
        bool bodyLeadsNow() const
        {
            const auto& on = bodyLeadsSettings();
            if (!mSituationKnown || !mControllerOutput)
                return false;
            const auto mode = mControllerOutput->mMode;
            if (mode != RagdollCore::ActiveControllerMode::Standing && mode != RagdollCore::ActiveControllerMode::Bracing
                && mode != RagdollCore::ActiveControllerMode::Stumbling)
                return false;
            // Rolling the capsule follows the body (the roll's travel).
            if (rollLeads())
                return true;
            // A commanded jump keeps the capsule's travel (user 10-30 play:
            // "jumping while running doesnt conserve the running momentum" -
            // jumps count as real drops, so the capsule followed the lagging
            // body through the air and lost 16-60% of a run's speed).
            // OPENMW_RAGDOLL_JUMP_KEEPS_TRAVEL=0 = the body leads jumps too.
            static const auto jumpKeeps_tuned = RagdollCore::tuned<bool>([] {
                const char* text = RagdollCore::tuningText("OPENMW_RAGDOLL_JUMP_KEEPS_TRAVEL");
                return !(text && std::atoi(text) == 0);
            });
            const bool jumping = jumpKeeps_tuned.get() && mJumpCommanded > 0.0f;
            return (on[0] && mSituation.mAirTime > 0.1f && inRealDrop() && !jumping)
                || ((on[1] || slopeStanceSettings().mOn) && mSituation.mCapsuleSliding)
                || (on[2] && mStaggerPlan.active())
                // LEGS_LEAD: walking, the legs set the speed.
                || mLegsLeading;
        }
        bool synchronizePoweredRoot(Actor& actor, float dt = 0.0f)
        {
            if (!mPowered || !mMotorTargetCaptured || !mPelvisBodyIndex
                || *mPelvisBodyIndex >= mMotorTargetPose.mBodyTransforms.size())
                return false;

            RagdollCore::RagdollTelemetry telemetry;
            if (!mRagdoll->captureTelemetry(telemetry) || *mPelvisBodyIndex >= telemetry.mBodies.size())
                return false;
            const RagdollCore::RagdollPose& rootTarget = motorBasePose();
            const auto targetPosition = mRagdoll->getWorldBodyPosition(rootTarget, *mPelvisBodyIndex);
            if (!targetPosition)
                return false;

            const osg::Vec3d actorPosition = actor.getPosition();
            JPH::RVec3 newReference(actorPosition.x(), actorPosition.y(), actorPosition.z());
            // A kinematic root means gameplay owns the actor's translation;
            // the physical pelvis must not drag the reference (or the actor)
            // while the root follows the actor. After a release the root is
            // dynamic again and the physical body resumes ownership.
            const bool poweredLocomotionOwnsHorizontalRoot = mRagdoll
                && !mRagdoll->isRootKinematic()
                && mControllerOutput && mControllerOutput->mDriveJointMotors
                && !mTargetHorizontalVelocity.IsNearZero();
            // Getting up (and blending back) the root is held to the actor plus
            // the get-up clip's pelvis offset. Letting the pelvis carry the
            // actor there too closed a loop - the target ran ahead as fast as
            // the body followed it: the get-up slid the body 150-265 units
            // (path 400-590) at up to 430 units/s ("getting up takes like a
            // huge slinging slide motion", user 2026-09-28). While the root is
            // held the actor stays; a released root still carries it.
            // OPENMW_RAGDOLL_GETUP_FOLLOW=1 restores the old follow.
            static const auto getUpFollow_tuned = RagdollCore::tuned<bool>([] {
                const char* text = RagdollCore::tuningText("OPENMW_RAGDOLL_GETUP_FOLLOW");
                return text && std::atoi(text) != 0;
            });
            static const auto& getUpFollow = getUpFollow_tuned.get();
            const bool recovering = mControllerOutput
                && (mControllerOutput->mMode == RagdollCore::ActiveControllerMode::GettingUp
                    || mControllerOutput->mMode == RagdollCore::ActiveControllerMode::BlendBack);
            const bool physicsOwnsHorizontalRoot = mControllerOutput
                && (poweredLocomotionOwnsHorizontalRoot
                    || mControllerOutput->mMode == RagdollCore::ActiveControllerMode::Falling
                    || mControllerOutput->mMode == RagdollCore::ActiveControllerMode::Fallen
                    || (recovering && (getUpFollow || !mRagdoll || !mRagdoll->isRootKinematic())));
            // The physical pelvis carries the capsule while a stagger settles
            // (STAGGER_SETTLE below; STAGGER_FOLLOW, never on in play, deleted 10-07).
            bool staggerFollow = false;
            // PGC-03 A3, body-led movement: while airborne, while the capsule
            // slides on steep ground, or in a hard stagger the body leads and
            // the capsule follows it horizontally (as in a fall), so the
            // capsule no longer carries an upright body down a slope or drags
            // a staggering one back. The capsule keeps its vertical (ground
            // collision, step-downs). OPENMW_RAGDOLL_BODY_LEADS = "air, slide,
            // stagger" (1 = on each; unset = off).
            const bool bodyLeads = !physicsOwnsHorizontalRoot && bodyLeadsNow();
            if (bodyLeads != mBodyLeading)
            {
                mBodyLeading = bodyLeads;
                static const auto leadTrace_tuned = RagdollCore::tuned<bool>([] { return RagdollCore::tuningText("OPENMW_RAGDOLL_BODY_LEADS_TRACE") != nullptr; });
                if (leadTrace_tuned.get())
                    Log(Debug::Info) << "RAGDOLL_BODY_LEADS actor=" << getPtr().getCellRef().getRefId() << " on=" << bodyLeads
                                     << " air=" << mSituation.mAirborne << " slide=" << mSituation.mCapsuleSliding
                                     << " stagger=" << mStaggerPlan.active();
            }
            // Stagger settle (10-05): the helper still brakes the stagger, but
            // once the body has stopped (pelvis below 20 u/s, at least 0.15 s
            // after the hit) the capsule moves to it, eased over 0.15 s, so the
            // helper does not then drag the body back to where it was hit
            // (NEARPUSH-01 standing: pulled back 20-100 units).
            // OPENMW_RAGDOLL_STAGGER_SETTLE (seconds after a hit it may start;
            // 0 = off).
            float settleShare = 1.0f;
            if (mStaggerSettle > 0.0f && !physicsOwnsHorizontalRoot && mControllerOutput
                && (mControllerOutput->mMode == RagdollCore::ActiveControllerMode::Standing
                    || mControllerOutput->mMode == RagdollCore::ActiveControllerMode::Bracing
                    || mControllerOutput->mMode == RagdollCore::ActiveControllerMode::Stumbling))
            {
                mStaggerSettleTime += dt;
                const JPH::Vec3 v = telemetry.mBodies[*mPelvisBodyIndex].mMotion.mLinearVelocity;
                if (mStaggerSettling > 0.0f
                    || (mStaggerSettleTime > 0.15f && std::hypot(v.GetX(), v.GetY()) < 20.0f))
                {
                    // The share of the remaining gap closed this step.
                    settleShare = std::clamp(dt / std::max(dt, 0.15f - mStaggerSettling), 0.0f, 1.0f);
                    mStaggerSettling += dt;
                    staggerFollow = true;
                    if (mStaggerSettling >= 0.15f)
                        mStaggerSettle = 0.0f;
                }
                else if (mStaggerSettleTime > mStaggerSettle)
                    mStaggerSettle = 0.0f;
            }
            if (physicsOwnsHorizontalRoot || staggerFollow || bodyLeads)
            {
                // While balance is relinquished or powered locomotion is
                // active, let the physical pelvis carry the gameplay root.
                // The queued ordinary movement is still the desired-velocity
                // input, but must not independently drag the actor reference
                // away from the ragdoll that is trying to realize it.
                const JPH::RVec3 oldReference = mRagdoll->getReferencePosition();
                const JPH::RVec3 pelvisDisplacement = telemetry.mBodies[*mPelvisBodyIndex].mPosition - *targetPosition;
                const double share = physicsOwnsHorizontalRoot || bodyLeads ? 1.0 : settleShare;
                newReference.SetX(oldReference.GetX() + pelvisDisplacement.GetX() * share);
                newReference.SetY(oldReference.GetY() + pelvisDisplacement.GetY() * share);
            }
            // Anchor yield: a body standing still well off its anchor (the
            // actor plus the clip's pelvis) for a second gives the anchor to
            // the body, eased. Play test 2026-09-28 ("I can't get up", "stuck
            // in smooth criminal lean"): after a fall the body stood 25 units
            // from the actor with no input for 5 s, torso pitched 29 degrees
            // and 11 units low as the root spring pulled it toward an actor
            // it never stepped to. Footfall's anchor settle steps toward the
            // anchor first (8 units, 0.15 s); this is the fallback when the
            // feet do not. OPENMW_RAGDOLL_ANCHOR_YIELD = "distance,seconds,
            // speed" (distance 0 = off). 6 units / 0.6 s (10-31) settled a run's
            // stop nearer (12.6 -> 8.5 units off) but on a slope the anchor
            // followed the sagging body downhill and the feet chased it into a
            // fall (Balmora hill stop, end lean 17-44 deg in 3 of 3); kept at 15.
            bool anchorYield = false;
            {
                static const auto yieldSettings_tuned = RagdollCore::tuned<std::array<float, 3>>([] {
                    std::array<float, 3> value{ 15.0f, 1.0f, 60.0f };
                    if (const char* text = RagdollCore::tuningText("OPENMW_RAGDOLL_ANCHOR_YIELD"))
                        std::sscanf(text, "%f,%f,%f", &value[0], &value[1], &value[2]);
                    return value;
                });
                static const auto& yieldSettings = yieldSettings_tuned.get();
                const JPH::RVec3 displacement = telemetry.mBodies[*mPelvisBodyIndex].mPosition - *targetPosition;
                const float offset = static_cast<float>(
                    std::hypot(displacement.GetX(), displacement.GetY()));
                const bool still = !physicsOwnsHorizontalRoot && mControllerOutput
                    && mControllerOutput->mMode == RagdollCore::ActiveControllerMode::Standing
                    && mTargetHorizontalVelocity.IsNearZero() && dt > 0.0f;
                if (yieldSettings[0] > 0.0f && still && (offset > yieldSettings[0] || (mAnchorYielding && offset > 3.0f)))
                    mAnchorYieldTimer += dt;
                else
                {
                    mAnchorYieldTimer = 0.0f;
                    mAnchorYielding = false;
                }
                if (mAnchorYieldTimer > yieldSettings[1])
                {
                    if (!mAnchorYielding)
                        Log(Debug::Info) << "RAGDOLL_ANCHOR_YIELD actor=" << getPtr().getCellRef().getRefId()
                                         << " offset=" << offset;
                    mAnchorYielding = true;
                    anchorYield = true;
                    const float move = std::min(offset, yieldSettings[2] * dt) / std::max(offset, 1e-3f);
                    newReference.SetX(newReference.GetX() + displacement.GetX() * move);
                    newReference.SetY(newReference.GetY() + displacement.GetY() * move);
                }
            }
            // Stop carry (see stopCarryUnits): once the coast has ended (the
            // stop closed) the capsule takes the absorbed offset, at most 60
            // u/s. The balance target is the capsule plus the offset, so it
            // stays where it was and the body feels nothing. Taken in one step
            // (10 units) the drawn camera dipped 7 units and snapped back over
            // three frames. Not while travel is asked for or anything else
            // owns the capsule.
            bool stopCarry = false;
            if (stopCarryUnits() > 0.0f && !mStopAbsorbOpen && !mStopAbsorb.IsNearZero() && !physicsOwnsHorizontalRoot
                && !bodyLeads && !staggerFollow && !anchorYield && mControllerOutput
                && (mControllerOutput->mMode == RagdollCore::ActiveControllerMode::Standing
                    || mControllerOutput->mMode == RagdollCore::ActiveControllerMode::Bracing)
                && std::hypot(mRawTargetHorizontalVelocity.GetX(), mRawTargetHorizontalVelocity.GetY()) <= 20.0f)
            {
                JPH::Vec3 move(mStopAbsorb.GetX(), mStopAbsorb.GetY(), 0.0f);
                if (!mStopHandingOff)
                    Log(Debug::Info) << "RAGDOLL_STOP_CARRY actor=" << getPtr().getCellRef().getRefId()
                                     << " carry=" << move.Length();
                const float most = 60.0f * dt;
                if (move.Length() > most)
                    move = move.Normalized() * most;
                newReference += JPH::RVec3(move);
                mStopAbsorb -= move;
                if (mStopAbsorb.Length() < 0.01f)
                    mStopAbsorb = JPH::Vec3::sZero();
                mStopHandoffPending += move;
                mCameraAbsorb -= move;
                stopCarry = true;
            }
            mStopHandingOff = stopCarry;
            // Feet leash (PGC-03 C9): strafing up and down stairs the capsule
            // ran 55-75 u ahead of the feet along the travel (flat walking
            // 2-6 u median, 27-42 u at most), the soft root dragged the pelvis
            // after it and the torso tipped 30-50 deg until the body fell
            // (stairs up and back 3/3). Grounded and walking, the capsule
            // waits for the feet: past `base + perSpeed x speed` ahead of the
            // feet's middle it is pulled back by `share` of the excess per step.
            // On stairs and slopes only - while the capsule climbs or descends
            // (over 25 u/s in the last 0.5 s): on flat ground a walking body
            // pushed from the front was held back too (push walk front 2000
            // recovery 0.6-0.75 s -> 1.0-1.6 s).
            // OPENMW_RAGDOLL_FEET_LEASH = "base u, per speed, share" (unset = off).
            bool feetLeash = false;
            mLeashUneven = std::abs(mKinematicRootActualVerticalVelocity) > 25.0f ? 0.5f
                                                                                 : std::max(0.0f, mLeashUneven - dt);
            {
                static const auto leash_tuned = RagdollCore::tuned<std::array<float, 3>>([] {
                    std::array<float, 3> v{ 0.0f, 0.06f, 0.3f };
                    if (const char* text = RagdollCore::tuningText("OPENMW_RAGDOLL_FEET_LEASH"))
                        std::sscanf(text, "%f,%f,%f", &v[0], &v[1], &v[2]);
                    return v;
                });
                // On the flat too (STEPPING audit 11-01, item 8: the capsule
                // never waits for the legs there; the chargen guard's body
                // trailed it ~35 u, the player's feet dragged): a looser leash,
                // and never while a hit moves the body (the pushed-walk case
                // above) - only a calm, fully held body.
                // OPENMW_RAGDOLL_FEET_LEASH_FLAT = "base u, per speed, share"
                // (unset = off: stairs and slopes only).
                static const auto flat_tuned = RagdollCore::tuned<std::array<float, 3>>([] {
                    std::array<float, 3> v{ 0.0f, 0.1f, 0.2f };
                    RagdollCore::tuningList("OPENMW_RAGDOLL_FEET_LEASH_FLAT", v);
                    return v;
                });
                const auto& flat = flat_tuned.get();
                const bool calm = mSoftRootStrength >= 0.98f && !mStaggerPlan.active() && !mHitStun.active();
                const float speed = std::hypot(mTargetHorizontalVelocity.GetX(), mTargetHorizontalVelocity.GetY());
                // Turn leash (user 11-01 bookmarks 14-15: "a 180 turn while
                // running causes the ragdoll to drift from the capsule ... the
                // ragdoll will slingshot into the model"; the play log and
                // "run turn 180": the body swung wide 50-76 u behind the capsule
                // and was yanked back). The capsule turns at the mouse's rate,
                // the body carries its momentum round a wider curve. Once the
                // request turns faster than `rate` deg/s at over 100 u/s, the
                // capsule waits for the feet on any ground until the body is
                // back within the leash or 2 s pass.
                // OPENMW_RAGDOLL_TURN_LEASH = "base u, per speed, share, rate"
                // (base 0 = off).
                static const auto turn_tuned = RagdollCore::tuned<std::array<float, 4>>([] {
                    std::array<float, 4> v{ 15.0f, 0.05f, 0.3f, 115.0f };
                    RagdollCore::tuningList("OPENMW_RAGDOLL_TURN_LEASH", v);
                    return v;
                });
                const auto& turnLeash = turn_tuned.get();
                if (turnLeash[0] > 0.0f && speed > 100.0f && dt > 0.0f && !mStaggerPlan.active() && !mHitStun.active())
                {
                    const float heading = std::atan2(mTargetHorizontalVelocity.GetX(), mTargetHorizontalVelocity.GetY());
                    if (mTurnLeashHeading)
                    {
                        float change = heading - *mTurnLeashHeading;
                        change = std::atan2(std::sin(change), std::cos(change));
                        if (std::abs(change) / dt > osg::DegreesToRadians(turnLeash[3]))
                            mTurnLeashTime = 2.0f;
                    }
                    mTurnLeashHeading = heading;
                }
                else
                {
                    mTurnLeashHeading.reset();
                    if (speed <= 30.0f || mStaggerPlan.active() || mHitStun.active())
                        mTurnLeashTime = 0.0f;
                }
                mTurnLeashTime = std::max(0.0f, mTurnLeashTime - dt);
                const bool turning = turnLeash[0] > 0.0f && mTurnLeashTime > 0.0f;
                {
                    static const auto turnTrace_tuned = RagdollCore::tuned<bool>(
                        [] { return RagdollCore::tuningText("OPENMW_RAGDOLL_TURN_TRACE") != nullptr; });
                    static unsigned turnRows = 0;
                    if (turnTrace_tuned.get() && turning && getPtr() == MWMechanics::getPlayer() && ++turnRows % 6 == 0)
                        Log(Debug::Info) << "RAGDOLL_TURN_LEASH t=" << mTurnLeashTime << " speed=" << speed
                                         << " mode=" << (mControllerOutput ? static_cast<int>(mControllerOutput->mMode) : -1)
                                         << " owns=" << physicsOwnsHorizontalRoot << " leads=" << bodyLeads
                                         << " air=" << (mSituationKnown && mSituation.mAirborne) << " jump=" << mJumpAirborne
                                         << " mantle=" << (mantleCapsule().has_value());
                }
                const bool onFlat = !(mLeashUneven > 0.0f) && flat[0] > 0.0f && calm;
                const std::array<float, 3> turnValues{ turnLeash[0], turnLeash[1], turnLeash[2] };
                const auto& leash = turning ? turnValues : onFlat ? flat : leash_tuned.get();
                const bool upright = mControllerOutput
                    && (mControllerOutput->mMode == RagdollCore::ActiveControllerMode::Standing
                        || mControllerOutput->mMode == RagdollCore::ActiveControllerMode::Bracing);
                if (leash[0] > 0.0f && upright && (mLeashUneven > 0.0f || onFlat || turning) && !physicsOwnsHorizontalRoot && !bodyLeads && speed > 30.0f
                    && mSituationKnown && (turning || !mSituation.mAirborne) && !mJumpAirborne && mLeftLeg && mRightLeg
                    && std::max(mLeftLeg->mFoot, mRightLeg->mFoot) < telemetry.mBodies.size())
                {
                    const JPH::Vec3 along(mTargetHorizontalVelocity.GetX() / speed,
                        mTargetHorizontalVelocity.GetY() / speed, 0.0f);
                    const JPH::RVec3 feet = (telemetry.mBodies[mLeftLeg->mFoot].mPosition
                                                + telemetry.mBodies[mRightLeg->mFoot].mPosition)
                        * 0.5;
                    const float ahead = static_cast<float>(
                        (newReference.GetX() - feet.GetX()) * along.GetX() + (newReference.GetY() - feet.GetY()) * along.GetY());
                    const float limit = leash[0] + leash[1] * speed;
                    if (turning)
                    {
                        // A turning body swings wide to the side too: the
                        // capsule waits in any horizontal direction.
                        JPH::Vec3 apart(JPH::Vec3(newReference - feet));
                        apart.SetZ(0.0f);
                        const float distance = apart.Length();
                        if (distance > limit)
                        {
                            newReference -= JPH::RVec3(apart / distance
                                * ((distance - limit) * std::clamp(leash[2], 0.0f, 1.0f)));
                            feetLeash = true;
                            ++mFeetLeashSteps;
                        }
                        else if (mTurnLeashTime < 1.8f)
                            mTurnLeashTime = 0.0f;
                    }
                    else if (ahead > limit)
                    {
                        const float pull = (ahead - limit) * std::clamp(leash[2], 0.0f, 1.0f);
                        newReference -= JPH::RVec3(along * pull);
                        feetLeash = true;
                        ++mFeetLeashSteps;
                    }
                }
            }
            const auto mantle = mantleCapsule();
            if (mantle)
                newReference = *mantle;
            const JPH::Quat newRotation = Misc::Convert::toJolt(poweredActorRotation(getPtr()));

            RagdollCore::RagdollPose previous = mPreviousPhysicsPose;
            RagdollCore::RagdollPose current = mCurrentPhysicsPose;
            std::optional<JPH::Vec3> rebasedSwingStartModel;
            if (mSwingStartModel)
            {
                rebasedSwingStartModel
                    = mRagdoll->rebaseModelPosition(*mSwingStartModel, newReference, newRotation);
                if (!rebasedSwingStartModel)
                    return false;
            }
            if ((!previous.mBodyTransforms.empty() && !mRagdoll->rebaseModelPose(previous, newReference, newRotation))
                || (mCurrentPhysicsPoseCaptured && !mRagdoll->rebaseModelPose(current, newReference, newRotation))
                || !mRagdoll->setReferenceTransform(newReference, newRotation))
                return false;

            mPreviousPhysicsPose = std::move(previous);
            mCurrentPhysicsPose = std::move(current);
            if (rebasedSwingStartModel)
                mSwingStartModel = *rebasedSwingStartModel;
            mExperimentalReferenceRotation = newRotation;
            if (physicsOwnsHorizontalRoot || anchorYield || staggerFollow || bodyLeads || mantle || feetLeash || stopCarry)
            {
                actor.setPoweredRagdollPosition(osg::Vec3f(static_cast<float>(newReference.GetX()),
                    static_cast<float>(newReference.GetY()), static_cast<float>(newReference.GetZ())));
            }
            const osg::Vec3f synchronizedActorPosition = actor.getPhysicsPosition();
            mSynchronizedActorPosition = JPH::RVec3(
                synchronizedActorPosition.x(), synchronizedActorPosition.y(), synchronizedActorPosition.z());
            return true;
        }

        void updateControllerObservation(const RagdollCore::ActiveControllerProfile& profile, float duration,
            const JPH::PhysicsSystem& physics)
        {
            RagdollCore::RagdollTelemetry telemetry;
            if (!mRagdoll->captureTelemetry(telemetry))
                return;
            ++mStepQuality.mSteps;
            updateObservationAxesFromAnimation(duration);
#ifdef OPENMW_RAGDOLL_DEV_API
            // Every step a joint is open by more than 1.2 units: what the two
            // bodies are doing (DUEL-A01 stretch spikes).
            static const auto traceStretch_tuned = RagdollCore::tuned<bool>([] { return RagdollCore::tuningText("OPENMW_RAGDOLL_STRETCH_TRACE") != nullptr; });
            static const auto& traceStretch = traceStretch_tuned.get();
            if (traceStretch && getPtr() != MWMechanics::getPlayer())
                for (const auto& constraint : telemetry.mConstraints)
                {
                    if (constraint.mAnchorSeparation <= 1.2f || constraint.mChildBodyIndex >= telemetry.mBodies.size()
                        || constraint.mParentBodyIndex >= telemetry.mBodies.size())
                        continue;
                    const auto& parent = telemetry.mBodies[constraint.mParentBodyIndex];
                    const auto& child = telemetry.mBodies[constraint.mChildBodyIndex];
                    const JPH::Vec3 relative = child.mMotion.mLinearVelocity - parent.mMotion.mLinearVelocity;
                    Log(Debug::Info) << std::dec << std::fixed << std::setprecision(2) << "RAGDOLL_STRETCH actor="
                                     << getPtr().getCellRef().getRefId() << " step=" << mStepQuality.mSteps
                                     << " sep=" << constraint.mAnchorSeparation << " parent=" << constraint.mParentBodyIndex
                                     << " child=" << constraint.mChildBodyIndex << " mode="
                                     << (mControllerOutput ? static_cast<int>(mControllerOutput->mMode) : -1)
                                     << " t_mode=" << (mControllerOutput ? mControllerOutput->mTimeInMode : -1.0f)
                                     << " root_kin=" << mRagdoll->isRootKinematic()
                                     << " parent_z=" << parent.mPosition.GetZ() << " child_z=" << child.mPosition.GetZ()
                                     << " pelvis_z=" << telemetry.mBodies[0].mPosition.GetZ()
                                     << " child_v=" << child.mMotion.mLinearVelocity.Length()
                                     << " rel_v=" << relative.Length()
                                     << " child_w=" << child.mMotion.mAngularVelocity.Length()
                                     << " stun=" << mHitStun.active();
                }
#endif
            for (const auto& constraint : telemetry.mConstraints)
            {
                if (constraint.mAnchorSeparation > mStepQuality.mMaximumAnchorSeparation)
                {
#ifdef OPENMW_RAGDOLL_DEV_API
                    // Joint stretch diagnosis: a physical joint that opens by
                    // more than a unit shows as a gap between body parts. One
                    // row per new maximum that is at least half a unit worse.
                    static const auto traceAnchors_tuned = RagdollCore::tuned<bool>([] { return RagdollCore::tuningText("OPENMW_RAGDOLL_ANCHOR_TRACE") != nullptr; });
                    static const auto& traceAnchors = traceAnchors_tuned.get();
                    if (traceAnchors && constraint.mAnchorSeparation > 1.0f
                        && constraint.mAnchorSeparation > mStepQuality.mMaximumAnchorSeparation + 0.5f)
                        Log(Debug::Info) << std::dec << std::setprecision(4) << "RAGDOLL_ANCHOR_MAX player="
                                         << (getPtr() == MWMechanics::getPlayer())
                                         << " actor=" << getPtr().getCellRef().getRefId()
                                         << " separation=" << constraint.mAnchorSeparation
                                         << " parent=" << constraint.mParentBodyIndex
                                         << " child=" << constraint.mChildBodyIndex
                                         << " child_name=" << [&](std::size_t body) -> const char* {
                                                const auto arm = [&](const std::optional<RagdollArmChain>& c) {
                                                    return c && (body == c->mFrame || body == c->mShoulder
                                                        || body == c->mElbow || body == c->mHand);
                                                };
                                                const auto leg = [&](const std::optional<RagdollLegChain>& c) {
                                                    return c && (body == c->mHip || body == c->mKnee || body == c->mFoot);
                                                };
                                                if (arm(mLeftArm)) return "left_arm";
                                                if (arm(mRightArm)) return "right_arm";
                                                if (leg(mLeftLeg)) return "left_leg";
                                                if (leg(mRightLeg)) return "right_leg";
                                                if (mHeadBodyIndex && body == *mHeadBodyIndex) return "head";
                                                if (mWeapon && body == mWeapon->mWeaponBody) return "weapon";
                                                return "trunk";
                                            }(constraint.mChildBodyIndex)
                                         << " step=" << mStepQuality.mSteps << " powered=" << mPowered
                                         << " root_kin=" << (mRagdoll && mRagdoll->isRootKinematic())
                                         << " strike=" << (mAiStrikeActive || mPlayerStrikeActive)
                                         << " swinging=" << mSwing.mSwinging
                                         << " stun=" << mHitStun.active();
#endif
                    mStepQuality.mMaximumAnchorSeparation = constraint.mAnchorSeparation;
                    mStepQuality.mMaximumAnchorStep = mStepQuality.mSteps;
                    mStepQuality.mMaximumAnchorParentBody = constraint.mParentBodyIndex;
                    mStepQuality.mMaximumAnchorChildBody = constraint.mChildBodyIndex;
                }
                if (constraint.mHingeAngle && constraint.mHingeMinimum && constraint.mHingeMaximum)
                    mStepQuality.mMaximumHingeViolation = std::max({ mStepQuality.mMaximumHingeViolation,
                        *constraint.mHingeMinimum - *constraint.mHingeAngle,
                        *constraint.mHingeAngle - *constraint.mHingeMaximum });
            }
            if (!mLeftFootBodyIndex || !mRightFootBodyIndex)
                return;
            std::vector<RagdollCore::GroundContact> contacts;
            {
                std::scoped_lock lock(mContactMutex);
                contacts = RagdollCore::resolveGroundContacts(mStepContacts, physics);
            }
            mObservedGroundContacts = contacts;
            if (*mLeftFootBodyIndex >= telemetry.mBodies.size() || *mRightFootBodyIndex >= telemetry.mBodies.size())
                return;
            auto estimate = RagdollCore::estimateFootSupport(
                telemetry.mCenterOfMass, contacts, { *mLeftFootBodyIndex, *mRightFootBodyIndex }, profile);
            if (!estimate)
                return;
            if (estimate->hasGroundContact() || mRagdoll->isActive() || !mSupportEstimate
                || !mSupportEstimate->hasGroundContact())
                mSupportEstimate = *estimate;

            if (!mControllerObservationInitialized || !mSupportEstimate || !mPelvisBodyIndex || !mTorsoBodyIndex
                || *mPelvisBodyIndex >= telemetry.mBodies.size() || *mTorsoBodyIndex >= telemetry.mBodies.size())
                return;
            RagdollCore::ActiveControllerInput input;
            input.mSupport = *mSupportEstimate;
            input.mRecoveryRequested = mRecoveryRequested;
            // ACRO-01: a fallen body lies `lie low..high` s longer by
            // Acrobatics before the get-up starts (on top of the profile's
            // recovery delay).
            if (const auto& acro = acroRollSettings(); acro.mOn && mRecoveryRequested && mControllerOutput
                && mControllerOutput->mMode == RagdollCore::ActiveControllerMode::Fallen)
            {
                const float lie = acro.mLieLow + (acro.mLieHigh - acro.mLieLow) * acroSkill();
                if (mControllerOutput->mTimeInMode < profile.mRecoveryDelay + lie)
                    input.mRecoveryRequested = false;
            }
            input.mActuationInterrupted = mLocomotionInterrupted;
            input.mRecoveryInterrupted = mRecoveryInterrupted;
            input.mForcedRecoveryDirection = sForcedRecoveryDirection;
            input.mRecoveryAnimationFinished = mRecoveryAnimationFinished;
            input.mRootExternallyOwned = mRagdoll->isRootKinematic();
            if (profile.mLocomotionRoute == RagdollCore::LocomotionRoute::KinematicRoot
                && input.mRootExternallyOwned && !telemetry.mBodies.empty())
            {
                // Body zero is the owned ragdoll root. This exact snapshot
                // also supplies COM velocity below, before updateKinematicRoot
                // schedules the next solve's prescribed root velocity.
                input.mOwnedRootVerticalVelocity = telemetry.mBodies.front().mMotion.mLinearVelocity.GetZ();
            }
            mLastRecoveryAnimationFinishedInput = input.mRecoveryAnimationFinished;
            input.mPelvisUpDot
                = std::clamp((telemetry.mBodies[*mPelvisBodyIndex].mRotation * mPelvisLocalUp).Dot(JPH::Vec3::sAxisZ()),
                    -1.0f, 1.0f);
            input.mTorsoUpDot = std::clamp(
                (telemetry.mBodies[*mTorsoBodyIndex].mRotation * mTorsoLocalUp).Dot(JPH::Vec3::sAxisZ()), -1.0f, 1.0f);
            input.mTorsoFacingUpDot = std::clamp(
                (telemetry.mBodies[*mTorsoBodyIndex].mRotation * mTorsoLocalForward).GetZ(), -1.0f, 1.0f);
            // Active body: the legs swing the light pelvis around mid-stride
            // (49 deg in fast running turns) under an upright torso. Whether the
            // body stands or falls is the torso's call.
            if (mRagdoll && mRagdoll->getSoftRoot().mEnabled && mRagdoll->isRootKinematic())
                input.mPelvisUpDot = std::max(input.mPelvisUpDot, input.mTorsoUpDot);
            // A drop roll turns the body over on purpose: not a fall while the
            // roll holds the root (the torso values stay raw for the reports).
            if (rollOwnsBody() && mRagdoll && mRagdoll->isRootKinematic())
                input.mPelvisUpDot = std::max(input.mPelvisUpDot, profile.mStandingMinimumUpDot + 0.05f);
            {
                JPH::Vec3 pelvisForward = telemetry.mBodies[*mPelvisBodyIndex].mRotation * mPelvisLocalForward;
                pelvisForward.SetZ(0.0f);
                const osg::Vec3f look = actorLookDirection(getPtr());
                if (!pelvisForward.IsNearZero() && look.valid())
                {
                    pelvisForward = pelvisForward.Normalized();
                    const JPH::Vec3 gameplay(look.x(), look.y(), 0.0f);
                    mHeadingError = std::atan2(gameplay.Cross(pelvisForward).GetZ(), gameplay.Dot(pelvisForward));
                    if (!std::isfinite(mHeadingError))
                        mHeadingError = 0.0f;
                }
            }
            if (input.mSupport.hasGroundContact())
            {
                input.mPelvisHeight = std::max(0.0f,
                    static_cast<float>(telemetry.mBodies[*mPelvisBodyIndex].mCenterOfMass.GetZ()
                        - input.mSupport.mGroundCenter.GetZ()));
            }
            JPH::Vec3 centerOfMassVelocity = JPH::Vec3::sZero();
            if (mRecoveryHandoverPending)
            {
                // Gameplay yaw has now been synchronized and the measured
                // model pose rebased. Start the motor/support transition in
                // this frame, rather than retaining a pose in the old basis.
                if (mControllerOutput && mControllerOutput->mDriveJointMotors
                    && mControllerOutput->mMode == RagdollCore::ActiveControllerMode::Standing
                    && mCurrentPhysicsPoseCaptured)
                    mHandover.begin(mCurrentPhysicsPose, input.mPelvisHeight,
                        telemetry.mCenterOfMass, mExperimentalReferenceProfile);
                mRecoveryHandoverPending = false;
            }
            // The controller reads this speed as "is the body being carried
            // off its feet". On a held root, arms that the actor itself is
            // swinging are not that: two arms and a weapon at attack speed are
            // worth 75 units/s of whole-body speed against a standing limit
            // of 60, so every real attack read as bracing (staff tap: 140-180
            // for three steps). Their momentum is left out while an attack or
            // a dragged swing owns them; trunk and legs still count in full.
            const bool ownSwing = (mAnimationAttackMotors || mSwingMotorsActive) && mRagdoll->isRootKinematic();
            const auto swungByActor = [&](std::size_t index) {
                if (!ownSwing)
                    return false;
                if (mWeapon && mWeapon->mAttached && index == mWeapon->mWeaponBody)
                    return true;
                for (const auto* arm : { &mLeftArm, &mRightArm })
                    if (*arm && (index == (*arm)->mShoulder || index == (*arm)->mElbow || index == (*arm)->mHand))
                        return true;
                return false;
            };
            for (std::size_t index = 0; index < telemetry.mBodies.size(); ++index)
                if (!swungByActor(index))
                    centerOfMassVelocity += telemetry.mBodies[index].mMotion.mLinearVelocity
                        * telemetry.mBodies[index].mMass;
            centerOfMassVelocity /= telemetry.mTotalMass;
            input.mCenterOfMassVelocity = centerOfMassVelocity;
            input.mTargetHorizontalVelocity = JPH::Vec3::sZero();
            // Steering: the gameplay request becomes the command the gait
            // follows, turning and stopping at the profile's rates.
            {
                const JPH::Vec3 horizontalVelocity(centerOfMassVelocity.GetX(), centerOfMassVelocity.GetY(), 0.0f);
                // The removed reference walker was the only source of a
                // stance here; without it the body always counts as planted.
                const bool bothFeetPlanted = true;
                const bool standingReady = true;
                // A player's input is not swept round at the turn rate: it
                // takes effect at once and the body accelerates into it,
                // while the body's FACING turns behind at the turn rate
                // (plan item 2.3b). AI walkers keep the filtered heading
                // their gates were measured on.
                const bool playerBody = getPtr() == MWMechanics::getPlayer();
                mTargetHorizontalVelocity = mSteering.step(mRawTargetHorizontalVelocity, duration,
                    mExperimentalReferenceProfile, standingReady, bothFeetPlanted, playerBody, horizontalVelocity);
                if (playerBody)
                {
                    const float yaw = getPtr().getRefData().getPosition().rot[2];
                    const osg::Vec3f look = osg::Quat(yaw, osg::Vec3(0, 0, -1)) * osg::Vec3f(0, 1, 0);
                    if (look.valid())
                    {
                        mRawFacingRequest = JPH::Vec3(look.x(), look.y(), 0.0f);
                        mSteering.stepFacing(mRawFacingRequest, duration, mExperimentalReferenceProfile);
                    }
                }
                else if (static const bool npcFacingLatch = [] { const char* t = RagdollCore::tuningText("OPENMW_RAGDOLL_NPC_FACING_LATCH"); return !(t && std::atoi(t) == 0); }(); npcFacingLatch)  // default ON since 2026-09-11; =0 disables
                {
                    // ENV-GATED (default off): the latch regressed the scripted
                    // turn-and-stop smoke test on 2026-09-11, so AI walkers keep
                    // the historical behaviour (no facing request, facing =
                    // travel) unless OPENMW_RAGDOLL_NPC_FACING_LATCH is set.
                    // Non-player bodies (2026-09-11, strafe-search doc): their
                    // actor yaw inherits the physical heading, so it cannot be
                    // a facing request while the body turns - feeding it back
                    // made an NPC strafe spin (heading error -> 3 rad in 2 s).
                    // Follow the actor yaw only while the travel request is
                    // idle or within 45 degrees of it; while the travel is
                    // sideways or backward, hold the last facing. That is the
                    // held facing the offline strafe/backpedal gates use.
                    const float yaw = getPtr().getRefData().getPosition().rot[2];
                    const osg::Vec3f look = osg::Quat(yaw, osg::Vec3(0, 0, -1)) * osg::Vec3f(0, 1, 0);
                    if (look.valid())
                    {
                        const JPH::Vec3 candidate(look.x(), look.y(), 0.0f);
                        JPH::Vec3 travel = mRawTargetHorizontalVelocity;
                        travel.SetZ(0.0f);
                        const bool idle = travel.LengthSq() < 1.0f;
                        const bool aligned = !idle && candidate.Dot(travel.Normalized()) > 0.7071f;
                        if (mRawFacingRequest.IsNearZero() || idle || aligned)
                            mRawFacingRequest = candidate;
                        mSteering.stepFacing(mRawFacingRequest, duration, mExperimentalReferenceProfile);
                    }
                }
                // Plan item 1.6: sample the three headings once per fixed
                // step so their totals can be compared across frame rates.
                ++mFixedSteps;
                if (!mRawTargetHorizontalVelocity.IsNearZero())
                    accumulateHeading(mLastRequestHeading,
                        std::atan2(mRawTargetHorizontalVelocity.GetY(), mRawTargetHorizontalVelocity.GetX()),
                        mRequestHeadingTravel);
                if (!mTargetHorizontalVelocity.IsNearZero())
                    accumulateHeading(mLastCommandHeading,
                        std::atan2(mTargetHorizontalVelocity.GetY(), mTargetHorizontalVelocity.GetX()),
                        mCommandHeadingTravel);
                const JPH::Vec3 referenceForward = mExperimentalReferenceRotation * JPH::Vec3::sAxisY();
                accumulateHeading(mLastReferenceYaw,
                    std::atan2(referenceForward.GetY(), referenceForward.GetX()), mReferenceYawTravel);
                // The authored base pose the plan builds its targets from,
                // and the reference height: both are refreshed once per
                // rendered frame, so a frame-rate path would show here.
                if (mMotorTargetCaptured)
                {
                    const RagdollCore::RagdollPose& basePose
                        = mLocomotionBasePose ? *mLocomotionBasePose : mMotorTargetPose;
                    if (mLastBasePose.size() == basePose.mBodyTransforms.size())
                    {
                        for (std::size_t body = 0; body < basePose.mBodyTransforms.size(); ++body)
                        {
                            const float dot = std::clamp(
                                std::abs(mLastBasePose[body].Dot(basePose.mBodyTransforms[body].mRotation)),
                                -1.0f, 1.0f);
                            mBasePoseTravel += 2.0f * std::acos(dot);
                        }
                    }
                    mLastBasePose.clear();
                    mLastBasePose.reserve(basePose.mBodyTransforms.size());
                    for (const RagdollCore::Transform& transform : basePose.mBodyTransforms)
                        mLastBasePose.push_back(transform.mRotation);
                }
                const JPH::RVec3 referenceOrigin = mRagdoll->getReferencePosition();
                const float referenceHeight = static_cast<float>(referenceOrigin.GetZ());
                if (mLastReferenceHeight)
                    mReferenceHeightTravel += std::abs(referenceHeight - *mLastReferenceHeight);
                mLastReferenceHeight = referenceHeight;
                const JPH::Vec3 referenceGround(
                    static_cast<float>(referenceOrigin.GetX()), static_cast<float>(referenceOrigin.GetY()), 0.0f);
                if (mLastReferenceGround)
                    mReferenceGroundTravel += (referenceGround - *mLastReferenceGround).Length();
                mLastReferenceGround = referenceGround;
            }

            bool stanceSupportsCenterOfMass = false;
            std::optional<RagdollCore::SupportEstimate> stanceSupportEstimate;
            std::optional<JPH::RVec3> backwardRecoveryTarget;
            if (mGaitOutput && mGaitOutput->hasStance())
            {
                const std::size_t stanceFoot = mGaitOutput->leftFootIsStance()
                    ? *mLeftFootBodyIndex : *mRightFootBodyIndex;
                JPH::RVec3 stancePosition = telemetry.mBodies[stanceFoot].mPosition;
                stancePosition.SetZ(input.mSupport.mGroundCenter.GetZ());
                const auto stance = RagdollCore::estimateGaitStanceSupport(mGaitOutput->mPhase,
                    telemetry.mCenterOfMass, centerOfMassVelocity, mTargetHorizontalVelocity,
                    input.mSupport.mCenterOfMassHeight, RagdollCore::UnitModel::GravityUnitsPerSecondSquared,
                    contacts, { *mLeftFootBodyIndex, *mRightFootBodyIndex }, profile, true,
                    RagdollCore::GaitCaptureStepInput{ stancePosition, mGaitOutput->mTimeInPhase });
                if (!stance)
                {
                    failPoweredControl(__LINE__);
                    return;
                }
                stanceSupportsCenterOfMass = stance->mReady;
                stanceSupportEstimate = stance->mSupport;
                backwardRecoveryTarget = stance->mBackwardRecoveryTarget;
            }

            if (mRagdoll->isActive())
            {
                mUprightControllerInput.reset();
                mUprightControllerOutput.reset();
            }
            const bool recovering = mControllerOutput
                && (mControllerOutput->mMode == RagdollCore::ActiveControllerMode::GettingUp
                    || mControllerOutput->mMode == RagdollCore::ActiveControllerMode::BlendBack);
            const bool locomotionRequested = !recovering && !mTargetHorizontalVelocity.IsNearZero();
            RagdollCore::SettledPelvisHeightInput heightInput;
            heightInput.mSupport = input.mSupport;
            heightInput.mMode = mControllerOutput ? mControllerOutput->mMode
                                                  : RagdollCore::ActiveControllerMode::Standing;
            heightInput.mPelvisHeight = input.mPelvisHeight;
            heightInput.mPelvisVerticalVelocity
                = telemetry.mBodies[*mPelvisBodyIndex].mMotion.mLinearVelocity.Dot(JPH::Vec3::sAxisZ());
            heightInput.mLocomotionRequested = locomotionRequested;
            if (!mPelvisHeightTracker.step(heightInput, duration, profile, mPelvisHeightOutput))
            {
                failPoweredControl(__LINE__);
                return;
            }
            std::optional<float> targetPelvisHeight = mPelvisHeightOutput.mTargetHeight;
            mRecoveryReferencePose.reset();
            const auto recoveryHeight = recovering ? projectRecoveryReference() : std::nullopt;
            // A learned standing height is not a ceiling for a different
            // articulated pose. Capping the floor bound can request that a
            // collision shape pass below the floor during recovery.
            if (recoveryHeight)
                targetPelvisHeight = *recoveryHeight;
            // The pelvis height only settles standing still, so a player who
            // ran straight out of a get-up was never "locomoting": the target
            // velocity stayed zero, the running body read as a 200 u/s
            // tracking error, and the controller stayed in Bracing until they
            // stopped (user bookmarks 2026-09-30 "stuck in a pose", "legs just
            // don't work", "I had to wait until it settled"; KNOCKRUN-01).
            // While the soft root holds the body upright and no recovery owns
            // it, a request is locomotion without the settle.
            // OPENMW_RAGDOLL_HELD_LOCOMOTION=0 = the old rule.
            static const auto heldLocomotion_tuned = RagdollCore::tuned<bool>([] { return weaponDriveSetting("OPENMW_RAGDOLL_HELD_LOCOMOTION", 1.0f) > 0.0f; });
            static const auto& heldLocomotion = heldLocomotion_tuned.get();
            const bool heldUpright = heldLocomotion && mRagdoll->getSoftRoot().mEnabled && mRagdoll->isRootKinematic()
                && !recovering;
            const bool locomoting = locomotionRequested && (mPelvisHeightOutput.mSettled || heldUpright);
            if (locomoting)
                input.mTargetHorizontalVelocity = mTargetHorizontalVelocity;
            const bool preservingGaitOrientation
                = locomoting && mControllerOutput && mControllerOutput->mDriveJointMotors;
            // With the soft root the get-up clip is carried by the balance
            // spring toward the animated root. The height assist latched at
            // pelvis up-dot 0.65 while still kneeling and, with no authored
            // recovery height, retargeted the upright controller at the
            // standing height (73.5): a saturated 150000 pelvis force threw
            // the pelvis from 14 to 53 units in 0.2 s at 250 u/s, 12-30
            // units above the clip, and the feet off the floor (knockdown
            // cases). Without it the soft root alone tracked the clip to
            // standing (warhammer knockdown 6000, where it never latched).
            // OPENMW_RAGDOLL_SOFT_ROOT_GETUP_HEIGHT_ASSIST=1 restores it.
            static const auto softRootGetUpHeightAssist_tuned = RagdollCore::tuned<bool>([] {
                const char* text = RagdollCore::tuningText("OPENMW_RAGDOLL_SOFT_ROOT_GETUP_HEIGHT_ASSIST");
                return text && std::atoi(text) != 0;
            });
            static const auto& softRootGetUpHeightAssist = softRootGetUpHeightAssist_tuned.get();
            const bool heightAssist = mControllerOutput && mControllerOutput->mRecoveryHeightAssist
                && (softRootGetUpHeightAssist || !mRagdoll->getSoftRoot().mEnabled
                    || mControllerOutput->mMode != RagdollCore::ActiveControllerMode::GettingUp);
            const bool correctTranslation
                = input.mSupport.hasGroundContact() && (!recovering || recoveryHeight || heightAssist
                    || mControllerOutput->mMode == RagdollCore::ActiveControllerMode::BlendBack);
            RagdollCore::GaitActuationDecisionInput gaitDecisionInput;
            gaitDecisionInput.mLocomotionRequested = locomotionRequested;
            gaitDecisionInput.mPelvisHeightSettled = mPelvisHeightOutput.mSettled;
            gaitDecisionInput.mDriveJointMotors = mControllerOutput && mControllerOutput->mDriveJointMotors;
            gaitDecisionInput.mRecovering = recovering;
            gaitDecisionInput.mCorrectTranslation = correctTranslation;
            gaitDecisionInput.mBothFeetSupported
                = input.mSupport.mLeftFootSupported && input.mSupport.mRightFootSupported;
            gaitDecisionInput.mRequestedHorizontalVelocity = mTargetHorizontalVelocity;
            gaitDecisionInput.mMeasuredHorizontalVelocity = centerOfMassVelocity;
            if (mGaitOutput)
                gaitDecisionInput.mGait = *mGaitOutput;
            mGaitActuationDecision
                = RagdollCore::calculateGaitActuationDecision(gaitDecisionInput, profile.mGait);
            if (!mGaitActuationDecision)
            {
                failPoweredControl(__LINE__);
                return;
            }
            mJointSupportControllerOutput.reset();
            // Standing support is for a body on its feet. Between the get-up
            // request and the get-up it ran saturated on a body lying on the
            // floor, flipped it over and threw the pelvis up at 170-260 u/s,
            // back into Falling - the retry loop (an NPC needed four tries,
            // 2026-09-24 N10; "the stand up animation is crazy", R5).
            const bool lying = mControllerOutput
                && (mControllerOutput->mMode == RagdollCore::ActiveControllerMode::Falling
                    || mControllerOutput->mMode == RagdollCore::ActiveControllerMode::Fallen);
            // Dev switch (PGC skate check 2026-09-30): OPENMW_RAGDOLL_STAND_JOINT_SUPPORT=0
            // skips the standing joint support plan.
            static const auto standJointSupport_tuned = RagdollCore::tuned<bool>([] { return weaponDriveSetting("OPENMW_RAGDOLL_STAND_JOINT_SUPPORT", 1.0f) > 0.0f; });
            static const auto& standJointSupport = standJointSupport_tuned.get();
            if (mPowered && mGaitActuationDecision->mUseJointSupportControl && !lying && standJointSupport)
            {
                // After a stop the hand-over blend moves the standing support
                // target from the center of mass at the hand-over to the
                // mid-foot center (plan item 1.5).
                mJointSupportControllerOutput = RagdollCore::calculateStandingJointSupport(telemetry, contacts,
                    { *mLeftFootBodyIndex, *mRightFootBodyIndex },
                    RagdollCore::UnitModel::GravityUnitsPerSecondSquared, input.mSupport.mFriction.value_or(0), profile,
                    mHandover.supportReference(input.mSupport.mCenter, centerOfMassVelocity, mExperimentalReferenceProfile));
                if (!mJointSupportControllerOutput)
                {
                    failPoweredControl(__LINE__);
                    return;
                }
            }
            if (targetPelvisHeight
                && (input.mSupport.hasSupport() || recovering || (locomoting && input.mSupport.hasGroundContact())
                    || preservingGaitOrientation))
            {
                RagdollCore::UprightControllerInput upright;
                // Joint motors only control bodies relative to the pelvis; the
                // free pelvis needs a world-space torque to follow a get-up.
                // Recovery therefore keeps bounded orientation control even
                // while the animation temporarily has no foot support. Without
                // a support surface, suppress translational correction rather
                // than manufacturing a world-space support point.
                // Physical settling must restore COM and height feedback;
                // continued unweighting replaces it with lift-only acceleration.
                // Not with the soft root: its balance spring already carries
                // the get-up, and the extra 2.5 g lift on top threw a kneeling
                // body 50 units above the clip at 226-273 u/s ("the stand up
                // animation is crazy", 2026-09-24 R5; new walking cases
                // `knockdown`). OPENMW_RAGDOLL_SOFT_ROOT_UNWEIGHT=1 restores it.
                static const auto softRootUnweight_tuned = RagdollCore::tuned<bool>([] {
                    const char* text = RagdollCore::tuningText("OPENMW_RAGDOLL_SOFT_ROOT_UNWEIGHT");
                    return text && std::atoi(text) != 0;
                });
                static const auto& softRootUnweight = softRootUnweight_tuned.get();
                upright.mRecoveryUnweight = recovering
                    && (softRootUnweight || !mRagdoll->getSoftRoot().mEnabled)
                    && !recoveryHeight
                    && mControllerOutput->mMode == RagdollCore::ActiveControllerMode::GettingUp
                    && input.mSupport.hasGroundContact()
                    && (!mControllerOutput->mRecoveryHeightAssist
                        || input.mPelvisUpDot < profile.mStandingMinimumUpDot);
                upright.mTargetPelvisHeight = correctTranslation ? *targetPelvisHeight
                    : input.mSupport.hasGroundContact()          ? input.mPelvisHeight
                                                                 : *targetPelvisHeight;
                if (correctTranslation && mHandover.active())
                    upright.mTargetPelvisHeight
                        = mHandover.blendPelvisHeight(*targetPelvisHeight, mExperimentalReferenceProfile);
                upright.mPelvisHeight
                    = input.mSupport.hasGroundContact() ? input.mPelvisHeight : *targetPelvisHeight;
                if (correctTranslation)
                {
                    upright.mPelvisVerticalVelocity
                        = telemetry.mBodies[*mPelvisBodyIndex].mMotion.mLinearVelocity.Dot(JPH::Vec3::sAxisZ());
                }
                if (correctTranslation && input.mSupport.hasSupport())
                {
                    const JPH::Vec3 defaultOffset(telemetry.mCenterOfMass - input.mSupport.mCenter);
                    std::optional<JPH::Vec3> stanceOffset;
                    if (stanceSupportEstimate && stanceSupportEstimate->hasSupport())
                    {
                        const JPH::RVec3 target = stanceSupportEstimate->mClosestPoint
                            + 0.5 * (stanceSupportEstimate->mCenter - stanceSupportEstimate->mClosestPoint);
                        stanceOffset = JPH::Vec3(telemetry.mCenterOfMass - target);
                        stanceOffset->SetZ(0.0f);
                    }
                    const auto selectedOffset = RagdollCore::selectGaitCenterOfMassOffset(
                        *mGaitActuationDecision, mTargetHorizontalVelocity, defaultOffset, stanceOffset);
                    if (!selectedOffset)
                    {
                        failPoweredControl(__LINE__);
                        return;
                    }
                    upright.mCenterOfMassOffset = *selectedOffset;
                }
                if (correctTranslation)
                    upright.mCenterOfMassVelocity = centerOfMassVelocity;
                // During a brief authored gait flight phase, keep orientation
                // torque alive but do not accelerate the ragdoll through the
                // air. Translation resumes from measured support after the
                // next ground contact.
                upright.mTargetHorizontalVelocity = mGaitActuationDecision->mTargetHorizontalVelocity;
                upright.mPelvisUp = telemetry.mBodies[*mPelvisBodyIndex].mRotation * mPelvisLocalUp;
                upright.mPelvisAngularVelocity = telemetry.mBodies[*mPelvisBodyIndex].mMotion.mAngularVelocity;
                upright.mTorsoUp = telemetry.mBodies[*mTorsoBodyIndex].mRotation * mTorsoLocalUp;
                upright.mTorsoAngularVelocity = telemetry.mBodies[*mTorsoBodyIndex].mMotion.mAngularVelocity;
                // Standing and gait balance against world up. Following the
                // animated pelvis-up vector here makes authored walk-cycle
                // lean become the physical definition of upright and can
                // topple the whole ragdoll. Only the active get-up follows
                // the changing authored orientation. Physical settling must
                // balance against world up, not retain an animation lean.
                if (mControllerOutput
                    && mControllerOutput->mMode == RagdollCore::ActiveControllerMode::GettingUp
                    && mMotorTargetCaptured)
                {
                    const auto targetPelvisRotation
                        = mRagdoll->getWorldBodyRotation(mMotorTargetPose, *mPelvisBodyIndex);
                    if (targetPelvisRotation)
                        upright.mTargetUp = *targetPelvisRotation * mPelvisLocalUp;
                }
                // Under the held (soft) root only the spine torque of this
                // controller is applied (the pelvis parts are zeroed): toward
                // world up it held the chest against the animation's lean and
                // side sway (running roll 13 of 21 deg). Aimed at the animated
                // torso's up it keeps its damping and helps the pose instead.
                // OPENMW_RAGDOLL_HELD_SPINE_FOLLOW = 1 (test knob, 2026-09-28).
                else if (mMotorTargetCaptured && mRagdoll->isRootKinematic())
                {
                    static const auto followAnimation_tuned = RagdollCore::tuned<bool>([] {
                        const char* text = RagdollCore::tuningText("OPENMW_RAGDOLL_HELD_SPINE_FOLLOW");
                        return text && std::atoi(text) != 0;
                    });
                    static const auto& followAnimation = followAnimation_tuned.get();
                    if (followAnimation)
                        if (const auto targetTorsoRotation
                            = mRagdoll->getWorldBodyRotation(mMotorTargetPose, *mTorsoBodyIndex))
                            upright.mTargetUp = *targetTorsoRotation * mTorsoLocalUp;
                }
                upright.mTotalMass = telemetry.mTotalMass;
                // Contact budgets are selected by the shared gait policy.
                upright.mSupportFriction = input.mSupport.mFriction.value_or(0);
                upright.mGravityMagnitude = RagdollCore::UnitModel::GravityUnitsPerSecondSquared;
                upright.mCenterOfMassPosition = telemetry.mCenterOfMass;
                upright.mCenterOfMassHeight = input.mSupport.mCenterOfMassHeight;
                RagdollCore::configureGaitSupportBudget(*mGaitActuationDecision, correctTranslation, contacts,
                    { *mLeftFootBodyIndex, *mRightFootBodyIndex }, upright);
                // Standing too, the upright controller's horizontal pull on the
                // pelvis is limited to what the feet can hold (walking already
                // is). Unlimited, after a push it braked at up to ~1 g and its
                // reaction dragged both planted feet through their grip: the
                // standing skate, mostly in double support (PGC session,
                // 2026-09-30, reproduced offline). OPENMW_RAGDOLL_STAND_FRICTION
                // = the limit as a share of weight (0 = unlimited, the old law).
                static const auto standFriction_tuned = RagdollCore::tuned<float>([] { return weaponDriveSetting("OPENMW_RAGDOLL_STAND_FRICTION", 0.0f); });
                static const auto& standFriction = standFriction_tuned.get();
                if (standFriction > 0.0f && correctTranslation && !upright.mLimitToSupportFriction)
                {
                    upright.mLimitToSupportFriction = true;
                    upright.mSupportFriction = standFriction;
                }
                if (auto correction = RagdollCore::calculateUprightControl(upright, profile))
                {
                    mUprightControllerInput = upright;
                    mUprightControllerOutput = *correction;
                    mUprightPolicyStage = mGaitActuationDecision->mStage;
                }
            }

#ifdef OPENMW_RAGDOLL_DEV_API
            // Bodies under the floor while down (play test 2026-09-29: "the
            // enemy fell in the stairs and clipped into the ground").
            // OPENMW_RAGDOLL_SINK_TRACE: every 0.25 s while falling, fallen or
            // getting up, the body whose centre lies deepest under the
            // collision surface straight above it (negative = above it) and
            // the deepest floor contact.
            static const auto traceSink_tuned = RagdollCore::tuned<bool>([] { return RagdollCore::tuningText("OPENMW_RAGDOLL_SINK_TRACE") != nullptr; });
            static const auto& traceSink = traceSink_tuned.get();
            if (traceSink && mSurfaceQuery && mControllerOutput && mFixedSteps % 15 == 0
                && (mControllerOutput->mMode == RagdollCore::ActiveControllerMode::Falling
                    || mControllerOutput->mMode == RagdollCore::ActiveControllerMode::Fallen
                    || mControllerOutput->mMode == RagdollCore::ActiveControllerMode::GettingUp))
            {
                float deepest = -1.0e9f;
                std::size_t deepestBody = 0;
                for (std::size_t i = 0; i < telemetry.mBodies.size(); ++i)
                {
                    const JPH::RVec3 centre = telemetry.mBodies[i].mCenterOfMass;
                    const auto hit = mSurfaceQuery(
                        JPH::RVec3(centre.GetX(), centre.GetY(), centre.GetZ() + 80.0), -JPH::Vec3::sAxisZ(), 160.0f);
                    if (!hit)
                        continue;
                    const float depth = static_cast<float>(hit->first.GetZ() - centre.GetZ());
                    if (depth > deepest)
                    {
                        deepest = depth;
                        deepestBody = i;
                    }
                }
                float penetration = 0.0f;
                for (const auto& contact : mObservedGroundContacts)
                    penetration = std::max(penetration, contact.mPenetrationDepth);
                const JPH::RVec3 root = telemetry.mBodies.front().mCenterOfMass;
                Log(Debug::Info) << std::dec << std::fixed << std::setprecision(1) << "RAGDOLL_SINK actor="
                                 << getPtr().getCellRef().getRefId() << " powered=" << mPowered
                                 << " mode=" << static_cast<int>(mControllerOutput->mMode)
                                 << " t=" << mControllerOutput->mTimeInMode << " depth=" << deepest
                                 << " body=" << deepestBody << " contact_pen=" << penetration
                                 << " ground=" << (mSupportEstimate && mSupportEstimate->hasGroundContact())
                                 << " request=" << mRecoveryRequested << " anim=" << mRecoveryAnimationStarted
                                 << mRecoveryAnimationFinished << " root=" << root.GetX() << ',' << root.GetY()
                                 << ',' << root.GetZ();
            }
            if (RagdollCore::tuningText("OPENMW_RAGDOLL_RECOVERY_TRACE") && mControllerOutput
                && (mControllerOutput->mMode == RagdollCore::ActiveControllerMode::GettingUp
                    || mControllerOutput->mMode == RagdollCore::ActiveControllerMode::BlendBack)
                && mFixedSteps % 6 == 0)
            {
                static unsigned inputSamples = 0;
                if (inputSamples < 400)
                {
                    ++inputSamples;
                    Log(Debug::Info) << std::dec << std::setprecision(4)
                        << "RAGDOLL_RECOVERY_INPUT step=" << mFixedSteps
                        << " player=" << (getPtr() == MWMechanics::getPlayer() ? 1 : 0)
                        << " prev_mode=" << static_cast<int>(mControllerOutput->mMode)
                        << " root_owned=" << input.mRootExternallyOwned
                        << " height=" << input.mPelvisHeight
                        << " fallen_max=" << profile.mFallenMaximumPelvisHeight
                        << " up=" << input.mPelvisUpDot
                        << " feet=" << static_cast<int>(input.mSupport.mLeftFootSupported)
                            + static_cast<int>(input.mSupport.mRightFootSupported);
                }
            }
#endif
            RagdollCore::ActiveControllerOutput output;
            if (mController.step(input, duration, profile, output))
            {
                // A hit can arrive during the mode's minimum-duration guard.
                // Keep the one-shot latched until the controller actually
                // leaves recovery, then discard it before any later retry.
                mRecoveryInterrupted = input.mRecoveryInterrupted
                    && (output.mMode == RagdollCore::ActiveControllerMode::GettingUp
                        || output.mMode == RagdollCore::ActiveControllerMode::BlendBack);
                if (mControllerOutput && mControllerOutput->mMode == RagdollCore::ActiveControllerMode::BlendBack
                    && (output.mMode == RagdollCore::ActiveControllerMode::Fallen
                        || output.mMode == RagdollCore::ActiveControllerMode::Falling))
                {
                    // A collapsed attempt must not leave its completion signal
                    // latched into the next rise. Automatic recovery may request
                    // a fresh attempt through the ordinary Fallen path.
                    mRecoveryRequested = false;
                    mRecoveryAnimationStarted = false;
                    mRecoveryAnimationFinished = false;
                }
                if (output.mMode != RagdollCore::ActiveControllerMode::GettingUp
                    && output.mMode != RagdollCore::ActiveControllerMode::BlendBack)
                    mSampledRecoveryTarget.reset();
                mControllerInput = input;
                mControllerOutput = output;

                RagdollCore::GaitControllerInput gaitInput;
                gaitInput.mEnabled = locomoting && output.mDriveJointMotors;
                gaitInput.mLeftFootSupported = input.mSupport.mLeftFootSupported;
                gaitInput.mRightFootSupported = input.mSupport.mRightFootSupported;
                gaitInput.mStanceSupportsCenterOfMass = stanceSupportsCenterOfMass;
                gaitInput.mLeftFootHeight
                    = static_cast<float>(telemetry.mBodies[*mLeftFootBodyIndex].mCenterOfMass.GetZ());
                gaitInput.mRightFootHeight
                    = static_cast<float>(telemetry.mBodies[*mRightFootBodyIndex].mCenterOfMass.GetZ());
                gaitInput.mLeftFootVerticalVelocity
                    = telemetry.mBodies[*mLeftFootBodyIndex].mMotion.mLinearVelocity.GetZ();
                gaitInput.mRightFootVerticalVelocity
                    = telemetry.mBodies[*mRightFootBodyIndex].mMotion.mLinearVelocity.GetZ();
                if (mGaitOutput && mGaitOutput->hasStance() && mSwingFootTarget)
                {
                    const std::size_t swingFoot
                        = mGaitOutput->leftFootIsStance() ? *mRightFootBodyIndex : *mLeftFootBodyIndex;
                    const std::size_t stanceFoot
                        = mGaitOutput->leftFootIsStance() ? *mLeftFootBodyIndex : *mRightFootBodyIndex;
                    // Swing targets are body-origin positions converted from
                    // RagdollPose. Authored foot shapes can have a non-zero
                    // center-of-mass offset, so compare matching points.
                    JPH::Vec3 placementError
                        = JPH::Vec3(telemetry.mBodies[swingFoot].mPosition - *mSwingFootTarget);
                    placementError.SetZ(0.0f);
                    gaitInput.mSwingFootHorizontalPlacementError = placementError.Length();
                    gaitInput.mSwingFootVerticalPlacementError = std::abs(static_cast<float>(
                        telemetry.mBodies[swingFoot].mPosition.GetZ()
                        - telemetry.mBodies[stanceFoot].mPosition.GetZ()));
                    gaitInput.mSwingFootRelativeVerticalSpeed = std::abs(
                        telemetry.mBodies[swingFoot].mMotion.mLinearVelocity.GetZ()
                        - telemetry.mBodies[stanceFoot].mMotion.mLinearVelocity.GetZ());
                }
                RagdollCore::GaitControllerOutput gaitOutput;
                if (mGaitController.step(gaitInput, duration, profile.mGait, gaitOutput))
                {
                    mGaitOutput = gaitOutput;
                    if (!gaitOutput.hasStance())
                    {
                        mSwingStartModel.reset();
                        mSwingFootTarget.reset();
                        mBackwardRecoveryStep = false;
                    }
                    else if (mLeftLeg && mRightLeg)
                    {
                        const RagdollLegChain& swingLeg = gaitOutput.leftFootIsStance() ? *mRightLeg : *mLeftLeg;
                        if (gaitOutput.mTransitioned)
                        {
                            mSwingFootTarget.reset();
                            mBackwardRecoveryStep = false;
                            mSwingStartModel.reset();
                        }
                        if (!mSwingStartModel && mCurrentPhysicsPoseCaptured
                            && swingLeg.mFoot < mCurrentPhysicsPose.mBodyTransforms.size())
                        {
                            mSwingStartModel = mCurrentPhysicsPose.mBodyTransforms[swingLeg.mFoot].mTranslation;
                        }
                    }
                    // Replan during the planted, vertical-only lift, then
                    // capture the last placement at measured lift-off. An
                    // airborne foot must not chase a moving capture point.
                    if (gaitOutput.hasStance() && (!mSwingFootTarget || !gaitOutput.mSwingFootLifted)
                        && input.mSupport.hasGroundContact())
                    {
                        JPH::Vec3 forward = mTargetHorizontalVelocity;
                        forward.SetZ(0.0f);
                        const float speedSquared = forward.LengthSq();
                        if (speedSquared > std::numeric_limits<float>::epsilon())
                        {
                            forward /= std::sqrt(speedSquared);
                            const std::size_t stanceBodyIndex
                                = gaitOutput.leftFootIsStance() ? *mLeftFootBodyIndex : *mRightFootBodyIndex;
                            const JPH::RVec3 footCenter = telemetry.mBodies[stanceBodyIndex].mCenterOfMass;
                            const JPH::RVec3 stanceFootPosition(
                                footCenter.GetX(), footCenter.GetY(), input.mSupport.mGroundCenter.GetZ());
                            const auto placement = RagdollCore::selectGaitSwingPlacement(gaitOutput,
                                { gaitOutput.mPhase, telemetry.mCenterOfMass, centerOfMassVelocity,
                                    mTargetHorizontalVelocity, stanceFootPosition, forward,
                                    input.mSupport.mCenterOfMassHeight,
                                    RagdollCore::UnitModel::GravityUnitsPerSecondSquared },
                                backwardRecoveryTarget, { mSwingFootTarget, mBackwardRecoveryStep }, profile.mGait);
                            if (placement)
                            {
                                mSwingFootTarget = placement->mTarget;
                                mBackwardRecoveryStep = placement->mBackwardRecovery;
                            }
                            else if (profile.mLocomotionRoute
                                != RagdollCore::LocomotionRoute::KinematicRoot)
                            {
                                // The placement is a walking assist. It is not
                                // fatal on the kinematic route, where gameplay
                                // owns the root: rejecting it there used to
                                // drop the whole powered body mid-fight.
                                failPoweredControl(__LINE__);
                            }
                        }
                    }
                }
            }
        }

        RagdollCore::ReferenceGaitProfile mExperimentalReferenceProfile;
        // Blend from the walking end pose into standing after a stop.
        RagdollCore::ReferenceGaitHandover mHandover;
        // Brief suppression of the locomotion request after a hit.
        RagdollCore::ReferenceGaitHitStun mHitStun;
        // Powered AI melee strike: while the controller attacks, the swing
        // is driven toward the victim and the physical contact prices the hit.
        bool mAiStrikeActive = false;
        bool mAiAttackIntent = false;
        // Hard blocks this body's blade struck (it staggered), for tests.
        std::uint64_t mBlockStaggerCount = 0;
        // 0..1: how hard the player's view should nod (takePlayerCameraKick).
        float mCameraKick = 0.0f;
        float mCameraRoll = 0.0f; // signed, -1..1: a taken blow tilts the view (CAMERA_KICK)
        // Weapon knock (user 10-07: "hitting a one handed weapon should push
        // it away"): a blow on the weapon or its arm eases the weapon drive
        // for a moment, so the weapon flies off line and is brought back.
        // OPENMW_RAGDOLL_WEAPON_KNOCK = "seconds at full, drive left" (0 = off).
        float mWeaponKnock = 0.0f;
        // Guard zones (user 10-07, right-click guard: "how do we set a
        // defensive stance to for example parry an overhead chop?"): mouse
        // counts accumulated while the guard is held pick where the blade
        // covers - high (an overhead chop), left, right, low or the middle.
        // The player's from the mouse (RMB_GUARD), an NPC's from the swing it
        // reads. Within `sGuardZoneDeadCounts` of the middle: the middle.
        float mGuardZoneX = 0.0f, mGuardZoneY = 0.0f;
        static constexpr float sGuardZoneDeadCounts = 150.0f;
        static constexpr float sGuardZoneMaxCounts = 600.0f;
        enum class GuardZone : std::uint8_t { Middle, High, Left, Right, Low };
        void moveGuardZone(float countsRight, float countsUp, bool reset)
        {
            if (reset)
                mGuardZoneX = mGuardZoneY = 0.0f;
            mGuardZoneX += countsRight;
            mGuardZoneY += countsUp;
            const float length = std::hypot(mGuardZoneX, mGuardZoneY);
            if (length > sGuardZoneMaxCounts)
            {
                mGuardZoneX *= sGuardZoneMaxCounts / length;
                mGuardZoneY *= sGuardZoneMaxCounts / length;
            }
        }
        GuardZone guardZone() const
        {
