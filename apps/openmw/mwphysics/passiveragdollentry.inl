        void stepReseat(float duration)
        {
            static const auto enabled_tuned = RagdollCore::tuned<bool>([] { return weaponDriveSetting("OPENMW_RAGDOLL_HSC_RESEAT", 1.0f) > 0.0f; });
            static const auto& enabled = enabled_tuned.get();
            if (!enabled || !mRagdoll)
                return;
            // Not in a cut, where the blade lags its route for a moment (19
            // false starts in the combat checks); in a wind-up only far off.
            const bool winding = mAttackStage == AttackStage::Wind;
            const bool bad = mAttackStage != AttackStage::Cut
                && (mChamberHandError > (winding ? 15.0f : 12.0f) || mChamberWristError > (winding ? 60.0f : 45.0f));
            const bool good = mChamberHandError >= 0.0f && mChamberHandError < 8.0f && mChamberWristError >= 0.0f
                && mChamberWristError < 25.0f;
            if (bad)
                mImplausibleTime += duration;
            else if (good)
                mImplausibleTime = 0.0f;
            mReseatCooldown = std::max(0.0f, mReseatCooldown - duration);
            const bool twoHands = mWeapon && mWeapon->mTwoHanded && mSupportGrip && mSupportGrip->attached();
            if (mReseatTime <= 0.0f && mReseatEase <= 0.0f && mImplausibleTime > 0.3f && mReseatCooldown <= 0.0f)
            {
                for (int side = 0; side < 2; ++side)
                {
                    const auto& arm = side == 1 ? mRightArm : mLeftArm;
                    mReseatWrist[static_cast<std::size_t>(side)].reset();
                    if (arm && (side == 1 || twoHands))
                        mReseatWrist[static_cast<std::size_t>(side)] = mRagdoll->getSwingTwistJointGeometry(arm->mHand);
                }
                mReseatTime = 0.6f;
                // the two arms fighting each other over the hilt: the hand
                // turned over 90 deg, or pulled over 20 units off its place
                // (MOVE-01 claymore running: 22.6 units, then a cut flipped and
                // stayed flipped 69 steps with the left hand still on)
                mReseatTwisted = mChamberWristError > 90.0f || mChamberHandError > 20.0f;
                ++mReseatCount;
                Log(Debug::Info) << "RAGDOLL_HSC_RESEAT start count=" << mReseatCount
                                 << " hand_error=" << mChamberHandError << " wrist_error=" << mChamberWristError
                                 << " stage=" << static_cast<int>(mAttackStage);
            }
            if (mReseatTime > 0.0f)
            {
                mReseatTime -= duration;
                mReseatEase = 1.0f;
            }
            else if (mReseatEase > 0.0f)
                mReseatEase = std::max(0.0f, mReseatEase - duration / 0.3f);
            else
                return;
            for (int side = 0; side < 2; ++side)
                setWristOpening(side, mReseatEase);
            if (mReseatEase <= 0.0f)
            {
                mReseatWrist = {};
                mReseatCooldown = 0.5f;
                mImplausibleTime = 0.0f;
            }
        }
