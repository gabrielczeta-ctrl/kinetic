        // Puts the weapon in the hands reversed, or back, to match the grip.
        // Run with the physics step (the constraints change).
        void reconcileMurderGrip(JPH::PhysicsSystem& physics)
        {
            const bool want = murderStrokeGrip() && mWeapon && mWeapon->mAttached && mRagdoll;
            if (want == mMurder.has_value())
                return;
            if (!mWeapon || !mRagdoll || mWeapon->mHandBody >= mRagdoll->getBodyCount()
                || mWeapon->mWeaponBody >= mRagdoll->getBodyCount())
            {
                if (mReverseGrip)
                    mReverseGrip->clear();
                mMurder.reset();
                return;
            }
            // The support hand regrips on the moved weapon (as after a draw).
            clearNativeSupportGrip("murder-stroke");
            mSupportGripTelemetry.mAcquireCount = 0;
            JPH::BodyInterface& bodies = physics.GetBodyInterface();
            const JPH::BodyID handId = mRagdoll->getBodyId(mWeapon->mHandBody);
            const JPH::BodyID weaponId = mRagdoll->getBodyId(mWeapon->mWeaponBody);
            const JPH::RVec3 handPosition = bodies.GetPosition(handId);
            const JPH::Quat handRotation = bodies.GetRotation(handId);
            const auto ok = [](bool value) { return value; };
            if (want)
            {
                const JPH::RVec3 weaponPosition = bodies.GetPosition(weaponId);
                const JPH::Quat weaponRotation = bodies.GetRotation(weaponId);
                MurderReversal reversal;
                reversal.mCenterFromHand = mWeapon->mCenterFromHand;
                reversal.mBladeAxis = mWeapon->mBladeAxis.NormalizedOr(JPH::Vec3::sAxisY());
                reversal.mEdgeAxis = mWeapon->mEdgeAxis;
                reversal.mWound = mWeapon->mWoundProfile;
                reversal.mRelativePosition = handRotation.Conjugated() * JPH::Vec3(weaponPosition - handPosition);
                reversal.mRelativeRotation = (handRotation.Conjugated() * weaponRotation).Normalized();
                reversal.mHold = gripMurderSettings()[1] * mWeapon->tipDistanceFromHand();
                const float scale = mExperimentalUniformScale;
                const JPH::Vec3 blade = reversal.mBladeAxis;
                const JPH::Vec3 flat = (mWeapon->mFlatAxis - blade * mWeapon->mFlatAxis.Dot(blade))
                                           .NormalizedOr(blade.GetNormalizedPerpendicular());
                const JPH::Quat turn = JPH::Quat::sRotation(flat, osg::PIf);
                // The hold point to the hand, the blade turned half round it.
                const JPH::Vec3 position = turn * (reversal.mRelativePosition - blade * (reversal.mHold * scale));
                const JPH::Quat rotation = (turn * reversal.mRelativeRotation).Normalized();
                if (!ok(mRagdoll->releaseConstraint(mWeapon->mWeaponBody).value_or(false)))
                    return;
                mRagdoll->setBodyWorldTransform(mWeapon->mWeaponBody, handPosition + JPH::RVec3(handRotation * position),
                    (handRotation * rotation).Normalized(), mWeapon->mHandBody);
                RagdollCore::SupportGripRequest request;
                request.mFirstBody = handId;
                request.mSecondBody = weaponId;
                {
                    const std::array ids{ handId, weaponId };
                    JPH::BodyLockMultiRead lock(physics.GetBodyLockInterface(), ids.data(), static_cast<int>(ids.size()));
                    const auto* hand = lock.GetBody(0);
                    const auto* weapon = lock.GetBody(1);
                    if (!hand || !weapon)
                    {
                        mRagdoll->restoreConstraint(mWeapon->mWeaponBody);
                        return;
                    }
                    request.mFirstLocalAnchor = -hand->GetShape()->GetCenterOfMass();
                    request.mSecondLocalAnchor = rotation.Conjugated() * -position - weapon->GetShape()->GetCenterOfMass();
                }
                request.mVelocitySolverSteps = sWeaponGripSolverSteps;
                request.mPositionSolverSteps = sWeaponGripSolverSteps;
                request.mConstraintPriority = 3;
                request.mHoldRelation = rotation.Conjugated();
                request.mHoldTorque = 1.0e9f;
                request.mHoldFrequency = 30.0f;
                request.mHoldDamping = 1.0f;
                if (!mReverseGrip)
                    mReverseGrip = std::make_unique<RagdollCore::SupportGrip>(physics);
                const auto result = mReverseGrip->acquire(request, { 1.0e3f, 1.0e6f });
                if (result != RagdollCore::SupportGripAcquireResult::Acquired)
                {
                    Log(Debug::Warning) << "RAGDOLL_GRIP murder-stroke hold refused: " << static_cast<int>(result);
                    mRagdoll->setBodyWorldTransform(mWeapon->mWeaponBody,
                        handPosition + JPH::RVec3(handRotation * reversal.mRelativePosition),
                        (handRotation * reversal.mRelativeRotation).Normalized(), mWeapon->mHandBody);
                    mRagdoll->restoreConstraint(mWeapon->mWeaponBody);
                    mGrip = Grip::Normal;
                    return;
                }
                // The hand-frame geometry the planners strike with: the hilt
                // end is the "tip" now, the same way along the blade axis from
                // the hand; the edge faces the other way.
                mWeapon->mCenterFromHand = turn * (reversal.mCenterFromHand - blade * reversal.mHold);
                mWeapon->mEdgeAxis = -reversal.mEdgeAxis;
                mWeapon->mWoundProfile.mClass = RagdollCore::WoundClass::Blunt;
                mMurder = reversal;
                mMurderTurn = turn;
                mHscStriker = currentStriker();
                Log(Debug::Info) << "RAGDOLL_GRIP actor=" << getPtr().getCellRef().getRefId()
                                 << " murder-stroke hold=" << reversal.mHold << " strike_reach="
                                 << mWeapon->tipDistanceFromHand();
            }
            else
            {
                if (mReverseGrip)
                    mReverseGrip->clear();
                const MurderReversal reversal = *mMurder;
                mMurder.reset();
                mMurderTurn = JPH::Quat::sIdentity();
                mWeapon->mCenterFromHand = reversal.mCenterFromHand;
                mWeapon->mEdgeAxis = reversal.mEdgeAxis;
                mWeapon->mWoundProfile = reversal.mWound;
                mRagdoll->setBodyWorldTransform(mWeapon->mWeaponBody,
                    handPosition + JPH::RVec3(handRotation * reversal.mRelativePosition),
                    (handRotation * reversal.mRelativeRotation).Normalized(), mWeapon->mHandBody);
                mRagdoll->restoreConstraint(mWeapon->mWeaponBody);
                mHscStriker = currentStriker();
                Log(Debug::Info) << "RAGDOLL_GRIP actor=" << getPtr().getCellRef().getRefId() << " murder-stroke end";
            }
        }
